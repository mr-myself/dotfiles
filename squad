  # --- Helper scripts (run in agent panes) ------------------------------------

  {
    printf '#!/usr/bin/env bash\n'
    printf 'set -euo pipefail\n'
    printf 'SQUAD_DIR=%q\n' "$SQUAD_DIR"
    cat <<'HELPER'
EVENT="$1"
STATUS_FILE="$2"
ROLE="$3"
TIMEOUT_SECONDS="$4"
LABEL="$5"

# Upper bound on how long we let our OWN `tmux wait-for` client take to notice
# the signal we send it on a failure path. It exits at once in practice; the
# bound exists only so this script can never block forever.
WAITER_GRACE_SECONDS=5

log() {
  printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"
}

# COMPLETION IS THE STATUS FILE, NOT THE TMUX EVENT.
#
# Each agent helper deletes this file when it starts and writes it exactly once,
# BEFORE signalling, when it finishes. So a non-empty status file means "this
# round finished" and nothing else can mean that. -s rather than -f is
# deliberate: it skips the instant during which the redirect has truncated the
# file but not yet written to it.
#
# The event is only a low-latency hint. One event name is reused for every round
# of a step, and the Manager re-runs the Coder via resume and re-runs RuboCop
# after every fix, so a flag left on the channel by an earlier round used to make
# the next wait return at once and hand back the PREVIOUS round's status - which
# looks exactly like success. Trusting the file instead makes that impossible.
status_ready() {
  [[ -s "$STATUS_FILE" ]]
}

# Fail closed on a bad role: waiting for an event that nothing will ever signal
# would hang the Manager forever.
#
# Deliberately NO `wait-for -S` here: no waiter has been started yet, and
# signalling an unwaited channel leaves tmux's "woken" flag set on it. Event
# names are reused by later rounds (the same coder event is waited on again), so
# a leftover flag would make a LATER run-wait return immediately and hand the
# Manager a stale status file.
case "$ROLE" in
  manager|coder|advisor) ;;
  *)
    printf '125\n' > "$STATUS_FILE"
    log "$LABEL: invalid role $ROLE (expected manager, coder, or advisor). Pass a role, never a pane ID."
    exit 2
    ;;
esac

# NOTHING IS ARMED YET, DELIBERATELY. The waiter is armed once, below, and only
# after the fast path has had its chance to return. Arming before that leaked one
# `tmux wait-for` client on every fast-path return, and a leaked client stays
# registered and swallows the next signal on this event name.

# Wait for our own waiter to exit, bounded so we can never block forever.
#
# Killing it is the LAST resort, never the normal mechanism: on tmux 3.4 a killed
# `tmux wait-for` client stays in the channel's waiter list and SWALLOWS the next
# signal sent to that name, which would silently break the next round that reuses
# the event. Signalling and letting the client consume it is the only sequence
# that leaves the channel with neither a stale flag nor a dead waiter.
reap_waiter() {
  local waited=0
  while kill -0 "$WAIT_PID" 2>/dev/null; do
    if (( waited >= WAITER_GRACE_SECONDS )); then
      log "$LABEL: the tmux wait-for client ignored our own signal; terminating it. Event $EVENT may now swallow one signal - use a fresh round rather than reusing it."
      kill "$WAIT_PID" 2>/dev/null || true
      break
    fi
    sleep 1
    waited=$((waited + 1))
  done
  wait "$WAIT_PID" 2>/dev/null || true
}

# Stop OUR OWN waiter. We only signal while our own waiter is alive to consume
# it, so this send never arms the channel by itself.
#
# KNOWN AND DELIBERATELY TOLERATED RACE. The agent writes its status file and
# only then signals, with a `tmux select-pane` between the two. If we notice the
# status file inside that gap we release our waiter, and the agent's own signal
# then lands on a channel with nobody waiting and arms the flag. Measured: this
# reproduces, and the flag really is left set.
#
# It is tolerated because it is SELF-CORRECTING and the alternatives are not:
#   * The next round on this event hits the discard branch below - event fired,
#     no status file - logs it, discards it and re-arms. Measured end to end on a
#     reused event: round 2 waited the full duration and returned the real
#     status, with no waiter left over.
#   * NOT releasing at all, and leaving our waiter for the agent's signal to
#     consume, removes the flag but leaks a registered client whenever the agent
#     never signals (it crashed, or we are on the 124/125 path). A leaked client
#     silently swallows the NEXT round's real signal and nothing ever cleans it
#     up - measured: leaked clients from an earlier test run were still
#     registered hours later. That failure is invisible and permanent; this one
#     costs one extra loop iteration and a log line.
#   * Killing the client is worse still - see reap_waiter.
#
# So: prefer a self-correcting flag over a permanent dead waiter. Do not
# "fix" this by removing the signal without solving the leak it would create.
release_waiter() {
  if kill -0 "$WAIT_PID" 2>/dev/null; then
    tmux wait-for -S "$EVENT"
    reap_waiter
  else
    wait "$WAIT_PID" 2>/dev/null || true
  fi
}

report_done() {
  log "$LABEL finished (status $(cat "$STATUS_FILE"))."
  exit 0
}

# Fast path: the agent may have finished before this wait was ever called. No
# waiter has been armed yet, so there is nothing to release.
if status_ready; then
  report_done
fi

tmux wait-for "$EVENT" &
WAIT_PID=$!

elapsed=0
while :; do
  # Authoritative check, always first.
  if status_ready; then
    release_waiter
    report_done
  fi

  # Our waiter exited but no status file exists. The agent always writes its
  # status BEFORE signalling, so this cannot be this round's completion: it is a
  # leftover flag from an earlier round that reused this event name. Discard it
  # and keep waiting for the real thing.
  if ! kill -0 "$WAIT_PID" 2>/dev/null; then
    wait "$WAIT_PID" 2>/dev/null || true
    log "$LABEL: discarded a stale tmux signal on $EVENT (no status file was written)."
    tmux wait-for "$EVENT" &
    WAIT_PID=$!
  fi

  # Resolved every iteration: the pane ID behind a role is not stable.
  if ! "$SQUAD_DIR/squad-pane" "$ROLE" >/dev/null 2>&1; then
    release_waiter
    # The pane may have vanished only after the agent finished.
    if status_ready; then
      report_done
    fi
    printf '125\n' > "$STATUS_FILE"
    log "$LABEL: role $ROLE could not be resolved (pane gone)."
    exit 0
  fi

  if (( elapsed >= TIMEOUT_SECONDS )); then
    release_waiter
    # Re-read before giving up: the agent may have finished during the last
    # sleep. Recording 124 over a real status would report a completed step as a
    # timeout.
    if status_ready; then
      report_done
    fi
    printf '124\n' > "$STATUS_FILE"
    log "$LABEL timed out after $TIMEOUT_SECONDS seconds."
    exit 0
  fi

  sleep 1
  ((elapsed += 1))
done
HELPER
  } > "$SQUAD_DIR/run-wait"
  chmod +x "$SQUAD_DIR/run-wait"

