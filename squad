#!/usr/bin/env bash
set -euo pipefail
EVENT="$1"
STATUS_FILE="$2"
PANE="$3"
TIMEOUT_SECONDS="$4"
LABEL="$5"

log() {
  printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"
}

tmux wait-for "$EVENT" &
WAIT_PID=$!

elapsed=0
while kill -0 "$WAIT_PID" 2>/dev/null; do
  if ! tmux display-message -p -t "$PANE" '#{pane_id}' >/dev/null 2>&1; then
    printf '125\n' > "$STATUS_FILE"
    log "$LABEL pane disappeared before completion."
    tmux wait-for -S "$EVENT"
    break
  fi

  if (( elapsed >= TIMEOUT_SECONDS )); then
    printf '124\n' > "$STATUS_FILE"
    log "$LABEL timed out after $TIMEOUT_SECONDS seconds."
    tmux wait-for -S "$EVENT"
    break
  fi

  sleep 1
  ((elapsed += 1))
done

wait "$WAIT_PID"
