  cat > "$SQUAD_DIR/run-rubocop" <<'HELPER'
#!/usr/bin/env bash
set -euo pipefail
COMMAND_FILE="$1"
RESULT_FILE="$2"
STATUS_FILE="$3"
EVENT="$4"
TITLE_FILE="$5"

log() {
  printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"
}

set_title() {
  tmux select-pane -T "Coder: $1"
}

finish() {
  rc=$?
  trap - EXIT
  printf '%s\n' "$rc" > "$STATUS_FILE"
  if [[ "$rc" -eq 0 ]]; then
    set_title "RuboCop passed $(date '+%H:%M:%S')"
  else
    set_title "RuboCop failed($rc) $(date '+%H:%M:%S')"
  fi
  tmux wait-for -S "$EVENT"
  exit "$rc"
}
trap finish EXIT

set_title "RuboCop since $(date '+%H:%M:%S')"
log ">>> RuboCop starting..."

BASE_COMMAND="$(cat "$COMMAND_FILE")"
if [[ -z "$BASE_COMMAND" ]]; then
  {
    log ">>> RuboCop skipped: not a Ruby project (no RuboCop command configured)."
    printf 'RuboCop skipped: not a Ruby project.\n'
  } | tee "$RESULT_FILE"
  exit 0
fi

RUBOCOP_FILES=()
while IFS= read -r file; do
  case "$file" in
    app/*|config/*|db/*|lib/*|spec/*|test/*|Gemfile|Rakefile|config.ru|*.rb|*.rake|*.gemspec|*.jbuilder|*.builder)
      [[ -f "$file" ]] && RUBOCOP_FILES+=("$file")
      ;;
  esac
done < <(
  {
    # HEAD does not exist in a repository without commits; everything is
    # untracked there and covered by ls-files below.
    if git rev-parse --verify --quiet HEAD >/dev/null; then
      git diff --name-only --diff-filter=ACMRT HEAD --
    fi
    git ls-files --others --exclude-standard
  } | sort -u
)

if [[ "${#RUBOCOP_FILES[@]}" -eq 0 ]]; then
  {
    log ">>> RuboCop skipped: no changed Rails/Ruby files."
    printf 'No changed Rails/Ruby files for RuboCop.\n'
  } | tee "$RESULT_FILE"
  exit 0
fi

{
  printf 'RuboCop target files:\n'
  printf '%s\n' "${RUBOCOP_FILES[@]}"
} > "$RESULT_FILE"
log ">>> RuboCop target files:"
printf '%s\n' "${RUBOCOP_FILES[@]}" |
  while IFS= read -r line; do log "  $line"; done

printf '%q\n' "${RUBOCOP_FILES[@]}" > "${RESULT_FILE%.txt}.files"
AUTOCORRECT_LOG="${RESULT_FILE%.txt}.autocorrect.log"

log ">>> RuboCop autocorrect starting..."
{
  printf '\nRuboCop autocorrect (-a):\n'
  set +e
  bash -lc "$BASE_COMMAND -a --cache true \"\$@\"" bash "${RUBOCOP_FILES[@]}"
  autocorrect_status=$?
  set -e
  printf 'RuboCop autocorrect exit status: %s\n' "$autocorrect_status"
} > "$AUTOCORRECT_LOG" 2>&1
cat "$AUTOCORRECT_LOG" >> "$RESULT_FILE"
while IFS= read -r line; do log "$line"; done < "$AUTOCORRECT_LOG"

log ">>> RuboCop verification starting..."
bash -lc "$BASE_COMMAND --cache true \"\$@\"" bash "${RUBOCOP_FILES[@]}" 2>&1 |
  tee -a "$RESULT_FILE" |
  while IFS= read -r line; do log "$line"; done
log ">>> RuboCop autocorrect and verification finished for changed Rails/Ruby files."
HELPER
  chmod +x "$SQUAD_DIR/run-rubocop"
}

# --- Manager system prompt ----------------------------------------------------
# Contains NO tmux pane ID: every agent is addressed by role, so the prompt stays
# valid across any number of resumes. Regenerated on resume for the same reason.
generate_manager_prompt() {
  local plan_event="squad-$RUN_ID-plan"
  local coder_event="squad-$RUN_ID-coder"
  local rubocop_event="squad-$RUN_ID-rubocop"
  local review_event="squad-$RUN_ID-review"

  set_worktree_mode

  cat > "$SQUAD_DIR/manager-prompt.md" << PROMPT
# You are a Development Manager

You coordinate a Coder and an Advisor in separate tmux panes.
You do NOT write code yourself.
Speak Japanese to PO (user). Write English for agents.

## Environment

- Original worktree: $REPO_ROOT
- Squad worktree: $WORKDIR
- Worktree mode: $WORKTREE_MODE
- Squad branch: $BRANCH
- Squad title: $SQUAD_TITLE
- Detected ticket ID: ${TICKET_ID:-not detected}
- Artifacts: $SQUAD_DIR
- Manager session ID: $MANAGER_SESSION_ID
- Coder session ID: $CODER_SESSION_ID
- Wait timeout: $WAIT_TIMEOUT_SECONDS seconds

$WORKTREE_NOTE
Agents must not create additional worktrees. In particular, do not create
worktrees under the repository such as .claude/worktree or .claude/worktrees.

## Agent addressing (roles, never pane IDs)

tmux assigns new pane IDs to every pane whenever this squad is resumed, so a
pane ID is NEVER a stable address. Address agents by role only. The roles are
exactly: manager, coder, advisor.

  '$SQUAD_DIR/squad-pane' <role>              # prints the live pane ID for a role
  '$SQUAD_DIR/send-to' <role> '<command>'     # runs one command in that role's pane

Both resolve the pane from the tmux options tagged on it, require exactly one
match for this run, and exit non-zero (sending nothing) otherwise. run-wait
likewise takes a role, not a pane ID.

- NEVER run 'tmux send-keys' yourself, and never write a literal tmux pane ID
  (a %-prefixed number such as the ones tmux prints) in any command.
- If a helper reports that a role cannot be resolved, report that to PO and stop.
  Do not guess a pane ID.

## Critical rules

- BEFORE asking Advisor to plan, inspect the ticket URL or task context and
  replace the provisional squad title with a specific title.
- A squad title MUST include the ticket ID when one exists, the business object
  or feature area, and the concrete change. Avoid vague titles such as
  "CSV import", "API fix", or "bug fix". For example:
  "EAR-123 | 車両マスタCSVインポートの重複検証追加".
- NEVER run codex or claude commands directly. ALL work MUST go through the
  send-to helper so that it lands in the agent panes.
- NEVER skip the Advisor planning step.
- ALWAYS follow the full workflow in order.
- The PO must be able to see agent work in the tmux panes.
- Use the run-wait helper to wait for completion. NEVER poll with capture-pane.
- NEVER run tmux kill-server, with or without -L or TMUX_TMPDIR. Do not ask
  Coder or Advisor to run it either. If a temporary tmux server is created for
  testing, leave it running and report the cleanup command to PO instead of
  executing it.
- NEVER run tmux kill-session, kill-window, or kill-pane unless PO explicitly
  requests that exact tmux operation. This includes test cleanup commands.
- After each Coder run, ALWAYS run the RuboCop helper and require exit status 0.
  The helper runs RuboCop autocorrect and verification only on changed
  Rails/Ruby files, never the full repo.
- The Coder MUST run relevant automated tests for the task. If tests cannot run,
  report the exact blocker to PO and do not claim completion.
- RuboCop success is required independently of the Coder's report.
- NEVER commit, push, force-push, merge, rebase, or create a pull request unless
  PO explicitly asks for that Git operation. Editing files is allowed.
- NEVER create additional git worktrees, including Claude Code default locations
  such as .claude/worktree or .claude/worktrees. Use only the isolated squad
  worktree: $WORKDIR.

## Status handling

Each helper writes an exit code to its status file before signaling completion.
After every run-wait command, read the status file. If it is not 0, read
the corresponding result file if present, report the failure to PO, and decide
whether the Coder can fix it. Never wait indefinitely after a helper failure.
run-wait writes status 125 when the role no longer resolves to a live pane, and
applies a $WAIT_TIMEOUT_SECONDS second timeout as a final fallback.

## Commands

### Update the squad title after reading the ticket

Read the ticket URL or task context first. Write a concise, specific Japanese
title to $SQUAD_DIR/new-title.txt. Include the detected ticket ID
(${TICKET_ID:-none}) when available. Distinguish this squad from parallel work
on similar features by naming the business object and concrete change. Then run:

  cat > '$SQUAD_DIR/new-title.txt' <<'EOF'
  (specific title, for example: EAR-123 | 車両マスタCSVインポートの重複検証追加)
  EOF
  '$SQUAD_DIR/update-title' '$SQUAD_DIR/title.txt' '$SQUAD_DIR/new-title.txt' '$WINDOW_SHORT_NAME'

### Ask Advisor for an implementation plan

Write an English request to $SQUAD_DIR/advisor-task.txt. Ask Advisor to inspect
the repository, produce a scoped implementation plan, define acceptance
criteria, identify relevant tests, and call out risks. Then run:

  '$SQUAD_DIR/send-to' advisor '$SQUAD_DIR/run-advisor $SQUAD_DIR/advisor-task.txt $SQUAD_DIR/advisor-result.txt $SQUAD_DIR/advisor-status.txt $plan_event $SQUAD_DIR/plan-schema.json $SQUAD_DIR/title.txt'
  '$SQUAD_DIR/run-wait' '$plan_event' '$SQUAD_DIR/advisor-status.txt' advisor '$WAIT_TIMEOUT_SECONDS' 'Advisor planning'
  cat '$SQUAD_DIR/advisor-status.txt'
  cat '$SQUAD_DIR/advisor-result.txt'

### Ask Coder to implement

Write an English request to $SQUAD_DIR/coder-task.txt. Include the approved plan
and acceptance criteria. Require Coder to inspect project rules, implement the
change, run relevant automated tests, run RuboCop, and return the structured
verification report. For broad or uncertain changes, require Coder to use
built-in Explore subagents to investigate independent areas in parallel before
editing. Keep all file writes in the main Coder session, and skip subagents for
narrow changes. Explicitly prohibit commit, push, force-push, merge, rebase, and
pull-request creation unless PO requested that specific Git operation. Explicitly
prohibit creating any additional git worktree, including .claude/worktree or
.claude/worktrees. Explicitly prohibit tmux kill-server, tmux kill-session,
tmux kill-window, and tmux kill-pane; tell Coder to leave any temporary tmux
test server running and report the cleanup command instead. Then run:

  '$SQUAD_DIR/send-to' coder '$SQUAD_DIR/run-coder $SQUAD_DIR/coder-task.txt $SQUAD_DIR/coder-result.txt $SQUAD_DIR/coder-status.txt $coder_event $CODER_SESSION_ID $SQUAD_DIR/coder-schema.json initial $SQUAD_DIR/title.txt'
  '$SQUAD_DIR/run-wait' '$coder_event' '$SQUAD_DIR/coder-status.txt' coder '$WAIT_TIMEOUT_SECONDS' 'Coder'
  cat '$SQUAD_DIR/coder-status.txt'
  cat '$SQUAD_DIR/coder-result.txt'

### Run mandatory RuboCop verification

Always run this after Coder implementation and after each fix:

  '$SQUAD_DIR/send-to' coder '$SQUAD_DIR/run-rubocop $SQUAD_DIR/rubocop-command.txt $SQUAD_DIR/rubocop-result.txt $SQUAD_DIR/rubocop-status.txt $rubocop_event $SQUAD_DIR/title.txt'
  '$SQUAD_DIR/run-wait' '$rubocop_event' '$SQUAD_DIR/rubocop-status.txt' coder '$WAIT_TIMEOUT_SECONDS' 'RuboCop'
  cat '$SQUAD_DIR/rubocop-status.txt'
  cat '$SQUAD_DIR/rubocop-result.txt'

RuboCop status must be 0. The helper first runs rubocop -a --cache true on the
changed Rails/Ruby files, then runs verification on the same files. If there are
no changed Rails/Ruby files, or the project is not a Ruby project (no RuboCop
command configured), the helper records that and returns 0. The configured
command uses --fail-level W, so warnings also fail verification.

### Ask Advisor to review

Write an English request to $SQUAD_DIR/review-task.txt. Tell Advisor to inspect
all uncommitted changes, verify behavior against the approved acceptance
criteria, check the Coder's test report and mandatory RuboCop result, and return
must_fix findings. A pass verdict is allowed only when relevant tests ran and
RuboCop status is 0. Then run:

  '$SQUAD_DIR/send-to' advisor '$SQUAD_DIR/run-review $SQUAD_DIR/review-task.txt $SQUAD_DIR/review-result.txt $SQUAD_DIR/review-status.txt $review_event $SQUAD_DIR/review-schema.json $SQUAD_DIR/title.txt'
  '$SQUAD_DIR/run-wait' '$review_event' '$SQUAD_DIR/review-status.txt' advisor '$WAIT_TIMEOUT_SECONDS' 'Advisor review'
  cat '$SQUAD_DIR/review-status.txt'
  cat '$SQUAD_DIR/review-result.txt'

### Ask Coder to fix review findings

Write an English request to $SQUAD_DIR/coder-task.txt. Include all must_fix
findings and require updated tests and RuboCop. Reiterate that Coder must not
create additional git worktrees and must keep all work in $WORKDIR. Reiterate
that Coder must not run tmux kill-server, tmux kill-session, tmux kill-window,
or tmux kill-pane, including for test cleanup. Continue the exact Coder session:

  '$SQUAD_DIR/send-to' coder '$SQUAD_DIR/run-coder $SQUAD_DIR/coder-task.txt $SQUAD_DIR/coder-result.txt $SQUAD_DIR/coder-status.txt $coder_event $CODER_SESSION_ID $SQUAD_DIR/coder-schema.json resume $SQUAD_DIR/title.txt'
  '$SQUAD_DIR/run-wait' '$coder_event' '$SQUAD_DIR/coder-status.txt' coder '$WAIT_TIMEOUT_SECONDS' 'Coder fix'
  cat '$SQUAD_DIR/coder-status.txt'
  cat '$SQUAD_DIR/coder-result.txt'

## Workflow

1. Inspect the linked ticket or task context and update the provisional title.
2. Ask Advisor for a structured implementation plan.
3. Show the plan to PO in Japanese and ask for approval.
4. Ask Coder to implement the approved plan.
5. Read Coder status and structured verification report.
6. Run the mandatory RuboCop helper and require status 0.
7. Ask Advisor to review the uncommitted changes and verification evidence.
8. If review verdict is must_fix or RuboCop failed, ask Coder to fix the issues.
9. After every fix, repeat from step 5.
10. Report completion to PO in Japanese. Include the squad worktree path, branch,
   test commands and results, and mandatory RuboCop result.
PROMPT
}

# The resumed Manager keeps its previous Claude session, so its transcript still
# contains the pane IDs it used before the resume. Those IDs are dead: say so
# explicitly, or the model will keep reusing them from its own history.
generate_resume_prompt() {
  cat "$SQUAD_DIR/manager-prompt.md" > "$SQUAD_DIR/manager-resume-prompt.md"
  cat >> "$SQUAD_DIR/manager-resume-prompt.md" << PROMPT

## MIGRATION: this squad was resumed (read this before any command)

This squad has been resumed in a NEW tmux window, so every tmux pane ID changed.
Any literal tmux pane ID (a %-prefixed number) that appears in earlier turns of
this conversation is now STALE, and tmux may already have reassigned it to an
unrelated pane.

- Those earlier commands are OBSOLETE. NEVER copy or reuse a command containing
  a literal pane ID, and never run 'tmux send-keys' yourself.
- NEVER pass a pane ID to run-wait. It takes a role: manager, coder, or advisor.
- ALWAYS address agents by role through the helpers, exactly as shown in the
  Commands section above:

    '$SQUAD_DIR/send-to' coder '<command>'
    '$SQUAD_DIR/run-wait' '<event>' '<status file>' coder '$WAIT_TIMEOUT_SECONDS' '<label>'

- The helpers resolve the live pane for this run themselves. If one reports that
  a role cannot be resolved, report that to PO and stop; do not guess.
- The Coder and Advisor panes of this resumed window are fresh shells: no agent
  is mid-task, and the Coder resumes its own session only when you send
  run-coder with the resume mode.
PROMPT
}

resume_run() {
  local new_window
  local target_session="${2:-}"

  # Without an explicit target session, resume must run inside tmux (existing
  # behavior). With --session, we create the window in that session directly and
  # do not require $TMUX (e.g. when launched from an external tool).
  if [[ -z "$target_session" && -z "${TMUX:-}" ]]; then
    echo "Error: squad resume must be run inside tmux (or pass --session <name>)" >&2
    exit 1
  fi

  load_run "${1:-}"
  [[ -d "$WORKDIR" ]] || {
    echo "Error: squad worktree no longer exists: $WORKDIR" >&2
    exit 1
  }

  if window_exists "${WINDOW_ID:-}"; then
    echo "Error: squad is already running in window $WINDOW_ID" >&2
    exit 1
  fi

  # Diagnostics only: kept so state.env still records the original layout.
  ORIG_MANAGER_PANE="${ORIG_MANAGER_PANE:-${MANAGER_PANE:-}}"
  ORIG_CODER_PANE="${ORIG_CODER_PANE:-${CODER_PANE:-}}"
  ORIG_ADVISOR_PANE="${ORIG_ADVISOR_PANE:-${ADVISOR_PANE:-}}"

  if [[ -n "$target_session" ]]; then
    new_window="$(tmux new-window -d -t "${target_session}:" -c "$WORKDIR" -P -F '#{window_id} #{pane_id}')"
  else
    new_window="$(tmux new-window -d -c "$WORKDIR" -P -F '#{window_id} #{pane_id}')"
  fi
  read -r WINDOW_ID MANAGER_PANE <<< "$new_window"
  CODER_PANE="$(tmux split-window -h -c "$WORKDIR" -d -t "$MANAGER_PANE" -P -F '#{pane_id}')"
  ADVISOR_PANE="$(tmux split-window -v -c "$WORKDIR" -d -t "$CODER_PANE" -P -F '#{pane_id}')"
  CURRENT_WINDOW_NAME="$(tmux display-message -p -t "$WINDOW_ID" '#W')"
  WINDOW_SHORT_NAME="${WINDOW_SHORT_NAME:-squad:${RUN_ID:0:15}}"
  RUN_STATUS="running"
  write_state
  tag_all_panes

  # Regenerate the helper scripts and prompts from this version of squad, so a
  # run created by an older version is migrated to role addressing the moment it
  # is resumed. The prompts contain no pane ID, so no rewrite is needed.
  SQUAD_TITLE="$(cat "$SQUAD_DIR/title.txt" 2>/dev/null || printf 'squad')"
  generate_helper_scripts
  generate_manager_prompt
  generate_resume_prompt

  tmux rename-window -t "$WINDOW_ID" "$WINDOW_SHORT_NAME"
  tmux select-pane -t "$MANAGER_PANE" -T "$SQUAD_TITLE"
  tmux select-pane -t "$CODER_PANE" -T "Coder"
  tmux select-pane -t "$ADVISOR_PANE" -T "Advisor"
  tmux set-option -w -t "$WINDOW_ID" pane-border-status top
  tmux set-option -w -t "$WINDOW_ID" pane-border-format " #{pane_title} "
  tmux set-option -w -t "$WINDOW_ID" @squad_run_id "$RUN_ID"
  tmux set-option -w -t "$WINDOW_ID" @squad_state_file "$STATE_FILE"
  tmux send-keys -t "$MANAGER_PANE" "$SQUAD_DIR/run-manager-resume '$WORKDIR' '$SQUAD_DIR/manager-resume-prompt.md' '$MANAGER_SESSION_ID'" Enter
  tmux select-window -t "$WINDOW_ID"
  printf 'Squad resumed: %s\n' "$RUN_ID"
}

[[ $# -gt 0 ]] || usage
case "$1" in
  -h|--help)
    usage 0
    ;;
  list)
    list_runs
    exit 0
    ;;
  close)
    close_run "${2:-}"
    exit 0
    ;;
  rm)
    shift
    [[ $# -gt 0 ]] || {
      echo "Error: squad rm requires at least one run-id (see: squad list)" >&2
      exit 1
    }
    rm_status=0
    for run_id in "$@"; do
      rm_state_file="$SQUAD_RUN_ROOT/$run_id/state.env"
      if [[ ! -f "$rm_state_file" ]]; then
        echo "Error: unknown squad run: $run_id" >&2
        rm_status=1
        continue
      fi
      remove_run "$rm_state_file" || rm_status=1
    done
    exit "$rm_status"
    ;;
  clean)
    clean_runs
    exit 0
    ;;
  resume)
    shift
    resume_session=""
    if [[ "${1:-}" == "--session" ]]; then
      if [[ $# -lt 2 || -z "${2:-}" ]]; then
        echo "Error: --session requires a value" >&2
        exit 1
      fi
      resume_session="$2"
      shift 2
    fi
    resume_run "${1:-}" "$resume_session"
    exit 0
    ;;
esac

TASK="$*"
if [[ "$TASK" =~ ([[:alnum:]_]+-[[:digit:]]+) ]]; then
  TICKET_ID="${BASH_REMATCH[1]}"
  SQUAD_TITLE="$TICKET_ID | チケット内容を確認中"
else
  TICKET_ID=""
  SQUAD_TITLE="チケット内容を確認中"
fi
WAIT_TIMEOUT_SECONDS="${SQUAD_WAIT_TIMEOUT_SECONDS:-7200}"
[[ "$WAIT_TIMEOUT_SECONDS" =~ ^[1-9][0-9]*$ ]] || {
  echo "Error: SQUAD_WAIT_TIMEOUT_SECONDS must be a positive integer." >&2
  exit 1
}
ORIGINAL_WORKDIR="$(pwd)"

if [[ -z "${TMUX:-}" ]]; then
  echo "Error: squad must be run inside tmux" >&2
  exit 1
fi

for cmd in claude codex git jq tmux uuidgen; do
  command -v "$cmd" >/dev/null 2>&1 || {
    echo "Error: $cmd is not installed or not in PATH" >&2
    exit 1
  }
done

REPO_ROOT="$(git -C "$ORIGINAL_WORKDIR" rev-parse --show-toplevel 2>/dev/null)" || {
  echo "Error: squad must be run inside a git repository" >&2
  exit 1
}

# git worktree add creates the worktree from HEAD, so a repository without any
# commits (unborn HEAD) cannot get an isolated worktree. In that case fall back
# to running the squad directly in the original repository.
HAS_COMMITS=true
git -C "$REPO_ROOT" rev-parse --verify --quiet HEAD >/dev/null || HAS_COMMITS=false

# --- Setup isolated worktree and artifact directory ---------------------------

RUN_ID="$(date '+%Y%m%d-%H%M%S')-$$"
STARTED_AT="$(date '+%Y-%m-%d %H:%M:%S')"
REPO_NAME="$(basename "$REPO_ROOT")"
COMPOSE_PROJECT_NAME_SAFE="$(
  printf '%s' "$REPO_NAME" |
    tr '[:upper:]' '[:lower:]' |
    sed -E 's/[^a-z0-9_-]+/-/g; s/^-+//; s/-+$//'
)"
COMPOSE_PROJECT_NAME_SAFE="${COMPOSE_PROJECT_NAME_SAFE:-squad}"
SQUAD_DIR="$SQUAD_RUN_ROOT/$RUN_ID"
if [[ "$HAS_COMMITS" == "true" ]]; then
  WORKDIR="$SQUAD_WORKTREE_ROOT/$REPO_NAME-$RUN_ID"
  if [[ -n "$TICKET_ID" ]]; then
    BRANCH="feat/$TICKET_ID"
    if branch_exists "$BRANCH"; then
      BRANCH="feat/$TICKET_ID-$RUN_ID"
    fi
  else
    BRANCH="feat/squad-$RUN_ID"
  fi
else
  # No commits yet: work directly in the original repository on its current
  # (unborn) branch.
  WORKDIR="$REPO_ROOT"
  BRANCH="$(git -C "$REPO_ROOT" symbolic-ref --short -q HEAD || echo main)"
fi
MANAGER_SESSION_ID="$(uuidgen | tr '[:upper:]' '[:lower:]')"
CODER_SESSION_ID="$(uuidgen | tr '[:upper:]' '[:lower:]')"

# If the launch dies before state.env exists (set -e), leave nothing behind:
# no empty run directory and no orphaned worktree/branch. Once state.env is
# written the run is resumable and must be kept.
cleanup_failed_launch() {
  [[ -f "$SQUAD_DIR/state.env" ]] && return 0
  rm -rf "$SQUAD_DIR"
  if [[ "$WORKDIR" != "$REPO_ROOT" && -d "$WORKDIR" ]]; then
    git -C "$REPO_ROOT" worktree remove --force "$WORKDIR" >/dev/null 2>&1 || true
    git -C "$REPO_ROOT" branch -D "$BRANCH" >/dev/null 2>&1 || true
  fi
  return 0
}
trap cleanup_failed_launch EXIT

mkdir -p "$SQUAD_RUN_ROOT" "$SQUAD_WORKTREE_ROOT" "$SQUAD_DIR"

if [[ "$HAS_COMMITS" == "true" && -n "$(git -C "$REPO_ROOT" status --porcelain)" ]]; then
  echo "Note: existing changes remain untouched in the original worktree:"
  git -C "$REPO_ROOT" status --short
  echo ""
fi

if [[ -n "${SQUAD_RUBOCOP_COMMAND:-}" ]]; then
  RUBOCOP_COMMAND="$SQUAD_RUBOCOP_COMMAND"
elif [[ ! -f "$REPO_ROOT/Gemfile" ]]; then
  # Not a Ruby project: run-rubocop sees the empty command and reports the
  # step as skipped instead of failing the squad.
  RUBOCOP_COMMAND=""
elif [[ -f "$REPO_ROOT/compose.yml" ]] && command -v docker >/dev/null 2>&1; then
  RUBOCOP_COMMAND="COMPOSE_PROJECT_NAME=$COMPOSE_PROJECT_NAME_SAFE docker compose run --no-deps --rm --entrypoint '' app bundle exec rubocop --force-exclusion --fail-level W --display-only-fail-level-offenses"
elif [[ -f "$REPO_ROOT/compose.ci.yml" ]] && command -v docker >/dev/null 2>&1; then
  RUBOCOP_COMMAND="COMPOSE_PROJECT_NAME=$COMPOSE_PROJECT_NAME_SAFE docker compose -f compose.ci.yml run --no-deps --rm --entrypoint '' app bundle exec rubocop --force-exclusion --fail-level W --display-only-fail-level-offenses"
elif command -v bundle >/dev/null 2>&1; then
  RUBOCOP_COMMAND="bundle exec rubocop --force-exclusion --fail-level W --display-only-fail-level-offenses"
else
  echo "Error: no RuboCop command could be detected for this Ruby project." >&2
  echo "Set SQUAD_RUBOCOP_COMMAND to the project-specific command." >&2
  exit 1
fi

if [[ "$HAS_COMMITS" == "true" ]]; then
  git -C "$REPO_ROOT" worktree add -b "$BRANCH" "$WORKDIR" HEAD
  if [[ -f "$REPO_ROOT/.env" ]]; then
    cp "$REPO_ROOT/.env" "$WORKDIR/.env"
  fi
else
  echo "Note: this repository has no commits yet, so no isolated worktree is created."
  echo "The squad works directly in: $WORKDIR"
  echo ""
fi

set_worktree_mode

cat > "$SQUAD_DIR/run-info.txt" << INFO
Squad title:       $SQUAD_TITLE
Ticket ID:         ${TICKET_ID:-not detected}
Started at:        $STARTED_AT
Original worktree: $REPO_ROOT
Squad worktree:    $WORKDIR
Worktree mode:     $WORKTREE_MODE
Squad branch:      $BRANCH
Artifacts:         $SQUAD_DIR
Manager session:   $MANAGER_SESSION_ID
Coder session:     $CODER_SESSION_ID
RuboCop command:   ${RUBOCOP_COMMAND:-(none: not a Ruby project, RuboCop step is skipped)}
Wait timeout:      $WAIT_TIMEOUT_SECONDS seconds
INFO

cat "$SQUAD_DIR/run-info.txt"
echo ""
printf '%s\n' "$SQUAD_TITLE" > "$SQUAD_DIR/title.txt"

# --- Create panes -------------------------------------------------------------

MANAGER_PANE="${TMUX_PANE:-$(tmux display-message -p '#{pane_id}')}"
CURRENT_WINDOW_NAME="$(tmux display-message -p -t "$MANAGER_PANE" '#W')"
WINDOW_ID="$(tmux display-message -p -t "$MANAGER_PANE" '#{window_id}')"
WINDOW_SHORT_NAME="squad:${RUN_ID:0:15}"
CODER_PANE=$(tmux split-window -h -c "$WORKDIR" -d -t "$MANAGER_PANE" -P -F '#{pane_id}')
ADVISOR_PANE=$(tmux split-window -v -c "$WORKDIR" -d -t "$CODER_PANE" -P -F '#{pane_id}')

RUN_STATUS="running"
write_state
tag_all_panes
tmux rename-window -t "$WINDOW_ID" "$WINDOW_SHORT_NAME"
tmux select-pane -t "$MANAGER_PANE" -T "$SQUAD_TITLE"
tmux select-pane -t "$CODER_PANE" -T "Coder"
tmux select-pane -t "$ADVISOR_PANE" -T "Advisor"
tmux set-option -w -t "$WINDOW_ID" pane-border-status top
tmux set-option -w -t "$WINDOW_ID" pane-border-format " #{pane_title} "
tmux set-option -w -t "$WINDOW_ID" @squad_run_id "$RUN_ID"
tmux set-option -w -t "$WINDOW_ID" @squad_state_file "$STATE_FILE"

# --- Structured output schemas ------------------------------------------------

cat > "$SQUAD_DIR/plan-schema.json" <<'SCHEMA'
{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "summary": { "type": "string" },
    "scope": { "type": "array", "items": { "type": "string" } },
    "acceptance_criteria": { "type": "array", "items": { "type": "string" } },
    "files_to_inspect": { "type": "array", "items": { "type": "string" } },
    "implementation_steps": { "type": "array", "items": { "type": "string" } },
    "tests": { "type": "array", "items": { "type": "string" } },
    "risks": { "type": "array", "items": { "type": "string" } }
  },
  "required": [
    "summary",
    "scope",
    "acceptance_criteria",
    "files_to_inspect",
    "implementation_steps",
    "tests",
    "risks"
  ]
}
SCHEMA

cat > "$SQUAD_DIR/coder-schema.json" <<'SCHEMA'
{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "summary": { "type": "string" },
    "changed_files": { "type": "array", "items": { "type": "string" } },
    "tests_run": { "type": "array", "items": { "type": "string" } },
    "tests_not_run": { "type": "array", "items": { "type": "string" } },
    "test_status": { "type": "string", "enum": ["pass", "fail", "blocked"] },
    "rubocop_status": { "type": "string", "enum": ["pass", "fail", "blocked"] },
    "remaining_issues": { "type": "array", "items": { "type": "string" } }
  },
  "required": [
    "summary",
    "changed_files",
    "tests_run",
    "tests_not_run",
    "test_status",
    "rubocop_status",
    "remaining_issues"
  ]
}
SCHEMA

cat > "$SQUAD_DIR/review-schema.json" <<'SCHEMA'
{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "verdict": { "type": "string", "enum": ["pass", "must_fix"] },
    "summary": { "type": "string" },
    "must_fix": { "type": "array", "items": { "type": "string" } },
    "should_fix": { "type": "array", "items": { "type": "string" } },
    "test_gaps": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["verdict", "summary", "must_fix", "should_fix", "test_gaps"]
}
SCHEMA

printf '%s\n' "$RUBOCOP_COMMAND" > "$SQUAD_DIR/rubocop-command.txt"

# --- Generated helper scripts and Manager prompt ------------------------------
# Both are regenerated verbatim by resume_run, so they must never contain a
# tmux pane ID.

generate_helper_scripts
generate_manager_prompt

# --- Launch Manager -----------------------------------------------------------

cd "$WORKDIR"
MANAGER_GUARD_BIN="$SQUAD_DIR/manager-guard-bin"
mkdir -p "$MANAGER_GUARD_BIN"
SQUAD_REAL_TMUX="$(command -v tmux)"
export SQUAD_REAL_TMUX
cat > "$MANAGER_GUARD_BIN/tmux" <<'WRAPPER'
#!/usr/bin/env bash
set -euo pipefail
for arg in "$@"; do
  case "$arg" in
    kill-server|kill-session|kill-window|kill-pane)
      printf 'squad: blocked dangerous tmux command: %s\n' "$arg" >&2
      exit 126
      ;;
  esac
done
exec "$SQUAD_REAL_TMUX" "$@"
WRAPPER
chmod +x "$MANAGER_GUARD_BIN/tmux"
export PATH="$MANAGER_GUARD_BIN:$PATH"

set +e
printf '[%s] Manager prompt sent for squad: %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$SQUAD_TITLE"
CLAUDE_CODE_DISABLE_TERMINAL_TITLE=1 claude --dangerously-skip-permissions \
  --allowedTools "Bash Read Glob Grep WebFetch WebSearch" \
  --append-system-prompt "$(cat "$SQUAD_DIR/manager-prompt.md")" \
  --session-id "$MANAGER_SESSION_ID" \
  "$TASK"
MANAGER_STATUS=$?
set -e

echo ""
echo "Manager exited with status $MANAGER_STATUS."
echo "Squad worktree retained at: $WORKDIR"
echo "Squad branch retained as:   $BRANCH"
echo "Artifacts retained at:      $SQUAD_DIR"
exit "$MANAGER_STATUS"
