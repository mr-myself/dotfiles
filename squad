codex -a never -s read-only exec review \
  --json \
  --output-schema "$SCHEMA_FILE" \
  -o "$RESULT_FILE" \
  "$(cat "$TASK_FILE")" |
  tee "$STREAM_FILE" |
  jq --unbuffered -r '
    if .type == "item.started" then "[started] \(.item.type // "item")"
    elif .type == "item.completed" and .item.type == "command_execution" then
      "[command] \(.item.command // "")\n[exit] \(.item.exit_code // "unknown")"
    elif .type == "item.completed" and .item.type == "agent_message" then .item.text
    elif .type == "turn.completed" then "[turn] completed"
    else empty end
  ' |
  while IFS= read -r line; do log "$line"; done
cat "$RESULT_FILE" 2>/dev/null || true
log ">>> Advisor review finished."
