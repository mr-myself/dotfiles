# Full review-schema.json conformance, not just "the fields I am about to read
# exist". The schema sets additionalProperties:false, so an UNEXPECTED top-level
# key is off-schema even when every required key is present and well typed - and
# a lens result carrying stray metadata must not be merged into a pass.
check_result() {
  local lens="$1" file="$2" count extra
  [[ -s "$file" ]] || fail "the $lens result file is missing or empty: $file"

  # EXACTLY ONE JSON value, checked FIRST and enforced for every check below.
  #
  # jq on a multi-document stream runs the filter once per document, and `jq -e`
  # reports the exit status of the LAST one - while the merge reads only the
  # FIRST value. Without this, a bad first object followed by a good second
  # object validates clean and then gets merged, which is the silent pass this
  # whole function exists to prevent. `jq -s` is what makes every later check
  # speak about the same single value the merge will use.
  count="$(jq -s 'length' "$file" 2>/dev/null || true)"
  [[ "$count" =~ ^[0-9]+$ ]] ||
    fail "the $lens result file is not valid JSON: $file"
  [[ "$count" -eq 1 ]] ||
    fail "the $lens result file must contain exactly one JSON value, found $count: $file"

  jq -s -e '.[0] | type == "object"' "$file" >/dev/null 2>&1 ||
    fail "the $lens result file is not a JSON object: $file"
  extra="$(
    jq -s -r '.[0] | (keys) - ["verdict","summary","must_fix","should_fix","test_gaps"] | join(", ")' \
      "$file" 2>/dev/null || true
  )"
  [[ -z "$extra" ]] ||
    fail "the $lens result file has top-level properties review-schema.json does not allow ($extra): $file"
  jq -s -e '
    .[0] |
    ((keys) == ["must_fix","should_fix","summary","test_gaps","verdict"])
    and (.verdict == "pass" or .verdict == "must_fix")
    and (.summary | type == "string")
    and (.must_fix | type == "array")
    and (.should_fix | type == "array")
    and (.test_gaps | type == "array")
    and ([.must_fix[], .should_fix[], .test_gaps[]] | all(type == "string"))
  ' "$file" >/dev/null 2>&1 ||
    fail "the $lens result file is not a valid review-schema.json object (missing key, wrong type, or non-string finding): $file"
