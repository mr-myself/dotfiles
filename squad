fi

# must_fix if EITHER lens says must_fix; the arrays are the union of both, each
# finding tagged with the lens that found it.
jq -n \
  --slurpfile correctness "$CORRECTNESS_RESULT" \
  --slurpfile security "$SECURITY_RESULT" '
  ($correctness[0]) as $c |
  ($security[0]) as $s |
  {
    verdict: (if $c.verdict == "must_fix" or $s.verdict == "must_fix" then "must_fix" else "pass" end),
    summary: ("[correctness] " + $c.summary + "\n\n[security] " + $s.summary),
    must_fix: (($c.must_fix | map("[correctness] " + .)) + ($s.must_fix | map("[security] " + .))),
    should_fix: (($c.should_fix | map("[correctness] " + .)) + ($s.should_fix | map("[security] " + .))),
    test_gaps: (($c.test_gaps | map("[correctness] " + .)) + ($s.test_gaps | map("[security] " + .)))
  }' > "$OUT_RESULT" || fail "could not merge the two lens results"

[[ -s "$OUT_RESULT" ]] || fail "the merged result came out empty"

printf '%s\n' "$AGGREGATE_RC" > "$OUT_STATUS"
printf 'merge-reviews: correctness status %s, security status %s -> aggregate status %s\n' \
  "$CORRECTNESS_RC" "$SECURITY_RC" "$AGGREGATE_RC"
printf 'merge-reviews: aggregate verdict %s\n' "$(jq -r '.verdict' "$OUT_RESULT")"
# Exit 0 because the MERGE succeeded. The lens outcome lives in the status file,
# never in this helper's exit code.
HELPER
  chmod +x "$SQUAD_DIR/merge-reviews"

  cat > "$SQUAD_DIR/run-rubocop" <<'HELPER'
#!/usr/bin/env bash
set -euo pipefail
COMMAND_FILE="$1"
RESULT_FILE="$2"
STATUS_FILE="$3"
EVENT="$4"
TITLE_FILE="$5"

log() {
  printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"
}

set_title() {
  # -t "$TMUX_PANE" is required. Without a target tmux retitles the window's
  # ACTIVE pane, which during a real squad is the Manager pane - so the Manager
  # pane would show this agent's status and lose the squad title, while this pane
  # kept a stale label. TMUX_PANE is always set inside a pane.
  if [[ -n "${TMUX_PANE:-}" ]]; then
    tmux select-pane -t "$TMUX_PANE" -T "Coder: $1"
  else
    tmux select-pane -T "Coder: $1"
  fi
}

finish() {
  rc=$?
  trap - EXIT
  printf '%s\n' "$rc" > "$STATUS_FILE"
  if [[ "$rc" -eq 0 ]]; then
    set_title "RuboCop passed $(date '+%H:%M:%S')"
  else
    set_title "RuboCop failed($rc) $(date '+%H:%M:%S')"
  fi
  tmux wait-for -S "$EVENT"
  exit "$rc"
}
trap finish EXIT

# Clear the previous round's status so its presence unambiguously means "THIS
# round finished". run-wait treats the status file as the single source of
# truth, and the Manager re-runs the Coder via resume and re-runs RuboCop after
# every fix, so a status left over from an earlier round would otherwise let the
# next wait report a stale result as if it were fresh. Done AFTER the trap is
# installed, so a failure from here on still records a status.
rm -f "$STATUS_FILE"

set_title "RuboCop since $(date '+%H:%M:%S')"
log ">>> RuboCop starting..."

BASE_COMMAND="$(cat "$COMMAND_FILE")"
if [[ -z "$BASE_COMMAND" ]]; then
  {
    log ">>> RuboCop skipped: not a Ruby project (no RuboCop command configured)."
    printf 'RuboCop skipped: not a Ruby project.\n'
  } | tee "$RESULT_FILE"
  exit 0
fi

RUBOCOP_FILES=()
while IFS= read -r file; do
  case "$file" in
    app/*|config/*|db/*|lib/*|spec/*|test/*|Gemfile|Rakefile|config.ru|*.rb|*.rake|*.gemspec|*.jbuilder|*.builder)
      [[ -f "$file" ]] && RUBOCOP_FILES+=("$file")
      ;;
  esac
done < <(
  {
    # HEAD does not exist in a repository without commits; everything is
    # untracked there and covered by ls-files below.
    if git rev-parse --verify --quiet HEAD >/dev/null; then
      git diff --name-only --diff-filter=ACMRT HEAD --
    fi
    git ls-files --others --exclude-standard
  } | sort -u
)

if [[ "${#RUBOCOP_FILES[@]}" -eq 0 ]]; then
  {
    log ">>> RuboCop skipped: no changed Rails/Ruby files."
    printf 'No changed Rails/Ruby files for RuboCop.\n'
  } | tee "$RESULT_FILE"
  exit 0
fi

{
  printf 'RuboCop target files:\n'
  printf '%s\n' "${RUBOCOP_FILES[@]}"
} > "$RESULT_FILE"
log ">>> RuboCop target files:"
printf '%s\n' "${RUBOCOP_FILES[@]}" |
  while IFS= read -r line; do log "  $line"; done

printf '%q\n' "${RUBOCOP_FILES[@]}" > "${RESULT_FILE%.txt}.files"
AUTOCORRECT_LOG="${RESULT_FILE%.txt}.autocorrect.log"

log ">>> RuboCop autocorrect starting..."
{
  printf '\nRuboCop autocorrect (-a):\n'
  set +e
  bash -lc "$BASE_COMMAND -a --cache true \"\$@\"" bash "${RUBOCOP_FILES[@]}"
  autocorrect_status=$?
  set -e
  printf 'RuboCop autocorrect exit status: %s\n' "$autocorrect_status"
} > "$AUTOCORRECT_LOG" 2>&1
cat "$AUTOCORRECT_LOG" >> "$RESULT_FILE"
while IFS= read -r line; do log "$line"; done < "$AUTOCORRECT_LOG"

log ">>> RuboCop verification starting..."
bash -lc "$BASE_COMMAND --cache true \"\$@\"" bash "${RUBOCOP_FILES[@]}" 2>&1 |
  tee -a "$RESULT_FILE" |
  while IFS= read -r line; do log "$line"; done
log ">>> RuboCop autocorrect and verification finished for changed Rails/Ruby files."
HELPER
  chmod +x "$SQUAD_DIR/run-rubocop"

  # Brakeman is a GATE, not a review lens: it does not feed merge-reviews and it
  # has no verdict to merge. It either passes with zero warnings, is skipped
  # because the project has no Brakeman, or it fails the round.
  #
  # WHOLE-APP scan, deliberately. Brakeman is a dataflow analyser: a warning
  # routinely originates in a controller, view or route the change never
  # touched, because the change made an existing path reachable. Filtering to
  # changed files would produce confident silence in exactly the case this gate
  # exists to catch.
  cat > "$SQUAD_DIR/run-brakeman" <<'HELPER'
#!/usr/bin/env bash
set -euo pipefail
COMMAND_FILE="$1"
RESULT_FILE="$2"
STATUS_FILE="$3"
EVENT="$4"
TITLE_FILE="$5"

JSON_REPORT="${RESULT_FILE%.txt}.json"
CONSOLE_LOG="${RESULT_FILE%.txt}.console.log"
# RELATIVE on purpose. Under the docker-compose branch the scan runs inside the
# container, where $SQUAD_DIR is not mounted but the worktree is - so an
# absolute host path for -o would fail there and nowhere else. A relative path
# resolves against the app directory in both cases. It is moved into $SQUAD_DIR
# and removed from the worktree before this helper exits, so it can never show
# up as an uncommitted change in the review that follows.
REPORT_BASENAME=".squad-brakeman-report.json"

log() {
  printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"
}

set_title() {
  # See run-rubocop: without -t this retitles the active (Manager) pane.
  if [[ -n "${TMUX_PANE:-}" ]]; then
    tmux select-pane -t "$TMUX_PANE" -T "Coder: $1"
  else
    tmux select-pane -T "Coder: $1"
  fi
}

finish() {
  rc=$?
  trap - EXIT
  rm -f "$REPORT_BASENAME"
  printf '%s\n' "$rc" > "$STATUS_FILE"
  if [[ "$rc" -eq 0 ]]; then
    set_title "Brakeman passed $(date '+%H:%M:%S')"
  else
    set_title "Brakeman failed($rc) $(date '+%H:%M:%S')"
  fi
  tmux wait-for -S "$EVENT"
  exit "$rc"
}
trap finish EXIT

# Same stale-status protection as every other helper: cleared AFTER the trap is
# installed, so a failure from here on still records a status.
rm -f "$STATUS_FILE"

set_title "Brakeman since $(date '+%H:%M:%S')"
log ">>> Brakeman starting..."

skip() {
  {
    log ">>> Brakeman skipped: $1"
    printf 'Brakeman skipped: %s\n' "$1"
  } | tee "$RESULT_FILE"
  exit 0
}

fail() {
  {
    log ">>> Brakeman FAILED: $1"
    printf 'Brakeman failed: %s\n' "$1"
  } | tee -a "$RESULT_FILE"
  exit "${2:-1}"
}

BASE_COMMAND="$(cat "$COMMAND_FILE")"
if [[ -z "$BASE_COMMAND" ]]; then
  skip "no Brakeman command configured (not a Ruby project, or Brakeman is not installed)."
fi

# Proof that BRAKEMAN ITSELF is absent - not that something else went wrong.
#
# Every pattern must NAME brakeman on the SAME LINE as an "this executable does
# not exist" phrase. That pairing is the entire point. A bare "Could not find
# ..." naming some other gem means the BUNDLE is broken, and a broken toolchain
# has to FAIL this gate, not quietly switch it off.
#
# When a failure cannot be classified, it is a FAILURE. The asymmetry is not
# close: a false failure costs one confused round and is immediately visible,
# while a false skip hides every security warning in the change set and still
# reports green.
#
# Deliberately NOT treated as proof of absence:
#   * "Could not find <gem>-<version> in locally installed gems", even when the
#     gem named IS brakeman. Detection already ran brakeman successfully at
#     launch, so that message means the environment regressed afterwards - and a
#     project that declares brakeman must not have its security gate disabled by
#     a stale bundle.
#   * Any docker daemon or container error.
#   * Any unrecognised output.
brakeman_absent() {
  printf '%s' "$1" | grep -qiE \
    -e 'command not found:[[:space:]]*brakeman' \
    -e 'brakeman:[[:space:]]*command not found' \
    -e 'cannot load such file --[[:space:]]*brakeman' \
    -e 'brakeman.*no such file or directory' \
    -e 'no such file or directory.*brakeman'
}

# Probe before scanning, so "brakeman is not installed here" is distinguishable
# from "the scan failed". ONLY the signatures above may become a skip: a docker
# daemon that is not running, a broken bundle, or any other failure is a real
# failure and must stop the round.
log ">>> Verifying Brakeman is runnable: $BASE_COMMAND --version"
set +e
VERSION_OUTPUT="$(bash -lc "$BASE_COMMAND --version" 2>&1)"
VERSION_STATUS=$?
set -e
if [[ "$VERSION_STATUS" -ne 0 ]]; then
  printf '%s\n' "$VERSION_OUTPUT" | while IFS= read -r line; do log "  $line"; done
  if brakeman_absent "$VERSION_OUTPUT"; then
    skip "Brakeman itself is not installed for this project (probe exit $VERSION_STATUS)."
  fi
  {
    printf 'Brakeman probe command: %s --version\n' "$BASE_COMMAND"
    printf 'Brakeman probe exit status: %s\n' "$VERSION_STATUS"
    printf '%s\n' "$VERSION_OUTPUT"
  } > "$RESULT_FILE"
  fail "the Brakeman probe failed for a reason that does NOT prove Brakeman is absent - a broken bundle, a docker or runtime failure, or an unrecognised error (see $RESULT_FILE). This is NOT treated as a skip." "$VERSION_STATUS"
fi
log ">>> Brakeman version: $(printf '%s' "$VERSION_OUTPUT" | head -n 1)"

rm -f "$REPORT_BASENAME" "$JSON_REPORT"

# -q            no informational banner
# --no-pager    never page; this is non-interactive
# --exit-on-warn  a warning is a non-zero exit, which is the whole point
# -o <file>     JSON report (format is taken from the .json extension)
# .             the WHOLE application, not a file list
log ">>> Brakeman scanning the whole application..."
set +e
bash -lc "$BASE_COMMAND -q --no-pager --exit-on-warn -o \"\$1\" ." bash "$REPORT_BASENAME" \
  > "$CONSOLE_LOG" 2>&1
SCAN_STATUS=$?
set -e
while IFS= read -r line; do log "$line"; done < "$CONSOLE_LOG"

if [[ -f "$REPORT_BASENAME" ]]; then
  mv "$REPORT_BASENAME" "$JSON_REPORT"
fi

{
  printf 'Brakeman command: %s\n' "$BASE_COMMAND"
  printf 'Brakeman exit status: %s\n' "$SCAN_STATUS"
  printf '\nBrakeman console output:\n'
  cat "$CONSOLE_LOG"
} > "$RESULT_FILE"

# Summarise the report BEFORE deciding pass or fail. The failing path is exactly
# where the warning list matters - it is what the Manager quotes to the Coder -
# so it must not be skipped by an early exit.
WARNING_COUNT=""
ERROR_COUNT=""
REPORT_USABLE=false
if [[ -s "$JSON_REPORT" ]] && command -v jq >/dev/null 2>&1; then
  if jq -e 'type == "object" and (.warnings | type == "array")' "$JSON_REPORT" >/dev/null 2>&1; then
    REPORT_USABLE=true
    WARNING_COUNT="$(jq -r '.warnings | length' "$JSON_REPORT")"
    ERROR_COUNT="$(jq -r '(.errors // []) | length' "$JSON_REPORT")"
    {
      printf '\nBrakeman summary: %s warnings, %s scan errors.\n' "$WARNING_COUNT" "$ERROR_COUNT"
      if [[ "$WARNING_COUNT" -gt 0 ]]; then
        jq -r '.warnings[] | "- [\(.confidence // "?")] \(.warning_type // "?"): \(.message // "") (\(.file // "?"):\(.line // "?"))"' \
          "$JSON_REPORT"
      fi
    } >> "$RESULT_FILE"
    log ">>> Brakeman summary: $WARNING_COUNT warnings, $ERROR_COUNT scan errors."
  fi
fi

# Exit 4 means "no Rails application detected". Trusting the NUMBER alone would
# turn any future meaning of 4 into a silent skip, so the output has to say so
# too. Every other non-zero status is a failure.
if [[ "$SCAN_STATUS" -eq 4 ]]; then
  if grep -qiE 'please supply the path to a rails application|no rails application|not a rails application' \
    "$CONSOLE_LOG"; then
    skip "no Rails application was detected in this repository (Brakeman exit 4)."
  fi
  fail "Brakeman exited 4 but did not report a missing Rails application, so this is not a skip." "$SCAN_STATUS"
fi

if [[ "$SCAN_STATUS" -ne 0 ]]; then
  fail "Brakeman exited $SCAN_STATUS. With --exit-on-warn this means warnings were found, or the scan itself errored. Read $RESULT_FILE and $JSON_REPORT." "$SCAN_STATUS"
fi

# A zero exit is not sufficient on its own: if the JSON report is missing or
# unreadable there is nothing proving the scan actually happened, and reporting
# a pass from an absent report is the failure mode this gate cannot have.
if [[ ! -s "$JSON_REPORT" ]]; then
  fail "Brakeman exited 0 but wrote no JSON report to $JSON_REPORT, so the scan cannot be confirmed." 1
fi

if command -v jq >/dev/null 2>&1; then
  if [[ "$REPORT_USABLE" != "true" ]]; then
    fail "the Brakeman JSON report at $JSON_REPORT is malformed or has no warnings array." 1
  fi
  # Belt and braces: --exit-on-warn should already have produced a non-zero
  # status, so reaching here with warnings means the flag did not do what it
  # claims. Fail rather than trust the exit code alone.
  if [[ "$WARNING_COUNT" -gt 0 ]]; then
    fail "Brakeman exited 0 but the report contains $WARNING_COUNT warnings." 1
  fi
  if [[ "$ERROR_COUNT" -gt 0 ]]; then
    fail "Brakeman reported $ERROR_COUNT scan errors, so the scan is not trustworthy." 1
  fi
else
  printf '\n(jq is unavailable, so no summary was extracted from %s)\n' "$JSON_REPORT" >> "$RESULT_FILE"
fi

log ">>> Brakeman passed with 0 warnings (whole-application scan)."
HELPER
  chmod +x "$SQUAD_DIR/run-brakeman"
}

# --- Manager system prompt ----------------------------------------------------
# Contains NO tmux pane ID: every agent is addressed by role, so the prompt stays
# valid across any number of resumes. Regenerated on resume for the same reason.
generate_manager_prompt() {
  local plan_event="squad-$RUN_ID-plan"
  local coder_event="squad-$RUN_ID-coder"
  local rubocop_event="squad-$RUN_ID-rubocop"
  local brakeman_event="squad-$RUN_ID-brakeman"
  # One event per review lens. The two lenses run one after the other in the
  # same pane, and reusing a single event name for both would let the second
  # run-wait return on the first lens's signal.
  local review_correctness_event="squad-$RUN_ID-review-correctness"
  local review_security_event="squad-$RUN_ID-review-security"

  set_worktree_mode

  cat > "$SQUAD_DIR/manager-prompt.md" << PROMPT
# You are a Development Manager

You coordinate a Coder and an Advisor in separate tmux panes.
You do NOT write code yourself.
Speak Japanese to PO (user). Write English for agents.

## Environment

- Original worktree: $REPO_ROOT
- Squad worktree: $WORKDIR
- Worktree mode: $WORKTREE_MODE
- Squad branch: $BRANCH
- Squad title: $SQUAD_TITLE
- Detected ticket ID: ${TICKET_ID:-not detected}
- Artifacts: $SQUAD_DIR
- Manager session ID: $MANAGER_SESSION_ID
- Coder session ID: $CODER_SESSION_ID
- Wait timeout: $WAIT_TIMEOUT_SECONDS seconds

$WORKTREE_NOTE
Agents must not create additional worktrees. In particular, do not create
worktrees under the repository such as .claude/worktree or .claude/worktrees.

## Agent addressing (roles, never pane IDs)

tmux assigns new pane IDs to every pane whenever this squad is resumed, so a
pane ID is NEVER a stable address. Address agents by role only. The roles are
exactly: manager, coder, advisor.

  '$SQUAD_DIR/squad-pane' <role>              # prints the live pane ID for a role
  '$SQUAD_DIR/send-to' <role> '<command>'     # runs one command in that role's pane

Both resolve the pane from the tmux options tagged on it, require exactly one
match for this run, and exit non-zero (sending nothing) otherwise. run-wait
likewise takes a role, not a pane ID.

- NEVER run 'tmux send-keys' yourself, and never write a literal tmux pane ID
  (a %-prefixed number such as the ones tmux prints) in any command.
- If a helper reports that a role cannot be resolved, report that to PO and stop.
  Do not guess a pane ID.

## Critical rules

- BEFORE asking Advisor to plan, inspect the ticket URL or task context and
  replace the provisional squad title with a specific title.
- A squad title MUST include the ticket ID when one exists, the business object
  or feature area, and the concrete change. Avoid vague titles such as
  "CSV import", "API fix", or "bug fix". For example:
  "EAR-123 | 車両マスタCSVインポートの重複検証追加".
- NEVER run codex or claude commands directly. ALL work MUST go through the
  send-to helper so that it lands in the agent panes.
- NEVER skip the Advisor planning step.
- ALWAYS follow the full workflow in order.
- The PO must be able to see agent work in the tmux panes.
- Use the run-wait helper to wait for completion. NEVER poll with capture-pane.
- NEVER run tmux kill-server, with or without -L or TMUX_TMPDIR. Do not ask
  Coder or Advisor to run it either. If a temporary tmux server is created for
  testing, leave it running and report the cleanup command to PO instead of
  executing it.
- NEVER run tmux kill-session, kill-window, or kill-pane unless PO explicitly
  requests that exact tmux operation. This includes test cleanup commands.
- At the VERY START of every turn, before anything else, run:
  '$SQUAD_DIR/await-po' clear
  It is free when nothing is marked. This is what takes the waiting badge down
  once PO has answered, including when they answered directly in the tmux pane,
  so it must run whether or not you think you were waiting.
- BEFORE asking PO a question, or pausing for PO approval of anything, run:
  '$SQUAD_DIR/await-po' mark '<short reason>'
  Run it BEFORE you write the question, not after: once you have asked, you stop
  and PO may not look at this window for hours. PO is often not watching this
  window - sometimes not even this machine - and the marker is the only thing
  that tells them you are blocked.
- After each Coder run, ALWAYS run the RuboCop helper and require exit status 0.
  The helper runs RuboCop autocorrect and verification only on changed
  Rails/Ruby files, never the full repo.
- After RuboCop and BEFORE the review lenses, ALWAYS run the Brakeman helper and
  require exit status 0. It scans the WHOLE application, not the changed files,
  because Brakeman is a dataflow scanner and a warning often surfaces in code
  this change never touched. It skips with status 0 when the project has no
  Brakeman, so a non-zero status always means a real finding or a real failure.
- Brakeman is a GATE, not a third review lens. Never pass its files to
  merge-reviews and never treat it as a review verdict.
- The Coder MUST run relevant automated tests for the task. If tests cannot run,
  report the exact blocker to PO and do not claim completion.
- RuboCop success is required independently of the Coder's report.
- The review is TWO INDEPENDENT LENSES: correctness first, then security. They
  must stay independent. NEVER include, quote, summarize, or point at the
  correctness result in the security task text, and never the other way round.
  A lens that is told what the other already found stops looking for what the
  other missed, which is the entire reason there are two of them.
- ALWAYS run BOTH lenses in every review round, even when the first one returns
  must_fix. The only exception is a helper failure so severe that the diff
  cannot be reviewed at all; report that to PO instead of guessing.
- After BOTH lenses have finished, ALWAYS run the merge-reviews helper. It
  writes the aggregate $SQUAD_DIR/review-status.txt and
  $SQUAD_DIR/review-result.txt that the squad GUI reads. Your own decisions
  still come from the two lens files.
- NEVER commit, push, force-push, merge, rebase, or create a pull request unless
  PO explicitly asks for that Git operation. Editing files is allowed.
- NEVER create additional git worktrees, including Claude Code default locations
  such as .claude/worktree or .claude/worktrees. Use only the isolated squad
  worktree: $WORKDIR.

## Status handling

Each helper writes an exit code to its status file before signaling completion.
After every run-wait command, read the status file. If it is not 0, read
the corresponding result file if present, report the failure to PO, and decide
whether the Coder can fix it. Never wait indefinitely after a helper failure.
run-wait writes status 125 when the role no longer resolves to a live pane, and
applies a $WAIT_TIMEOUT_SECONDS second timeout as a final fallback.

## Result files

- $SQUAD_DIR/advisor-result.txt   - the implementation plan
- $SQUAD_DIR/coder-result.txt     - the Coder's structured verification report
- $SQUAD_DIR/rubocop-result.txt   - RuboCop autocorrect and verification output
- $SQUAD_DIR/brakeman-result.txt  - Brakeman gate output, with a warning summary
- $SQUAD_DIR/brakeman-result.json - the raw Brakeman JSON report. Both lenses may
  cite it as evidence; the SECURITY lens must read it. It is a GATE result, not
  a review verdict, and it is never an input to merge-reviews.
- $SQUAD_DIR/review-correctness-result.txt - correctness lens findings
- $SQUAD_DIR/review-security-result.txt    - security lens findings
- $SQUAD_DIR/review-result.txt    - the AGGREGATE of the two lenses, written by
  merge-reviews. It exists for the squad GUI, which reads this file and
  $SQUAD_DIR/review-status.txt and cannot be changed from here. Never write it
  by hand, and never base a decision on it alone.

EITHER lens may return must_fix, and they see different things: a pass from the
correctness lens says nothing about the security lens. When you ask Coder to
fix, take the UNION of must_fix from BOTH lens result files. Include the
should_fix and test_gaps items from both as well when they are cheap to address,
and say which lens raised each finding.

## Commands

### Update the squad title after reading the ticket

Read the ticket URL or task context first, then write TWO files and run one
command. They are one step - never write one without the other.

1. $SQUAD_DIR/new-title.txt - the long title, shown on the Manager PANE.
   A concise, specific Japanese title. Include the detected ticket ID
   (${TICKET_ID:-none}) when available. Distinguish this squad from parallel
   work on similar features by naming the business object and concrete change.

2. $SQUAD_DIR/new-short-name.txt - the short name, shown as the tmux WINDOW
   name. About two words, at most 20 display columns (roughly ten Japanese
   characters); anything longer is truncated. It must say WHAT THIS RUN IS
   DOING - not the tool, not a timestamp, not the ticket ID on its own.
   Good: 車両CSV重複検証 / 権限まわり修正 / レポートHTML化
   Bad:  squad / 作業中 / EAR-123 / 車両マスタCSVインポートの重複検証を追加する
   It sits in a window list beside other windows, so brevity is the point.

Then run:

  cat > '$SQUAD_DIR/new-title.txt' <<'EOF'
  (specific title, for example: EAR-123 | 車両マスタCSVインポートの重複検証追加)
  EOF
  cat > '$SQUAD_DIR/new-short-name.txt' <<'EOF'
  (two words, for example: CSV重複検証)
  EOF
  '$SQUAD_DIR/update-title' '$SQUAD_DIR/title.txt' '$SQUAD_DIR/new-title.txt' '$WINDOW_SHORT_NAME'

Re-run this whole step whenever the work materially changes - when the plan
lands, or when the squad moves on to something the current name no longer
describes. Keep both files in step with each other; the window name going stale
is how PO loses track of which window is which.

### Tell PO you are waiting for them

PO is not necessarily watching this window. Mark the run as waiting whenever you
are about to hand control back to them for an answer or a decision:

  '$SQUAD_DIR/await-po' mark 'plan approval'
  '$SQUAD_DIR/await-po' clear
  '$SQUAD_DIR/await-po' status

mark adds a marker to the tmux WINDOW name, so PO can see it in the window list
with this squad's window in the background, and it stays visible even if the
squad is later resumed. The reason is one short line - "plan approval",
"which API to use", "needs a production credential".

Both commands are idempotent and safe to repeat. clear at the start of a turn is
mandatory (see Critical rules); it is what lowers the marker after PO replies.
Marking never changes the squad title, and updating the title while marked keeps
the marker.

### Ask Advisor for an implementation plan

Write an English request to $SQUAD_DIR/advisor-task.txt. Ask Advisor to inspect
the repository, produce a scoped implementation plan, define acceptance
criteria, identify relevant tests, and call out risks. Then run:

  '$SQUAD_DIR/send-to' --status-file '$SQUAD_DIR/advisor-status.txt' advisor '$SQUAD_DIR/run-advisor $SQUAD_DIR/advisor-task.txt $SQUAD_DIR/advisor-result.txt $SQUAD_DIR/advisor-status.txt $plan_event $SQUAD_DIR/plan-schema.json $SQUAD_DIR/title.txt'
  '$SQUAD_DIR/run-wait' '$plan_event' '$SQUAD_DIR/advisor-status.txt' advisor '$WAIT_TIMEOUT_SECONDS' 'Advisor planning'
  cat '$SQUAD_DIR/advisor-status.txt'
  cat '$SQUAD_DIR/advisor-result.txt'

### Ask Coder to implement

Write an English request to $SQUAD_DIR/coder-task.txt. Include the approved plan
and acceptance criteria. Require Coder to inspect project rules, implement the
change, run relevant automated tests, run RuboCop and Brakeman, and return the
structured verification report. Its rubocop_status and brakeman_status fields
are self-reports: the authoritative results are the helper runs you do yourself
in the steps below. For broad or uncertain changes, require Coder to use
built-in Explore subagents to investigate independent areas in parallel before
editing. Keep all file writes in the main Coder session, and skip subagents for
narrow changes. Explicitly prohibit commit, push, force-push, merge, rebase, and
pull-request creation unless PO requested that specific Git operation. Explicitly
prohibit creating any additional git worktree, including .claude/worktree or
.claude/worktrees. Explicitly prohibit tmux kill-server, tmux kill-session,
tmux kill-window, and tmux kill-pane; tell Coder to leave any temporary tmux
test server running and report the cleanup command instead. Then run:

  '$SQUAD_DIR/send-to' --status-file '$SQUAD_DIR/coder-status.txt' coder '$SQUAD_DIR/run-coder $SQUAD_DIR/coder-task.txt $SQUAD_DIR/coder-result.txt $SQUAD_DIR/coder-status.txt $coder_event $CODER_SESSION_ID $SQUAD_DIR/coder-schema.json initial $SQUAD_DIR/title.txt'
  '$SQUAD_DIR/run-wait' '$coder_event' '$SQUAD_DIR/coder-status.txt' coder '$WAIT_TIMEOUT_SECONDS' 'Coder'
  cat '$SQUAD_DIR/coder-status.txt'
  cat '$SQUAD_DIR/coder-result.txt'

### Run mandatory RuboCop verification

Always run this after Coder implementation and after each fix:

  '$SQUAD_DIR/send-to' --status-file '$SQUAD_DIR/rubocop-status.txt' coder '$SQUAD_DIR/run-rubocop $SQUAD_DIR/rubocop-command.txt $SQUAD_DIR/rubocop-result.txt $SQUAD_DIR/rubocop-status.txt $rubocop_event $SQUAD_DIR/title.txt'
  '$SQUAD_DIR/run-wait' '$rubocop_event' '$SQUAD_DIR/rubocop-status.txt' coder '$WAIT_TIMEOUT_SECONDS' 'RuboCop'
  cat '$SQUAD_DIR/rubocop-status.txt'
  cat '$SQUAD_DIR/rubocop-result.txt'

RuboCop status must be 0. The helper first runs rubocop -a --cache true on the
changed Rails/Ruby files, then runs verification on the same files. If there are
no changed Rails/Ruby files, or the project is not a Ruby project (no RuboCop
command configured), the helper records that and returns 0. The configured
command uses --fail-level W, so warnings also fail verification.

### Run mandatory Brakeman verification

Always run this after RuboCop and BEFORE the review lenses, and again after each
fix:

  '$SQUAD_DIR/send-to' --status-file '$SQUAD_DIR/brakeman-status.txt' coder '$SQUAD_DIR/run-brakeman $SQUAD_DIR/brakeman-command.txt $SQUAD_DIR/brakeman-result.txt $SQUAD_DIR/brakeman-status.txt $brakeman_event $SQUAD_DIR/title.txt'
  '$SQUAD_DIR/run-wait' '$brakeman_event' '$SQUAD_DIR/brakeman-status.txt' coder '$WAIT_TIMEOUT_SECONDS' 'Brakeman'
  cat '$SQUAD_DIR/brakeman-status.txt'
  cat '$SQUAD_DIR/brakeman-result.txt'

Brakeman status must be 0. The scan covers the WHOLE application and requires
ZERO warnings; a project's curated config/brakeman.ignore is what carries any
accepted pre-existing warnings. The helper returns 0 when the project is not a
Ruby project, has no Brakeman installed, or contains no Rails application, so a
non-zero status is always a real finding or a real failure - never a missing
tool. Never work around a failure by narrowing the scan; either fix the warning
or ask PO about the ignore file.

### The review checklist (used by BOTH review lenses)

Before writing either review task, read the merged checklist:

  cat '$SQUAD_DIR/checklist.merged.md'

It is a list of LENSES to look through, not boxes to tick. Paste its contents
into each review task file under a "Review checklist" heading, and tell Advisor
to report only what it finds wrong - no coverage table, no "this lens was fine".
review-schema.json findings are flat strings, so tell Advisor to put the
checklist ID at the FRONT of the finding text, for example:

  [SEC-001] Missing tenant boundary check in app/controllers/reports_controller.rb

If the file says "(no checklist items)", this project has no checklist. Say so
in the task text and let the review run unstructured; that is not an error and
never a reason to skip a lens.

### Ask Advisor for a CORRECTNESS review

The first of two independent lenses. Write an English request to
$SQUAD_DIR/review-correctness-task.txt. Tell Advisor to inspect all uncommitted
changes against the approved acceptance criteria, the Coder's test report, and
the mandatory RuboCop and Brakeman results, and to cover correctness, data
integrity, tests, compatibility, performance, and the project's own conventions.
Report findings only. A pass verdict is allowed only when relevant tests ran and
both the RuboCop and Brakeman statuses are 0. The lens may cite the Brakeman
result as evidence. Then run:

  '$SQUAD_DIR/send-to' --status-file '$SQUAD_DIR/review-correctness-status.txt' advisor '$SQUAD_DIR/run-review $SQUAD_DIR/review-correctness-task.txt $SQUAD_DIR/review-correctness-result.txt $SQUAD_DIR/review-correctness-status.txt $review_correctness_event $SQUAD_DIR/review-schema.json $SQUAD_DIR/title.txt correctness'
  '$SQUAD_DIR/run-wait' '$review_correctness_event' '$SQUAD_DIR/review-correctness-status.txt' advisor '$WAIT_TIMEOUT_SECONDS' 'Advisor correctness review'
  cat '$SQUAD_DIR/review-correctness-status.txt'
  cat '$SQUAD_DIR/review-correctness-result.txt'

### Ask Advisor for a SECURITY review

The second lens, and it runs even when the correctness lens returned must_fix.
Write an English request to $SQUAD_DIR/review-security-task.txt. Tell Advisor to
inspect the same uncommitted diff INDEPENDENTLY for authorization, tenant and
user isolation, input validation, injection, information disclosure, secret
handling, and filesystem, shell and database risks. Report findings only.

Tell it to READ $SQUAD_DIR/brakeman-result.txt and, when present,
$SQUAD_DIR/brakeman-result.json as evidence - a passing Brakeman scan is a
starting point, not a conclusion, since Brakeman cannot see authorization or
tenant-isolation logic. Citing the Brakeman gate is allowed and expected.

This task text must NOT mention, quote, summarize or point at the CORRECTNESS
result in any way. Write it as if the correctness lens had never run. The
Brakeman gate is shared evidence and is not a lens, so referencing it does not
break the independence of the two lenses. Then run:

  '$SQUAD_DIR/send-to' --status-file '$SQUAD_DIR/review-security-status.txt' advisor '$SQUAD_DIR/run-review $SQUAD_DIR/review-security-task.txt $SQUAD_DIR/review-security-result.txt $SQUAD_DIR/review-security-status.txt $review_security_event $SQUAD_DIR/review-schema.json $SQUAD_DIR/title.txt security'
  '$SQUAD_DIR/run-wait' '$review_security_event' '$SQUAD_DIR/review-security-status.txt' advisor '$WAIT_TIMEOUT_SECONDS' 'Advisor security review'
  cat '$SQUAD_DIR/review-security-status.txt'
  cat '$SQUAD_DIR/review-security-result.txt'

### Merge the two reviews (mandatory)

Run this after BOTH lenses have finished, before you decide anything:

  '$SQUAD_DIR/merge-reviews' '$SQUAD_DIR/review-correctness-result.txt' '$SQUAD_DIR/review-correctness-status.txt' '$SQUAD_DIR/review-security-result.txt' '$SQUAD_DIR/review-security-status.txt' '$SQUAD_DIR/review-result.txt' '$SQUAD_DIR/review-status.txt'
  cat '$SQUAD_DIR/review-status.txt'
  cat '$SQUAD_DIR/review-result.txt'

Run it in YOUR OWN pane, not through send-to: it is a deterministic local merge,
not agent work, so it needs no run-wait and no tmux event. It writes the
aggregate the squad GUI reads: status 0 only when both lens statuses are 0,
verdict must_fix when either lens says must_fix, findings unioned and tagged
with the lens that raised them.

If merge-reviews fails it says so loudly and writes a must_fix aggregate. That
means a lens result is missing or malformed: re-run that lens, and report it to
PO if it keeps failing. Never hand-write the aggregate files to work around it.

### Ask Coder to fix review findings

Write an English request to $SQUAD_DIR/coder-task.txt. Include the UNION of the
must_fix findings from BOTH lens result files, saying which lens raised each
one, plus any RuboCop or Brakeman failure, and require updated tests, RuboCop
and Brakeman. When Brakeman failed, quote the offending warnings from
$SQUAD_DIR/brakeman-result.txt and require a real fix - never a narrowed scan. Reiterate that Coder must not
create additional git worktrees and must keep all work in $WORKDIR. Reiterate
that Coder must not run tmux kill-server, tmux kill-session, tmux kill-window,
or tmux kill-pane, including for test cleanup. Continue the exact Coder session:

  '$SQUAD_DIR/send-to' --status-file '$SQUAD_DIR/coder-status.txt' coder '$SQUAD_DIR/run-coder $SQUAD_DIR/coder-task.txt $SQUAD_DIR/coder-result.txt $SQUAD_DIR/coder-status.txt $coder_event $CODER_SESSION_ID $SQUAD_DIR/coder-schema.json resume $SQUAD_DIR/title.txt'
  '$SQUAD_DIR/run-wait' '$coder_event' '$SQUAD_DIR/coder-status.txt' coder '$WAIT_TIMEOUT_SECONDS' 'Coder fix'
  cat '$SQUAD_DIR/coder-status.txt'
  cat '$SQUAD_DIR/coder-result.txt'

## Workflow

0. Run '$SQUAD_DIR/await-po' clear at the start of every turn, including this one.
1. Inspect the linked ticket or task context and update the provisional title.
2. Ask Advisor for a structured implementation plan.
3. Run '$SQUAD_DIR/await-po' mark 'plan approval', then show the plan to PO in
   Japanese and ask for approval. Waiting for plan approval is the most common
   place this squad sits idle without PO knowing, so the mark is not optional.
4. Ask Coder to implement the approved plan.
5. Read Coder status and structured verification report.
6. Run the mandatory RuboCop helper and require status 0.
7. Run the mandatory Brakeman helper and require status 0.
8. Ask Advisor for the CORRECTNESS review of the uncommitted changes and the
   verification evidence.
9. Ask Advisor for the SECURITY review of the same diff, independently. This
   runs even when the correctness lens returned must_fix.
10. Run merge-reviews to write the aggregate files for the GUI.
11. If either lens status is non-zero, either lens verdict is must_fix, or
   RuboCop or Brakeman failed, ask Coder to fix the issues. Pass the union of
   the findings from both lenses.
12. After every fix, repeat from step 5.
13. Report completion to PO in Japanese. Include the squad worktree path, branch,
   test commands and results, and the mandatory RuboCop and Brakeman results.
PROMPT
}

# The resumed Manager keeps its previous Claude session, so its transcript still
# contains the pane IDs it used before the resume. Those IDs are dead: say so
# explicitly, or the model will keep reusing them from its own history.
generate_resume_prompt() {
  cat "$SQUAD_DIR/manager-prompt.md" > "$SQUAD_DIR/manager-resume-prompt.md"
  cat >> "$SQUAD_DIR/manager-resume-prompt.md" << PROMPT

## MIGRATION: this squad was resumed (read this before any command)

This squad has been resumed in a NEW tmux window, so every tmux pane ID changed.
Any literal tmux pane ID (a %-prefixed number) that appears in earlier turns of
this conversation is now STALE, and tmux may already have reassigned it to an
unrelated pane.

- Those earlier commands are OBSOLETE. NEVER copy or reuse a command containing
  a literal pane ID, and never run 'tmux send-keys' yourself.
- NEVER pass a pane ID to run-wait. It takes a role: manager, coder, or advisor.
- ALWAYS address agents by role through the helpers, exactly as shown in the
  Commands section above:

    '$SQUAD_DIR/send-to' --status-file '<status file>' coder '<command>'
    '$SQUAD_DIR/run-wait' '<event>' '<status file>' coder '$WAIT_TIMEOUT_SECONDS' '<label>'

- When you START an agent step, always pass --status-file, naming the SAME
  status file the following run-wait reads. It clears that file in your pane
  before the keystrokes are queued, which is what stops run-wait from handing
  you the PREVIOUS round's result. Never pass it to run-wait. Use the
  no-option form only for a one-off command that writes no status file.

- The helpers resolve the live pane for this run themselves. If one reports that
  a role cannot be resolved, report that to PO and stop; do not guess.
- The Coder and Advisor panes of this resumed window are fresh shells: no agent
  is mid-task, and the Coder resumes its own session only when you send
  run-coder with the resume mode.
- A resume does NOT answer any question you had asked PO, so an awaiting-PO
  marker deliberately survived into this window. Your first action is still
  '$SQUAD_DIR/await-po' clear - run it, then look at whether PO has actually
  replied, and mark again if you are still waiting.
PROMPT
}

resume_run() {
  local new_window
  local target_session="${2:-}"

  # Without an explicit target session, resume must run inside tmux (existing
  # behavior). With --session, we create the window in that session directly and
  # do not require $TMUX (e.g. when launched from an external tool).
  if [[ -z "$target_session" && -z "${TMUX:-}" ]]; then
    echo "Error: squad resume must be run inside tmux (or pass --session <name>)" >&2
    exit 1
  fi

  # Resume splits panes too, so the same check has to happen before the new
  # window is created rather than when the checklist is regenerated below.
  require_readable_checklist_config

  # An EXPLICIT run-id must match exactly. Without this, load_run's fallback
  # silently resolves a typo'd id to the most recent retained run - and resume
  # does not just display that run, it attaches LIVE AGENTS to it. A Coder would
  # start editing another squad's worktree and branch, which is far worse than
  # the wrong thing merely being shown. `close`, `rm` and `base` all already
  # refuse a bad id; resume was the only one that did not.
  #
  # Only the NO-ARG form may resolve on its own: the current window's run first,
  # then the latest.
  if [[ -n "${1:-}" ]]; then
    load_run "$1" false
  else
    load_run "" true
  fi
  [[ -d "$WORKDIR" ]] || {
    echo "Error: squad worktree no longer exists: $WORKDIR" >&2
    exit 1
  }

  if window_exists "${WINDOW_ID:-}"; then
    echo "Error: squad is already running in window $WINDOW_ID" >&2
    exit 1
  fi

  # Diagnostics only: kept so state.env still records the original layout.
  ORIG_MANAGER_PANE="${ORIG_MANAGER_PANE:-${MANAGER_PANE:-}}"
  ORIG_CODER_PANE="${ORIG_CODER_PANE:-${CODER_PANE:-}}"
  ORIG_ADVISOR_PANE="${ORIG_ADVISOR_PANE:-${ADVISOR_PANE:-}}"

  if [[ -n "$target_session" ]]; then
    new_window="$(tmux new-window -d -t "${target_session}:" -c "$WORKDIR" -P -F '#{window_id} #{pane_id}')"
  else
    new_window="$(tmux new-window -d -c "$WORKDIR" -P -F '#{window_id} #{pane_id}')"
  fi
  read -r WINDOW_ID MANAGER_PANE <<< "$new_window"
  CODER_PANE="$(tmux split-window -h -c "$WORKDIR" -d -t "$MANAGER_PANE" -P -F '#{pane_id}')"
  ADVISOR_PANE="$(tmux split-window -v -c "$WORKDIR" -d -t "$CODER_PANE" -P -F '#{pane_id}')"
  CURRENT_WINDOW_NAME="$(tmux display-message -p -t "$WINDOW_ID" '#W')"
  # Restore the name the Manager last set, exactly as the pane title is restored
  # from title.txt below. state.env's copy is the next best thing (it is written
  # on every state change), and the placeholder is the last resort.
  if [[ -s "$SQUAD_DIR/short-name.txt" ]]; then
    WINDOW_SHORT_NAME="$(head -n 1 "$SQUAD_DIR/short-name.txt")"
  fi
  WINDOW_SHORT_NAME="${WINDOW_SHORT_NAME:-$(placeholder_window_name)}"
  RUN_STATUS="running"
  write_state
  tag_all_panes

  # Regenerate the helper scripts and prompts from this version of squad, so a
  # run created by an older version is migrated to role addressing the moment it
  # is resumed. The prompts contain no pane ID, so no rewrite is needed.
  SQUAD_TITLE="$(cat "$SQUAD_DIR/title.txt" 2>/dev/null || printf 'squad')"
  # Re-emitted from state.env before the helpers, so brakeman-command.txt exists
  # for a run created before the Brakeman gate did (where it resolves to the
  # empty command, i.e. skip) and so launch and resume stay idempotent.
  printf '%s\n' "${BRAKEMAN_COMMAND:-}" > "$SQUAD_DIR/brakeman-command.txt"
  # Re-resolved before the prompt, so a resumed run reviews against the project
  # checklist as it stands NOW, not as it stood when the squad was created.
  generate_review_checklist
  generate_helper_scripts
  generate_manager_prompt
  generate_resume_prompt

  # PRESERVES an existing awaiting-PO marker: a resume does not answer the
  # Manager's question, so the badge must come back with the window. The base is
  # the one just restored above, and window-name re-composes the marker onto it.
  WINDOW_DISPLAY_NAME="$(
    "$SQUAD_DIR/window-name" display "$WINDOW_SHORT_NAME" 2>/dev/null ||
      printf '%s' "$WINDOW_SHORT_NAME"
  )"
  tmux rename-window -t "$WINDOW_ID" "$WINDOW_DISPLAY_NAME"
  tmux select-pane -t "$MANAGER_PANE" -T "$SQUAD_TITLE"
  tmux select-pane -t "$CODER_PANE" -T "Coder"
  tmux select-pane -t "$ADVISOR_PANE" -T "Advisor"
  tmux set-option -w -t "$WINDOW_ID" pane-border-status top
  tmux set-option -w -t "$WINDOW_ID" pane-border-format " #{pane_title} "
  tmux set-option -w -t "$WINDOW_ID" @squad_run_id "$RUN_ID"
  tmux set-option -w -t "$WINDOW_ID" @squad_state_file "$STATE_FILE"
  tmux send-keys -t "$MANAGER_PANE" "$SQUAD_DIR/run-manager-resume '$WORKDIR' '$SQUAD_DIR/manager-resume-prompt.md' '$MANAGER_SESSION_ID'" Enter
  tmux select-window -t "$WINDOW_ID"
  printf 'Squad resumed: %s\n' "$RUN_ID"
}

[[ $# -gt 0 ]] || usage
case "$1" in
  -h|--help)
    usage 0
    ;;
  list)
    list_runs
    exit 0
    ;;
  close)
    close_run "${2:-}"
    exit 0
    ;;
  rm)
    shift
    [[ $# -gt 0 ]] || {
      echo "Error: squad rm requires at least one run-id (see: squad list)" >&2
      exit 1
    }
    rm_status=0
    for run_id in "$@"; do
      rm_state_file="$SQUAD_RUN_ROOT/$run_id/state.env"
      if [[ ! -f "$rm_state_file" ]]; then
        echo "Error: unknown squad run: $run_id" >&2
        rm_status=1
        continue
      fi
      remove_run "$rm_state_file" || rm_status=1
    done
    exit "$rm_status"
    ;;
  clean)
    clean_runs
    exit 0
    ;;
  base)
    shift
    base_target_run=""
    # `--run` names another squad. A POSITIONAL run-id is deliberately not
    # accepted: `squad base <x>` would be ambiguous between "inspect run x" and
    # "set the base to ref x".
    if [[ "${1:-}" == "--run" ]]; then
      if [[ $# -lt 2 || -z "${2:-}" ]]; then
        echo "Error: --run requires a run-id (see: squad list)" >&2
        exit 1
      fi
      base_target_run="$2"
      shift 2
    fi
    if [[ $# -gt 1 ]]; then
      echo "Error: squad base takes at most one ref (see: squad --help)" >&2
      exit 1
    fi
    if [[ $# -eq 1 ]]; then
      base_run "$base_target_run" "$1" true
    else
      base_run "$base_target_run" "" false
    fi
    exit 0
    ;;
  resume)
    shift
    resume_session=""
    if [[ "${1:-}" == "--session" ]]; then
      if [[ $# -lt 2 || -z "${2:-}" ]]; then
        echo "Error: --session requires a value" >&2
        exit 1
      fi
      resume_session="$2"
      shift 2
    fi
    resume_run "${1:-}" "$resume_session"
    exit 0
    ;;
esac

