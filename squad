# --- Helper scripts (run in agent panes) --------------------------------------

cat > "$SQUAD_DIR/run-wait" <<'HELPER'
#!/usr/bin/env bash
set -euo pipefail
EVENT="$1"
STATUS_FILE="$2"
PANE="$3"
TIMEOUT_SECONDS="$4"
LABEL="$5"

log() {
  printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"
}

tmux wait-for "$EVENT" &
WAIT_PID=$!

elapsed=0
while kill -0 "$WAIT_PID" 2>/dev/null; do
  if ! tmux display-message -p -t "$PANE" '#{pane_id}' >/dev/null 2>&1; then
    printf '125\n' > "$STATUS_FILE"
    log "$LABEL pane disappeared before completion."
    tmux wait-for -S "$EVENT"
    break
  fi

  if (( elapsed >= TIMEOUT_SECONDS )); then
    printf '124\n' > "$STATUS_FILE"
    log "$LABEL timed out after $TIMEOUT_SECONDS seconds."
    tmux wait-for -S "$EVENT"
    break
  fi

  sleep 1
  ((elapsed += 1))
done

wait "$WAIT_PID"
HELPER
chmod +x "$SQUAD_DIR/run-wait"

cat > "$SQUAD_DIR/run-coder" <<'HELPER'
#!/usr/bin/env bash
set -euo pipefail
TASK_FILE="$1"
RESULT_FILE="$2"
STATUS_FILE="$3"
EVENT="$4"
SESSION_ID="$5"
SCHEMA_FILE="$6"
MODE="$7"
TITLE_FILE="$8"
STREAM_FILE="${RESULT_FILE%.json}.stream.jsonl"
STDERR_FILE="${RESULT_FILE%.json}.stderr.log"

log() {
  printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"
}

set_title() {
  tmux select-pane -T "Coder"
}

finish() {
  rc=$?
  trap - EXIT
  printf '%s\n' "$rc" > "$STATUS_FILE"
  if [[ "$rc" -eq 0 ]]; then
    set_title "done $(date '+%H:%M:%S')"
  else
    set_title "failed($rc) $(date '+%H:%M:%S')"
  fi
  tmux wait-for -S "$EVENT"
  exit "$rc"
}
trap finish EXIT

set_title "running since $(date '+%H:%M:%S')"
if [[ "$MODE" == "initial" ]]; then
  log ">>> Coder prompt sent (initial session)."
  claude -p \
    --dangerously-skip-permissions \
    --session-id "$SESSION_ID" \
    --output-format stream-json \
    --include-partial-messages \
    --verbose \
    --json-schema "$(cat "$SCHEMA_FILE")" \
    "$(cat "$TASK_FILE")" 2> "$STDERR_FILE" |
    tee "$STREAM_FILE" |
    jq --unbuffered -r '
      if .type == "assistant" then
        .message.content[]? |
        if .type == "tool_use" then "[tool] \(.name)"
        elif .type == "text" then .text
        else empty end
      elif .type == "result" then "[result] \(.subtype // "done")"
      else empty end
    ' |
    while IFS= read -r line; do log "$line"; done
else
  log ">>> Coder prompt sent (resuming fixed session $SESSION_ID)."
  claude -p \
    --dangerously-skip-permissions \
    --resume "$SESSION_ID" \
    --output-format stream-json \
    --include-partial-messages \
    --verbose \
    --json-schema "$(cat "$SCHEMA_FILE")" \
    "$(cat "$TASK_FILE")" 2> "$STDERR_FILE" |
    tee "$STREAM_FILE" |
    jq --unbuffered -r '
      if .type == "assistant" then
        .message.content[]? |
        if .type == "tool_use" then "[tool] \(.name)"
        elif .type == "text" then .text
        else empty end
      elif .type == "result" then "[result] \(.subtype // "done")"
      else empty end
    ' |
    while IFS= read -r line; do log "$line"; done
fi

if [[ -s "$STDERR_FILE" ]]; then
  while IFS= read -r line; do log "[stderr] $line" >&2; done < "$STDERR_FILE"
fi
jq -c 'select(.type == "result") | (.structured_output // .result)' "$STREAM_FILE" |
  tail -n 1 > "$RESULT_FILE"
log ">>> Coder finished."
HELPER
chmod +x "$SQUAD_DIR/run-coder"

cat > "$SQUAD_DIR/run-advisor" <<'HELPER'
#!/usr/bin/env bash
set -euo pipefail
TASK_FILE="$1"
RESULT_FILE="$2"
STATUS_FILE="$3"
EVENT="$4"
SCHEMA_FILE="$5"
TITLE_FILE="$6"
STREAM_FILE="${RESULT_FILE%.json}.stream.jsonl"

log() {
  printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"
}

set_title() {
  tmux select-pane -T "Advisor"
}

finish() {
  rc=$?
  trap - EXIT
  printf '%s\n' "$rc" > "$STATUS_FILE"
  if [[ "$rc" -eq 0 ]]; then
    set_title "done $(date '+%H:%M:%S')"
  else
    set_title "failed($rc) $(date '+%H:%M:%S')"
  fi
  tmux wait-for -S "$EVENT"
  exit "$rc"
}
trap finish EXIT

set_title "planning since $(date '+%H:%M:%S')"
log ">>> Advisor planning prompt sent."
codex -a never -s read-only exec \
  --json \
  --output-schema "$SCHEMA_FILE" \
  -o "$RESULT_FILE" \
  "$(cat "$TASK_FILE")" |
  tee "$STREAM_FILE" |
  jq --unbuffered -r '
    if .type == "item.started" then "[started] \(.item.type // "item")"
    elif .type == "item.completed" and .item.type == "command_execution" then
      "[command] \(.item.command // "")\n[exit] \(.item.exit_code // "unknown")"
    elif .type == "item.completed" and .item.type == "agent_message" then .item.text
    elif .type == "turn.completed" then "[turn] completed"
    else empty end
  ' |
  while IFS= read -r line; do log "$line"; done
cat "$RESULT_FILE" 2>/dev/null || true
log ">>> Advisor finished."
HELPER
chmod +x "$SQUAD_DIR/run-advisor"

cat > "$SQUAD_DIR/run-review" <<'HELPER'
