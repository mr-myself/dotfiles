#!/usr/bin/env bash
set -euo pipefail

# ==============================================================================
# squad - AI 3-agent team orchestration via tmux panes
# ==============================================================================

usage() {
  local status="${1:-1}"
  cat <<'EOF'
Usage: squad <task>
       squad list
       squad close [run-id]
       squad resume [run-id]
       squad rm <run-id>...
       squad clean
       squad base [--run <run-id>] [<ref>]

Create an isolated git worktree and split the current tmux pane into 3 AI agents:
  Manager (Claude Code) - left, talks to you
  Coder   (Claude Code) - right-top, implements code
  Advisor (Codex)       - right-bottom, plans and reviews

Example:
  squad "TRACK-123 CSVインポート機能を追加"

Lifecycle:
  squad list             List retained squads and their status.
  squad close            Close the squad for the current tmux window.
  squad close <run-id>   Close a squad from another tmux window.
  squad resume           Resume the most recent retained squad.
  squad resume <run-id>  Resume a specific retained squad.
  squad rm <run-id>...   Delete closed squads: worktree, branch, and artifacts.
  squad clean            Delete ALL squads that are not running (asks first).

Diff base (what Squad Cockpit compares this squad against):
  squad base             Show the recorded base of the current window's squad.
  squad base <ref>       Re-pin it to where this squad forked from <ref>.
  squad base --run <run-id> [<ref>]
                         Same, for a squad in another window.
EOF
  exit "$status"
}

# --- Herdr delegation ---------------------------------------------------------
# Inside a herdr pane there is no tmux server to split, so every subcommand is
# handed to squad-herdr instead. This is deliberately the FIRST thing that runs,
# so lifecycle subcommands delegate too: a herdr run is recorded in
# ~/.local/state/squad-herdr, and answering `list` or `close` from squad's own
# state root would silently look in the wrong store.
#
# tmux wins when both are set. A tmux session started inside a herdr pane
# exports HERDR_PANE_ID as well, and there the tmux path is the one that works.
#
# HERDR_PANE_ID is per-pane and names the pane this shell is in. Do NOT switch
# this to HERDR_ACTIVE_*: those describe whichever pane the herdr UI currently
# focuses, which is not necessarily the one running this command.
if [[ -z "${TMUX:-}" && -n "${HERDR_PANE_ID:-}" ]]; then
  squad_self="${BASH_SOURCE[0]}"
  # Resolve symlinks so an installed ~/.local/bin/squad finds the squad-herdr
  # that ships beside the real script, not one beside the symlink.
  while [[ -L "$squad_self" ]]; do
    squad_link="$(readlink "$squad_self")"
    case "$squad_link" in
      /*) squad_self="$squad_link" ;;
      *) squad_self="$(dirname "$squad_self")/$squad_link" ;;
    esac
  done
  squad_herdr="$(cd "$(dirname "$squad_self")" && pwd)/squad-herdr"
  if [[ ! -x "$squad_herdr" ]]; then
    squad_herdr="$(command -v squad-herdr 2>/dev/null || true)"
  fi
  if [[ -z "$squad_herdr" || ! -x "$squad_herdr" ]]; then
    echo "Error: running inside a herdr pane, but squad-herdr was not found" >&2
    echo "       next to squad or on PATH." >&2
    exit 1
  fi

  # Usage text only. Every lifecycle instruction squad-herdr emits stays
  # hard-coded as squad-herdr, because `squad close` and `squad-herdr close`
  # read different state roots and must never be confused for each other.
  #
  # A plain exec, NOT `exec -a squad`: argv[0] is what squad-herdr would fall
  # back to for its own name, and disguising it would make those hard-coded
  # lifecycle strings inconsistent with a $0 that claims to be squad.
  SQUAD_HERDR_DISPLAY_NAME="${0##*/}"
  export SQUAD_HERDR_DISPLAY_NAME
  exec "$squad_herdr" "$@"
fi

SQUAD_STATE_ROOT="${SQUAD_STATE_ROOT:-${XDG_STATE_HOME:-$HOME/.local/state}/squad}"
SQUAD_RUN_ROOT="$SQUAD_STATE_ROOT/runs"
SQUAD_WORKTREE_ROOT="${SQUAD_WORKTREE_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}/squad/worktrees}"
mkdir -p "$SQUAD_RUN_ROOT" "$SQUAD_WORKTREE_ROOT"

# The PO runs squad through a ~/.local/bin symlink, so the bundled
# _vet/checklist.md has to be found relative to the resolved real path, not $0.
# Same helper vet uses, for the same reason.
script_real_path() {
  local src="${BASH_SOURCE[0]}" dir
  while [[ -L "$src" ]]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" == /* ]] || src="$dir/$src"
  done
  printf '%s/%s\n' "$(cd -P "$(dirname "$src")" && pwd)" "$(basename "$src")"
}
SQUAD_SCRIPT_PATH="$(script_real_path)"
SQUAD_SCRIPT_DIR="$(dirname "$SQUAD_SCRIPT_PATH")"

load_run() {
  local requested_id="${1:-}"
  local allow_latest="${2:-true}"
  local state_file=""

  if [[ -n "$requested_id" ]]; then
    state_file="$SQUAD_RUN_ROOT/$requested_id/state.env"
  elif [[ -n "${TMUX:-}" ]]; then
    state_file="$(tmux show-option -wqv @squad_state_file 2>/dev/null || true)"
  fi

  if [[ ( -z "$state_file" || ! -f "$state_file" ) && "$allow_latest" == "true" ]]; then
    state_file="$(
      find "$SQUAD_RUN_ROOT" -mindepth 2 -maxdepth 2 -name state.env -type f 2>/dev/null |
        sort |
        tail -n 1
    )"
  fi

  [[ -n "$state_file" && -f "$state_file" ]] || {
    echo "Error: no matching squad run found (see: squad list)" >&2
    exit 1
  }

  # state.env is generated by squad itself and contains shell-escaped values.
  source "$state_file"
  STATE_FILE="$state_file"
}

write_state() {
  mkdir -p "$SQUAD_DIR"
  {
    printf 'RUN_ID=%q\n' "$RUN_ID"
    printf 'STARTED_AT=%q\n' "$STARTED_AT"
    printf 'TASK=%q\n' "$TASK"
    printf 'TICKET_ID=%q\n' "$TICKET_ID"
    printf 'REPO_ROOT=%q\n' "$REPO_ROOT"
    printf 'WORKDIR=%q\n' "$WORKDIR"
    printf 'BRANCH=%q\n' "$BRANCH"
    # The EXACT fork point of this run's worktree, captured at creation time.
    # Squad Cockpit diffs against this commit directly instead of guessing a
    # base branch. Resume re-emits whatever load_run sourced, so the recorded
    # fork point survives; it is never recomputed from a later HEAD.
    printf 'SQUAD_BASE_COMMIT=%q\n' "${SQUAD_BASE_COMMIT:-}"
    printf 'SQUAD_BASE_REF=%q\n' "${SQUAD_BASE_REF:-}"
    printf 'SQUAD_DIR=%q\n' "$SQUAD_DIR"
    printf 'WINDOW_SHORT_NAME=%q\n' "${WINDOW_SHORT_NAME:-squad}"
    printf 'MANAGER_SESSION_ID=%q\n' "$MANAGER_SESSION_ID"
    printf 'CODER_SESSION_ID=%q\n' "$CODER_SESSION_ID"
    printf 'RUBOCOP_COMMAND=%q\n' "$RUBOCOP_COMMAND"
    # Defaulted, unlike RUBOCOP_COMMAND above: a run created before Brakeman
    # existed has no such key in state.env, and resume sources that file before
    # calling write_state. Without the default, set -u would abort the resume.
    printf 'BRAKEMAN_COMMAND=%q\n' "${BRAKEMAN_COMMAND:-}"
    printf 'WAIT_TIMEOUT_SECONDS=%q\n' "$WAIT_TIMEOUT_SECONDS"
    printf 'WINDOW_ID=%q\n' "${WINDOW_ID:-}"
    printf 'CURRENT_WINDOW_NAME=%q\n' "${CURRENT_WINDOW_NAME:-}"
    # NON-AUTHORITATIVE. tmux assigns new pane IDs on every resume, so these are
    # only a diagnostic record of the last known layout (and are read by older
    # Squad Cockpit builds). Never address a pane through them: resolve
    # (RUN_ID, role) with $SQUAD_DIR/squad-pane instead.
    printf 'MANAGER_PANE=%q\n' "${MANAGER_PANE:-}"
    printf 'CODER_PANE=%q\n' "${CODER_PANE:-}"
    printf 'ADVISOR_PANE=%q\n' "${ADVISOR_PANE:-}"
    # NON-AUTHORITATIVE. The pane IDs of the original launch, kept only for
    # diagnostics; no prompt is rewritten from them any more.
    printf 'ORIG_MANAGER_PANE=%q\n' "${ORIG_MANAGER_PANE:-${MANAGER_PANE:-}}"
    printf 'ORIG_CODER_PANE=%q\n' "${ORIG_CODER_PANE:-${CODER_PANE:-}}"
    printf 'ORIG_ADVISOR_PANE=%q\n' "${ORIG_ADVISOR_PANE:-${ADVISOR_PANE:-}}"
    printf 'RUN_STATUS=%q\n' "${RUN_STATUS:-running}"
  } > "$SQUAD_DIR/state.env"
  STATE_FILE="$SQUAD_DIR/state.env"
}

# The tmux WINDOW name to use before the Manager has decided what this run is
# about.
#
# DISPLAY ONLY. Runs are resolved by WINDOW_ID and by the @squad_run_id /
# @squad_role PANE options (see window_exists and squad-pane), never by this
# string, so the window name can change freely.
#
# The Manager replaces this with a two-word description of the actual work as
# soon as it has read the ticket - see update-title. Until then there is nothing
# true to say about the work, so this only has to IDENTIFY the run: the ticket ID
# when one was detected, otherwise the old squad:<timestamp>, which is unique and
# says which tool owns the window. Deliberately NOT a generic word like 作業中:
# several concurrent squads would all show the same thing, which is less useful
# than a timestamp, and this placeholder is also what PO is left looking at if
# the Manager dies before its first title update.
placeholder_window_name() {
  if [[ -n "${TICKET_ID:-}" ]]; then
    printf '%s' "$TICKET_ID"
  else
    printf 'squad:%s' "${RUN_ID:0:15}"
  fi
}

window_exists() {
  local target_window_id="${1:-}"
  [[ -n "$target_window_id" ]] || return 1
  tmux list-windows -a -F '#{window_id}' 2>/dev/null |
    awk -v target="$target_window_id" '$0 == target { found = 1 } END { exit !found }'
}

branch_exists() {
  local branch_name="$1"
  git -C "$REPO_ROOT" show-ref --verify --quiet "refs/heads/$branch_name" ||
    git -C "$REPO_ROOT" show-ref --verify --quiet "refs/remotes/origin/$branch_name"
}

list_runs() {
  local state_file title status
  printf '%-24s  %-9s  %s\n' "RUN ID" "STATUS" "TITLE"
  find "$SQUAD_RUN_ROOT" -mindepth 2 -maxdepth 2 -name state.env -type f 2>/dev/null |
    sort -r |
    while IFS= read -r state_file; do
      unset RUN_ID RUN_STATUS SQUAD_DIR WINDOW_ID
      source "$state_file"
      title="$(cat "$SQUAD_DIR/title.txt" 2>/dev/null || printf 'unknown')"
      status="${RUN_STATUS:-unknown}"
      if window_exists "${WINDOW_ID:-}"; then
        status="running"
      elif [[ "$status" == "running" ]]; then
        status="closed"
      fi
      printf '%-24s  %-9s  %s\n' "$RUN_ID" "$status" "$title"
    done
}

# True when a tmux on PATH is one of squad's own kill-guard shims rather than the
# real binary. The marker is the wrapper's own message, written a few functions
# below, so the two stay in sync.
is_tmux_guard_shim() {
  grep -q 'blocked dangerous tmux command' "$1" 2>/dev/null
}

# The REAL tmux binary, skipping squad's kill-guard shims.
#
# Agents run with a PATH shim that refuses kill-server/kill-session/kill-window/
# kill-pane. `squad close` is an explicit, PO-requested close — exactly the
# carve-out that guard allows — so squad's own close path resolves the real
# binary and calls it directly. The shim is NOT weakened: an agent that runs
# `tmux kill-window` itself is still refused.
#
# The guard exports SQUAD_REAL_TMUX, but a nested guard (run-coder starts inside
# the already-guarded Manager pane, so its `command -v tmux` finds the outer
# shim) can capture a shim in it. Every candidate is therefore checked, and the
# first non-shim wins.
squad_real_tmux() {
  local candidate
  local -a candidates=()
  if [[ -n "${SQUAD_REAL_TMUX:-}" ]]; then
    candidates+=("$SQUAD_REAL_TMUX")
  fi
  while IFS= read -r candidate; do
    if [[ -n "$candidate" ]]; then
      candidates+=("$candidate")
    fi
  done < <(type -aP tmux 2>/dev/null || true)

  for candidate in ${candidates[@]+"${candidates[@]}"}; do
    [[ -x "$candidate" ]] || continue
    if is_tmux_guard_shim "$candidate"; then
      continue
    fi
    printf '%s\n' "$candidate"
    return 0
  done
  # Nothing but shims (or no tmux at all): fall back to PATH and let the caller
  # report the failure rather than guessing.
  printf 'tmux\n'
}

# Kill a squad window through the real tmux and confirm it is really gone.
close_window() {
  local window_id="$1"
  local tmux_bin
  tmux_bin="$(squad_real_tmux)"
  "$tmux_bin" kill-window -t "$window_id" || return 1
  ! window_exists "$window_id"
}

# THE INVARIANT: whenever the awaiting-PO marker's presence CHANGES, the tmux
# window name is recomposed from the current base. No exceptions.
#
# tmux only repaints a window name when something calls rename-window, so
# unlinking the marker file on its own leaves the [?] badge on screen with
# nothing left that will ever repaint it - the file says "not waiting" while the
# PO still sees "waiting", and they would believe the badge. Every clearing path
# in squad therefore goes through await-po, which is the single place that does
# both halves, rather than removing the file itself. Hand-rolling rename-window
# here would give the composition a second implementation, and the column budget
# would eventually drift between them.
#
# stderr is dropped because these are tidy-up paths: a window that is already
# gone (the usual case when closing) cannot be renamed, and that is expected,
# not a problem worth printing. The marker file removal is the durable half and
# happens first inside the helper regardless.
#
# A run created before await-po existed has no helper to call. It also has no
# marker and no badge, so removing the file directly is exactly right there.
clear_awaiting_po() {
  local squad_dir="${1:-$SQUAD_DIR}"
  if [[ -x "$squad_dir/await-po" ]]; then
    "$squad_dir/await-po" clear 2>/dev/null || true
  else
    rm -f "$squad_dir/awaiting-po.env"
  fi
}

close_run() {
  local previous_status
  load_run "${1:-}" false
  previous_status="${RUN_STATUS:-running}"
  RUN_STATUS="closed"
  # A closed squad is not waiting on anyone. Cleared here rather than after the
  # kill because kill-window destroys this process when close is run from inside
  # the squad's own window, and a marker left behind would outlive the run - a
  # stuck badge is worse than no badge.
  #
  # This also covers the rollback path below: when the kill FAILS the window is
  # still alive, so the badge has to come down on screen too, not just on disk.
  clear_awaiting_po
  # Persisted BEFORE the kill on purpose: `squad close` is normally run from
  # inside the squad's own window, where kill-window destroys this very process
  # and nothing after it would ever run. The rollback below covers the opposite
  # case, so the state file is never left disagreeing with reality.
  write_state
  if window_exists "${WINDOW_ID:-}"; then
    if ! close_window "$WINDOW_ID"; then
      RUN_STATUS="$previous_status"
      write_state
      echo "Error: could not close the tmux window $WINDOW_ID of squad $RUN_ID." >&2
      echo "The squad is still running; its state was left unchanged." >&2
      echo "If you are inside an agent pane, squad's tmux guard blocks kill-window." >&2
      echo "Run this from your own shell instead: squad close $RUN_ID" >&2
      exit 1
    fi
  fi
  printf 'Squad closed: %s\n' "$RUN_ID"
  printf 'Resume with: squad resume %s\n' "$RUN_ID"
}

print_recorded_base() {
  if [[ -n "${SQUAD_BASE_COMMIT:-}" ]]; then
    printf 'Recorded base for %s: %s (%s)\n' \
      "$RUN_ID" "$SQUAD_BASE_COMMIT" "${SQUAD_BASE_REF:-unknown}"
  else
    printf 'Recorded base for %s: not recorded\n' "$RUN_ID"
  fi
}

# Show or RE-PIN the fork point Squad Cockpit diffs this run against.
#
# Cockpit uses SQUAD_BASE_COMMIT directly, but ONLY while it resolves to a commit
# AND is an ancestor of the worktree HEAD; anything else is silently ignored and
# it falls back to guessing a base branch. So this stores a commit satisfying
# exactly that condition, and asserts it before returning.
base_run() {
  local run_id="${1:-}"
  local requested="${2:-}"
  local has_arg="${3:-false}"

  # `false` = no hidden fallback to "the latest retained run", matching close.
  load_run "$run_id" false

  [[ -n "${WORKDIR:-}" && -d "$WORKDIR" ]] || {
    echo "Error: the worktree for $RUN_ID is missing: ${WORKDIR:-<unset>}" >&2
    exit 1
  }
  git -C "$WORKDIR" rev-parse --git-dir >/dev/null 2>&1 || {
    echo "Error: not a git worktree: $WORKDIR" >&2
    exit 1
  }

  if [[ "$has_arg" != "true" ]]; then
    print_recorded_base
    return 0
  fi

  # Validate the input BEFORE touching state.env, so every rejection below
  # leaves the file byte-for-byte unchanged.
  [[ -n "$requested" ]] || {
    echo "Error: squad base requires a non-empty ref or commit" >&2
    exit 1
  }
  [[ "$requested" != -* ]] || {
    echo "Error: invalid base '$requested': must not start with '-'" >&2
    exit 1
  }
  # state.env is written with printf %q and sourced by bash, so %q already makes
  # sourcing safe; this keeps the file inspectable by humans too.
  [[ "$requested" != *[[:cntrl:]]* ]] || {
    echo "Error: invalid base: control characters are not allowed" >&2
    exit 1
  }

  local full_ref="" new_commit=""
  if [[ "$requested" == refs/* ]]; then
    # An explicit refs/... argument is taken literally.
    if git -C "$WORKDIR" show-ref --verify --quiet "$requested"; then
      full_ref="$requested"
    fi
  else
    local candidate
    for candidate in "refs/heads/$requested" "refs/remotes/$requested" \
      "refs/tags/$requested"; do
      if git -C "$WORKDIR" show-ref --verify --quiet "$candidate"; then
        full_ref="$candidate"
        break
      fi
    done
  fi

  if [[ -n "$full_ref" ]]; then
    # An exact ref: record the FORK POINT, never the ref's tip. The tip is
    # usually not an ancestor of HEAD, so cockpit would ignore it and fall back
    # to guessing — and it is not where this run diverged anyway.
    new_commit="$(git -C "$WORKDIR" merge-base "$full_ref" HEAD 2>/dev/null || true)"
    [[ -n "$new_commit" ]] || {
      echo "Error: '$requested' has no merge-base with HEAD in $WORKDIR" >&2
      exit 1
    }
  else
    # Not a ref: a commit-ish the operator typed deliberately. Accept it only if
    # it is ALREADY an ancestor of HEAD, which is precisely what cockpit needs.
    new_commit="$(
      git -C "$WORKDIR" rev-parse --verify --quiet --end-of-options \
        "$requested^{commit}" 2>/dev/null || true
    )"
    [[ -n "$new_commit" ]] || {
      echo "Error: '$requested' is not a known ref or commit in $WORKDIR" >&2
      exit 1
    }
    if ! git -C "$WORKDIR" merge-base --is-ancestor "$new_commit" HEAD 2>/dev/null; then
      echo "Error: '$requested' is not an ancestor of HEAD, so Squad Cockpit" >&2
      echo "would ignore it. Pass a branch/tag instead and squad will record" >&2
      echo "the fork point, or pick a commit on this branch's history." >&2
      exit 1
    fi
  fi

  # The invariant cockpit itself applies. If it does not hold, this command has
  # failed at its job, so fail loudly rather than record a base to be ignored.
  git -C "$WORKDIR" rev-parse --verify --quiet "$new_commit^{commit}" >/dev/null || {
    echo "Error: refusing to record '$new_commit': it is not a commit" >&2
    exit 1
  }
  git -C "$WORKDIR" merge-base --is-ancestor "$new_commit" HEAD || {
    echo "Error: refusing to record $new_commit: not an ancestor of HEAD" >&2
    exit 1
  }

  # Only these two change. load_run sourced the TARGET run's state.env, so
  # write_state re-emits every other key unchanged into that run's own
  # $SQUAD_DIR — including when it is not the current tmux window.
  SQUAD_BASE_COMMIT="$new_commit"
  SQUAD_BASE_REF="$requested"
  write_state
  print_recorded_base
}

# Delete one retained run: its worktree, its squad branch, and its artifact
# directory. Refuses while the squad window is still open. The branch and
# worktree are only deleted when squad created them (isolated-worktree mode);
# in the no-commit fallback WORKDIR is the original repository and BRANCH the
# user's own branch, so both must survive.
remove_run() {
  local state_file="$1"
  unset RUN_ID RUN_STATUS SQUAD_DIR WINDOW_ID WORKDIR BRANCH REPO_ROOT
  source "$state_file"
  if window_exists "${WINDOW_ID:-}"; then
    echo "Skip $RUN_ID: still running. Close it first: squad close $RUN_ID" >&2
    return 1
  fi
  if [[ -n "${WORKDIR:-}" && "$WORKDIR" != "${REPO_ROOT:-}" && -d "$WORKDIR" ]]; then
    git -C "$REPO_ROOT" worktree remove --force "$WORKDIR" 2>/dev/null ||
      rm -rf "$WORKDIR"
    git -C "$REPO_ROOT" worktree prune 2>/dev/null || true
    if [[ -n "${BRANCH:-}" && -d "${REPO_ROOT:-}" ]]; then
      git -C "$REPO_ROOT" branch -D "$BRANCH" 2>/dev/null || true
    fi
  fi
  rm -rf "$SQUAD_DIR"
  printf 'Squad removed: %s\n' "$RUN_ID"
}

clean_runs() {
  local state_file answer title removable=()
  while IFS= read -r state_file; do
    unset RUN_ID RUN_STATUS WINDOW_ID
    source "$state_file"
    window_exists "${WINDOW_ID:-}" || removable+=("$state_file")
  done < <(
    find "$SQUAD_RUN_ROOT" -mindepth 2 -maxdepth 2 -name state.env -type f 2>/dev/null | sort
  )

  if [[ ${#removable[@]} -eq 0 ]]; then
    echo "No closed squads to remove."
    return 0
  fi

  echo "The following ${#removable[@]} squad run(s) will be DELETED (worktree, branch, artifacts):"
  for state_file in "${removable[@]}"; do
    unset RUN_ID SQUAD_DIR
    source "$state_file"
    title="$(cat "$SQUAD_DIR/title.txt" 2>/dev/null || printf 'unknown')"
    printf '  %s  %s\n' "$RUN_ID" "$title"
  done
  printf 'Proceed? [y/N] '
  read -r answer
  [[ "$answer" == "y" || "$answer" == "Y" ]] || {
    echo "Aborted."
    return 1
  }
  for state_file in "${removable[@]}"; do
    remove_run "$state_file"
  done
}

# --- Role-addressed panes -----------------------------------------------------
# tmux assigns brand-new pane IDs to every pane of a resumed squad, so a pane ID
# is never a stable address. Each pane is instead tagged with the run it belongs
# to and the role it plays, and every generated helper resolves
# (RUN_ID, role) -> live pane ID at the moment it needs it.
tag_pane() {
  local pane_id="$1"
  local role="$2"
  tmux set-option -p -t "$pane_id" @squad_run_id "$RUN_ID"
  tmux set-option -p -t "$pane_id" @squad_role "$role"
}

tag_all_panes() {
  tag_pane "$MANAGER_PANE" manager
  tag_pane "$CODER_PANE" coder
  tag_pane "$ADVISOR_PANE" advisor
}

# Worktree mode is derivable from state.env alone: squad only creates an
# isolated worktree when the repository has commits, and otherwise works
# directly in REPO_ROOT. Deriving it lets resume regenerate the Manager prompt
# without any new state field.
set_worktree_mode() {
  if [[ "$WORKDIR" != "$REPO_ROOT" ]]; then
    WORKTREE_MODE="isolated worktree"
    WORKTREE_NOTE="All implementation work happens in the isolated squad worktree. Existing changes
in the original worktree must remain untouched. The squad worktree is retained
after completion so that PO can inspect, commit, or merge the result."
  else
    WORKTREE_MODE="original repository (no commits yet, no isolated worktree)"
    WORKTREE_NOTE="This repository has no commits yet, so git could not create an isolated
worktree. All work happens DIRECTLY in the original repository: $REPO_ROOT.
There is no isolation from existing files; be careful not to destroy them."
  fi
}

# --- Review checklist ---------------------------------------------------------
# The review lenses both Advisor reviews look through. Same file format, same
# lookup order and same merge semantics as vet, so a project that already tunes
# its lenses in .vet/checklist.md gets them here too. vet itself is NEVER
# invoked; only the format is shared.
#
# Deliberate difference from vet: an empty checklist is NOT a failure here. vet
# exists only to review a PR, so it refuses to run without lenses. squad also
# runs on repositories that have no checklist at all, and there the reviews just
# run unstructured.
#
# Regenerated on resume as well as on launch, so a resumed run picks up a
# project checklist that was added after the squad started.

# PREFLIGHT half of the "a configured path is authoritative" rule.
#
# generate_review_checklist runs late - after the worktree, the run directory
# and the three tmux panes exist - so failing there for a mistyped env var
# leaves the PO's tmux layout split even though the launch is aborted (the
# cleanup removes files, not panes). This is pure environment validation, so it
# runs with the other preflight dependency checks instead, before anything has
# been created, on BOTH the launch and the resume path.
#
# generate_review_checklist keeps its own copy of the check: the file can still
# be deleted between preflight and use, and it is called directly on resume.
# Precedence matches it exactly - the FIRST variable that is set wins, so a
# stale VET_CHECKLIST behind a good SQUAD_REVIEW_CHECKLIST is never consulted
# and must not fail the run.
#
# READABILITY, not mere existence. A file that exists but cannot be opened
# (wrong owner, chmod 000) would otherwise sail through preflight and only fail
# when the parser opens it - by which point the worktree, the run artifacts and
# the panes all exist, which is the entire thing this check is here to avoid.
require_readable_checklist_config() {
  local var value
  for var in SQUAD_REVIEW_CHECKLIST VET_CHECKLIST; do
    value="${!var:-}"
    [[ -n "$value" ]] || continue
    [[ -f "$value" && -r "$value" ]] || {
      echo "Error: $var is set but is not a readable file: $value" >&2
      exit 1
    }
    return 0
  done
}

generate_review_checklist() {
  mkdir -p "$SQUAD_DIR"

  local common="" common_source="none"
  local project="" project_source="none"

  # Common checklist, first match wins.
  #
  # An explicitly configured path is AUTHORITATIVE, exactly as in vet: set but
  # unreadable is a configuration error and stops the run. Falling through to
  # the next candidate would run both review lenses against lenses nobody asked
  # for, and a typo in the variable would look like a normal review. Only the
  # EMPTY checklist case is relaxed here (see the header comment); a wrong path
  # is a different thing entirely.
  # Same readability test as require_readable_checklist_config, deliberately
  # duplicated: preflight cannot cover a file that becomes unreadable later, and
  # this function is also called directly on resume.
  if [[ -n "${SQUAD_REVIEW_CHECKLIST:-}" ]]; then
    [[ -f "$SQUAD_REVIEW_CHECKLIST" && -r "$SQUAD_REVIEW_CHECKLIST" ]] || {
      echo "Error: SQUAD_REVIEW_CHECKLIST is set but is not a readable file: $SQUAD_REVIEW_CHECKLIST" >&2
      exit 1
    }
    common="$SQUAD_REVIEW_CHECKLIST"
    common_source="SQUAD_REVIEW_CHECKLIST"
  elif [[ -n "${VET_CHECKLIST:-}" ]]; then
    [[ -f "$VET_CHECKLIST" && -r "$VET_CHECKLIST" ]] || {
      echo "Error: VET_CHECKLIST is set but is not a readable file: $VET_CHECKLIST" >&2
      exit 1
    }
    common="$VET_CHECKLIST"
    common_source="VET_CHECKLIST"
  elif [[ -f "$HOME/.vet/checklist.md" ]]; then
    common="$HOME/.vet/checklist.md"
    common_source="$HOME/.vet/checklist.md"
  elif [[ -f "$SQUAD_SCRIPT_DIR/_vet/checklist.md" ]]; then
    common="$SQUAD_SCRIPT_DIR/_vet/checklist.md"
    common_source="$SQUAD_SCRIPT_DIR/_vet/checklist.md"
  fi

  # Project override, inside the squad worktree.
  if [[ -f "$WORKDIR/.vet/checklist.md" ]]; then
    project="$WORKDIR/.vet/checklist.md"
    project_source=".vet/checklist.md"
  elif [[ -f "$WORKDIR/.review/checklist.md" ]]; then
    project="$WORKDIR/.review/checklist.md"
    project_source=".review/checklist.md"
  fi

  # Parse only `- [ID] text` bullets so the checklist files stay readable prose.
  # Merge rule: common first in its own order, then the project file on top -
  # same ID replaces the text, a new ID is appended.
  if command -v perl >/dev/null 2>&1; then
    perl -e '
      use strict;
      use warnings;
      my ($common_file, $project_file) = @ARGV;
      my (@order, %text, %source);
      sub items {
        my ($file, $kind) = @_;
        my @found;
        return @found unless defined $file && length $file && -f $file;
        open my $fh, "<", $file or die "squad: cannot read $file: $!\n";
        while (my $line = <$fh>) {
          chomp $line;
          # The bullet must start at column 0. That single rule is what keeps an
          # indented "- [ID] ..." example inside the file own documentation from
          # being parsed as a real checklist item.
          next unless $line =~ /^-\s+\[([A-Z][A-Z0-9_-]*)\]\s+(\S.*?)\s*$/;
          push @found, [$1, $2, $kind];
        }
        close $fh;
        return @found;
      }
      for my $item (items($common_file, "common")) {
        my ($id, $body) = @$item;
        push @order, $id unless exists $text{$id};
        $text{$id}   = $body;
        $source{$id} = "common";
      }
      for my $item (items($project_file, "project")) {
        my ($id, $body) = @$item;
        if (exists $text{$id}) {
          $source{$id} = ($source{$id} eq "common") ? "project-override" : $source{$id};
        } else {
          push @order, $id;
          $source{$id} = "project";
        }
        $text{$id} = $body;
      }
      sub esc {
        my $value = shift;
        $value =~ s/\\/\\\\/g;
        $value =~ s/"/\\"/g;
        $value =~ s/[\x00-\x1f]/ /g;
        return $value;
      }
      for my $id (@order) {
        printf qq({"id":"%s","text":"%s","source":"%s"}\n),
          esc($id), esc($text{$id}), esc($source{$id});
      }
    ' "$common" "$project" > "$SQUAD_DIR/checklist.jsonl"
  else
    echo "Warning: perl was not found, so the review checklist could not be parsed." >&2
    : > "$SQUAD_DIR/checklist.jsonl"
  fi

  local count=0 overrides=0 added=0
  if command -v jq >/dev/null 2>&1; then
    jq -s --arg common "$common_source" --arg project "$project_source" \
      '{common_checklist: $common, project_checklist: $project, items: .}' \
      "$SQUAD_DIR/checklist.jsonl" > "$SQUAD_DIR/checklist.json"
    count="$(jq -r '.items | length' "$SQUAD_DIR/checklist.json")"
    overrides="$(jq -r '[.items[] | select(.source == "project-override")] | length' "$SQUAD_DIR/checklist.json")"
    added="$(jq -r '[.items[] | select(.source == "project")] | length' "$SQUAD_DIR/checklist.json")"
  else
    echo "Warning: jq was not found, so checklist.json could not be written." >&2
    printf '{"common_checklist":"%s","project_checklist":"%s","items":[]}\n' \
      "$common_source" "$project_source" > "$SQUAD_DIR/checklist.json"
  fi

  {
    printf '# Merged review checklist\n\n'
    printf 'Common checklist:  %s\n' "$common_source"
    printf 'Project checklist: %s\n' "$project_source"
    printf 'Items: %s total (%s overridden by the project, %s added by the project)\n\n' \
      "$count" "$overrides" "$added"
    if [[ "$count" -eq 0 ]]; then
      printf '(no checklist items)\n'
    else
      jq -r '.items[] | "- [\(.id)] \(.text)  <!-- source: \(.source) -->"' "$SQUAD_DIR/checklist.json"
    fi
  } > "$SQUAD_DIR/checklist.merged.md"
}

# --- Generated helper scripts -------------------------------------------------
# Regenerated on every launch AND on every resume, so a squad created by an
# older version of this script gets the role-addressed helpers as soon as it is
# resumed.
generate_helper_scripts() {
  mkdir -p "$SQUAD_DIR"

  # squad-pane is the single source of truth for agent addressing.
  {
    printf '#!/usr/bin/env bash\n'
    printf 'set -euo pipefail\n'
    printf 'SQUAD_RUN_ID=%q\n' "$RUN_ID"
    cat <<'HELPER'
# Resolve one squad role to the live tmux pane ID that currently plays it.
# Matches the pane-level @squad_run_id and @squad_role options exactly, so two
# squads in the same tmux server can never target each other's panes.

if [[ $# -ne 1 ]]; then
  printf 'Usage: squad-pane <manager|coder|advisor>\n' >&2
  exit 2
fi

ROLE="$1"
case "$ROLE" in
  manager|coder|advisor) ;;
  *)
    printf 'Error: unknown squad role: %s (expected manager, coder, or advisor)\n' "$ROLE" >&2
    exit 2
    ;;
esac

TAB=$'\t'
MATCHES=()
while IFS="$TAB" read -r pane_id pane_run_id pane_role; do
  [[ "$pane_run_id" == "$SQUAD_RUN_ID" && "$pane_role" == "$ROLE" ]] || continue
  MATCHES+=("$pane_id")
done < <(
  tmux list-panes -a -F "#{pane_id}${TAB}#{@squad_run_id}${TAB}#{@squad_role}" 2>/dev/null || true
)

case "${#MATCHES[@]}" in
  1)
    printf '%s\n' "${MATCHES[0]}"
    ;;
  0)
    printf 'Error: no live tmux pane has role %s for squad run %s.\n' "$ROLE" "$SQUAD_RUN_ID" >&2
    printf 'The pane is gone. Report this to PO; resume the squad with: squad resume %s\n' "$SQUAD_RUN_ID" >&2
    exit 1
    ;;
  *)
    printf 'Error: %s tmux panes claim role %s for squad run %s: %s\n' \
      "${#MATCHES[@]}" "$ROLE" "$SQUAD_RUN_ID" "${MATCHES[*]}" >&2
    printf 'Refusing to guess. Close the stale squad window, then retry.\n' >&2
    exit 1
    ;;
esac
HELPER
  } > "$SQUAD_DIR/squad-pane"
  chmod +x "$SQUAD_DIR/squad-pane"

  {
    printf '#!/usr/bin/env bash\n'
    printf 'set -euo pipefail\n'
    printf 'SQUAD_DIR=%q\n' "$SQUAD_DIR"
    cat <<'HELPER'
# Run one shell command in the pane that currently plays the given role.
# Never falls back to a guessed pane: if the role cannot be resolved, nothing
# is sent and the exit status is non-zero.
#
#   send-to [--status-file <path>] <manager|coder|advisor> <shell-command>
#
# --status-file exists to close a launch race, and it must be an explicit option
# rather than a path parsed out of the command string, which would be fragile.
#
# tmux send-keys only QUEUES keystrokes. The helper has NOT started when send-to
# returns, so its own `rm -f "$STATUS_FILE"` has not run either. The Manager
# runs a launch and then the matching run-wait synchronously in its own pane, so
# without clearing here run-wait's fast path would find the PREVIOUS round's
# status file and report that old result before the new command had even begun.
# Clearing here is guaranteed to precede the wait because it happens in the
# Manager's pane, before the keystrokes are queued.
#
# Only a LAUNCH passes --status-file. A run-wait must never clear, or a repeated
# wait would discard a real result and then block.

STATUS_FILE=""
if [[ "${1:-}" == "--status-file" ]]; then
  if [[ $# -lt 2 || -z "${2:-}" ]]; then
    printf 'Error: --status-file requires a path.\n' >&2
    exit 2
  fi
  STATUS_FILE="$2"
  shift 2
fi

if [[ $# -ne 2 ]]; then
  printf 'Usage: send-to [--status-file <path>] <manager|coder|advisor> <shell-command>\n' >&2
  printf 'The command must be a single argument; quote it.\n' >&2
  exit 2
fi

ROLE="$1"
COMMAND="$2"

if ! PANE="$("$SQUAD_DIR/squad-pane" "$ROLE")"; then
  printf 'Error: send-to %s aborted, nothing was sent.\n' "$ROLE" >&2
  exit 1
fi

# Before the keystrokes are queued, and only for a launch.
if [[ -n "$STATUS_FILE" ]]; then
  rm -f "$STATUS_FILE"
fi

tmux send-keys -t "$PANE" "$COMMAND" Enter
printf '[%s] sent to %s (pane %s)\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$ROLE" "$PANE"
HELPER
  } > "$SQUAD_DIR/send-to"
  chmod +x "$SQUAD_DIR/send-to"

  # --- Window display name ----------------------------------------------------
  # The ONE place that knows how a tmux window name is composed and truncated.
  #
  # There are two different strings and confusing them is the bug this helper
  # exists to prevent:
  #
  #   BASE    - what the run is about, chosen by the Manager and stored in
  #             short-name.txt. Never contains the awaiting-PO marker.
  #   DISPLAY - what tmux actually shows: the base, plus the marker while
  #             $SQUAD_DIR/awaiting-po.env exists.
  #
  # Composing at display time (rather than storing the decorated name) is what
  # lets the Manager retitle the run WHILE it is waiting: the marker survives a
  # title change, and clearing it reveals the CURRENT base rather than whatever
  # the base happened to be when the marker went up.
  {
    printf '#!/usr/bin/env bash\n'
    printf 'set -euo pipefail\n'
    printf 'SQUAD_DIR=%q\n' "$SQUAD_DIR"
    printf 'WINDOW_FALLBACK_NAME=%q\n' \
      "${WINDOW_SHORT_NAME:-$(placeholder_window_name)}"
    cat <<'HELPER'
# Usage:
#   window-name display [base]   the name to hand to tmux rename-window
#   window-name fit <text> [max] width-aware truncation
#   window-name width <text>     display columns of a string
#
# How wide the tmux window name may be, in DISPLAY COLUMNS, not characters. A
# window name sits in a list beside other windows, so this is a hard budget:
# one Japanese character costs two columns, so 20 columns is about ten of them.
SHORT_NAME_MAX_COLUMNS=20

# Shown while the Manager is waiting on PO. Deliberately ASCII: it costs exactly
# four columns in every terminal, where an emoji's width depends on the font and
# would make the budget below a guess. To change it, change this one line - the
# marker is never stored in the base name, so nothing else needs to agree.
AWAITING_PO_MARKER='[?] '

# jq is used because it is already a hard dependency of squad and is
# Unicode-aware, where the awk on macOS is not. `cut -c` counts CHARACTERS, so
# it would let a ten-character Japanese name occupy twenty columns.
#
# $1 = mode (fit|width), $2 = text, $3 = max columns (fit only).
measure() {
  jq -Rr --arg mode "$1" --argjson max "${3:-0}" '
    # jq has NO hexadecimal literals, so these are decimal. The hex equivalent
    # is in the comment beside each range.
    def cw:
      if . >= 4352 and (
           . <= 4447                          # 1100-115F Hangul Jamo
        or (. >= 11904 and . <= 12350)        # 2E80-303E CJK radicals, kana punct
        or (. >= 12353 and . <= 13311)        # 3041-33FF kana, CJK compat
        or (. >= 13312 and . <= 19903)        # 3400-4DBF CJK ext A
        or (. >= 19968 and . <= 40959)        # 4E00-9FFF CJK unified
        or (. >= 40960 and . <= 42191)        # A000-A4CF Yi
        or (. >= 44032 and . <= 55203)        # AC00-D7A3 Hangul syllables
        or (. >= 63744 and . <= 64255)        # F900-FAFF CJK compat ideographs
        or (. >= 65072 and . <= 65135)        # FE30-FE6F CJK compat forms
        or (. >= 65280 and . <= 65376)        # FF00-FF60 fullwidth forms
        or (. >= 65504 and . <= 65510)        # FFE0-FFE6 fullwidth signs
        or (. >= 127744 and . <= 129535)      # 1F300-1F9FF emoji
        or (. >= 131072 and . <= 262141)      # 20000-3FFFD CJK ext B+
      ) then 2 else 1 end;
    def fit($m):
      explode as $cp
      | reduce range(0; ($cp | length)) as $i ({w: 0, out: [], done: false};
          if .done then .
          elif (.w + ($cp[$i] | cw)) > $m then .done = true
          else .w = (.w + ($cp[$i] | cw)) | .out = (.out + [$cp[$i]])
          end)
      | .out | implode;
    (explode | map(cw) | add // 0) as $width
    | if $mode == "width" then ($width | tostring)
      elif $width <= $max then .
      else (fit($max - 2)) + ".."
      end
  ' <<< "$2"
}

case "${1:-}" in
  fit)
    if [[ $# -lt 2 ]]; then
      printf 'Usage: window-name fit <text> [max-columns]\n' >&2
      exit 2
    fi
    measure fit "$2" "${3:-$SHORT_NAME_MAX_COLUMNS}"
    ;;
  width)
    if [[ $# -ne 2 ]]; then
      printf 'Usage: window-name width <text>\n' >&2
      exit 2
    fi
    measure width "$2"
    ;;
  display)
    BASE="${2:-}"
    # short-name.txt is the stored base. It is written by update-title on every
    # title change and seeded at launch, so it is normally present; the baked-in
    # placeholder covers a run whose first title update has not happened yet.
    if [[ -z "$BASE" && -s "$SQUAD_DIR/short-name.txt" ]]; then
      BASE="$(head -n 1 "$SQUAD_DIR/short-name.txt")"
    fi
    if [[ -z "$BASE" ]]; then
      BASE="$WINDOW_FALLBACK_NAME"
    fi
    # PRESENCE of the marker file is the truth; its contents are detail only, so
    # a half-written or hand-edited file still renders correctly.
    if [[ -e "$SQUAD_DIR/awaiting-po.env" ]]; then
      MARKER_COLUMNS="$(measure width "$AWAITING_PO_MARKER")"
      # The marker spends part of the SAME budget, so the composed name still
      # fits the window list. The base is re-fitted rather than pre-truncated,
      # which is why clearing the marker restores the full stored base.
      printf '%s%s\n' "$AWAITING_PO_MARKER" \
        "$(measure fit "$BASE" "$((SHORT_NAME_MAX_COLUMNS - MARKER_COLUMNS))")"
    else
      measure fit "$BASE" "$SHORT_NAME_MAX_COLUMNS"
    fi
    ;;
  *)
    printf 'Usage: window-name <display|fit|width> [args]\n' >&2
    exit 2
    ;;
esac
HELPER
  } > "$SQUAD_DIR/window-name"
  chmod +x "$SQUAD_DIR/window-name"

  # --- Awaiting-PO marker -------------------------------------------------------
  # Records that the Manager has asked PO something and is waiting for an answer.
  #
  # WHY A FILE OF ITS OWN. Not RUN_STATUS: that feeds `squad list` and the
  # closed/running lifecycle, and "running but waiting" is not a lifecycle state.
  # Not a state.env key: write_state rewrites a fixed set of variables wholesale,
  # so a key written by a helper while squad itself is mid-write would be lost.
  # An independent file, replaced by rename, has neither problem and is readable
  # by anything - including Squad Cockpit, with the app closed.
  {
    printf '#!/usr/bin/env bash\n'
    printf 'set -euo pipefail\n'
    printf 'SQUAD_DIR=%q\n' "$SQUAD_DIR"
    cat <<'HELPER'
# Usage:
#   await-po mark [reason...]   about to ask PO something; raise the marker
#   await-po clear              PO has been heard from; lower it
#   await-po status             print the current state (debugging)
#
# Both mark and clear are IDEMPOTENT. The Manager runs `clear` at the start of
# every turn without knowing whether a marker exists, so clearing nothing must
# be silent and free.

MARKER="$SQUAD_DIR/awaiting-po.env"

# Re-apply the window name for the CURRENT marker state.
#
# Best effort on purpose. The marker file is the durable truth and it is already
# written by the time this runs; a tmux window that cannot be renamed (no server,
# a pane that has gone away, a squad resumed elsewhere) must not turn into a
# failed command in the Manager's face, so this warns and returns success.
apply_window_name() {
  local display pane
  if ! display="$("$SQUAD_DIR/window-name" display 2>/dev/null)"; then
    printf 'Warning: could not compose the window name; it was left unchanged.\n' >&2
    return 0
  fi
  # Resolved by ROLE, never from state.env's pane IDs, which tmux invalidates on
  # every resume and which state.env itself documents as non-authoritative.
  if ! pane="$("$SQUAD_DIR/squad-pane" manager 2>/dev/null)"; then
    printf 'Warning: the Manager pane could not be resolved; the tmux window name\n' >&2
    printf 'was left unchanged. The marker file itself is up to date.\n' >&2
    return 0
  fi
  if ! tmux rename-window -t "$pane" "$display" 2>/dev/null; then
    printf 'Warning: tmux rename-window failed; the window name was left unchanged.\n' >&2
    return 0
  fi
  printf '%s\n' "$display"
}

# One safe line: no control characters (so the file stays parseable), no runaway
# length, whitespace collapsed. The value is additionally written with %q below,
# so quotes, $, backticks and the like are inert even when the file is sourced.
sanitize_reason() {
  printf '%s' "$1" |
    tr '\n\r\t' '   ' |
    sed -E 's/[[:cntrl:]]//g; s/^[[:space:]]+//; s/[[:space:]]+$//; s/[[:space:]]+/ /g' |
    cut -c 1-120
}

case "${1:-}" in
  mark)
    shift
    REASON="$(sanitize_reason "${*:-}")"
    # Written to a temp file and RENAMED, so a reader (cockpit polling, or the
    # window-name helper) never observes a half-written marker. $$ keeps two
    # concurrent marks from sharing a temp path; rename is atomic within the
    # directory, so the last writer simply wins.
    TMP="$MARKER.tmp.$$"
    {
      printf 'AWAITING_PO=1\n'
      printf 'AWAITING_PO_AT=%q\n' "$(date '+%Y-%m-%d %H:%M:%S')"
      if [[ -n "$REASON" ]]; then
        printf 'AWAITING_PO_REASON=%q\n' "$REASON"
      fi
    } > "$TMP"
    mv -f "$TMP" "$MARKER"
    apply_window_name >/dev/null || true
    if [[ -n "$REASON" ]]; then
      printf 'Awaiting PO: %s\n' "$REASON"
    else
      printf 'Awaiting PO.\n'
    fi
    ;;
  clear)
    rm -f "$MARKER"
    apply_window_name >/dev/null || true
    ;;
  status)
    if [[ -e "$MARKER" ]]; then
      printf 'awaiting-po: YES\n'
      cat "$MARKER"
    else
      printf 'awaiting-po: no\n'
    fi
    printf 'window name would be: %s\n' \
      "$("$SQUAD_DIR/window-name" display 2>/dev/null || printf '(unavailable)')"
    ;;
  *)
    printf 'Usage: await-po <mark [reason...]|clear|status>\n' >&2
    exit 2
    ;;
esac
HELPER
  } > "$SQUAD_DIR/await-po"
  chmod +x "$SQUAD_DIR/await-po"

  # --- Dynamic title update ---------------------------------------------------

  {
    printf '#!/usr/bin/env bash\n'
    printf 'set -euo pipefail\n'
    printf 'SQUAD_DIR=%q\n' "$SQUAD_DIR"
    cat <<'HELPER'
TITLE_FILE="$1"
NEW_TITLE_FILE="$2"
# $3 is the window name to fall back to when the Manager has not supplied a
# short one - the placeholder squad chose at launch.
FALLBACK_SHORT_NAME="$3"

NEW_TITLE="$(
  tr '\n\r\t' '   ' < "$NEW_TITLE_FILE" |
    sed -E \
      -e 's/^[[:space:]]+//' \
      -e 's/[[:space:]]+$//' \
      -e 's/[[:space:]]+/ /g' |
    cut -c 1-90
)"

if [[ -z "$NEW_TITLE" ]]; then
  echo "Error: squad title must not be empty" >&2
  exit 1
fi

printf '%s\n' "$NEW_TITLE" > "$TITLE_FILE"

# The window BASE name. The Manager writes a two-word description of what this
# run is doing to new-short-name.txt at the same moment it writes the long title;
# the long one goes to the Manager PANE, the short one to the WINDOW. When the
# Manager has not written one yet, the launch placeholder stands.
#
# This is the base ONLY. It never contains the awaiting-PO marker: the marker is
# composed on top of it by window-name at display time, so a title update made
# while the Manager is waiting keeps the marker visible instead of erasing it.
SHORT_NAME=""
if [[ -s "$SQUAD_DIR/new-short-name.txt" ]]; then
  SHORT_NAME="$(
    tr '\n\r\t' '   ' < "$SQUAD_DIR/new-short-name.txt" |
      sed -E \
        -e 's/^[[:space:]]+//' \
        -e 's/[[:space:]]+$//' \
        -e 's/[[:space:]]+/ /g'
  )"
fi
if [[ -n "$SHORT_NAME" ]]; then
  SHORT_NAME="$("$SQUAD_DIR/window-name" fit "$SHORT_NAME")"
fi
# Keep the name we last applied rather than reverting to the launch placeholder.
# Sliding a good window name back to squad:<timestamp> because one title update
# happened to omit the short file is the exact thing this change exists to stop.
if [[ -z "$SHORT_NAME" && -s "$SQUAD_DIR/short-name.txt" ]]; then
  SHORT_NAME="$(head -n 1 "$SQUAD_DIR/short-name.txt")"
fi
if [[ -z "$SHORT_NAME" ]]; then
  SHORT_NAME="$FALLBACK_SHORT_NAME"
fi
# Persisted so `squad resume` can restore the name without the Manager having to
# set it again, exactly as title.txt restores the pane title.
printf '%s\n' "$SHORT_NAME" > "$SQUAD_DIR/short-name.txt"

# What tmux is actually given: the base just stored, plus the awaiting-PO marker
# when that marker is up. Computed AFTER the write above so it reflects the new
# base, which is what makes "retitle while waiting" keep the marker.
DISPLAY_NAME="$("$SQUAD_DIR/window-name" display "$SHORT_NAME")"

retitle_agent() {
