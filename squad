#!/usr/bin/env bash
set -euo pipefail

# ==============================================================================
# squad - AI 3-agent team orchestration via tmux panes
# ==============================================================================

usage() {
  local status="${1:-1}"
  cat <<'EOF'
Usage: squad <task>
       squad list
       squad close [run-id]
       squad resume [run-id]
       squad rm <run-id>...
       squad clean

Create an isolated git worktree and split the current tmux pane into 3 AI agents:
  Manager (Claude Code) - left, talks to you
  Coder   (Claude Code) - right-top, implements code
  Advisor (Codex)       - right-bottom, plans and reviews

Example:
  squad "TRACK-123 CSVインポート機能を追加"

Lifecycle:
  squad list             List retained squads and their status.
  squad close            Close the squad for the current tmux window.
  squad close <run-id>   Close a squad from another tmux window.
  squad resume           Resume the most recent retained squad.
  squad resume <run-id>  Resume a specific retained squad.
  squad rm <run-id>...   Delete closed squads: worktree, branch, and artifacts.
  squad clean            Delete ALL squads that are not running (asks first).
EOF
  exit "$status"
}

SQUAD_STATE_ROOT="${SQUAD_STATE_ROOT:-${XDG_STATE_HOME:-$HOME/.local/state}/squad}"
SQUAD_RUN_ROOT="$SQUAD_STATE_ROOT/runs"
SQUAD_WORKTREE_ROOT="${SQUAD_WORKTREE_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}/squad/worktrees}"
mkdir -p "$SQUAD_RUN_ROOT" "$SQUAD_WORKTREE_ROOT"

load_run() {
  local requested_id="${1:-}"
  local allow_latest="${2:-true}"
  local state_file=""

  if [[ -n "$requested_id" ]]; then
    state_file="$SQUAD_RUN_ROOT/$requested_id/state.env"
  elif [[ -n "${TMUX:-}" ]]; then
    state_file="$(tmux show-option -wqv @squad_state_file 2>/dev/null || true)"
  fi

  if [[ ( -z "$state_file" || ! -f "$state_file" ) && "$allow_latest" == "true" ]]; then
    state_file="$(
      find "$SQUAD_RUN_ROOT" -mindepth 2 -maxdepth 2 -name state.env -type f 2>/dev/null |
        sort |
        tail -n 1
    )"
  fi

  [[ -n "$state_file" && -f "$state_file" ]] || {
    echo "Error: no matching squad run found (see: squad list)" >&2
    exit 1
  }

  # state.env is generated by squad itself and contains shell-escaped values.
  source "$state_file"
  STATE_FILE="$state_file"
}

write_state() {
  mkdir -p "$SQUAD_DIR"
  {
    printf 'RUN_ID=%q\n' "$RUN_ID"
    printf 'STARTED_AT=%q\n' "$STARTED_AT"
    printf 'TASK=%q\n' "$TASK"
    printf 'TICKET_ID=%q\n' "$TICKET_ID"
    printf 'REPO_ROOT=%q\n' "$REPO_ROOT"
    printf 'WORKDIR=%q\n' "$WORKDIR"
    printf 'BRANCH=%q\n' "$BRANCH"
    printf 'SQUAD_DIR=%q\n' "$SQUAD_DIR"
    printf 'WINDOW_SHORT_NAME=%q\n' "${WINDOW_SHORT_NAME:-squad}"
    printf 'MANAGER_SESSION_ID=%q\n' "$MANAGER_SESSION_ID"
    printf 'CODER_SESSION_ID=%q\n' "$CODER_SESSION_ID"
    printf 'RUBOCOP_COMMAND=%q\n' "$RUBOCOP_COMMAND"
    printf 'WAIT_TIMEOUT_SECONDS=%q\n' "$WAIT_TIMEOUT_SECONDS"
    printf 'WINDOW_ID=%q\n' "${WINDOW_ID:-}"
    printf 'CURRENT_WINDOW_NAME=%q\n' "${CURRENT_WINDOW_NAME:-}"
    printf 'MANAGER_PANE=%q\n' "${MANAGER_PANE:-}"
    printf 'CODER_PANE=%q\n' "${CODER_PANE:-}"
    printf 'ADVISOR_PANE=%q\n' "${ADVISOR_PANE:-}"
    # The pane IDs embedded in manager-prompt.md at launch. Resume rewrites the
    # prompt by mapping FROM these, so they must survive any number of resumes.
    printf 'ORIG_MANAGER_PANE=%q\n' "${ORIG_MANAGER_PANE:-${MANAGER_PANE:-}}"
    printf 'ORIG_CODER_PANE=%q\n' "${ORIG_CODER_PANE:-${CODER_PANE:-}}"
    printf 'ORIG_ADVISOR_PANE=%q\n' "${ORIG_ADVISOR_PANE:-${ADVISOR_PANE:-}}"
    printf 'RUN_STATUS=%q\n' "${RUN_STATUS:-running}"
  } > "$SQUAD_DIR/state.env"
  STATE_FILE="$SQUAD_DIR/state.env"
}

window_exists() {
  local target_window_id="${1:-}"
  [[ -n "$target_window_id" ]] || return 1
  tmux list-windows -a -F '#{window_id}' 2>/dev/null |
    awk -v target="$target_window_id" '$0 == target { found = 1 } END { exit !found }'
}

branch_exists() {
  local branch_name="$1"
  git -C "$REPO_ROOT" show-ref --verify --quiet "refs/heads/$branch_name" ||
    git -C "$REPO_ROOT" show-ref --verify --quiet "refs/remotes/origin/$branch_name"
}

list_runs() {
  local state_file title status
  printf '%-24s  %-9s  %s\n' "RUN ID" "STATUS" "TITLE"
  find "$SQUAD_RUN_ROOT" -mindepth 2 -maxdepth 2 -name state.env -type f 2>/dev/null |
    sort -r |
    while IFS= read -r state_file; do
      unset RUN_ID RUN_STATUS SQUAD_DIR WINDOW_ID
      source "$state_file"
      title="$(cat "$SQUAD_DIR/title.txt" 2>/dev/null || printf 'unknown')"
      status="${RUN_STATUS:-unknown}"
      if window_exists "${WINDOW_ID:-}"; then
        status="running"
      elif [[ "$status" == "running" ]]; then
        status="closed"
      fi
      printf '%-24s  %-9s  %s\n' "$RUN_ID" "$status" "$title"
    done
}

close_run() {
  load_run "${1:-}" false
  RUN_STATUS="closed"
  write_state
  if window_exists "${WINDOW_ID:-}"; then
    tmux kill-window -t "$WINDOW_ID"
  fi
  printf 'Squad closed: %s\n' "$RUN_ID"
  printf 'Resume with: squad resume %s\n' "$RUN_ID"
}

# Delete one retained run: its worktree, its squad branch, and its artifact
# directory. Refuses while the squad window is still open. The branch and
# worktree are only deleted when squad created them (isolated-worktree mode);
# in the no-commit fallback WORKDIR is the original repository and BRANCH the
# user's own branch, so both must survive.
remove_run() {
  local state_file="$1"
  unset RUN_ID RUN_STATUS SQUAD_DIR WINDOW_ID WORKDIR BRANCH REPO_ROOT
  source "$state_file"
  if window_exists "${WINDOW_ID:-}"; then
    echo "Skip $RUN_ID: still running. Close it first: squad close $RUN_ID" >&2
    return 1
  fi
  if [[ -n "${WORKDIR:-}" && "$WORKDIR" != "${REPO_ROOT:-}" && -d "$WORKDIR" ]]; then
    git -C "$REPO_ROOT" worktree remove --force "$WORKDIR" 2>/dev/null ||
      rm -rf "$WORKDIR"
    git -C "$REPO_ROOT" worktree prune 2>/dev/null || true
    if [[ -n "${BRANCH:-}" && -d "${REPO_ROOT:-}" ]]; then
      git -C "$REPO_ROOT" branch -D "$BRANCH" 2>/dev/null || true
    fi
  fi
  rm -rf "$SQUAD_DIR"
  printf 'Squad removed: %s\n' "$RUN_ID"
}

clean_runs() {
  local state_file answer title removable=()
  while IFS= read -r state_file; do
    unset RUN_ID RUN_STATUS WINDOW_ID
    source "$state_file"
    window_exists "${WINDOW_ID:-}" || removable+=("$state_file")
  done < <(
    find "$SQUAD_RUN_ROOT" -mindepth 2 -maxdepth 2 -name state.env -type f 2>/dev/null | sort
  )

  if [[ ${#removable[@]} -eq 0 ]]; then
    echo "No closed squads to remove."
    return 0
  fi

  echo "The following ${#removable[@]} squad run(s) will be DELETED (worktree, branch, artifacts):"
  for state_file in "${removable[@]}"; do
    unset RUN_ID SQUAD_DIR
    source "$state_file"
    title="$(cat "$SQUAD_DIR/title.txt" 2>/dev/null || printf 'unknown')"
    printf '  %s  %s\n' "$RUN_ID" "$title"
  done
  printf 'Proceed? [y/N] '
  read -r answer
  [[ "$answer" == "y" || "$answer" == "Y" ]] || {
    echo "Aborted."
    return 1
  }
  for state_file in "${removable[@]}"; do
    remove_run "$state_file"
  done
}

resume_run() {
  local new_window
  local target_session="${2:-}"

  # Without an explicit target session, resume must run inside tmux (existing
  # behavior). With --session, we create the window in that session directly and
  # do not require $TMUX (e.g. when launched from an external tool).
  if [[ -z "$target_session" && -z "${TMUX:-}" ]]; then
    echo "Error: squad resume must be run inside tmux (or pass --session <name>)" >&2
    exit 1
  fi

  load_run "${1:-}"
  [[ -d "$WORKDIR" ]] || {
    echo "Error: squad worktree no longer exists: $WORKDIR" >&2
    exit 1
  }

  if window_exists "${WINDOW_ID:-}"; then
    echo "Error: squad is already running in window $WINDOW_ID" >&2
    exit 1
  fi

  # manager-prompt.md embeds the pane IDs from the ORIGINAL launch, so the
  # rewrite below must always map from those — not from the previous resume's
  # panes. Older state files lack ORIG_*; their last-known panes are the best
  # available approximation (exact for runs that were never resumed).
  ORIG_MANAGER_PANE="${ORIG_MANAGER_PANE:-${MANAGER_PANE:-}}"
  ORIG_CODER_PANE="${ORIG_CODER_PANE:-${CODER_PANE:-}}"
  ORIG_ADVISOR_PANE="${ORIG_ADVISOR_PANE:-${ADVISOR_PANE:-}}"

  if [[ -n "$target_session" ]]; then
    new_window="$(tmux new-window -d -t "${target_session}:" -c "$WORKDIR" -P -F '#{window_id} #{pane_id}')"
  else
    new_window="$(tmux new-window -d -c "$WORKDIR" -P -F '#{window_id} #{pane_id}')"
  fi
  read -r WINDOW_ID MANAGER_PANE <<< "$new_window"
  CODER_PANE="$(tmux split-window -h -c "$WORKDIR" -d -t "$MANAGER_PANE" -P -F '#{pane_id}')"
  ADVISOR_PANE="$(tmux split-window -v -c "$WORKDIR" -d -t "$CODER_PANE" -P -F '#{pane_id}')"
  CURRENT_WINDOW_NAME="$(tmux display-message -p -t "$WINDOW_ID" '#W')"
  WINDOW_SHORT_NAME="${WINDOW_SHORT_NAME:-squad:${RUN_ID:0:15}}"
  RUN_STATUS="running"
  write_state

  # (?!\d) keeps a shorter pane ID (%31) from matching the prefix of a longer
  # one (%319).
  OLD_MANAGER_PANE="$ORIG_MANAGER_PANE" NEW_MANAGER_PANE="$MANAGER_PANE" \
  OLD_CODER_PANE="$ORIG_CODER_PANE" NEW_CODER_PANE="$CODER_PANE" \
  OLD_ADVISOR_PANE="$ORIG_ADVISOR_PANE" NEW_ADVISOR_PANE="$ADVISOR_PANE" \
    perl -0pe '
      s/\Q$ENV{OLD_MANAGER_PANE}\E(?!\d)/$ENV{NEW_MANAGER_PANE}/g if length $ENV{OLD_MANAGER_PANE};
      s/\Q$ENV{OLD_CODER_PANE}\E(?!\d)/$ENV{NEW_CODER_PANE}/g if length $ENV{OLD_CODER_PANE};
      s/\Q$ENV{OLD_ADVISOR_PANE}\E(?!\d)/$ENV{NEW_ADVISOR_PANE}/g if length $ENV{OLD_ADVISOR_PANE};
    ' "$SQUAD_DIR/manager-prompt.md" > "$SQUAD_DIR/manager-resume-prompt.md"

  title="$(cat "$SQUAD_DIR/title.txt")"
  tmux rename-window -t "$WINDOW_ID" "$WINDOW_SHORT_NAME"
  tmux select-pane -t "$MANAGER_PANE" -T "$title"
  tmux select-pane -t "$CODER_PANE" -T "Coder"
  tmux select-pane -t "$ADVISOR_PANE" -T "Advisor"
  tmux set-option -w -t "$WINDOW_ID" pane-border-status top
  tmux set-option -w -t "$WINDOW_ID" pane-border-format " #{pane_title} "
  tmux set-option -w -t "$WINDOW_ID" @squad_run_id "$RUN_ID"
  tmux set-option -w -t "$WINDOW_ID" @squad_state_file "$STATE_FILE"
  tmux send-keys -t "$MANAGER_PANE" "$SQUAD_DIR/run-manager-resume '$WORKDIR' '$SQUAD_DIR/manager-resume-prompt.md' '$MANAGER_SESSION_ID'" Enter
  tmux select-window -t "$WINDOW_ID"
  printf 'Squad resumed: %s\n' "$RUN_ID"
}

[[ $# -gt 0 ]] || usage
case "$1" in
  -h|--help)
    usage 0
    ;;
  list)
    list_runs
    exit 0
    ;;
  close)
    close_run "${2:-}"
    exit 0
    ;;
  rm)
    shift
    [[ $# -gt 0 ]] || {
      echo "Error: squad rm requires at least one run-id (see: squad list)" >&2
      exit 1
    }
    rm_status=0
    for run_id in "$@"; do
      rm_state_file="$SQUAD_RUN_ROOT/$run_id/state.env"
      if [[ ! -f "$rm_state_file" ]]; then
        echo "Error: unknown squad run: $run_id" >&2
        rm_status=1
        continue
      fi
      remove_run "$rm_state_file" || rm_status=1
    done
    exit "$rm_status"
    ;;
  clean)
    clean_runs
    exit 0
    ;;
  resume)
    shift
    resume_session=""
    if [[ "${1:-}" == "--session" ]]; then
      if [[ $# -lt 2 || -z "${2:-}" ]]; then
        echo "Error: --session requires a value" >&2
        exit 1
      fi
      resume_session="$2"
      shift 2
    fi
    resume_run "${1:-}" "$resume_session"
    exit 0
    ;;
esac

TASK="$*"
if [[ "$TASK" =~ ([[:alnum:]_]+-[[:digit:]]+) ]]; then
  TICKET_ID="${BASH_REMATCH[1]}"
  SQUAD_TITLE="$TICKET_ID | チケット内容を確認中"
else
  TICKET_ID=""
  SQUAD_TITLE="チケット内容を確認中"
fi
WAIT_TIMEOUT_SECONDS="${SQUAD_WAIT_TIMEOUT_SECONDS:-7200}"
[[ "$WAIT_TIMEOUT_SECONDS" =~ ^[1-9][0-9]*$ ]] || {
  echo "Error: SQUAD_WAIT_TIMEOUT_SECONDS must be a positive integer." >&2
  exit 1
}
ORIGINAL_WORKDIR="$(pwd)"

if [[ -z "${TMUX:-}" ]]; then
  echo "Error: squad must be run inside tmux" >&2
  exit 1
fi

for cmd in claude codex git jq perl tmux uuidgen; do
  command -v "$cmd" >/dev/null 2>&1 || {
    echo "Error: $cmd is not installed or not in PATH" >&2
    exit 1
  }
done

REPO_ROOT="$(git -C "$ORIGINAL_WORKDIR" rev-parse --show-toplevel 2>/dev/null)" || {
  echo "Error: squad must be run inside a git repository" >&2
  exit 1
}

# git worktree add creates the worktree from HEAD, so a repository without any
# commits (unborn HEAD) cannot get an isolated worktree. In that case fall back
# to running the squad directly in the original repository.
HAS_COMMITS=true
git -C "$REPO_ROOT" rev-parse --verify --quiet HEAD >/dev/null || HAS_COMMITS=false

# --- Setup isolated worktree and artifact directory ---------------------------

RUN_ID="$(date '+%Y%m%d-%H%M%S')-$$"
STARTED_AT="$(date '+%Y-%m-%d %H:%M:%S')"
REPO_NAME="$(basename "$REPO_ROOT")"
COMPOSE_PROJECT_NAME_SAFE="$(
  printf '%s' "$REPO_NAME" |
    tr '[:upper:]' '[:lower:]' |
    sed -E 's/[^a-z0-9_-]+/-/g; s/^-+//; s/-+$//'
)"
COMPOSE_PROJECT_NAME_SAFE="${COMPOSE_PROJECT_NAME_SAFE:-squad}"
SQUAD_DIR="$SQUAD_RUN_ROOT/$RUN_ID"
if [[ "$HAS_COMMITS" == "true" ]]; then
  WORKDIR="$SQUAD_WORKTREE_ROOT/$REPO_NAME-$RUN_ID"
  if [[ -n "$TICKET_ID" ]]; then
    BRANCH="feat/$TICKET_ID"
    if branch_exists "$BRANCH"; then
      BRANCH="feat/$TICKET_ID-$RUN_ID"
    fi
  else
    BRANCH="feat/squad-$RUN_ID"
  fi
else
  # No commits yet: work directly in the original repository on its current
  # (unborn) branch.
  WORKDIR="$REPO_ROOT"
  BRANCH="$(git -C "$REPO_ROOT" symbolic-ref --short -q HEAD || echo main)"
fi
MANAGER_SESSION_ID="$(uuidgen | tr '[:upper:]' '[:lower:]')"
CODER_SESSION_ID="$(uuidgen | tr '[:upper:]' '[:lower:]')"

# If the launch dies before state.env exists (set -e), leave nothing behind:
# no empty run directory and no orphaned worktree/branch. Once state.env is
# written the run is resumable and must be kept.
cleanup_failed_launch() {
  [[ -f "$SQUAD_DIR/state.env" ]] && return 0
  rm -rf "$SQUAD_DIR"
  if [[ "$WORKDIR" != "$REPO_ROOT" && -d "$WORKDIR" ]]; then
    git -C "$REPO_ROOT" worktree remove --force "$WORKDIR" >/dev/null 2>&1 || true
    git -C "$REPO_ROOT" branch -D "$BRANCH" >/dev/null 2>&1 || true
  fi
  return 0
}
trap cleanup_failed_launch EXIT

mkdir -p "$SQUAD_RUN_ROOT" "$SQUAD_WORKTREE_ROOT" "$SQUAD_DIR"

if [[ "$HAS_COMMITS" == "true" && -n "$(git -C "$REPO_ROOT" status --porcelain)" ]]; then
  echo "Note: existing changes remain untouched in the original worktree:"
  git -C "$REPO_ROOT" status --short
  echo ""
fi

if [[ -n "${SQUAD_RUBOCOP_COMMAND:-}" ]]; then
  RUBOCOP_COMMAND="$SQUAD_RUBOCOP_COMMAND"
elif [[ ! -f "$REPO_ROOT/Gemfile" ]]; then
  # Not a Ruby project: run-rubocop sees the empty command and reports the
  # step as skipped instead of failing the squad.
  RUBOCOP_COMMAND=""
elif [[ -f "$REPO_ROOT/compose.yml" ]] && command -v docker >/dev/null 2>&1; then
  RUBOCOP_COMMAND="COMPOSE_PROJECT_NAME=$COMPOSE_PROJECT_NAME_SAFE docker compose run --no-deps --rm --entrypoint '' app bundle exec rubocop --force-exclusion --fail-level W --display-only-fail-level-offenses"
elif [[ -f "$REPO_ROOT/compose.ci.yml" ]] && command -v docker >/dev/null 2>&1; then
  RUBOCOP_COMMAND="COMPOSE_PROJECT_NAME=$COMPOSE_PROJECT_NAME_SAFE docker compose -f compose.ci.yml run --no-deps --rm --entrypoint '' app bundle exec rubocop --force-exclusion --fail-level W --display-only-fail-level-offenses"
elif command -v bundle >/dev/null 2>&1; then
  RUBOCOP_COMMAND="bundle exec rubocop --force-exclusion --fail-level W --display-only-fail-level-offenses"
else
  echo "Error: no RuboCop command could be detected for this Ruby project." >&2
  echo "Set SQUAD_RUBOCOP_COMMAND to the project-specific command." >&2
  exit 1
fi

if [[ "$HAS_COMMITS" == "true" ]]; then
  git -C "$REPO_ROOT" worktree add -b "$BRANCH" "$WORKDIR" HEAD
  if [[ -f "$REPO_ROOT/.env" ]]; then
    cp "$REPO_ROOT/.env" "$WORKDIR/.env"
  fi
else
  echo "Note: this repository has no commits yet, so no isolated worktree is created."
  echo "The squad works directly in: $WORKDIR"
  echo ""
fi

if [[ "$HAS_COMMITS" == "true" ]]; then
  WORKTREE_MODE="isolated worktree"
  WORKTREE_NOTE="All implementation work happens in the isolated squad worktree. Existing changes
in the original worktree must remain untouched. The squad worktree is retained
after completion so that PO can inspect, commit, or merge the result."
else
  WORKTREE_MODE="original repository (no commits yet, no isolated worktree)"
  WORKTREE_NOTE="This repository has no commits yet, so git could not create an isolated
worktree. All work happens DIRECTLY in the original repository: $REPO_ROOT.
There is no isolation from existing files; be careful not to destroy them."
fi

cat > "$SQUAD_DIR/run-info.txt" << INFO
Squad title:       $SQUAD_TITLE
Ticket ID:         ${TICKET_ID:-not detected}
Started at:        $STARTED_AT
Original worktree: $REPO_ROOT
Squad worktree:    $WORKDIR
Worktree mode:     $WORKTREE_MODE
Squad branch:      $BRANCH
Artifacts:         $SQUAD_DIR
Manager session:   $MANAGER_SESSION_ID
Coder session:     $CODER_SESSION_ID
RuboCop command:   ${RUBOCOP_COMMAND:-(none: not a Ruby project, RuboCop step is skipped)}
Wait timeout:      $WAIT_TIMEOUT_SECONDS seconds
INFO

cat "$SQUAD_DIR/run-info.txt"
echo ""
printf '%s\n' "$SQUAD_TITLE" > "$SQUAD_DIR/title.txt"

# --- Create panes -------------------------------------------------------------

MANAGER_PANE="${TMUX_PANE:-$(tmux display-message -p '#{pane_id}')}"
CURRENT_WINDOW_NAME="$(tmux display-message -p -t "$MANAGER_PANE" '#W')"
WINDOW_ID="$(tmux display-message -p -t "$MANAGER_PANE" '#{window_id}')"
WINDOW_SHORT_NAME="squad:${RUN_ID:0:15}"
CODER_PANE=$(tmux split-window -h -c "$WORKDIR" -d -t "$MANAGER_PANE" -P -F '#{pane_id}')
ADVISOR_PANE=$(tmux split-window -v -c "$WORKDIR" -d -t "$CODER_PANE" -P -F '#{pane_id}')

RUN_STATUS="running"
write_state
tmux rename-window -t "$WINDOW_ID" "$WINDOW_SHORT_NAME"
tmux select-pane -t "$MANAGER_PANE" -T "$SQUAD_TITLE"
tmux select-pane -t "$CODER_PANE" -T "Coder"
tmux select-pane -t "$ADVISOR_PANE" -T "Advisor"
tmux set-option -w -t "$WINDOW_ID" pane-border-status top
tmux set-option -w -t "$WINDOW_ID" pane-border-format " #{pane_title} "
tmux set-option -w -t "$WINDOW_ID" @squad_run_id "$RUN_ID"
tmux set-option -w -t "$WINDOW_ID" @squad_state_file "$STATE_FILE"

# --- Dynamic title update -----------------------------------------------------

cat > "$SQUAD_DIR/update-title" <<'HELPER'
#!/usr/bin/env bash
set -euo pipefail
TITLE_FILE="$1"
NEW_TITLE_FILE="$2"
WINDOW_SHORT_NAME="$3"
MANAGER_PANE="$4"
CODER_PANE="$5"
ADVISOR_PANE="$6"

NEW_TITLE="$(
  tr '\n\r\t' '   ' < "$NEW_TITLE_FILE" |
    sed -E \
      -e 's/^[[:space:]]+//' \
      -e 's/[[:space:]]+$//' \
      -e 's/[[:space:]]+/ /g' |
    cut -c 1-90
)"

if [[ -z "$NEW_TITLE" ]]; then
  echo "Error: squad title must not be empty" >&2
  exit 1
fi

printf '%s\n' "$NEW_TITLE" > "$TITLE_FILE"
tmux rename-window -t "$MANAGER_PANE" "$WINDOW_SHORT_NAME"
tmux select-pane -t "$MANAGER_PANE" -T "$NEW_TITLE"
tmux select-pane -t "$CODER_PANE" -T "Coder"
tmux select-pane -t "$ADVISOR_PANE" -T "Advisor"
printf '[%s] Squad title updated: %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$NEW_TITLE"
HELPER
chmod +x "$SQUAD_DIR/update-title"

# --- Manager resume helper ----------------------------------------------------

cat > "$SQUAD_DIR/run-manager-resume" <<'HELPER'
#!/usr/bin/env bash
set -euo pipefail
WORKDIR="$1"
PROMPT_FILE="$2"
SESSION_ID="$3"
GUARD_BIN="$(dirname "$PROMPT_FILE")/manager-guard-bin"

cd "$WORKDIR"
mkdir -p "$GUARD_BIN"
SQUAD_REAL_TMUX="$(command -v tmux)"
export SQUAD_REAL_TMUX
cat > "$GUARD_BIN/tmux" <<'WRAPPER'
#!/usr/bin/env bash
set -euo pipefail
for arg in "$@"; do
  case "$arg" in
    kill-server|kill-session|kill-window|kill-pane)
      printf 'squad: blocked dangerous tmux command: %s\n' "$arg" >&2
      exit 126
      ;;
  esac
done
exec "$SQUAD_REAL_TMUX" "$@"
WRAPPER
chmod +x "$GUARD_BIN/tmux"
export PATH="$GUARD_BIN:$PATH"

printf '[%s] Manager session resuming: %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$SESSION_ID"
CLAUDE_CODE_DISABLE_TERMINAL_TITLE=1 exec claude \
  --dangerously-skip-permissions \
  --allowedTools "Bash Read Glob Grep WebFetch WebSearch" \
  --append-system-prompt "$(cat "$PROMPT_FILE")" \
  --resume "$SESSION_ID"
HELPER
