#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 6 ]]; then
  printf 'Usage: merge-reviews <correctness-result> <correctness-status> <security-result> <security-status> <out-result> <out-status>\n' >&2
  exit 2
fi

CORRECTNESS_RESULT="$1"
CORRECTNESS_STATUS="$2"
SECURITY_RESULT="$3"
SECURITY_STATUS="$4"
OUT_RESULT="$5"
OUT_STATUS="$6"

# Anything other than a clean merge is reported as this status, and as a
# must_fix verdict. A missing or malformed lens result must never be able to
# reach the GUI as a pass.
MERGE_FAILURE_STATUS=65

# Last-resort net: an unexpected failure (a missing jq, a full disk) still
# leaves a non-zero status behind rather than a stale one from the last round.
trap 'rc=$?; trap - EXIT; if [[ "$rc" -ne 0 && ! -s "$OUT_STATUS" ]]; then printf "%s\n" "$rc" > "$OUT_STATUS"; fi; exit "$rc"' EXIT

# Clear both outputs first. If this helper dies before writing them, absent
# files are the honest answer; the previous round's pass is not.
rm -f "$OUT_RESULT" "$OUT_STATUS"

fail() {
  local message="$1"
  printf 'merge-reviews: ERROR: %s\n' "$message" >&2
  printf 'merge-reviews: refusing to emit a pass. Re-run the failed review lens.\n' >&2
  # Still write a schema-conforming result, so a GUI reading review-result.txt
  # sees must_fix and the reason rather than nothing or something stale.
  jq -n --arg message "$message" '
    {
      verdict: "must_fix",
      summary: ("merge-reviews failed: " + $message),
      must_fix: [("[merge-reviews] " + $message)],
      should_fix: [],
      test_gaps: []
    }' > "$OUT_RESULT" 2>/dev/null || printf '\n' > "$OUT_RESULT"
  printf '%s\n' "$MERGE_FAILURE_STATUS" > "$OUT_STATUS"
  exit "$MERGE_FAILURE_STATUS"
}

command -v jq >/dev/null 2>&1 || {
  printf 'merge-reviews: ERROR: jq is required.\n' >&2
  printf '%s\n' "$MERGE_FAILURE_STATUS" > "$OUT_STATUS"
  exit "$MERGE_FAILURE_STATUS"
}

read_status() {
  local lens="$1" file="$2" value
  [[ -s "$file" ]] || fail "the $lens status file is missing or empty: $file"
  value="$(head -n 1 "$file" | tr -d '[:space:]')"
  [[ "$value" =~ ^[0-9]+$ ]] || fail "the $lens status file does not contain an exit code: $file"
  printf '%s\n' "$value"
