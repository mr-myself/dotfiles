#!/usr/bin/env bash
set -euo pipefail

# ==============================================================================
# squad-herdr - AI 3-agent team orchestration via Herdr agents
# ==============================================================================

usage() {
  local status="${1:-1}"
  cat <<'EOF'
Usage: squad-herdr <task>
       squad-herdr list
       squad-herdr close <run-id>
       squad-herdr rm <run-id>...

Create an isolated git worktree and launch 3 AI agents in Herdr:
  Manager (Claude Code) - talks to you
  Coder   (Claude Code) - implements code
  Advisor (Codex)       - plans and reviews

This is a Herdr prototype. Existing tmux-based `squad` remains the stable path.
EOF
  exit "$status"
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" || $# -eq 0 ]]; then
  usage 0
fi

SQUAD_STATE_ROOT="${SQUAD_STATE_ROOT:-${XDG_STATE_HOME:-$HOME/.local/state}/squad-herdr}"
SQUAD_RUN_ROOT="$SQUAD_STATE_ROOT/runs"
SQUAD_WORKTREE_ROOT="${SQUAD_WORKTREE_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}/squad-herdr/worktrees}"
mkdir -p "$SQUAD_RUN_ROOT" "$SQUAD_WORKTREE_ROOT"

load_run() {
  local run_id="$1"
  local state_file="$SQUAD_RUN_ROOT/$run_id/state.env"
  [[ -f "$state_file" ]] || {
    echo "Error: unknown squad-herdr run: $run_id" >&2
    exit 1
  }

  # state.env is generated by squad-herdr itself and contains shell-escaped values.
  source "$state_file"
  STATE_FILE="$state_file"
}

write_state() {
  mkdir -p "$SQUAD_DIR"
  {
    printf 'RUN_ID=%q\n' "$RUN_ID"
    printf 'STARTED_AT=%q\n' "$STARTED_AT"
    printf 'TASK=%q\n' "$TASK"
    printf 'TICKET_ID=%q\n' "$TICKET_ID"
    printf 'REPO_ROOT=%q\n' "$REPO_ROOT"
    printf 'WORKDIR=%q\n' "$WORKDIR"
    printf 'BRANCH=%q\n' "$BRANCH"
    printf 'SQUAD_DIR=%q\n' "$SQUAD_DIR"
    printf 'WORKSPACE_ID=%q\n' "${WORKSPACE_ID:-}"
    printf 'TAB_ID=%q\n' "${TAB_ID:-}"
    printf 'MANAGER_AGENT=%q\n' "$MANAGER_AGENT"
    printf 'CODER_AGENT=%q\n' "$CODER_AGENT"
    printf 'ADVISOR_AGENT=%q\n' "$ADVISOR_AGENT"
    printf 'RUN_STATUS=%q\n' "${RUN_STATUS:-running}"
    printf 'WORKTREE_CREATED=%q\n' "${WORKTREE_CREATED:-false}"
  } > "$SQUAD_DIR/state.env"
  STATE_FILE="$SQUAD_DIR/state.env"
}

branch_exists() {
  local branch_name="$1"
  git -C "$REPO_ROOT" show-ref --verify --quiet "refs/heads/$branch_name" ||
    git -C "$REPO_ROOT" show-ref --verify --quiet "refs/remotes/origin/$branch_name"
}

workspace_exists() {
  local workspace_id="${1:-}"
  [[ -n "$workspace_id" ]] || return 1
  herdr api snapshot |
    jq -e --arg id "$workspace_id" '.result.snapshot.workspaces[]? | select(.workspace_id == $id)' >/dev/null
}

find_workspace_for_workdir() {
  local workdir="$1"
  herdr api snapshot |
    jq -r --arg workdir "$workdir" '
      .result.snapshot.workspaces[]?
      | select(.worktree.checkout_path == $workdir)
      | .workspace_id
    ' |
    head -n 1
}

active_tab_for_workspace() {
  local workspace_id="$1"
  herdr api snapshot |
    jq -r --arg id "$workspace_id" '
      .result.snapshot.workspaces[]?
      | select(.workspace_id == $id)
      | .active_tab_id // empty
    ' |
    head -n 1
}

list_runs() {
  local state_file title status
  printf '%-24s  %-9s  %s\n' "RUN ID" "STATUS" "TITLE"
  find "$SQUAD_RUN_ROOT" -mindepth 2 -maxdepth 2 -name state.env -type f 2>/dev/null |
    sort -r |
    while IFS= read -r state_file; do
      unset RUN_ID RUN_STATUS SQUAD_DIR WORKSPACE_ID
      source "$state_file"
      title="$(cat "$SQUAD_DIR/title.txt" 2>/dev/null || printf 'unknown')"
      status="${RUN_STATUS:-unknown}"
      if workspace_exists "${WORKSPACE_ID:-}"; then
        status="running"
      elif [[ "$status" == "running" ]]; then
        status="closed"
      fi
      printf '%-24s  %-9s  %s\n' "$RUN_ID" "$status" "$title"
    done
}

close_run() {
  local run_id="$1"
  load_run "$run_id"
  RUN_STATUS="closed"
  write_state
  if workspace_exists "${WORKSPACE_ID:-}"; then
    herdr workspace close "$WORKSPACE_ID"
  fi
}

remove_run() {
  local run_id="$1"
  load_run "$run_id"
  if workspace_exists "${WORKSPACE_ID:-}"; then
    echo "Skip $RUN_ID: still running. Close it first: squad-herdr close $RUN_ID" >&2
    return 1
  fi

  if [[ "${WORKTREE_CREATED:-false}" == "true" && -d "$WORKDIR" ]]; then
    git -C "$REPO_ROOT" worktree remove --force "$WORKDIR"
  fi
  if [[ "${WORKTREE_CREATED:-false}" == "true" && -n "${BRANCH:-}" ]]; then
    git -C "$REPO_ROOT" branch -D "$BRANCH" >/dev/null 2>&1 || true
  fi
  rm -rf "$SQUAD_DIR"
}

case "${1:-}" in
  -h|--help|"")
    usage 0
    ;;
  list)
    list_runs
    exit 0
    ;;
  close)
    [[ -n "${2:-}" ]] || {
      echo "Error: squad-herdr close requires a run-id" >&2
      exit 1
    }
    close_run "$2"
    exit 0
    ;;
  rm)
    shift
    [[ $# -gt 0 ]] || {
      echo "Error: squad-herdr rm requires at least one run-id" >&2
      exit 1
    }
    rm_status=0
    for run_id in "$@"; do
      remove_run "$run_id" || rm_status=1
    done
    exit "$rm_status"
    ;;
esac

TASK="$*"
if [[ "$TASK" =~ ([[:alnum:]_]+-[[:digit:]]+) ]]; then
  TICKET_ID="${BASH_REMATCH[1]}"
  SQUAD_TITLE="$TICKET_ID | チケット内容を確認中"
else
  TICKET_ID=""
  SQUAD_TITLE="チケット内容を確認中"
fi
WAIT_TIMEOUT_SECONDS="${SQUAD_WAIT_TIMEOUT_SECONDS:-7200}"
[[ "$WAIT_TIMEOUT_SECONDS" =~ ^[1-9][0-9]*$ ]] || {
  echo "Error: SQUAD_WAIT_TIMEOUT_SECONDS must be a positive integer." >&2
  exit 1
}

for cmd in claude codex git herdr jq uuidgen; do
  command -v "$cmd" >/dev/null 2>&1 || {
    echo "Error: $cmd is not installed or not in PATH" >&2
    exit 1
  }
done

ORIGINAL_WORKDIR="$(pwd)"
REPO_ROOT="$(git -C "$ORIGINAL_WORKDIR" rev-parse --show-toplevel 2>/dev/null)" || {
  echo "Error: squad-herdr must be run inside a git repository" >&2
  exit 1
}

HAS_COMMITS=true
git -C "$REPO_ROOT" rev-parse --verify --quiet HEAD >/dev/null || HAS_COMMITS=false

RUN_ID="$(date '+%Y%m%d-%H%M%S')-$$"
STARTED_AT="$(date '+%Y-%m-%d %H:%M:%S')"
REPO_NAME="$(basename "$REPO_ROOT")"
SQUAD_DIR="$SQUAD_RUN_ROOT/$RUN_ID"
MANAGER_AGENT="Manager-$RUN_ID"
CODER_AGENT="Coder-$RUN_ID"
ADVISOR_AGENT="Advisor-$RUN_ID"
WORKTREE_CREATED=false

if [[ "$HAS_COMMITS" == "true" ]]; then
  WORKDIR="$SQUAD_WORKTREE_ROOT/$REPO_NAME-$RUN_ID"
  if [[ -n "$TICKET_ID" ]]; then
    BRANCH="feat/$TICKET_ID"
    if branch_exists "$BRANCH"; then
      BRANCH="feat/$TICKET_ID-$RUN_ID"
    fi
  else
    BRANCH="feat/squad-herdr-$RUN_ID"
  fi
else
  WORKDIR="$REPO_ROOT"
  BRANCH="$(git -C "$REPO_ROOT" symbolic-ref --short -q HEAD || echo main)"
fi

cleanup_failed_launch() {
  [[ -f "$SQUAD_DIR/state.env" ]] && return 0
  rm -rf "$SQUAD_DIR"
  if [[ "$WORKTREE_CREATED" == "true" && -d "$WORKDIR" ]]; then
    git -C "$REPO_ROOT" worktree remove --force "$WORKDIR" >/dev/null 2>&1 || true
    git -C "$REPO_ROOT" branch -D "$BRANCH" >/dev/null 2>&1 || true
  fi
}
trap cleanup_failed_launch EXIT

mkdir -p "$SQUAD_DIR" "$SQUAD_WORKTREE_ROOT"

if [[ "$HAS_COMMITS" == "true" && -n "$(git -C "$REPO_ROOT" status --porcelain)" ]]; then
  echo "Note: existing changes remain untouched in the original worktree:"
  git -C "$REPO_ROOT" status --short
  echo ""
fi

if [[ "$HAS_COMMITS" == "true" ]]; then
  git -C "$REPO_ROOT" worktree add -b "$BRANCH" "$WORKDIR" HEAD
  WORKTREE_CREATED=true
  if [[ -f "$REPO_ROOT/.env" ]]; then
    cp "$REPO_ROOT/.env" "$WORKDIR/.env"
  fi
  WORKTREE_MODE="isolated worktree"
  WORKTREE_NOTE="All implementation work happens in the isolated squad-herdr worktree. Existing changes
in the original worktree must remain untouched. The worktree is retained after
completion so PO can inspect, commit, or merge the result."
else
  echo "Note: this repository has no commits yet, so no isolated worktree is created."
  echo "The squad-herdr agents work directly in: $WORKDIR"
  echo ""
  WORKTREE_MODE="original repository (no commits yet, no isolated worktree)"
  WORKTREE_NOTE="This repository has no commits yet, so git could not create an isolated
worktree. All work happens DIRECTLY in the original repository: $REPO_ROOT."
fi

cat > "$SQUAD_DIR/run-info.txt" << INFO
Squad title:       $SQUAD_TITLE
Ticket ID:         ${TICKET_ID:-not detected}
Started at:        $STARTED_AT
Original worktree: $REPO_ROOT
Squad worktree:    $WORKDIR
Worktree mode:     $WORKTREE_MODE
Squad branch:      $BRANCH
Artifacts:         $SQUAD_DIR
Manager agent:     $MANAGER_AGENT
Coder agent:       $CODER_AGENT
Advisor agent:     $ADVISOR_AGENT
Wait timeout:      $WAIT_TIMEOUT_SECONDS seconds
INFO

printf '%s\n' "$SQUAD_TITLE" > "$SQUAD_DIR/title.txt"

cat > "$SQUAD_DIR/update-title" <<'HELPER'
#!/usr/bin/env bash
set -euo pipefail
TITLE_FILE="$1"
NEW_TITLE_FILE="$2"
WORKSPACE_ID="$3"
TAB_ID="$4"

NEW_TITLE="$(
  tr '\n\r\t' '   ' < "$NEW_TITLE_FILE" |
    sed -E \
      -e 's/^[[:space:]]+//' \
      -e 's/[[:space:]]+$//' \
      -e 's/[[:space:]]+/ /g' |
    cut -c 1-90
)"

if [[ -z "$NEW_TITLE" ]]; then
  echo "Error: squad title must not be empty" >&2
  exit 1
fi

printf '%s\n' "$NEW_TITLE" > "$TITLE_FILE"
herdr workspace rename "$WORKSPACE_ID" "$NEW_TITLE"
herdr tab rename "$TAB_ID" "$NEW_TITLE"
printf '[%s] Squad title updated: %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$NEW_TITLE"
HELPER
chmod +x "$SQUAD_DIR/update-title"

cat > "$SQUAD_DIR/plan-schema.json" <<'SCHEMA'
{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "summary": { "type": "string" },
    "scope": { "type": "array", "items": { "type": "string" } },
    "acceptance_criteria": { "type": "array", "items": { "type": "string" } },
    "files_to_inspect": { "type": "array", "items": { "type": "string" } },
    "implementation_steps": { "type": "array", "items": { "type": "string" } },
    "tests": { "type": "array", "items": { "type": "string" } },
    "risks": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["summary", "scope", "acceptance_criteria", "files_to_inspect", "implementation_steps", "tests", "risks"]
}
SCHEMA

cat > "$SQUAD_DIR/coder-schema.json" <<'SCHEMA'
{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "summary": { "type": "string" },
    "changed_files": { "type": "array", "items": { "type": "string" } },
    "tests_run": { "type": "array", "items": { "type": "string" } },
    "tests_not_run": { "type": "array", "items": { "type": "string" } },
    "test_status": { "type": "string", "enum": ["pass", "fail", "blocked"] },
    "remaining_issues": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["summary", "changed_files", "tests_run", "tests_not_run", "test_status", "remaining_issues"]
}
SCHEMA

cat > "$SQUAD_DIR/review-schema.json" <<'SCHEMA'
{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "verdict": { "type": "string", "enum": ["pass", "must_fix"] },
    "summary": { "type": "string" },
    "must_fix": { "type": "array", "items": { "type": "string" } },
    "should_fix": { "type": "array", "items": { "type": "string" } },
    "test_gaps": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["verdict", "summary", "must_fix", "should_fix", "test_gaps"]
}
SCHEMA

cat "$SQUAD_DIR/run-info.txt"
echo ""

if [[ "$HAS_COMMITS" == "true" ]]; then
  herdr worktree open --cwd "$REPO_ROOT" --path "$WORKDIR" --label "$SQUAD_TITLE" --focus --json >/dev/null
  WORKSPACE_ID="$(find_workspace_for_workdir "$WORKDIR")"
else
  herdr workspace create --cwd "$WORKDIR" --label "$SQUAD_TITLE" --focus >/dev/null
  WORKSPACE_ID="$(
    herdr api snapshot |
      jq -r --arg label "$SQUAD_TITLE" '
        .result.snapshot.workspaces[]?
        | select(.label == $label)
        | .workspace_id
      ' |
      tail -n 1
  )"
fi

[[ -n "${WORKSPACE_ID:-}" ]] || {
  echo "Error: failed to determine Herdr workspace ID" >&2
  exit 1
}
TAB_ID="$(active_tab_for_workspace "$WORKSPACE_ID")"
[[ -n "${TAB_ID:-}" ]] || {
  echo "Error: failed to determine Herdr active tab ID" >&2
  exit 1
}

cat > "$SQUAD_DIR/manager-prompt.md" << PROMPT
# You are a Development Manager

You coordinate a Coder and an Advisor as Herdr agents.
You do NOT write code yourself.
Speak Japanese to PO (user). Write English for agents.

## Environment

- Original worktree: $REPO_ROOT
- Squad worktree: $WORKDIR
- Worktree mode: $WORKTREE_MODE
- Squad branch: $BRANCH
- Initial squad title: $SQUAD_TITLE
- Detected ticket ID: ${TICKET_ID:-not detected}
- Artifacts: $SQUAD_DIR
- Herdr workspace ID: $WORKSPACE_ID
- Herdr tab ID: $TAB_ID
- Manager agent: $MANAGER_AGENT
- Coder agent: $CODER_AGENT
- Advisor agent: $ADVISOR_AGENT
- Wait timeout: $WAIT_TIMEOUT_SECONDS seconds

$WORKTREE_NOTE
Agents must not create additional worktrees. In particular, do not create
worktrees under the repository such as .claude/worktree or .claude/worktrees.

## Critical rules

- BEFORE asking Advisor to plan, inspect the ticket URL or task context and
  replace the provisional squad title with a specific title.
- NEVER run codex or claude commands directly. ALL work MUST go through
  \`herdr agent send\` to the Coder and Advisor agents.
- NEVER skip the Advisor planning step.
- ALWAYS follow the full workflow in order.
- The PO must be able to see agent work in Herdr.
- Use \`herdr agent wait\` to wait for completion. If Herdr cannot detect a
  status transition for an agent, report that blocker to PO instead of polling forever.
- The Coder MUST run relevant automated tests for the task. If tests cannot run,
  report the exact blocker to PO and do not claim completion.
- NEVER commit, push, force-push, merge, rebase, or create a pull request unless
  PO explicitly asks for that Git operation. Editing files is allowed.

## Commands

### Update the squad title after reading the ticket

Read the ticket URL or task context first. Write a concise, specific Japanese
title to $SQUAD_DIR/new-title.txt. Include the detected ticket ID
(${TICKET_ID:-none}) when available. Then run:

  cat > '$SQUAD_DIR/new-title.txt' <<'EOF'
  (specific title)
  EOF
  '$SQUAD_DIR/update-title' '$SQUAD_DIR/title.txt' '$SQUAD_DIR/new-title.txt' '$WORKSPACE_ID' '$TAB_ID'

### Ask Advisor for an implementation plan

Write an English request to $SQUAD_DIR/advisor-task.txt. Ask Advisor to inspect
the repository, produce a scoped implementation plan, define acceptance criteria,
identify relevant tests, and call out risks. Then run:

  herdr agent send '$ADVISOR_AGENT' "\$(cat '$SQUAD_DIR/advisor-task.txt')"
  herdr agent wait '$ADVISOR_AGENT' --status working --timeout 30000 || true
  herdr agent wait '$ADVISOR_AGENT' --status idle --timeout $((WAIT_TIMEOUT_SECONDS * 1000))
  herdr agent read '$ADVISOR_AGENT' --source recent --lines 200 > '$SQUAD_DIR/advisor-result.txt'
  cat '$SQUAD_DIR/advisor-result.txt'

### Ask Coder to implement

Write an English request to $SQUAD_DIR/coder-task.txt. Include the approved plan
and acceptance criteria. Require Coder to inspect project rules, implement the
change, run relevant automated tests, and return the verification report. Then run:

  herdr agent send '$CODER_AGENT' "\$(cat '$SQUAD_DIR/coder-task.txt')"
  herdr agent wait '$CODER_AGENT' --status working --timeout 30000 || true
  herdr agent wait '$CODER_AGENT' --status idle --timeout $((WAIT_TIMEOUT_SECONDS * 1000))
  herdr agent read '$CODER_AGENT' --source recent --lines 300 > '$SQUAD_DIR/coder-result.txt'
  cat '$SQUAD_DIR/coder-result.txt'

### Ask Advisor to review

Write an English request to $SQUAD_DIR/review-task.txt. Tell Advisor to inspect
all uncommitted changes, verify behavior against the approved acceptance criteria,
and check the Coder's test report. Then run:

  herdr agent send '$ADVISOR_AGENT' "\$(cat '$SQUAD_DIR/review-task.txt')"
  herdr agent wait '$ADVISOR_AGENT' --status working --timeout 30000 || true
  herdr agent wait '$ADVISOR_AGENT' --status idle --timeout $((WAIT_TIMEOUT_SECONDS * 1000))
  herdr agent read '$ADVISOR_AGENT' --source recent --lines 300 > '$SQUAD_DIR/review-result.txt'
  cat '$SQUAD_DIR/review-result.txt'

### Ask Coder to fix review findings

Write an English request to $SQUAD_DIR/coder-task.txt. Include all must-fix
findings and require updated tests. Then run:

  herdr agent send '$CODER_AGENT' "\$(cat '$SQUAD_DIR/coder-task.txt')"
  herdr agent wait '$CODER_AGENT' --status working --timeout 30000 || true
  herdr agent wait '$CODER_AGENT' --status idle --timeout $((WAIT_TIMEOUT_SECONDS * 1000))
  herdr agent read '$CODER_AGENT' --source recent --lines 300 > '$SQUAD_DIR/coder-result.txt'
  cat '$SQUAD_DIR/coder-result.txt'

## Workflow

1. Inspect the linked ticket or task context and update the provisional title.
2. Ask Advisor for a structured implementation plan.
3. Show the plan to PO in Japanese and ask for approval.
4. Ask Coder to implement the approved plan.
5. Read Coder verification report.
6. Ask Advisor to review the uncommitted changes and verification evidence.
7. If review verdict is must_fix, ask Coder to fix the issues.
8. After every fix, repeat from step 5.
9. Report completion to PO in Japanese. Include the squad worktree path, branch,
   and test commands and results.
PROMPT

RUN_STATUS="running"
write_state

herdr agent start "$MANAGER_AGENT" --cwd "$WORKDIR" --workspace "$WORKSPACE_ID" --tab "$TAB_ID" --no-focus -- \
  bash -lc 'sleep 3; exec "$@"' bash \
  claude --dangerously-skip-permissions \
  --allowedTools "Bash Read Glob Grep WebFetch WebSearch" \
  --append-system-prompt "$(cat "$SQUAD_DIR/manager-prompt.md")" \
  "$TASK"

herdr agent start "$CODER_AGENT" --cwd "$WORKDIR" --workspace "$WORKSPACE_ID" --tab "$TAB_ID" --split right --no-focus -- \
  claude --dangerously-skip-permissions

herdr agent start "$ADVISOR_AGENT" --cwd "$WORKDIR" --workspace "$WORKSPACE_ID" --tab "$TAB_ID" --split down --focus -- \
  codex

herdr agent focus "$MANAGER_AGENT" || true

printf 'Squad-herdr started: %s\n' "$RUN_ID"
printf 'Workspace: %s\n' "$WORKSPACE_ID"
printf 'Tab:       %s\n' "$TAB_ID"
printf 'Worktree:  %s\n' "$WORKDIR"
printf 'Artifacts: %s\n' "$SQUAD_DIR"
