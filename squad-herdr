  printf '%s\n' "${RUBOCOP_FILES[@]}"
} > "$RESULT_FILE"
log ">>> RuboCop target files:"
printf '%s\n' "${RUBOCOP_FILES[@]}" |
  while IFS= read -r line; do log "  $line"; done

AUTOCORRECT_LOG="${RESULT_FILE%.txt}.autocorrect.log"
log ">>> RuboCop autocorrect starting..."
{
  printf '\nRuboCop autocorrect (-a):\n'
  set +e
  bash -lc "$BASE_COMMAND -a --cache true \"\$@\"" bash "${RUBOCOP_FILES[@]}"
  autocorrect_status=$?
  set -e
  printf 'RuboCop autocorrect exit status: %s\n' "$autocorrect_status"
} > "$AUTOCORRECT_LOG" 2>&1
cat "$AUTOCORRECT_LOG" >> "$RESULT_FILE"
while IFS= read -r line; do log "$line"; done < "$AUTOCORRECT_LOG"

log ">>> RuboCop verification starting..."
bash -lc "$BASE_COMMAND --cache true \"\$@\"" bash "${RUBOCOP_FILES[@]}" 2>&1 |
  tee -a "$RESULT_FILE" |
  while IFS= read -r line; do log "$line"; done
log ">>> RuboCop autocorrect and verification finished for changed Rails/Ruby files."
HELPER
  chmod +x "$SQUAD_DIR/run-rubocop"

  # Brakeman gate. A GATE, not a review lens: it never feeds merge-reviews.
  # WHOLE-APPLICATION scan, because Brakeman is a dataflow analyser and a
  # warning routinely surfaces in code the change never touched.
  cat > "$SQUAD_DIR/run-brakeman" <<'HELPER'
#!/usr/bin/env bash
set -euo pipefail
COMMAND_FILE="$1"
RESULT_FILE="$2"
STATUS_FILE="$3"

JSON_REPORT="${RESULT_FILE%.txt}.json"
CONSOLE_LOG="${RESULT_FILE%.txt}.console.log"
# RELATIVE on purpose: under the docker-compose branch the scan runs inside the
# container, where $SQUAD_DIR is not mounted but the app directory is. Moved
# into $SQUAD_DIR and deleted from the worktree before this helper exits, so it
# never shows up as an uncommitted change in the review that follows.
REPORT_BASENAME=".squad-brakeman-report.json"

log() {
  printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"
}

finish() {
  rc=$?
  trap - EXIT
  rm -f "$REPORT_BASENAME"
  printf '%s\n' "$rc" > "$STATUS_FILE"
  log ">>> Brakeman exited with status $rc."
  exit "$rc"
}
trap finish EXIT

rm -f "$STATUS_FILE"

log ">>> Brakeman starting..."

skip() {
  {
    log ">>> Brakeman skipped: $1"
    printf 'Brakeman skipped: %s\n' "$1"
  } | tee "$RESULT_FILE"
  exit 0
}

fail() {
  {
    log ">>> Brakeman FAILED: $1"
    printf 'Brakeman failed: %s\n' "$1"
  } | tee -a "$RESULT_FILE"
  exit "${2:-1}"
}

BASE_COMMAND="$(cat "$COMMAND_FILE")"
if [[ -z "$BASE_COMMAND" ]]; then
  skip "no Brakeman command configured (not a Ruby project, or Brakeman is not installed)."
fi

# Proof that BRAKEMAN ITSELF is absent - not that something else went wrong.
#
# Every pattern must NAME brakeman on the SAME LINE as an "this executable does
# not exist" phrase. That pairing is the entire point. A bare "Could not find
# ..." naming some other gem means the BUNDLE is broken, and a broken toolchain
# has to FAIL this gate, not quietly switch it off.
#
# When a failure cannot be classified, it is a FAILURE. The asymmetry is not
# close: a false failure costs one confused round and is immediately visible,
# while a false skip hides every security warning in the change set and still
# reports green.
#
# Deliberately NOT treated as proof of absence:
#   * "Could not find <gem>-<version> in locally installed gems", even when the
#     gem named IS brakeman. Detection already ran brakeman successfully at
#     launch, so that message means the environment regressed afterwards - and a
#     project that declares brakeman must not have its security gate disabled by
#     a stale bundle.
#   * Any docker daemon or container error.
#   * Any unrecognised output.
#
# KEEP IDENTICAL to squad's copy: the duplication is a deferred-dedupe decision,
# not licence for the two gates to drift.
brakeman_absent() {
  printf '%s' "$1" | grep -qiE \
    -e 'command not found:[[:space:]]*brakeman' \
    -e 'brakeman:[[:space:]]*command not found' \
    -e 'cannot load such file --[[:space:]]*brakeman' \
    -e 'brakeman.*no such file or directory' \
    -e 'no such file or directory.*brakeman'
}

log ">>> Verifying Brakeman is runnable: $BASE_COMMAND --version"
set +e
VERSION_OUTPUT="$(bash -lc "$BASE_COMMAND --version" 2>&1)"
VERSION_STATUS=$?
set -e
if [[ "$VERSION_STATUS" -ne 0 ]]; then
  printf '%s\n' "$VERSION_OUTPUT" | while IFS= read -r line; do log "  $line"; done
  if brakeman_absent "$VERSION_OUTPUT"; then
    skip "Brakeman itself is not installed for this project (probe exit $VERSION_STATUS)."
  fi
  {
    printf 'Brakeman probe command: %s --version\n' "$BASE_COMMAND"
    printf 'Brakeman probe exit status: %s\n' "$VERSION_STATUS"
    printf '%s\n' "$VERSION_OUTPUT"
  } > "$RESULT_FILE"
  fail "the Brakeman probe failed for a reason that does NOT prove Brakeman is absent - a broken bundle, a docker or runtime failure, or an unrecognised error (see $RESULT_FILE). This is NOT treated as a skip." "$VERSION_STATUS"
fi
log ">>> Brakeman version: $(printf '%s' "$VERSION_OUTPUT" | head -n 1)"

rm -f "$REPORT_BASENAME" "$JSON_REPORT"

log ">>> Brakeman scanning the whole application..."
set +e
bash -lc "$BASE_COMMAND -q --no-pager --exit-on-warn -o \"\$1\" ." bash "$REPORT_BASENAME" \
  > "$CONSOLE_LOG" 2>&1
SCAN_STATUS=$?
set -e
while IFS= read -r line; do log "$line"; done < "$CONSOLE_LOG"

if [[ -f "$REPORT_BASENAME" ]]; then
  mv "$REPORT_BASENAME" "$JSON_REPORT"
fi

{
  printf 'Brakeman command: %s\n' "$BASE_COMMAND"
  printf 'Brakeman exit status: %s\n' "$SCAN_STATUS"
  printf '\nBrakeman console output:\n'
  cat "$CONSOLE_LOG"
} > "$RESULT_FILE"

# Summarised BEFORE the pass/fail decision: the failing path is exactly where
# the warning list matters, since it is what the Manager quotes to the Coder.
WARNING_COUNT=""
ERROR_COUNT=""
REPORT_USABLE=false
if [[ -s "$JSON_REPORT" ]] && command -v jq >/dev/null 2>&1; then
  if jq -e 'type == "object" and (.warnings | type == "array")' "$JSON_REPORT" >/dev/null 2>&1; then
    REPORT_USABLE=true
    WARNING_COUNT="$(jq -r '.warnings | length' "$JSON_REPORT")"
    ERROR_COUNT="$(jq -r '(.errors // []) | length' "$JSON_REPORT")"
    {
      printf '\nBrakeman summary: %s warnings, %s scan errors.\n' "$WARNING_COUNT" "$ERROR_COUNT"
      if [[ "$WARNING_COUNT" -gt 0 ]]; then
        jq -r '.warnings[] | "- [\(.confidence // "?")] \(.warning_type // "?"): \(.message // "") (\(.file // "?"):\(.line // "?"))"' \
          "$JSON_REPORT"
      fi
    } >> "$RESULT_FILE"
    log ">>> Brakeman summary: $WARNING_COUNT warnings, $ERROR_COUNT scan errors."
  fi
fi

if [[ "$SCAN_STATUS" -eq 4 ]]; then
  if grep -qiE 'please supply the path to a rails application|no rails application|not a rails application' \
    "$CONSOLE_LOG"; then
    skip "no Rails application was detected in this repository (Brakeman exit 4)."
  fi
  fail "Brakeman exited 4 but did not report a missing Rails application, so this is not a skip." "$SCAN_STATUS"
fi

if [[ "$SCAN_STATUS" -ne 0 ]]; then
  fail "Brakeman exited $SCAN_STATUS. With --exit-on-warn this means warnings were found, or the scan itself errored. Read $RESULT_FILE and $JSON_REPORT." "$SCAN_STATUS"
fi

if [[ ! -s "$JSON_REPORT" ]]; then
  fail "Brakeman exited 0 but wrote no JSON report to $JSON_REPORT, so the scan cannot be confirmed." 1
fi

if command -v jq >/dev/null 2>&1; then
  if [[ "$REPORT_USABLE" != "true" ]]; then
    fail "the Brakeman JSON report at $JSON_REPORT is malformed or has no warnings array." 1
  fi
  if [[ "$WARNING_COUNT" -gt 0 ]]; then
    fail "Brakeman exited 0 but the report contains $WARNING_COUNT warnings." 1
  fi
  if [[ "$ERROR_COUNT" -gt 0 ]]; then
    fail "Brakeman reported $ERROR_COUNT scan errors, so the scan is not trustworthy." 1
  fi
else
  printf '\n(jq is unavailable, so no summary was extracted from %s)\n' "$JSON_REPORT" >> "$RESULT_FILE"
fi

log ">>> Brakeman passed with 0 warnings (whole-application scan)."
HELPER
  chmod +x "$SQUAD_DIR/run-brakeman"
}

# --- Resume -------------------------------------------------------------------
# Restart a run's agents and regenerate every generated artifact from THIS
# version of the script, so a run created by an older squad-herdr is migrated
# the moment it is resumed.
#
# NO PANE ID IS INVOLVED, at any point. Agents are created by NAME
# (`herdr agent start <name>`) and resolved by name through squad-agent, and the
# names are in state.env, so a resume can ask "does this role resolve?" and
# either reuse the live agent or start a new one under the same name. The
# workspace is rediscovered from the worktree checkout path rather than trusted
# from state.env, and the Coder's claude session UUID is persisted, so the
# Coder resumes its exact conversation.
resume_run() {
  local run_id="${1:-}"
  [[ -n "$run_id" ]] || {
    echo "Error: squad-herdr resume requires a run-id (see: squad-herdr list)" >&2
    exit 1
  }

  # Environment validation BEFORE anything is created or restarted.
  require_readable_checklist_config

  load_run "$run_id"

  [[ -d "$WORKDIR" ]] || {
    echo "Error: squad-herdr worktree no longer exists: $WORKDIR" >&2
    exit 1
  }

  # The workspace is authoritative from the CHECKOUT PATH, not from state.env:
  # the PO may have closed and reopened it, which changes the ID.
  local workspace tab
  workspace="$(find_workspace_for_workdir "$WORKDIR")"
  if [[ -z "$workspace" ]]; then
    if [[ "$WORKTREE_CREATED" == "true" ]]; then
      herdr worktree open --cwd "$REPO_ROOT" --path "$WORKDIR" --label "$(cat "$SQUAD_DIR/title.txt" 2>/dev/null || printf 'squad-herdr')" --focus --json >/dev/null
    else
      herdr workspace create --cwd "$WORKDIR" --label "$(cat "$SQUAD_DIR/title.txt" 2>/dev/null || printf 'squad-herdr')" --focus >/dev/null
    fi
    workspace="$(find_workspace_for_workdir "$WORKDIR")"
  fi
  [[ -n "$workspace" ]] || {
    echo "Error: failed to determine a Herdr workspace for $WORKDIR" >&2
    exit 1
  }
  WORKSPACE_ID="$workspace"

  tab="$(active_tab_for_workspace "$WORKSPACE_ID")"
  [[ -n "$tab" ]] || {
    echo "Error: failed to determine the active Herdr tab for workspace $WORKSPACE_ID" >&2
    exit 1
  }
  TAB_ID="$tab"

  SQUAD_TITLE="$(cat "$SQUAD_DIR/title.txt" 2>/dev/null || printf 'squad-herdr')"
  set_worktree_mode
  RUN_STATUS="running"
  write_state

  # Regenerated from the CURRENT script, in the same order as a launch.
  printf '%s\n' "${RUBOCOP_COMMAND:-}" > "$SQUAD_DIR/rubocop-command.txt"
  printf '%s\n' "${BRAKEMAN_COMMAND:-}" > "$SQUAD_DIR/brakeman-command.txt"
  generate_schemas
  generate_review_checklist
  generate_helper_scripts
  generate_manager_prompt
  generate_resume_prompt

  # Per role: reuse the agent if it still resolves, otherwise start a NEW one
  # under the SAME name. Starting a duplicate while the old one is alive would
  # make squad-agent refuse to guess between two identically named agents and
  # break every later dispatch, so the resolve check is not optional.
  local role agent_name split
  for role in manager coder advisor; do
    case "$role" in
      manager) agent_name="$MANAGER_AGENT"; split="" ;;
      coder) agent_name="$CODER_AGENT"; split="right" ;;
      advisor) agent_name="$ADVISOR_AGENT"; split="down" ;;
    esac
    if "$SQUAD_DIR/squad-agent" "$role" >/dev/null 2>&1; then
      printf 'Reusing live agent for %s (%s)\n' "$role" "$agent_name"
      continue
    fi
    printf 'Restarting agent for %s (%s)\n' "$role" "$agent_name"
    if [[ -n "$split" ]]; then
      herdr agent start "$agent_name" --cwd "$WORKDIR" --workspace "$WORKSPACE_ID" --tab "$TAB_ID" --split "$split" --no-focus -- \
        bash -l
    else
      herdr agent start "$agent_name" --cwd "$WORKDIR" --workspace "$WORKSPACE_ID" --tab "$TAB_ID" --no-focus -- \
        bash -l
    fi
  done

  local resume_ready_timeout=20 waited unresolved=""
  for role in manager coder advisor; do
    waited=0
    until "$SQUAD_DIR/squad-agent" "$role" >/dev/null 2>&1; do
      if ((waited >= resume_ready_timeout)); then
        unresolved="$unresolved $role"
        break
      fi
      sleep 1
      waited=$((waited + 1))
    done
  done
  if [[ -n "$unresolved" ]]; then
    echo "Error: these squad roles are not addressable after the resume:$unresolved" >&2
    echo "The agents that DID start were left running and untouched." >&2
    echo "To tear the run down: squad-herdr close $RUN_ID" >&2
    exit 1
  fi

  # The Manager keeps its own transcript only if the PO kept the pane; a resumed
  # Manager is a fresh claude either way, so it gets the resume prompt.
  rm -f "$SQUAD_DIR/manager-started.txt"
  local dispatch
  printf -v dispatch '%q %q %q %q %q' \
    "$SQUAD_DIR/run-manager" \
    "$WORKDIR" \
    "$SQUAD_DIR/manager-resume-prompt.md" \
    "$SQUAD_DIR/manager-task.txt" \
    "$SQUAD_DIR/manager-started.txt"
  "$SQUAD_DIR/send-to" manager "$dispatch"

  herdr agent focus "$MANAGER_AGENT" || true
  printf 'Squad-herdr resumed: %s\n' "$RUN_ID"
  printf 'Workspace: %s\n' "$WORKSPACE_ID"
  printf 'Tab:       %s\n' "$TAB_ID"
  printf 'Worktree:  %s\n' "$WORKDIR"
  printf 'Artifacts: %s\n' "$SQUAD_DIR"
}

# --- Manager system prompt ----------------------------------------------------
# A function so `resume` regenerates it verbatim from the CURRENT script.
# Contains NO herdr pane ID: every agent is addressed by role.
generate_manager_prompt() {
cat > "$SQUAD_DIR/manager-prompt.md" << PROMPT
# You are a Development Manager

You coordinate a Coder and an Advisor as Herdr agents.
You do NOT write code yourself.
Speak Japanese to PO (user). Write English for agents.

## Environment

- Original worktree: $REPO_ROOT
- Squad worktree: $WORKDIR
- Worktree mode: $WORKTREE_MODE
- Squad branch: $BRANCH
- Initial squad title: $SQUAD_TITLE
- Detected ticket ID: ${TICKET_ID:-not detected}
- Artifacts: $SQUAD_DIR
- Herdr workspace ID: $WORKSPACE_ID
- Herdr tab ID: $TAB_ID
- Manager agent: $MANAGER_AGENT
- Coder agent: $CODER_AGENT
- Advisor agent: $ADVISOR_AGENT
- Coder session ID: $CODER_SESSION_ID
- Wait timeout: $WAIT_TIMEOUT_SECONDS seconds

$WORKTREE_NOTE
Agents must not create additional worktrees. In particular, do not create
worktrees under the repository such as .claude/worktree or .claude/worktrees.

## Agent addressing (roles, never pane IDs)

The Coder and Advisor panes run plain login shells. You give them work by
running a generated runner script inside their pane, and the runner drives
claude or codex non-interactively with an enforced output schema.

Herdr assigns pane IDs dynamically, so a pane ID is NEVER a stable address.
Address agents by role only. The roles are exactly: manager, coder, advisor.

  '$SQUAD_DIR/squad-agent' <role>                    # prints the live pane ID
  '$SQUAD_DIR/send-to' [--status-file <path>] <role> '<command>'

squad-agent maps the role to this run's stable herdr agent name and resolves it
to a pane, first through \`herdr api snapshot\` (requiring exactly one match)
and then through \`herdr agent get\`. send-to and run-wait both address agents
through it, so if squad-agent cannot resolve a role, neither can they. On
failure send-to sends nothing and exits non-zero.

- NEVER run \`herdr pane run\`, \`herdr pane send-text\`, or \`herdr pane send-keys\`
  yourself, and never write a literal herdr pane ID (such as w1:p2) in any command.
- \`herdr agent send\` is for natural-language interactive fallback ONLY, when a
  runner is wedged and PO asks you to poke the pane by hand. It is never part of
  the normal workflow, because it produces no status file and no schema-checked
  result.
- If a helper reports that a role cannot be resolved, report that to PO and stop.
  Do not guess a pane ID.

## Critical rules

- BEFORE asking Advisor to plan, inspect the ticket URL or task context and
  replace the provisional squad title with a specific title.
- A squad title MUST include the ticket ID when one exists, the business object
  or feature area, and the concrete change. Avoid vague titles such as
  "CSV import", "API fix", or "bug fix". For example:
  "EAR-123 | 車両マスタCSVインポートの重複検証追加".
- NEVER run codex or claude commands directly. ALL work MUST go through the
  send-to helper so that it lands in the agent panes.
- NEVER skip the Advisor planning step.
- ALWAYS follow the full workflow in order.
- The PO must be able to see agent work in the Herdr panes.
- Use the run-wait helper to wait for completion. NEVER poll with
  \`herdr pane read\` or \`herdr agent read\`.
- NEVER run any herdr teardown command: \`herdr workspace close\`,
  \`herdr tab close\`, \`herdr pane close\`, \`herdr session stop\`,
  \`herdr session delete\`, \`herdr server stop\`, \`herdr server live-handoff\`,
  \`herdr worktree remove\`, \`herdr config reset-keys\`, or
  \`herdr integration uninstall\`. Never run \`herdr agent rename\` or
  \`herdr pane release-agent\` either: they clear the agent names send-to and
  run-wait resolve through, which breaks the whole squad silently.
  Do not ask Coder or Advisor to run any of them either. This
  includes test cleanup: if a temporary herdr workspace or pane is created for
  testing, leave it running and report the cleanup command to PO instead of
  executing it.
- The Coder MUST run relevant automated tests for the task. If tests cannot run,
  report the exact blocker to PO and do not claim completion.
- After each Coder run, ALWAYS run the RuboCop helper and require exit status 0.
  It checks only the changed Rails/Ruby files, and skips with 0 when the project
  is not a Ruby project.
- After RuboCop and BEFORE the review lenses, ALWAYS run the Brakeman helper and
  require exit status 0. It scans the WHOLE application, not the changed files,
  because Brakeman is a dataflow scanner and a warning often surfaces in code
  this change never touched. It skips with 0 when the project has no Brakeman,
  so a non-zero status always means a real finding or a real failure.
- Brakeman is a GATE, not a third review lens. Never pass its files to
  merge-reviews and never treat it as a review verdict.
- RuboCop and Brakeman success are required independently of the Coder's report.
- The review is TWO INDEPENDENT LENSES: correctness first, then security. NEVER
  include, quote, summarize, or point at the correctness result in the security
  task text, and never the other way round. A lens that is told what the other
  found stops looking for what the other missed, which is the entire reason
  there are two of them.
- ALWAYS run BOTH lenses in every review round, even when the first returns
  must_fix. The only exception is a helper failure so severe that the diff
  cannot be reviewed at all; report that to PO instead of guessing.
- After BOTH lenses finish, ALWAYS run merge-reviews. Your own decisions still
  come from the two lens files.
- NEVER commit, push, force-push, merge, rebase, or create a pull request unless
  PO explicitly asks for that Git operation. Editing files is allowed.
- NEVER create additional git worktrees, including Claude Code default locations
  such as .claude/worktree or .claude/worktrees. Use only the isolated squad
  worktree: $WORKDIR.

## Status handling

Every runner writes its exit code to its status file from an EXIT trap, so a
status file is written on every exit path. run-wait treats that file as the
single source of truth and blocks until it appears.

After every run-wait command, read the status file. If it is not 0, read the
corresponding result file if present, report the failure to PO, and decide
whether the Coder can fix it. Never wait indefinitely after a helper failure.

run-wait writes 125 into the status file when the herdr agent for that role no
longer exists, and 124 when the $WAIT_TIMEOUT_SECONDS second timeout expires.
run-wait itself always exits 0 except on an invalid role, so judge the outcome
by the status file content, never by run-wait's exit status.

A send-to that fails to launch also records its own non-zero exit code in the
status file, so a failed launch can never be mistaken for a completed run. If
send-to exits non-zero, report that to PO and do NOT run the matching run-wait
expecting work to have started.

## Commands

### Update the squad title after reading the ticket

Read the ticket URL or task context first. Write a concise, specific Japanese
title to $SQUAD_DIR/new-title.txt. Include the detected ticket ID
(${TICKET_ID:-none}) when available. Distinguish this squad from parallel work
on similar features by naming the business object and concrete change. Then run:

  cat > '$SQUAD_DIR/new-title.txt' <<'EOF'
  (specific title, for example: EAR-123 | 車両マスタCSVインポートの重複検証追加)
  EOF
  '$SQUAD_DIR/update-title' '$SQUAD_DIR/title.txt' '$SQUAD_DIR/new-title.txt' '$WORKSPACE_ID' '$TAB_ID'

### Ask Advisor for an implementation plan

Write an English request to $SQUAD_DIR/advisor-task.txt. Ask Advisor to inspect
the repository, produce a scoped implementation plan, define acceptance criteria,
identify relevant tests, and call out risks. Then run:

  '$SQUAD_DIR/send-to' --status-file '$SQUAD_DIR/advisor-status.txt' advisor '$SQUAD_DIR/run-advisor $SQUAD_DIR/advisor-task.txt $SQUAD_DIR/advisor-result.json $SQUAD_DIR/advisor-status.txt $SQUAD_DIR/plan-schema.json'
  '$SQUAD_DIR/run-wait' '$SQUAD_DIR/advisor-status.txt' advisor '$WAIT_TIMEOUT_SECONDS' 'Advisor planning'
  cat '$SQUAD_DIR/advisor-status.txt'
  cat '$SQUAD_DIR/advisor-result.json'

### Ask Coder to implement

Write an English request to $SQUAD_DIR/coder-task.txt. Include the approved plan
and acceptance criteria. Require Coder to inspect project rules, implement the
change, run relevant automated tests, run RuboCop and Brakeman, and return the
structured verification report. Its rubocop_status and brakeman_status fields
are self-reports: the authoritative results are the helper runs you do yourself
in the steps below. For broad or uncertain changes, require Coder to use Explore
subagents to investigate independent areas in parallel before editing. Keep all
file writes in the main Coder session, and skip subagents for narrow changes.
Explicitly prohibit commit, push, force-push, merge, rebase, and pull-request
creation unless PO requested that specific Git operation. Explicitly prohibit
creating any additional git worktree, including .claude/worktree or
.claude/worktrees. Explicitly prohibit every herdr teardown command:
\`herdr workspace close\`, \`herdr tab close\`, \`herdr pane close\`,
\`herdr session stop\`, \`herdr session delete\`, \`herdr server stop\`,
\`herdr server live-handoff\`, \`herdr worktree remove\`,
\`herdr config reset-keys\`, and \`herdr integration uninstall\`; also
\`herdr agent rename\` and \`herdr pane release-agent\`, which clear the agent
names this squad addresses through. Tell Coder to leave any temporary herdr
workspace or pane running and report the cleanup command instead. Then run:

  '$SQUAD_DIR/send-to' --status-file '$SQUAD_DIR/coder-status.txt' coder '$SQUAD_DIR/run-coder $SQUAD_DIR/coder-task.txt $SQUAD_DIR/coder-result.json $SQUAD_DIR/coder-status.txt $CODER_SESSION_ID $SQUAD_DIR/coder-schema.json initial'
  '$SQUAD_DIR/run-wait' '$SQUAD_DIR/coder-status.txt' coder '$WAIT_TIMEOUT_SECONDS' 'Coder'
  cat '$SQUAD_DIR/coder-status.txt'
  cat '$SQUAD_DIR/coder-result.json'

### Run mandatory RuboCop verification

Always run this after Coder implementation and after each fix:

  '$SQUAD_DIR/send-to' --status-file '$SQUAD_DIR/rubocop-status.txt' coder '$SQUAD_DIR/run-rubocop $SQUAD_DIR/rubocop-command.txt $SQUAD_DIR/rubocop-result.txt $SQUAD_DIR/rubocop-status.txt'
  '$SQUAD_DIR/run-wait' '$SQUAD_DIR/rubocop-status.txt' coder '$WAIT_TIMEOUT_SECONDS' 'RuboCop'
  cat '$SQUAD_DIR/rubocop-status.txt'
  cat '$SQUAD_DIR/rubocop-result.txt'

RuboCop status must be 0. The helper autocorrects and then verifies the changed
Rails/Ruby files. If there are no changed Rails/Ruby files, or the project is not
a Ruby project, it records that and returns 0.

### Run mandatory Brakeman verification

Always run this after RuboCop and BEFORE the review lenses, and again after each
fix:

  '$SQUAD_DIR/send-to' --status-file '$SQUAD_DIR/brakeman-status.txt' coder '$SQUAD_DIR/run-brakeman $SQUAD_DIR/brakeman-command.txt $SQUAD_DIR/brakeman-result.txt $SQUAD_DIR/brakeman-status.txt'
  '$SQUAD_DIR/run-wait' '$SQUAD_DIR/brakeman-status.txt' coder '$WAIT_TIMEOUT_SECONDS' 'Brakeman'
  cat '$SQUAD_DIR/brakeman-status.txt'
  cat '$SQUAD_DIR/brakeman-result.txt'

Brakeman status must be 0. The scan covers the WHOLE application and requires
ZERO warnings; a project's curated config/brakeman.ignore is what carries any
accepted pre-existing warnings. The helper returns 0 when the project is not a
Ruby project, has no Brakeman installed, or contains no Rails application, so a
non-zero status is always a real finding or a real failure. Never work around a
failure by narrowing the scan; either fix the warning or ask PO about the ignore
file.

### The output contract (put it FIRST in every review task file)

Both review task files must OPEN with this contract, before the task
description. The end of the file demonstrably does not work: the schema alone
does not reliably stop a lens from answering in prose, and a prose result costs
a full re-run of that lens because merge-reviews refuses to merge it.

Tell Advisor its FINAL message must be a single raw JSON object conforming to
review-schema.json and nothing else - no prose before or after, no markdown code
fences - carrying exactly these five top-level keys and no others: verdict,
summary, must_fix, should_fix, test_gaps. merge-reviews enforces the schema's
additionalProperties:false, so an extra key is as fatal as prose.

A lens that finds NOTHING still answers with the object: verdict "pass" with
empty arrays. A sentence saying the change looks fine is a FAILED lens run, not
a pass. verdict is "must_fix" when the must_fix array is non-empty, otherwise
"pass".

### The review checklist (used by BOTH review lenses)

Before writing either review task, read the merged checklist:

  cat '$SQUAD_DIR/checklist.merged.md'

It is a list of LENSES to look through, not boxes to tick. Paste its contents
into each review task file under a "Review checklist" heading, and tell Advisor
to report only what it finds wrong - no coverage table, no "this lens was fine".
review-schema.json findings are flat strings, so tell Advisor to put the
checklist ID at the FRONT of the finding text, for example:

  [SEC-001] Missing tenant boundary check in app/controllers/reports_controller.rb

If the file says "(no checklist items)", this project has no checklist. Say so
in the task text and let the review run unstructured; that is not an error and
never a reason to skip a lens.

### Ask Advisor for a CORRECTNESS review

The first of two independent lenses. Write an English request to
$SQUAD_DIR/review-correctness-task.txt. Tell Advisor to inspect all uncommitted
changes against the approved acceptance criteria, the Coder's test report, and
the mandatory RuboCop and Brakeman results, and to cover correctness, data
integrity, tests, compatibility, performance, and the project's own conventions.
Report findings only. A pass verdict is allowed only when relevant tests ran and
both the RuboCop and Brakeman statuses are 0. Open this task file with the
output contract above. Then run:

  '$SQUAD_DIR/send-to' --status-file '$SQUAD_DIR/review-correctness-status.txt' advisor '$SQUAD_DIR/run-review $SQUAD_DIR/review-correctness-task.txt $SQUAD_DIR/review-correctness-result.json $SQUAD_DIR/review-correctness-status.txt $SQUAD_DIR/review-schema.json correctness'
  '$SQUAD_DIR/run-wait' '$SQUAD_DIR/review-correctness-status.txt' advisor '$WAIT_TIMEOUT_SECONDS' 'Advisor correctness review'
  cat '$SQUAD_DIR/review-correctness-status.txt'
  cat '$SQUAD_DIR/review-correctness-result.json'

### Ask Advisor for a SECURITY review

The second lens, and it runs even when the correctness lens returned must_fix.
Write an English request to $SQUAD_DIR/review-security-task.txt. Tell Advisor to
inspect the same uncommitted diff INDEPENDENTLY for authorization, tenant and
user isolation, input validation, injection, information disclosure, secret
handling, and filesystem, shell and database risks. Report findings only.

Tell it to READ $SQUAD_DIR/brakeman-result.txt and, when present,
$SQUAD_DIR/brakeman-result.json as evidence - a passing Brakeman scan is a
starting point, not a conclusion, since Brakeman cannot see authorization or
tenant-isolation logic.

This task text must NOT mention, quote, summarize or point at the CORRECTNESS
result in any way. Write it as if the correctness lens had never run. The
Brakeman gate is shared evidence and is not a lens, so referencing it does not
break the independence of the two lenses. Open this task file with the output
contract above. Then run:

  '$SQUAD_DIR/send-to' --status-file '$SQUAD_DIR/review-security-status.txt' advisor '$SQUAD_DIR/run-review $SQUAD_DIR/review-security-task.txt $SQUAD_DIR/review-security-result.json $SQUAD_DIR/review-security-status.txt $SQUAD_DIR/review-schema.json security'
  '$SQUAD_DIR/run-wait' '$SQUAD_DIR/review-security-status.txt' advisor '$WAIT_TIMEOUT_SECONDS' 'Advisor security review'
  cat '$SQUAD_DIR/review-security-status.txt'
  cat '$SQUAD_DIR/review-security-result.json'

### Merge the two reviews (mandatory)

Run this after BOTH lenses have finished, before you decide anything:

  '$SQUAD_DIR/merge-reviews' '$SQUAD_DIR/review-correctness-result.json' '$SQUAD_DIR/review-correctness-status.txt' '$SQUAD_DIR/review-security-result.json' '$SQUAD_DIR/review-security-status.txt' '$SQUAD_DIR/review-result.json' '$SQUAD_DIR/review-status.txt'
  cat '$SQUAD_DIR/review-status.txt'
  cat '$SQUAD_DIR/review-result.json'

Run it in YOUR OWN pane, not through send-to: it is a deterministic local merge,
not agent work, so it needs no run-wait. It writes the aggregate a GUI reads:
status 0 only when both lens statuses are 0, verdict must_fix when either lens
says must_fix, findings unioned and tagged with the lens that raised them.

If merge-reviews fails it says so loudly and writes a must_fix aggregate. That
means a lens result is missing or malformed: re-run that lens, and report it to
PO if it keeps failing. Never hand-write the aggregate files to work around it.

### Ask Coder to fix review findings

Write an English request to $SQUAD_DIR/coder-task.txt. Include the UNION of the
must_fix findings from BOTH lens result files, saying which lens raised each
one, plus any RuboCop or Brakeman failure, and require updated tests, RuboCop
and Brakeman. When Brakeman failed, quote the offending warnings from
$SQUAD_DIR/brakeman-result.txt and require a real fix - never a narrowed scan.
Reiterate that Coder must not create
additional git worktrees and must keep all work in $WORKDIR. Reiterate that
Coder must not close, stop, delete, or hand off any herdr workspace, tab, pane,
session, worktree, or server, and must not rename or release any agent,
including for test cleanup. The final argument is \`resume\` rather than
\`initial\`, which continues the exact same Coder session:

  '$SQUAD_DIR/send-to' --status-file '$SQUAD_DIR/coder-status.txt' coder '$SQUAD_DIR/run-coder $SQUAD_DIR/coder-task.txt $SQUAD_DIR/coder-result.json $SQUAD_DIR/coder-status.txt $CODER_SESSION_ID $SQUAD_DIR/coder-schema.json resume'
  '$SQUAD_DIR/run-wait' '$SQUAD_DIR/coder-status.txt' coder '$WAIT_TIMEOUT_SECONDS' 'Coder fix'
  cat '$SQUAD_DIR/coder-status.txt'
  cat '$SQUAD_DIR/coder-result.json'

## Result files

Each runner enforces a JSON schema, so the result file is structured JSON:

- $SQUAD_DIR/advisor-result.json follows plan-schema.json: summary, scope,
  acceptance_criteria, files_to_inspect, implementation_steps, tests, risks.
- $SQUAD_DIR/coder-result.json follows coder-schema.json: summary,
  changed_files, tests_run, tests_not_run, test_status, rubocop_status,
  brakeman_status, remaining_issues.
- $SQUAD_DIR/review-correctness-result.json - correctness lens findings.
- $SQUAD_DIR/review-security-result.json - security lens findings.
  Both follow review-schema.json: verdict, summary, must_fix, should_fix,
  test_gaps.
- $SQUAD_DIR/review-result.json - the AGGREGATE of the two lenses, written by
  merge-reviews, alongside $SQUAD_DIR/review-status.txt. It exists for any GUI
  reading this run. Never write it by hand, and never base a decision on it
  alone.
- $SQUAD_DIR/rubocop-result.txt - RuboCop autocorrect and verification output.
- $SQUAD_DIR/brakeman-result.txt and brakeman-result.json - the Brakeman gate
  result. Both lenses may cite it; the SECURITY lens must read it. It is a GATE
  result, not a review verdict, and never an input to merge-reviews.

EITHER lens may return must_fix, and they see different things: a pass from the
correctness lens says nothing about the security lens. When you ask Coder to
fix, take the UNION of must_fix from BOTH lens result files, and say which lens
raised each finding.

The raw agent stream for each step is kept alongside as *.stream.jsonl, and the
Coder's stderr as coder-result.stderr.log. Read those only when a step failed
and the result file is missing or unusable.

## Workflow

1. Inspect the linked ticket or task context and update the provisional title.
2. Ask Advisor for a structured implementation plan.
3. Show the plan to PO in Japanese and ask for approval.
4. Ask Coder to implement the approved plan.
5. Read Coder status and structured verification report.
6. Run the mandatory RuboCop helper and require status 0.
7. Run the mandatory Brakeman helper and require status 0.
8. Ask Advisor for the CORRECTNESS review of the uncommitted changes and the
   verification evidence.
9. Ask Advisor for the SECURITY review of the same diff, independently. This
   runs even when the correctness lens returned must_fix.
10. Run merge-reviews to write the aggregate files.
11. If either lens status is non-zero, either lens verdict is must_fix, or
   RuboCop or Brakeman failed, ask Coder to fix the issues. Pass the union of
   the findings from both lenses.
12. After every fix, repeat from step 5.
13. Report completion to PO in Japanese. Include the squad worktree path, branch,
   test commands and results, and the mandatory RuboCop and Brakeman results.
PROMPT
}

# A resumed Manager is a fresh claude process, so it has no memory of the run.
# The resume prompt is the whole Manager prompt plus what changed underneath it.
generate_resume_prompt() {
  cat "$SQUAD_DIR/manager-prompt.md" > "$SQUAD_DIR/manager-resume-prompt.md"
  cat >> "$SQUAD_DIR/manager-resume-prompt.md" << PROMPT

## MIGRATION: this squad was resumed (read this before any command)

This run was resumed. Every herdr pane ID from before the resume is stale, and
the agents may have been restarted underneath you.

- Any literal herdr pane ID (such as w1:p2) that appears anywhere in earlier
  context is DEAD. Never reuse one. Address agents by role only, through
  '$SQUAD_DIR/squad-agent' and '$SQUAD_DIR/send-to'.
- The helper scripts, the JSON schemas, the review checklist and this prompt
  were all regenerated from the current squad-herdr, so they may differ from
  what an earlier version of this run used. The commands in this file are the
  authoritative ones.
- The Coder pane is a fresh login shell, but the Coder's claude SESSION is
  preserved: the fix command's trailing 'resume' argument continues the same
  conversation, with session ID $CODER_SESSION_ID.
- Read $SQUAD_DIR/coder-status.txt, $SQUAD_DIR/rubocop-status.txt,
  $SQUAD_DIR/brakeman-status.txt and the two review lens status files to work
  out where the run had got to before deciding what to do next. A status file
  from before the resume describes the round that ran BEFORE the interruption.
- Tell PO in Japanese that the squad was resumed, say which step it had reached,
  and confirm the next step before running it.
PROMPT
}

case "${1:-}" in
  -h|--help|"")
    usage 0
    ;;
  resume)
    resume_run "${2:-}"
    exit 0
    ;;
  clean|base)
    # squad subcommands that squad-herdr does not implement yet. Without this
    # arm they fall through to the new-run path below and get treated as a TASK
    # DESCRIPTION, which silently creates a worktree and launches three agents.
    # `squad` delegates every subcommand from inside a herdr pane, so `squad
    # base` arriving here is a normal typo-level mistake, not an exotic one.
    echo "Error: squad-herdr does not implement '$1' yet." >&2
    echo "       Implemented: list, resume, close, rm, gen-helpers, and <task>." >&2
    echo "       Refusing to treat '$1' as a task description." >&2
    exit 2
    ;;
  gen-helpers)
    [[ -n "${2:-}" ]] || {
      echo "Error: squad-herdr gen-helpers requires a target directory" >&2
      exit 1
    }
    # Writes the WHOLE generated surface - helpers, schemas, checklist and the
    # Manager prompts - so all of it can be inspected or tested without
    # starting a worktree, a workspace, a tab or a single agent. The placeholder
    # values below only ever reach the generated text.
    SQUAD_DIR="$2"
    RUN_ID="${SQUAD_GEN_RUN_ID:-gen-helpers}"
    MANAGER_AGENT="Manager-$RUN_ID"
    CODER_AGENT="Coder-$RUN_ID"
    ADVISOR_AGENT="Advisor-$RUN_ID"
    REPO_ROOT="${SQUAD_GEN_REPO_ROOT:-$(pwd)}"
    WORKDIR="${SQUAD_GEN_WORKDIR:-$REPO_ROOT}"
    BRANCH="${SQUAD_GEN_BRANCH:-feat/squad-herdr-$RUN_ID}"
    SQUAD_TITLE="${SQUAD_GEN_TITLE:-gen-helpers}"
    TICKET_ID="${SQUAD_GEN_TICKET_ID:-}"
    CODER_SESSION_ID="${SQUAD_GEN_CODER_SESSION_ID:-00000000-0000-0000-0000-000000000000}"
    WAIT_TIMEOUT_SECONDS="${SQUAD_WAIT_TIMEOUT_SECONDS:-7200}"
    WORKSPACE_ID="${SQUAD_GEN_WORKSPACE_ID:-}"
    TAB_ID="${SQUAD_GEN_TAB_ID:-}"
    set_worktree_mode
    generate_schemas
    generate_review_checklist
    generate_helper_scripts
    generate_manager_prompt
    generate_resume_prompt
    printf 'Generated helpers, schemas, checklist and prompts in %s\n' "$SQUAD_DIR"
    exit 0
    ;;
  list)
    list_runs
    exit 0
    ;;
  close)
    [[ -n "${2:-}" ]] || {
      echo "Error: squad-herdr close requires a run-id" >&2
      exit 1
    }
    close_run "$2"
    exit 0
    ;;
  rm)
    shift
    [[ $# -gt 0 ]] || {
      echo "Error: squad-herdr rm requires at least one run-id" >&2
      exit 1
    }
    rm_status=0
    for run_id in "$@"; do
      remove_run "$run_id" || rm_status=1
    done
    exit "$rm_status"
    ;;
esac

