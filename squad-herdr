#!/usr/bin/env bash
set -euo pipefail
TASK_FILE="$1"
RESULT_FILE="$2"
STATUS_FILE="$3"
SCHEMA_FILE="$4"
STREAM_FILE="${RESULT_FILE%.json}.stream.jsonl"

log() {
  printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"
}

finish() {
  rc=$?
  trap - EXIT
  printf '%s\n' "$rc" > "$STATUS_FILE"
  log ">>> Advisor review exited with status $rc."
  exit "$rc"
}
trap finish EXIT

# See run-coder: cleared after the trap is installed, so every later exit path
# still records a status.
rm -f "$STATUS_FILE"

log ">>> Advisor review prompt sent."
# NOTE: codex `exec review` treats the scope flags (--uncommitted/--base/--commit)
# as mutually exclusive with a custom [PROMPT]. We drive the review entirely from
# the prompt (which instructs inspecting the uncommitted changes), so do NOT pass
# --uncommitted here, or codex aborts with:
#   error: the argument '--uncommitted' cannot be used with '[PROMPT]'
codex -a never -s read-only exec review \
  --json \
  --output-schema "$SCHEMA_FILE" \
  -o "$RESULT_FILE" \
  "$(cat "$TASK_FILE")" |
  tee "$STREAM_FILE" |
  jq --unbuffered -r '
    if .type == "item.started" then "[started] \(.item.type // "item")"
    elif .type == "item.completed" and .item.type == "command_execution" then
      "[command] \(.item.command // "")\n[exit] \(.item.exit_code // "unknown")"
    elif .type == "item.completed" and .item.type == "agent_message" then .item.text
    elif .type == "turn.completed" then "[turn] completed"
    else empty end
  ' |
  while IFS= read -r line; do log "$line"; done
cat "$RESULT_FILE" 2>/dev/null || true
log ">>> Advisor review finished."
HELPER
  chmod +x "$SQUAD_DIR/run-review"
}

