#!/usr/bin/env bash
set -euo pipefail

# ==============================================================================
# squad-herdr - AI 3-agent team orchestration via Herdr agents
# ==============================================================================
#
# TODO(deferred): the following exist in the tmux-based `squad` and are NOT
# ported yet. Do not read this file as having parity with `squad`.
#   * `squad-herdr resume` - restarting a run's agents and regenerating the
#     helpers and Manager prompt for an existing run.
#   * `squad-herdr clean` - bulk removal of finished runs.
#   * RuboCop verification (run-rubocop, rubocop-command.txt, the mandatory
#     RuboCop step in the Manager workflow, and rubocop_status in
#     coder-schema.json).
#   * close_run rollback hardening: RUN_STATUS is written before the workspace
#     is closed, so a failed `herdr workspace close` leaves the state saying
#     closed while the workspace is still live.
#   * Full failed-launch cleanup parity: cleanup_failed_launch does not undo
#     herdr workspaces, tabs, or agents created before the failure.
#   * SQUAD_BASE_COMMIT / SQUAD_BASE_REF recording in state.env.

usage() {
  local status="${1:-1}"
  cat <<'EOF'
Usage: squad-herdr <task>
       squad-herdr list
       squad-herdr close <run-id>
       squad-herdr rm <run-id>...
       squad-herdr gen-helpers <dir>

Create an isolated git worktree and launch 3 AI agents in Herdr:
  Manager (Claude Code) - talks to you
  Coder   (Claude Code) - implements code
  Advisor (Codex)       - plans and reviews

`gen-helpers` only writes the generated helper scripts into <dir> and exits. It
starts nothing, so it is the way to inspect or test helper generation.

This is a Herdr prototype. Existing tmux-based `squad` remains the stable path.
EOF
  exit "$status"
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" || $# -eq 0 ]]; then
  usage 0
fi

SQUAD_STATE_ROOT="${SQUAD_STATE_ROOT:-${XDG_STATE_HOME:-$HOME/.local/state}/squad-herdr}"
SQUAD_RUN_ROOT="$SQUAD_STATE_ROOT/runs"
SQUAD_WORKTREE_ROOT="${SQUAD_WORKTREE_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}/squad-herdr/worktrees}"
mkdir -p "$SQUAD_RUN_ROOT" "$SQUAD_WORKTREE_ROOT"

load_run() {
  local run_id="$1"
  local state_file="$SQUAD_RUN_ROOT/$run_id/state.env"
  [[ -f "$state_file" ]] || {
    echo "Error: unknown squad-herdr run: $run_id" >&2
    exit 1
  }

  # state.env is generated by squad-herdr itself and contains shell-escaped values.
  source "$state_file"
  STATE_FILE="$state_file"
}

write_state() {
  mkdir -p "$SQUAD_DIR"
  {
    printf 'RUN_ID=%q\n' "$RUN_ID"
    printf 'STARTED_AT=%q\n' "$STARTED_AT"
    printf 'TASK=%q\n' "$TASK"
    printf 'TICKET_ID=%q\n' "$TICKET_ID"
    printf 'REPO_ROOT=%q\n' "$REPO_ROOT"
    printf 'WORKDIR=%q\n' "$WORKDIR"
    printf 'BRANCH=%q\n' "$BRANCH"
    printf 'SQUAD_DIR=%q\n' "$SQUAD_DIR"
    printf 'WORKSPACE_ID=%q\n' "${WORKSPACE_ID:-}"
    printf 'TAB_ID=%q\n' "${TAB_ID:-}"
    printf 'MANAGER_AGENT=%q\n' "$MANAGER_AGENT"
    printf 'CODER_AGENT=%q\n' "$CODER_AGENT"
    printf 'ADVISOR_AGENT=%q\n' "$ADVISOR_AGENT"
    printf 'CODER_SESSION_ID=%q\n' "$CODER_SESSION_ID"
    printf 'RUN_STATUS=%q\n' "${RUN_STATUS:-running}"
    printf 'WORKTREE_CREATED=%q\n' "${WORKTREE_CREATED:-false}"
  } > "$SQUAD_DIR/state.env"
  STATE_FILE="$SQUAD_DIR/state.env"
}

branch_exists() {
  local branch_name="$1"
  git -C "$REPO_ROOT" show-ref --verify --quiet "refs/heads/$branch_name" ||
    git -C "$REPO_ROOT" show-ref --verify --quiet "refs/remotes/origin/$branch_name"
}

workspace_exists() {
  local workspace_id="${1:-}"
  [[ -n "$workspace_id" ]] || return 1
  herdr api snapshot |
    jq -e --arg id "$workspace_id" '.result.snapshot.workspaces[]? | select(.workspace_id == $id)' >/dev/null
}

find_workspace_for_workdir() {
  local workdir="$1"
  herdr api snapshot |
    jq -r --arg workdir "$workdir" '
      .result.snapshot.workspaces[]?
      | select(.worktree.checkout_path == $workdir)
      | .workspace_id
    ' |
    head -n 1
}

active_tab_for_workspace() {
  local workspace_id="$1"
  herdr api snapshot |
    jq -r --arg id "$workspace_id" '
      .result.snapshot.workspaces[]?
      | select(.workspace_id == $id)
      | .active_tab_id // empty
    ' |
    head -n 1
}

list_runs() {
  local state_file title status
  printf '%-24s  %-9s  %s\n' "RUN ID" "STATUS" "TITLE"
  find "$SQUAD_RUN_ROOT" -mindepth 2 -maxdepth 2 -name state.env -type f 2>/dev/null |
    sort -r |
    while IFS= read -r state_file; do
      unset RUN_ID RUN_STATUS SQUAD_DIR WORKSPACE_ID
      source "$state_file"
      title="$(cat "$SQUAD_DIR/title.txt" 2>/dev/null || printf 'unknown')"
      status="${RUN_STATUS:-unknown}"
      if workspace_exists "${WORKSPACE_ID:-}"; then
        status="running"
      elif [[ "$status" == "running" ]]; then
        status="closed"
      fi
      printf '%-24s  %-9s  %s\n' "$RUN_ID" "$status" "$title"
    done
}

close_run() {
  local run_id="$1"
  load_run "$run_id"
  RUN_STATUS="closed"
  write_state
  if workspace_exists "${WORKSPACE_ID:-}"; then
    herdr workspace close "$WORKSPACE_ID"
  fi
}

remove_run() {
  local run_id="$1"
  load_run "$run_id"
  if workspace_exists "${WORKSPACE_ID:-}"; then
    echo "Skip $RUN_ID: still running. Close it first: squad-herdr close $RUN_ID" >&2
    return 1
  fi

  if [[ "${WORKTREE_CREATED:-false}" == "true" && -d "$WORKDIR" ]]; then
    git -C "$REPO_ROOT" worktree remove --force "$WORKDIR"
  fi
  if [[ "${WORKTREE_CREATED:-false}" == "true" && -n "${BRANCH:-}" ]]; then
    git -C "$REPO_ROOT" branch -D "$BRANCH" >/dev/null 2>&1 || true
  fi
  rm -rf "$SQUAD_DIR"
}

# --- Generated helper scripts -------------------------------------------------
# Ported from the tmux-based `squad`. The tmux parts are gone: there are no pane
# titles and no `tmux wait-for` signalling. What remains is the part that
# actually carried the protocol - a status file per step, written on every exit
# path, and treated as the single source of truth by run-wait.
#
# Depends only on SQUAD_DIR and the three per-run herdr agent names, so
# `squad-herdr gen-helpers <dir>` can exercise it without starting anything.
#
# TODO(deferred): squad regenerates these on every `resume` so an old run picks
# up newer helpers. squad-herdr has no `resume` yet, so generation happens only
# at launch.
generate_helper_scripts() {
  mkdir -p "$SQUAD_DIR"

  # --- herdr guard --------------------------------------------------------------
  # Shadows `herdr` on PATH for the Manager and the Coder, both of which run with
  # permissions skipped. Generated once and shared, so the blocklist cannot drift
  # between the two runners.
  #
  # THIS IS A SPEED BUMP, NOT A SECURITY BOUNDARY. It is trivially bypassed by an
  # absolute path (/opt/homebrew/bin/herdr ...), by `command herdr`, by reading
  # $SQUAD_REAL_HERDR, or by talking to the herdr socket directly. It exists to
  # stop an ACCIDENTAL teardown, not a determined one. The prohibition in the
  # Manager prompt and the Coder system prompt is the primary control.
  #
  # The blocklist is pinned to the herdr 0.7.3 command surface, enumerated from
  # `herdr --help` and each `herdr <group> --help`. RE-CHECK IT ON EVERY HERDR
  # UPGRADE: a renamed or newly added teardown verb silently stops being blocked.
  # Deliberately NOT listed, because they do not exist in 0.7.3 and listing dead
  # verbs makes the coverage look better than it is: `herdr session kill`,
  # `herdr agent stop`.
  mkdir -p "$SQUAD_DIR/guard-bin"
  {
    printf '#!/usr/bin/env bash\n'
    printf 'set -euo pipefail\n'
    printf 'SQUAD_REAL_HERDR=%q\n' "$(command -v herdr 2>/dev/null || printf 'herdr')"
    cat <<'HELPER'
# Blocked, grouped by what they destroy:
#   workspace close / tab close / pane close  - the panes the PO is watching
#   session stop / session delete             - the whole herdr session
#   server stop / server live-handoff         - the server behind every session
#   worktree remove                           - the squad's own git worktree
#   config reset-keys                         - the PO's keybindings
#   integration uninstall                     - the PO's agent integrations
#   agent rename / pane release-agent         - not destructive to panes, but
#     they clear the agent name send-to and run-wait resolve through, which
#     breaks addressing for the whole run silently.
case "${1:-} ${2:-}" in
  "workspace close" | "tab close" | "pane close" | \
    "session stop" | "session delete" | \
    "server stop" | "server live-handoff" | \
    "worktree remove" | \
    "config reset-keys" | "integration uninstall" | \
    "agent rename" | "pane release-agent")
    printf 'squad-herdr: blocked dangerous herdr command: %s %s\n' "${1:-}" "${2:-}" >&2
    exit 126
    ;;
esac
exec "$SQUAD_REAL_HERDR" "$@"
HELPER
  } > "$SQUAD_DIR/guard-bin/herdr"
  chmod +x "$SQUAD_DIR/guard-bin/herdr"

  # --- squad-agent --------------------------------------------------------------
  # The single source of truth for agent addressing. send-to, run-wait and the
  # launch-time precondition check all resolve through this one implementation,
  # so there is exactly one place where the herdr lookup can be wrong.

  {
    printf '#!/usr/bin/env bash\n'
    printf 'set -euo pipefail\n'
    printf 'MANAGER_AGENT=%q\n' "$MANAGER_AGENT"
    printf 'CODER_AGENT=%q\n' "$CODER_AGENT"
    printf 'ADVISOR_AGENT=%q\n' "$ADVISOR_AGENT"
    cat <<'HELPER'
# Resolve one squad role to the herdr pane ID that currently plays it.
#
#   squad-agent <manager|coder|advisor>
#
# Prints the pane ID on success. On zero or ambiguous matches it prints nothing
# to stdout and exits non-zero, so a caller can never act on a guess.
#
# TWO methods are tried, because it is not guaranteed that a pane started as
# `herdr agent start <name> -- bash -l` is reported in the snapshot's agents[]
# array: herdr may only populate that array for panes where it DETECTS a known
# AI agent, and these panes run a plain login shell.
#
#   1. `herdr api snapshot` -> .result.snapshot.agents[] matched on .name.
#      Exactly one match is required; several means two runs collided and we
#      refuse to guess between them.
#   2. `herdr agent get <name>` -> .result.agent.pane_id. Per `herdr agent
#      --help`, targets accept unique agent names, so this resolves a named
#      agent even when it is absent from agents[]. It answers
#      {"error":{"code":"agent_not_found"}} with a non-zero exit when there is
#      no such agent.
#
# Method 2 also accepts detected labels and terminal IDs, so a bare label could
# in principle match a pane we did not mean. The returned .name is therefore
# checked against the requested name whenever herdr reports one.

if [[ $# -ne 1 ]]; then
  printf 'Usage: squad-agent <manager|coder|advisor>\n' >&2
  exit 2
fi

ROLE="$1"
case "$ROLE" in
  manager) AGENT_NAME="$MANAGER_AGENT" ;;
  coder) AGENT_NAME="$CODER_AGENT" ;;
  advisor) AGENT_NAME="$ADVISOR_AGENT" ;;
  *)
    printf 'Error: unknown squad role: %s (expected manager, coder, or advisor)\n' "$ROLE" >&2
    exit 2
    ;;
esac

# Method 1: the snapshot's agents[] array.
if SNAPSHOT="$(herdr api snapshot 2>/dev/null)"; then
  MATCHES=()
  while IFS= read -r pane_id; do
    [[ -n "$pane_id" ]] || continue
    MATCHES+=("$pane_id")
  done < <(
    printf '%s' "$SNAPSHOT" |
      jq -r --arg name "$AGENT_NAME" '
        .result.snapshot.agents[]?
        | select(.name == $name)
        | .pane_id
      ' 2>/dev/null || true
  )

  if [[ "${#MATCHES[@]}" -gt 1 ]]; then
    printf 'Error: %s herdr agents are named %s (role %s): %s\n' \
      "${#MATCHES[@]}" "$AGENT_NAME" "$ROLE" "${MATCHES[*]}" >&2
    printf 'Refusing to guess between them.\n' >&2
    exit 1
  fi
  if [[ "${#MATCHES[@]}" -eq 1 ]]; then
    printf '%s\n' "${MATCHES[0]}"
    exit 0
  fi
fi

# Method 2: ask herdr to resolve the name directly.
if AGENT_JSON="$(herdr agent get "$AGENT_NAME" 2>/dev/null)"; then
  PANE_ID="$(
    printf '%s' "$AGENT_JSON" |
      jq -r --arg name "$AGENT_NAME" '
        .result.agent
        | select(.name == null or .name == $name)
        | .pane_id // empty
      ' 2>/dev/null || true
  )"
  if [[ -n "$PANE_ID" ]]; then
    printf '%s\n' "$PANE_ID"
    exit 0
  fi
fi

printf 'Error: no live herdr agent is named %s (role %s).\n' "$AGENT_NAME" "$ROLE" >&2
printf 'It is not in the snapshot agents list, and herdr agent get cannot resolve it.\n' >&2
exit 1
HELPER
  } > "$SQUAD_DIR/squad-agent"
  chmod +x "$SQUAD_DIR/squad-agent"

  # --- send-to ----------------------------------------------------------------

  {
    printf '#!/usr/bin/env bash\n'
    printf 'set -euo pipefail\n'
    printf 'SQUAD_DIR=%q\n' "$SQUAD_DIR"
    cat <<'HELPER'
# Run one shell command in the herdr pane that currently plays the given role.
# Never falls back to a guessed pane: if the role cannot be resolved, nothing is
# sent and the exit status is non-zero.
#
#   send-to [--status-file <path>] <manager|coder|advisor> <shell-command>
#
# Roles are accepted as aliases so the Manager prompt stays readable. Resolution
# is delegated to squad-agent, which is the only place that knows how to turn a
# role into a live herdr pane.
#
# --status-file exists to close a launch race, and it must be an explicit option
# rather than a path parsed out of the command string, which would be fragile.
#
# `herdr pane run` only types the command into the target pane and presses
# Enter. The runner has NOT started when send-to returns, so its own
# `rm -f "$STATUS_FILE"` has not run either. The Manager runs a launch and then
# the matching run-wait synchronously in its own pane, so without clearing here
# run-wait's fast path would find the PREVIOUS round's status file and report
# that old result before the new command had even begun. Clearing here is
# guaranteed to precede the wait because it happens in the Manager's own pane,
# before the command text is queued.
#
# Only a LAUNCH passes --status-file. A run-wait must never clear, or a repeated
# wait would discard a real result and then block.

STATUS_FILE=""
LAUNCHED=false

# THE STATUS FILE MUST NEVER OUTLIVE ITS ROUND.
#
# Every failure path below - a bad role, an unresolvable agent, a herdr socket
# error, a failed `pane run` - happens AFTER the Manager has already decided to
# run its run-wait line. If such a failure simply left the previous round's
# status file in place, run-wait's fast path would read it and report that old
# result as this round's completion. A silent wrong answer is worse than a hang,
# so the file is cleared before anything that can fail, and any failure records
# its own exit code in it.
#
# The trap deliberately does NOT write once the command has been dispatched:
# writing send-to's own 0 there would make run-wait instantly report "finished
# (status 0)" for a runner that had only just started - the same wrong-answer
# bug in the other direction. After a successful dispatch the ONLY writer is the
# runner's own EXIT trap.
record_failed_launch() {
  rc=$?
  trap - EXIT
  if [[ -n "$STATUS_FILE" && "$LAUNCHED" != "true" ]]; then
    printf '%s\n' "$rc" > "$STATUS_FILE"
  fi
  exit "$rc"
}
trap record_failed_launch EXIT

if [[ "${1:-}" == "--status-file" ]]; then
  if [[ $# -lt 2 || -z "${2:-}" ]]; then
    printf 'Error: --status-file requires a path.\n' >&2
    exit 2
  fi
  STATUS_FILE="$2"
  shift 2
  # Before anything that can fail, including argument validation below.
  rm -f "$STATUS_FILE"
fi

if [[ $# -ne 2 ]]; then
  printf 'Usage: send-to [--status-file <path>] <manager|coder|advisor> <shell-command>\n' >&2
  printf 'The command must be a single argument; quote it.\n' >&2
  exit 2
fi

ROLE="$1"
COMMAND="$2"

if ! PANE="$("$SQUAD_DIR/squad-agent" "$ROLE")"; then
  printf 'Error: send-to %s aborted, nothing was sent.\n' "$ROLE" >&2
  exit 1
fi

herdr pane run "$PANE" "$COMMAND" >/dev/null
LAUNCHED=true
printf '[%s] sent to %s (pane %s)\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$ROLE" "$PANE"
HELPER
  } > "$SQUAD_DIR/send-to"
  chmod +x "$SQUAD_DIR/send-to"

  # --- run-wait ---------------------------------------------------------------

  {
    printf '#!/usr/bin/env bash\n'
    printf 'set -euo pipefail\n'
    printf 'SQUAD_DIR=%q\n' "$SQUAD_DIR"
    cat <<'HELPER'
# Block until one step's status file appears.
#
#   run-wait <status-file> <manager|coder|advisor> <timeout-seconds> <label>
#
# run-wait itself exits 0 for every outcome except an invalid role (2). The
# outcome is the CONTENT of the status file: the runner's exit code, or 124 on
# timeout, or 125 when the agent vanished without one.
STATUS_FILE="$1"
ROLE="$2"
TIMEOUT_SECONDS="$3"
LABEL="$4"

# The status file is a local stat, so it is checked every second. A herdr
# snapshot is far more expensive and an agent that died a few seconds ago is
# still reported correctly, so agent liveness is checked far less often.
AGENT_CHECK_INTERVAL_SECONDS=10

log() {
  printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"
}

# COMPLETION IS THE STATUS FILE.
#
# Each runner deletes this file when it starts and writes it exactly once, from
# an EXIT trap, when it finishes. So a non-empty status file means "this round
# finished" and nothing else can mean that. -s rather than -f is deliberate: it
# skips the instant during which the redirect has truncated the file but not yet
# written to it.
#
# herdr does expose `herdr agent wait --status idle`, but agent status is a
# heuristic over what the pane is displaying, and one status transition is not
# tied to a particular round of work. The status file is.
status_ready() {
  [[ -s "$STATUS_FILE" ]]
}

# Fail closed on a bad role rather than waiting for something nothing will ever
# produce, which would hang the Manager.
case "$ROLE" in
  manager | coder | advisor) ;;
  *)
    printf '125\n' > "$STATUS_FILE"
    log "$LABEL: invalid role $ROLE (expected manager, coder, or advisor). Pass a role, never a pane ID."
    exit 2
    ;;
esac

# Returns 0 ONLY when the resolver definitively could not find the agent by any
# supported method. squad-agent tries the snapshot first and then
# `herdr agent get`, and both have to come back empty before we call it gone.
#
# This is intentionally not the same as "the resolver exited non-zero": a
# transient herdr socket error also fails, and recording that as a dead agent
# would turn a healthy run into a bogus 125. So a failure is re-checked once
# after a short pause, and only a second consecutive failure counts.
agent_gone() {
  "$SQUAD_DIR/squad-agent" "$ROLE" >/dev/null 2>&1 && return 1
  sleep 2
  "$SQUAD_DIR/squad-agent" "$ROLE" >/dev/null 2>&1 && return 1
  return 0
}

report_done() {
  log "$LABEL finished (status $(cat "$STATUS_FILE"))."
  exit 0
}

# Fast path: the runner may have finished before this wait was ever called.
if status_ready; then
  report_done
fi

elapsed=0
since_agent_check=0
while :; do
  # Authoritative check, always first.
  if status_ready; then
    report_done
  fi

  if ((since_agent_check >= AGENT_CHECK_INTERVAL_SECONDS)); then
    since_agent_check=0
    if agent_gone; then
      # The agent may have vanished only after the runner finished.
      if status_ready; then
        report_done
      fi
      printf '125\n' > "$STATUS_FILE"
      log "$LABEL: the herdr agent for role $ROLE no longer exists."
      exit 0
    fi
  fi

  if ((elapsed >= TIMEOUT_SECONDS)); then
    # Re-read before giving up: the runner may have finished during the last
    # sleep. Recording 124 over a real status would report a completed step as
    # a timeout.
    if status_ready; then
      report_done
    fi
    printf '124\n' > "$STATUS_FILE"
    log "$LABEL timed out after $TIMEOUT_SECONDS seconds."
    exit 0
  fi

  sleep 1
  ((elapsed += 1))
  ((since_agent_check += 1))
done
HELPER
  } > "$SQUAD_DIR/run-wait"
  chmod +x "$SQUAD_DIR/run-wait"

  # --- Runners (executed inside the Coder / Advisor panes) --------------------

  {
    printf '#!/usr/bin/env bash\n'
    printf 'set -euo pipefail\n'
    printf 'SQUAD_DIR=%q\n' "$SQUAD_DIR"
    cat <<'HELPER'
TASK_FILE="$1"
RESULT_FILE="$2"
STATUS_FILE="$3"
SESSION_ID="$4"
SCHEMA_FILE="$5"
MODE="$6"
STREAM_FILE="${RESULT_FILE%.json}.stream.jsonl"
STDERR_FILE="${RESULT_FILE%.json}.stderr.log"

log() {
  printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"
}

finish() {
  rc=$?
  trap - EXIT
  printf '%s\n' "$rc" > "$STATUS_FILE"
  log ">>> Coder exited with status $rc."
  exit "$rc"
}
trap finish EXIT

# Clear the previous round's status so its presence unambiguously means "THIS
# round finished". run-wait treats the status file as the single source of
# truth, and the Manager re-runs the Coder via resume after every fix, so a
# status left over from an earlier round would otherwise let the next wait
# report a stale result as if it were fresh. Done AFTER the trap is installed,
# so a failure from here on still records a status.
rm -f "$STATUS_FILE"

# The Coder runs with permissions skipped, and a single stray teardown command
# would destroy the workspace the PO is watching. See guard-bin/herdr for what
# this does and does not protect against.
export PATH="$SQUAD_DIR/guard-bin:$PATH"

if [[ "$MODE" == "initial" ]]; then
  SESSION_ARGS=(--session-id "$SESSION_ID")
  log ">>> Coder prompt sent (initial session)."
else
  SESSION_ARGS=(--resume "$SESSION_ID")
  log ">>> Coder prompt sent (resuming fixed session $SESSION_ID)."
fi
claude -p \
  --dangerously-skip-permissions \
  --append-system-prompt "Never tear down any part of the PO's herdr session. In particular never run 'herdr workspace close', 'herdr tab close', 'herdr pane close', 'herdr session stop', 'herdr session delete', 'herdr server stop', 'herdr server live-handoff', 'herdr worktree remove', 'herdr config reset-keys', or 'herdr integration uninstall'. Never run 'herdr agent rename' or 'herdr pane release-agent' either: they clear the agent names this squad addresses through. If a temporary herdr workspace or pane is created for testing, leave it running and report the cleanup command instead of executing it." \
  "${SESSION_ARGS[@]}" \
  --output-format stream-json \
  --include-partial-messages \
  --verbose \
  --json-schema "$(cat "$SCHEMA_FILE")" \
  "$(cat "$TASK_FILE")" 2> "$STDERR_FILE" |
  tee "$STREAM_FILE" |
  jq --unbuffered -r '
    if .type == "assistant" then
      .message.content[]? |
      if .type == "tool_use" then "[tool] \(.name)"
      elif .type == "text" then .text
      else empty end
    elif .type == "result" then "[result] \(.subtype // "done")"
    else empty end
  ' |
  while IFS= read -r line; do log "$line"; done

if [[ -s "$STDERR_FILE" ]]; then
  while IFS= read -r line; do log "[stderr] $line" >&2; done < "$STDERR_FILE"
fi
jq -c 'select(.type == "result") | (.structured_output // .result)' "$STREAM_FILE" |
  tail -n 1 > "$RESULT_FILE"
log ">>> Coder finished."
HELPER
  } > "$SQUAD_DIR/run-coder"
  chmod +x "$SQUAD_DIR/run-coder"

  # --- run-manager --------------------------------------------------------------
  # The Manager pane is started as a plain login shell and this is dispatched
  # into it with `herdr pane run`, exactly like every other step. That ordering
  # is deliberate: it lets the launch verify that all three roles are resolvable
  # BEFORE any AI starts, and it makes the first thing the run does a live test
  # of the same dispatch path the whole protocol depends on.

  cat > "$SQUAD_DIR/run-manager" <<'HELPER'
#!/usr/bin/env bash
set -euo pipefail
WORKDIR="$1"
PROMPT_FILE="$2"
TASK_FILE="$3"
