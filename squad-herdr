#!/usr/bin/env bash
set -euo pipefail

# ==============================================================================
# squad-herdr - AI 3-agent team orchestration via Herdr agents
# ==============================================================================
#
# The review and verification pipeline is now at parity with the tmux-based
# `squad`: two independent review lenses (correctness, then security), the
# merged review checklist, the merge-reviews aggregate, the mandatory RuboCop
# gate, the mandatory whole-application Brakeman gate, `resume`, and
# SQUAD_BASE_COMMIT / SQUAD_BASE_REF recording.
#
# The two scripts still share NO code. Every generator here is a port, so a
# change to squad's pipeline has to be made twice until they are unified; that
# extraction is deliberately deferred until both have harness coverage.
#
# TODO(deferred): the following exist in `squad` and are still NOT ported.
#   * `squad-herdr clean` - bulk removal of finished runs.
#   * `squad-herdr base` - recording a different fork point after the fact.
#   * close_run rollback hardening: RUN_STATUS is written before the workspace
#     is closed, so a failed `herdr workspace close` leaves the state saying
#     closed while the workspace is still live.
#   * Full failed-launch cleanup parity: cleanup_failed_launch does not undo
#     herdr workspaces, tabs, or agents created before the failure.
#   * The awaiting-PO marker (await-po) and the window-name badge, which have no
#     obvious Herdr equivalent.

usage() {
  local status="${1:-1}"
  # Display name ONLY, so `squad --help` inside a herdr pane shows the command
  # the PO actually typed. It must never reach a lifecycle instruction: `squad
  # close` and `squad-herdr close` read different state roots, so telling anyone
  # to run the wrong one would point them at the wrong store. Every such string
  # below stays hard-coded as squad-herdr.
  local name="${SQUAD_HERDR_DISPLAY_NAME:-${0##*/}}"
  cat <<EOF
Usage: $name <task>
       $name list
       $name resume <run-id>
       $name close <run-id>
       $name rm <run-id>...
       $name gen-helpers <dir>

Create an isolated git worktree and launch 3 AI agents in Herdr:
  Manager (Claude Code) - talks to you
  Coder   (Claude Code) - implements code
  Advisor (Codex)       - plans and reviews

\`gen-helpers\` only writes the generated helper scripts into <dir> and exits. It
starts nothing, so it is the way to inspect or test helper generation.

This is a Herdr prototype. Existing tmux-based \`squad\` remains the stable path.
EOF
  exit "$status"
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" || $# -eq 0 ]]; then
  usage 0
fi

SQUAD_STATE_ROOT="${SQUAD_STATE_ROOT:-${XDG_STATE_HOME:-$HOME/.local/state}/squad-herdr}"
SQUAD_RUN_ROOT="$SQUAD_STATE_ROOT/runs"
SQUAD_WORKTREE_ROOT="${SQUAD_WORKTREE_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}/squad-herdr/worktrees}"
mkdir -p "$SQUAD_RUN_ROOT" "$SQUAD_WORKTREE_ROOT"

# Ported from squad. The PO runs this through a ~/.local/bin symlink, so the
# bundled _vet/checklist.md has to be found relative to the resolved real path.
script_real_path() {
  local src="${BASH_SOURCE[0]}" dir
  while [[ -L "$src" ]]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" == /* ]] || src="$dir/$src"
  done
  printf '%s/%s\n' "$(cd -P "$(dirname "$src")" && pwd)" "$(basename "$src")"
}
SQUAD_SCRIPT_PATH="$(script_real_path)"
SQUAD_SCRIPT_DIR="$(dirname "$SQUAD_SCRIPT_PATH")"

# PREFLIGHT: a configured checklist path is authoritative, and must be readable,
# not merely present. Checked before any worktree, workspace, tab or agent
# exists, on both the launch and the resume path, so a typo cannot leave a
# half-built Herdr layout behind.
require_readable_checklist_config() {
  local var value
  for var in SQUAD_REVIEW_CHECKLIST VET_CHECKLIST; do
    value="${!var:-}"
    [[ -n "$value" ]] || continue
    [[ -f "$value" && -r "$value" ]] || {
      echo "Error: $var is set but is not a readable file: $value" >&2
      exit 1
    }
    return 0
  done
}

# --- Review checklist ---------------------------------------------------------
# Ported from squad, which took the format and merge semantics from vet: same
# lookup order, same "same ID replaces, new ID appends" merge, and the same
# deliberate difference from vet - an EMPTY checklist is not a failure here.
generate_review_checklist() {
  mkdir -p "$SQUAD_DIR"

  local common="" common_source="none"
  local project="" project_source="none"

  if [[ -n "${SQUAD_REVIEW_CHECKLIST:-}" ]]; then
    [[ -f "$SQUAD_REVIEW_CHECKLIST" && -r "$SQUAD_REVIEW_CHECKLIST" ]] || {
      echo "Error: SQUAD_REVIEW_CHECKLIST is set but is not a readable file: $SQUAD_REVIEW_CHECKLIST" >&2
      exit 1
    }
    common="$SQUAD_REVIEW_CHECKLIST"
    common_source="SQUAD_REVIEW_CHECKLIST"
  elif [[ -n "${VET_CHECKLIST:-}" ]]; then
    [[ -f "$VET_CHECKLIST" && -r "$VET_CHECKLIST" ]] || {
      echo "Error: VET_CHECKLIST is set but is not a readable file: $VET_CHECKLIST" >&2
      exit 1
    }
    common="$VET_CHECKLIST"
    common_source="VET_CHECKLIST"
  elif [[ -f "$HOME/.vet/checklist.md" ]]; then
    common="$HOME/.vet/checklist.md"
    common_source="$HOME/.vet/checklist.md"
  elif [[ -f "$SQUAD_SCRIPT_DIR/_vet/checklist.md" ]]; then
    common="$SQUAD_SCRIPT_DIR/_vet/checklist.md"
    common_source="$SQUAD_SCRIPT_DIR/_vet/checklist.md"
  fi

  if [[ -f "${WORKDIR:-}/.vet/checklist.md" ]]; then
    project="$WORKDIR/.vet/checklist.md"
    project_source=".vet/checklist.md"
  elif [[ -f "${WORKDIR:-}/.review/checklist.md" ]]; then
    project="$WORKDIR/.review/checklist.md"
    project_source=".review/checklist.md"
  fi

  if command -v perl >/dev/null 2>&1; then
    perl -e '
      use strict;
      use warnings;
      my ($common_file, $project_file) = @ARGV;
      my (@order, %text, %source);
      sub items {
        my ($file, $kind) = @_;
        my @found;
        return @found unless defined $file && length $file && -f $file;
        open my $fh, "<", $file or die "squad-herdr: cannot read $file: $!\n";
        while (my $line = <$fh>) {
          chomp $line;
          next unless $line =~ /^-\s+\[([A-Z][A-Z0-9_-]*)\]\s+(\S.*?)\s*$/;
          push @found, [$1, $2, $kind];
        }
        close $fh;
        return @found;
      }
      for my $item (items($common_file, "common")) {
        my ($id, $body) = @$item;
        push @order, $id unless exists $text{$id};
        $text{$id}   = $body;
        $source{$id} = "common";
      }
      for my $item (items($project_file, "project")) {
        my ($id, $body) = @$item;
        if (exists $text{$id}) {
          $source{$id} = ($source{$id} eq "common") ? "project-override" : $source{$id};
        } else {
          push @order, $id;
          $source{$id} = "project";
        }
        $text{$id} = $body;
      }
      sub esc {
        my $value = shift;
        $value =~ s/\\/\\\\/g;
        $value =~ s/"/\\"/g;
        $value =~ s/[\x00-\x1f]/ /g;
        return $value;
      }
      for my $id (@order) {
        printf qq({"id":"%s","text":"%s","source":"%s"}\n),
          esc($id), esc($text{$id}), esc($source{$id});
      }
    ' "$common" "$project" > "$SQUAD_DIR/checklist.jsonl"
  else
    echo "Warning: perl was not found, so the review checklist could not be parsed." >&2
    : > "$SQUAD_DIR/checklist.jsonl"
  fi

  local count=0 overrides=0 added=0
  if command -v jq >/dev/null 2>&1; then
    jq -s --arg common "$common_source" --arg project "$project_source" \
      '{common_checklist: $common, project_checklist: $project, items: .}' \
      "$SQUAD_DIR/checklist.jsonl" > "$SQUAD_DIR/checklist.json"
    count="$(jq -r '.items | length' "$SQUAD_DIR/checklist.json")"
    overrides="$(jq -r '[.items[] | select(.source == "project-override")] | length' "$SQUAD_DIR/checklist.json")"
    added="$(jq -r '[.items[] | select(.source == "project")] | length' "$SQUAD_DIR/checklist.json")"
  else
    echo "Warning: jq was not found, so checklist.json could not be written." >&2
    printf '{"common_checklist":"%s","project_checklist":"%s","items":[]}\n' \
      "$common_source" "$project_source" > "$SQUAD_DIR/checklist.json"
  fi

  {
    printf '# Merged review checklist\n\n'
    printf 'Common checklist:  %s\n' "$common_source"
    printf 'Project checklist: %s\n' "$project_source"
    printf 'Items: %s total (%s overridden by the project, %s added by the project)\n\n' \
      "$count" "$overrides" "$added"
    if [[ "$count" -eq 0 ]]; then
      printf '(no checklist items)\n'
    else
      jq -r '.items[] | "- [\(.id)] \(.text)  <!-- source: \(.source) -->"' "$SQUAD_DIR/checklist.json"
    fi
  } > "$SQUAD_DIR/checklist.merged.md"
}

load_run() {
  local run_id="$1"
  local state_file="$SQUAD_RUN_ROOT/$run_id/state.env"
  [[ -f "$state_file" ]] || {
    echo "Error: unknown squad-herdr run: $run_id" >&2
    exit 1
  }

  # state.env is generated by squad-herdr itself and contains shell-escaped values.
  source "$state_file"
  STATE_FILE="$state_file"
}

write_state() {
  mkdir -p "$SQUAD_DIR"
  {
    printf 'RUN_ID=%q\n' "$RUN_ID"
    printf 'STARTED_AT=%q\n' "$STARTED_AT"
    printf 'TASK=%q\n' "$TASK"
    printf 'TICKET_ID=%q\n' "$TICKET_ID"
    printf 'REPO_ROOT=%q\n' "$REPO_ROOT"
    printf 'WORKDIR=%q\n' "$WORKDIR"
    printf 'BRANCH=%q\n' "$BRANCH"
    # The EXACT fork point of this run's worktree, captured before the worktree
    # was created. Resume re-emits whatever load_run sourced; it is never
    # recomputed from a later HEAD.
    printf 'SQUAD_BASE_COMMIT=%q\n' "${SQUAD_BASE_COMMIT:-}"
    printf 'SQUAD_BASE_REF=%q\n' "${SQUAD_BASE_REF:-}"
    printf 'SQUAD_DIR=%q\n' "$SQUAD_DIR"
    # Defaulted, so a run created before these keys existed still resumes under
    # set -u. An empty verification command means "skip", never "block".
    printf 'RUBOCOP_COMMAND=%q\n' "${RUBOCOP_COMMAND:-}"
    printf 'BRAKEMAN_COMMAND=%q\n' "${BRAKEMAN_COMMAND:-}"
    printf 'WAIT_TIMEOUT_SECONDS=%q\n' "${WAIT_TIMEOUT_SECONDS:-7200}"
    printf 'WORKSPACE_ID=%q\n' "${WORKSPACE_ID:-}"
    printf 'TAB_ID=%q\n' "${TAB_ID:-}"
    printf 'MANAGER_AGENT=%q\n' "$MANAGER_AGENT"
    printf 'CODER_AGENT=%q\n' "$CODER_AGENT"
    printf 'ADVISOR_AGENT=%q\n' "$ADVISOR_AGENT"
    printf 'CODER_SESSION_ID=%q\n' "$CODER_SESSION_ID"
    printf 'RUN_STATUS=%q\n' "${RUN_STATUS:-running}"
    printf 'WORKTREE_CREATED=%q\n' "${WORKTREE_CREATED:-false}"
  } > "$SQUAD_DIR/state.env"
  STATE_FILE="$SQUAD_DIR/state.env"
}

# Shared by the launch flow and by resume, so a resumed prompt describes the
# worktree the same way the original one did.
set_worktree_mode() {
  if [[ "$WORKDIR" != "$REPO_ROOT" ]]; then
    WORKTREE_MODE="isolated worktree"
    WORKTREE_NOTE="All implementation work happens in the isolated squad-herdr worktree. Existing changes
in the original worktree must remain untouched. The worktree is retained after
completion so PO can inspect, commit, or merge the result."
  else
    WORKTREE_MODE="original repository (no commits yet, no isolated worktree)"
    WORKTREE_NOTE="This repository has no commits yet, so git could not create an isolated
worktree. All work happens DIRECTLY in the original repository: $REPO_ROOT."
  fi
}

# --- Structured output schemas ------------------------------------------------
# A function, not inline launch code, so `resume` and `gen-helpers` regenerate
# exactly what a launch writes.
generate_schemas() {
  mkdir -p "$SQUAD_DIR"

  cat > "$SQUAD_DIR/plan-schema.json" <<'SCHEMA'
{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "summary": { "type": "string" },
    "scope": { "type": "array", "items": { "type": "string" } },
    "acceptance_criteria": { "type": "array", "items": { "type": "string" } },
    "files_to_inspect": { "type": "array", "items": { "type": "string" } },
    "implementation_steps": { "type": "array", "items": { "type": "string" } },
    "tests": { "type": "array", "items": { "type": "string" } },
    "risks": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["summary", "scope", "acceptance_criteria", "files_to_inspect", "implementation_steps", "tests", "risks"]
}
SCHEMA

  # rubocop_status and brakeman_status are the Coder's SELF-REPORT. The
  # authoritative results are the Manager's own run-rubocop / run-brakeman runs.
  cat > "$SQUAD_DIR/coder-schema.json" <<'SCHEMA'
{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "summary": { "type": "string" },
    "changed_files": { "type": "array", "items": { "type": "string" } },
    "tests_run": { "type": "array", "items": { "type": "string" } },
    "tests_not_run": { "type": "array", "items": { "type": "string" } },
    "test_status": { "type": "string", "enum": ["pass", "fail", "blocked"] },
    "rubocop_status": { "type": "string", "enum": ["pass", "fail", "blocked"] },
    "brakeman_status": { "type": "string", "enum": ["pass", "fail", "blocked"] },
    "remaining_issues": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["summary", "changed_files", "tests_run", "tests_not_run", "test_status", "rubocop_status", "brakeman_status", "remaining_issues"]
}
SCHEMA

  # UNCHANGED by the two-lens split: lens identity comes from the filenames and
  # the prompt text, never from a schema field. merge-reviews emits an object
  # that conforms to this same schema.
  cat > "$SQUAD_DIR/review-schema.json" <<'SCHEMA'
{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "verdict": { "type": "string", "enum": ["pass", "must_fix"] },
    "summary": { "type": "string" },
    "must_fix": { "type": "array", "items": { "type": "string" } },
    "should_fix": { "type": "array", "items": { "type": "string" } },
    "test_gaps": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["verdict", "summary", "must_fix", "should_fix", "test_gaps"]
}
SCHEMA
}

branch_exists() {
  local branch_name="$1"
  git -C "$REPO_ROOT" show-ref --verify --quiet "refs/heads/$branch_name" ||
    git -C "$REPO_ROOT" show-ref --verify --quiet "refs/remotes/origin/$branch_name"
}

workspace_exists() {
  local workspace_id="${1:-}"
  [[ -n "$workspace_id" ]] || return 1
  herdr api snapshot |
    jq -e --arg id "$workspace_id" '.result.snapshot.workspaces[]? | select(.workspace_id == $id)' >/dev/null
}

find_workspace_for_workdir() {
  local workdir="$1"
  herdr api snapshot |
    jq -r --arg workdir "$workdir" '
      .result.snapshot.workspaces[]?
      | select(.worktree.checkout_path == $workdir)
      | .workspace_id
    ' |
    head -n 1
}

active_tab_for_workspace() {
  local workspace_id="$1"
  herdr api snapshot |
    jq -r --arg id "$workspace_id" '
      .result.snapshot.workspaces[]?
      | select(.workspace_id == $id)
      | .active_tab_id // empty
    ' |
    head -n 1
}

list_runs() {
  local state_file title status
  printf '%-24s  %-9s  %s\n' "RUN ID" "STATUS" "TITLE"
  find "$SQUAD_RUN_ROOT" -mindepth 2 -maxdepth 2 -name state.env -type f 2>/dev/null |
    sort -r |
    while IFS= read -r state_file; do
      unset RUN_ID RUN_STATUS SQUAD_DIR WORKSPACE_ID
      source "$state_file"
      title="$(cat "$SQUAD_DIR/title.txt" 2>/dev/null || printf 'unknown')"
      status="${RUN_STATUS:-unknown}"
      if workspace_exists "${WORKSPACE_ID:-}"; then
        status="running"
      elif [[ "$status" == "running" ]]; then
        status="closed"
      fi
      printf '%-24s  %-9s  %s\n' "$RUN_ID" "$status" "$title"
    done
}

close_run() {
  local run_id="$1"
  load_run "$run_id"
  RUN_STATUS="closed"
  write_state
  if workspace_exists "${WORKSPACE_ID:-}"; then
    herdr workspace close "$WORKSPACE_ID"
  fi
}

remove_run() {
  local run_id="$1"
  load_run "$run_id"
  if workspace_exists "${WORKSPACE_ID:-}"; then
    echo "Skip $RUN_ID: still running. Close it first: squad-herdr close $RUN_ID" >&2
    return 1
  fi

  if [[ "${WORKTREE_CREATED:-false}" == "true" && -d "$WORKDIR" ]]; then
    git -C "$REPO_ROOT" worktree remove --force "$WORKDIR"
  fi
  if [[ "${WORKTREE_CREATED:-false}" == "true" && -n "${BRANCH:-}" ]]; then
    git -C "$REPO_ROOT" branch -D "$BRANCH" >/dev/null 2>&1 || true
  fi
  rm -rf "$SQUAD_DIR"
}

# --- Generated helper scripts -------------------------------------------------
# Ported from the tmux-based `squad`. The tmux parts are gone: there are no pane
# titles and no `tmux wait-for` signalling. What remains is the part that
# actually carried the protocol - a status file per step, written on every exit
# path, and treated as the single source of truth by run-wait.
#
# Depends only on SQUAD_DIR and the three per-run herdr agent names, so
# `squad-herdr gen-helpers <dir>` can exercise it without starting anything.
#
# TODO(deferred): squad regenerates these on every `resume` so an old run picks
# up newer helpers. squad-herdr has no `resume` yet, so generation happens only
# at launch.
generate_helper_scripts() {
  mkdir -p "$SQUAD_DIR"

  # --- herdr guard --------------------------------------------------------------
  # Shadows `herdr` on PATH for the Manager and the Coder, both of which run with
  # permissions skipped. Generated once and shared, so the blocklist cannot drift
  # between the two runners.
  #
  # THIS IS A SPEED BUMP, NOT A SECURITY BOUNDARY. It is trivially bypassed by an
  # absolute path (/opt/homebrew/bin/herdr ...), by `command herdr`, by reading
  # $SQUAD_REAL_HERDR, or by talking to the herdr socket directly. It exists to
  # stop an ACCIDENTAL teardown, not a determined one. The prohibition in the
  # Manager prompt and the Coder system prompt is the primary control.
  #
  # The blocklist is pinned to the herdr 0.7.3 command surface, enumerated from
  # `herdr --help` and each `herdr <group> --help`. RE-CHECK IT ON EVERY HERDR
  # UPGRADE: a renamed or newly added teardown verb silently stops being blocked.
  # Deliberately NOT listed, because they do not exist in 0.7.3 and listing dead
  # verbs makes the coverage look better than it is: `herdr session kill`,
  # `herdr agent stop`.
  mkdir -p "$SQUAD_DIR/guard-bin"
  {
    printf '#!/usr/bin/env bash\n'
    printf 'set -euo pipefail\n'
    printf 'SQUAD_REAL_HERDR=%q\n' "$(command -v herdr 2>/dev/null || printf 'herdr')"
    cat <<'HELPER'
# Blocked, grouped by what they destroy:
#   workspace close / tab close / pane close  - the panes the PO is watching
#   session stop / session delete             - the whole herdr session
#   server stop / server live-handoff         - the server behind every session
#   worktree remove                           - the squad's own git worktree
#   config reset-keys                         - the PO's keybindings
#   integration uninstall                     - the PO's agent integrations
#   agent rename / pane release-agent         - not destructive to panes, but
#     they clear the agent name send-to and run-wait resolve through, which
#     breaks addressing for the whole run silently.
case "${1:-} ${2:-}" in
  "workspace close" | "tab close" | "pane close" | \
    "session stop" | "session delete" | \
    "server stop" | "server live-handoff" | \
    "worktree remove" | \
    "config reset-keys" | "integration uninstall" | \
    "agent rename" | "pane release-agent")
    printf 'squad-herdr: blocked dangerous herdr command: %s %s\n' "${1:-}" "${2:-}" >&2
    exit 126
    ;;
esac
exec "$SQUAD_REAL_HERDR" "$@"
HELPER
  } > "$SQUAD_DIR/guard-bin/herdr"
  chmod +x "$SQUAD_DIR/guard-bin/herdr"

  # --- squad-agent --------------------------------------------------------------
  # The single source of truth for agent addressing. send-to, run-wait and the
  # launch-time precondition check all resolve through this one implementation,
  # so there is exactly one place where the herdr lookup can be wrong.

  {
    printf '#!/usr/bin/env bash\n'
    printf 'set -euo pipefail\n'
    printf 'MANAGER_AGENT=%q\n' "$MANAGER_AGENT"
    printf 'CODER_AGENT=%q\n' "$CODER_AGENT"
    printf 'ADVISOR_AGENT=%q\n' "$ADVISOR_AGENT"
    cat <<'HELPER'
# Resolve one squad role to the herdr pane ID that currently plays it.
#
#   squad-agent <manager|coder|advisor>
#
# Prints the pane ID on success. On zero or ambiguous matches it prints nothing
# to stdout and exits non-zero, so a caller can never act on a guess.
#
# TWO methods are tried, because it is not guaranteed that a pane started as
# `herdr agent start <name> -- bash -l` is reported in the snapshot's agents[]
# array: herdr may only populate that array for panes where it DETECTS a known
# AI agent, and these panes run a plain login shell.
#
#   1. `herdr api snapshot` -> .result.snapshot.agents[] matched on .name.
#      Exactly one match is required; several means two runs collided and we
#      refuse to guess between them.
#   2. `herdr agent get <name>` -> .result.agent.pane_id. Per `herdr agent
#      --help`, targets accept unique agent names, so this resolves a named
#      agent even when it is absent from agents[]. It answers
#      {"error":{"code":"agent_not_found"}} with a non-zero exit when there is
#      no such agent.
#
# Method 2 also accepts detected labels and terminal IDs, so a bare label could
# in principle match a pane we did not mean. The returned .name is therefore
# checked against the requested name whenever herdr reports one.

if [[ $# -ne 1 ]]; then
  printf 'Usage: squad-agent <manager|coder|advisor>\n' >&2
  exit 2
fi

ROLE="$1"
case "$ROLE" in
  manager) AGENT_NAME="$MANAGER_AGENT" ;;
  coder) AGENT_NAME="$CODER_AGENT" ;;
  advisor) AGENT_NAME="$ADVISOR_AGENT" ;;
  *)
    printf 'Error: unknown squad role: %s (expected manager, coder, or advisor)\n' "$ROLE" >&2
    exit 2
    ;;
esac

# Method 1: the snapshot's agents[] array.
if SNAPSHOT="$(herdr api snapshot 2>/dev/null)"; then
  MATCHES=()
  while IFS= read -r pane_id; do
    [[ -n "$pane_id" ]] || continue
    MATCHES+=("$pane_id")
  done < <(
    printf '%s' "$SNAPSHOT" |
      jq -r --arg name "$AGENT_NAME" '
        .result.snapshot.agents[]?
        | select(.name == $name)
        | .pane_id
      ' 2>/dev/null || true
  )

  if [[ "${#MATCHES[@]}" -gt 1 ]]; then
    printf 'Error: %s herdr agents are named %s (role %s): %s\n' \
      "${#MATCHES[@]}" "$AGENT_NAME" "$ROLE" "${MATCHES[*]}" >&2
    printf 'Refusing to guess between them.\n' >&2
    exit 1
  fi
  if [[ "${#MATCHES[@]}" -eq 1 ]]; then
    printf '%s\n' "${MATCHES[0]}"
    exit 0
  fi
fi

# Method 2: ask herdr to resolve the name directly.
if AGENT_JSON="$(herdr agent get "$AGENT_NAME" 2>/dev/null)"; then
  PANE_ID="$(
    printf '%s' "$AGENT_JSON" |
      jq -r --arg name "$AGENT_NAME" '
        .result.agent
        | select(.name == null or .name == $name)
        | .pane_id // empty
      ' 2>/dev/null || true
  )"
  if [[ -n "$PANE_ID" ]]; then
