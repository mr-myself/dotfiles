rm -f "$OUT_RESULT" "$OUT_STATUS"

fail() {
  local message="$1"
  printf 'merge-reviews: ERROR: %s\n' "$message" >&2
  printf 'merge-reviews: refusing to emit a pass. Re-run the failed review lens.\n' >&2
  jq -n --arg message "$message" '
    {
      verdict: "must_fix",
      summary: ("merge-reviews failed: " + $message),
      must_fix: [("[merge-reviews] " + $message)],
      should_fix: [],
      test_gaps: []
    }' > "$OUT_RESULT" 2>/dev/null || printf '\n' > "$OUT_RESULT"
  printf '%s\n' "$MERGE_FAILURE_STATUS" > "$OUT_STATUS"
  exit "$MERGE_FAILURE_STATUS"
}

command -v jq >/dev/null 2>&1 || {
  printf 'merge-reviews: ERROR: jq is required.\n' >&2
  printf '%s\n' "$MERGE_FAILURE_STATUS" > "$OUT_STATUS"
  exit "$MERGE_FAILURE_STATUS"
}

