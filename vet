#!/usr/bin/env bash
set -euo pipefail

# ==============================================================================
# vet - review a GitHub Pull Request with two independent AI reviewers
# ==============================================================================
#
# vet checks the PR head out into a detached, throwaway git worktree, merges a
# pre-defined review checklist (common + project override), collects the PR
# context through `gh`, and drives two read-only reviewers in tmux panes:
#
#   Manager    (Claude Code, interactive) - left, talks to you, writes the report
#   Reviewer A (Claude Code, headless)    - right-top
#   Reviewer B (Codex, headless)          - right-bottom
#
# v1 is READ-ONLY. It never edits code and never posts anything to GitHub.

usage() {
  local status="${1:-1}"
  cat <<'EOF'
Usage: vet <pr-number>
       vet <pr-url>
       vet list
       vet close [run-id]
       vet resume [run-id]
       vet render [run-id]
       vet rm <run-id>...
       vet clean

Review a GitHub Pull Request with two independent AI reviewers that look at it
through a pre-defined checklist of review lenses, then produce one consolidated
report.html you can read and copy findings out of. vet never edits code and
never posts to GitHub on its own.

Examples:
  vet 1234
  vet https://github.com/org/repo/pull/1234

Options:
  --allow-empty-checklist  Proceed even when no checklist item could be found.
                           The report says so prominently.
  --include-closed         Review a closed or merged PR (refused by default).
  --open                   Open the finished report.html (macOS).
  --dry-run                Wiring check. Build the worktree, checklist merge,
                           context, prompts, schemas and helpers, but do NOT
                           launch any agent and do NOT split panes outside tmux.
                           PR context is read from fixture files instead of gh:
                           $VET_FIXTURE_DIR/{pr.json,diff.patch,comments.json}
                           (pr.json required, the rest optional).
                           Same as VET_DRY_RUN=1.

Lifecycle:
  vet list               List retained runs and their status.
  vet close              Close the run for the current tmux window.
  vet close <run-id>     Close a run from another tmux window.
  vet resume             Resume the most recent retained run.
  vet resume <run-id>    Resume a specific run. Validates the Manager's JSON
                         and renders the report when the Manager exits.
  vet render [run-id]    Re-render report.html from that run's consolidated.json.
                         Use after fixing the JSON by hand; refuses to render
                         anything that does not match the schema.
  vet rm <run-id>...     Delete closed runs: worktree and artifacts.
  vet clean              Delete ALL runs that are not running (asks first).

Checklist resolution (first match wins):
  common   $VET_CHECKLIST, then ~/.vet/checklist.md,
           then <dir of the real vet script>/_vet/checklist.md
  project  <pr worktree>/.vet/checklist.md, then .review/checklist.md
The project checklist is merged on top: same ID replaces, new ID is appended.

Environment:
  VET_STATE_ROOT             default ${XDG_STATE_HOME:-$HOME/.local/state}/vet
  VET_WORKTREE_ROOT          default ${XDG_DATA_HOME:-$HOME/.local/share}/vet/worktrees
  VET_CHECKLIST              full path to the common checklist
  VET_WAIT_TIMEOUT_SECONDS   reviewer timeout (default 7200)
  VET_MAX_FILES              default 80
  VET_MAX_DIFF_LINES         default 20000
  VET_MAX_CONTEXT_BYTES      default 1500000
  VET_MAX_COMMENT_BYTES      default 400000
EOF
  exit "$status"
}

VET_STATE_ROOT="${VET_STATE_ROOT:-${XDG_STATE_HOME:-$HOME/.local/state}/vet}"
VET_RUN_ROOT="$VET_STATE_ROOT/runs"
VET_WORKTREE_ROOT="${VET_WORKTREE_ROOT:-${XDG_DATA_HOME:-$HOME/.local/share}/vet/worktrees}"
mkdir -p "$VET_RUN_ROOT" "$VET_WORKTREE_ROOT"

# The PO runs vet through a ~/.local/bin symlink, so the bundled _vet/checklist.md
# has to be found relative to the resolved real path, not to $0.
script_real_path() {
  local src="${BASH_SOURCE[0]}" dir
  while [[ -L "$src" ]]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" == /* ]] || src="$dir/$src"
  done
  printf '%s/%s\n' "$(cd -P "$(dirname "$src")" && pwd)" "$(basename "$src")"
}
VET_SCRIPT_PATH="$(script_real_path)"
VET_SCRIPT_DIR="$(dirname "$VET_SCRIPT_PATH")"

# --- shared schema validator ---------------------------------------------------
#
# ONE implementation, used in three places: vet's own gate on the Manager's
# consolidated JSON, the `vet render` subcommand, and the generated
# validate-json helper that the reviewer helpers call from inside their panes.
# Keeping it in a single variable is what stops those three from drifting apart.
#
# It walks the schema file itself rather than hard-coding its rules, and covers
# exactly the JSON Schema subset these schemas use: type, required, enum,
# additionalProperties:false, object properties and array items.
read -r -d '' VET_VALIDATOR_JQ <<'JQPROG' || true
def check($schema; $v; $path):
  ( ($schema.type) as $t
    | if $t == null then empty
      elif $t == "object"  then (if ($v|type) != "object"  then "\($path): expected object, got \($v|type)"  else empty end)
      elif $t == "array"   then (if ($v|type) != "array"   then "\($path): expected array, got \($v|type)"   else empty end)
      elif $t == "string"  then (if ($v|type) != "string"  then "\($path): expected string, got \($v|type)"  else empty end)
      elif $t == "boolean" then (if ($v|type) != "boolean" then "\($path): expected boolean, got \($v|type)" else empty end)
      elif $t == "integer" then (if (($v|type) != "number") or (($v|floor) != $v) then "\($path): expected integer, got \($v|type)" else empty end)
      elif $t == "number"  then (if ($v|type) != "number"  then "\($path): expected number, got \($v|type)"  else empty end)
      else empty end ),
  ( if ($schema.enum != null) and (($schema.enum | index($v)) == null)
    then "\($path): \($v|tojson) is not one of: \($schema.enum | join(", "))"
    else empty end ),
  ( if ($schema.type == "object") and (($v|type) == "object")
    then
      ( (($schema.required // []) - ($v|keys)) | .[] | "\($path): missing required key \"\(.)\"" ),
      ( if ($schema.additionalProperties == false)
        then ((($v|keys) - (($schema.properties // {}) | keys)) | .[] | "\($path): unexpected key \"\(.)\"")
        else empty end ),
      ( ($schema.properties // {}) | to_entries[]
        | . as $p
        | if ($v | has($p.key))
          then check($p.value; $v[$p.key]; (if $path == "(root)" then $p.key else "\($path).\($p.key)" end))
          else empty end )
    else empty end ),
  ( if ($schema.type == "array") and (($v|type) == "array") and ($schema.items != null)
    then ( range(0; ($v|length)) as $i | check($schema.items; $v[$i]; "\($path)[\($i)]") )
    else empty end );

[ check($schema[0]; .; "(root)") ] | .[]
JQPROG

# --- consolidated JSON validation ---------------------------------------------
#
# The Manager is the ONE agent whose output nothing enforces. The reviewers run
# under `claude --json-schema` / `codex --output-schema`, but the Manager just
# writes a file. If it writes JSON that PARSES but does not match the schema -
# omits findings, misspells a severity, drops sources - a bare `jq -e .` check
# passes and the renderer silently produces a page with no findings.
#
# That is the worst failure this tool can have: the PO opens report.html, reads
# "must_fix 0", and merges a PR believing it was reviewed. Refusing to render is
# strictly better than rendering a clean-looking lie, so validation is a hard
# gate, and a partial render is never offered - half a report shown as if whole
# is the same trap.
#
# The checker is driven by the schema file itself rather than a hand-written
# copy of its rules, so the two cannot drift apart.
validate_against_schema() {
  local data="$1" schema="$2" problems=""

  if [[ ! -s "$data" ]]; then
    echo "  the file is empty" >&2
    return 1
  fi
  # `jq empty` tests parsing ONLY. `jq -e .` would be wrong here: it exits 1 for
  # a document that is literally `null`, which parses fine and deserves the
  # precise "expected object, got null" from the schema walk below.
  if ! jq empty "$data" >/dev/null 2>&1; then
    echo "  not valid JSON (truncated or malformed):" >&2
    { jq empty "$data" 2>&1 || true; } | head -3 | sed 's/^/    /' >&2
    return 1
  fi

  problems="$(jq -r --slurpfile schema "$schema" "$VET_VALIDATOR_JQ" "$data")" || {
    echo "  the validator itself failed to run against $schema" >&2
    return 1
  }

  [[ -z "$problems" ]] && return 0
  printf '%s\n' "$problems" | sed 's/^/  /' >&2
  return 1
}

# --- report.html renderer -----------------------------------------------------
#
# vet renders the report, NOT the Manager. The Manager produces consolidated JSON
# validated against consolidated-schema.json; this turns it into one
# self-contained HTML file. Rendering deterministically means the markup cannot
# drift, the clipboard payload is exactly right every time, and the whole thing
# can be developed and checked with --dry-run without spending an agent run.
#
# ESCAPING: every string that reaches the page comes from the PR or from a model
# and is therefore untrusted. jq's @html escapes < > & ' " so it is safe both in
# element text and inside a double-quoted attribute. The clipboard markdown rides
# in a data-md attribute rather than a <script> block on purpose: HTML entities
# are decoded in attribute values, but NOT inside <script>, so a finding
# containing </script> would break out of the latter.
render_report_html() {
  local src="$1" out="$2"
  jq -r \
    --arg pr_number "$PR_NUMBER" \
    --arg pr_title "$PR_TITLE" \
    --arg pr_url "$PR_URL" \
    --arg head_oid "$HEAD_OID" \
    --arg repo_spec "$REPO_SPEC" \
    --arg checklist_common "${COMMON_CHECKLIST:-$COMMON_CHECKLIST_SOURCE}" \
    --arg checklist_project "$PROJECT_CHECKLIST_SOURCE" \
    --arg checklist_count "$CHECKLIST_COUNT" \
    --arg truncated "${CONTEXT_TRUNCATED:-false}" \
    --arg generated "$(date '+%Y-%m-%d %H:%M:%S')" \
    -f /dev/stdin "$src" > "$out" <<'JQPROG'
def esc: if . == null then "" else (tostring | @html) end;

# Paste-ready GitHub comment for one finding. Raw markdown here; the caller
# escapes it for the attribute.
def md($f):
  "**[" + ($f.severity // "") + "] " + ($f.title // "") + "**"
  + (if (($f.checklist_ids // []) | length) > 0
     then "  (" + (($f.checklist_ids // []) | join(", ")) + ")" else "" end)
  + "\n\n"
  + (if (($f.file // "") | length) > 0
     then "`" + $f.file
          + (if (($f.line // 0) > 0) then ":" + (($f.line // 0) | tostring) else "" end)
          + "`\n\n"
     else "" end)
  + (($f.body // "") | rtrimstr("\n")) + "\n"
  + (if (($f.suggestion // "") | length) > 0
     then "\n```suggestion\n" + (($f.suggestion) | rtrimstr("\n")) + "\n```\n"
     else "" end);

def loc($f):
  if (($f.file // "") | length) == 0 then ""
  else ($f.file | esc)
       + (if (($f.line // 0) > 0) then ":" + (($f.line // 0) | tostring) else "" end)
       + (if (($f.line_range // "") | length) > 0 then " (" + ($f.line_range | esc) + ")" else "" end)
  end;

def finding_html($f):
  "<article class=\"f sev-" + (($f.severity // "other") | esc) + "\">"
  + "<h3>" + (($f.title // "(untitled)") | esc) + "</h3>"
  + "<div class=\"meta\">"
  + "<span class=\"pill sev\">" + (($f.severity // "") | esc) + "</span>"
  + (if (($f.category // "") | length) > 0 then "<span class=\"pill\">" + ($f.category | esc) + "</span>" else "" end)
  + (if (($f.confidence // "") | length) > 0 then "<span class=\"pill\">confidence: " + ($f.confidence | esc) + "</span>" else "" end)
  + (($f.checklist_ids // []) | map("<span class=\"pill id\">" + esc + "</span>") | join(""))
  + (if (($f.sources // []) | length) > 0
     then "<span class=\"pill src\">found by: " + (($f.sources // []) | map(esc) | join(", ")) + "</span>"
     else "" end)
  + "</div>"
  + (if (loc($f) | length) > 0 then "<p class=\"loc\"><code>" + loc($f) + "</code></p>" else "" end)
  + (if (($f.body // "") | length) > 0 then "<p class=\"body\">" + ($f.body | esc) + "</p>" else "" end)
  + (if (($f.evidence // "") | length) > 0
     then "<details class=\"ev\"><summary>evidence</summary><pre><code>" + ($f.evidence | esc) + "</code></pre></details>"
     else "" end)
  + (if (($f.suggestion // "") | length) > 0
     then "<div class=\"sug\"><div class=\"sug-h\">suggested fix</div><pre><code>" + ($f.suggestion | esc) + "</code></pre></div>"
     else "" end)
  + "<button class=\"copy\" type=\"button\" data-md=\"" + (md($f) | @html) + "\">Copy as markdown</button>"
  + "</article>";

def section($title; $sev; $open):
  ([.findings[]? | select((.severity // "") == $sev)]) as $fs
  | if ($fs | length) == 0 then "" else
      "<details class=\"sec\"" + (if $open then " open" else "" end) + ">"
      + "<summary><span class=\"sev-dot sev-" + $sev + "\"></span>"
      + $title + " <span class=\"count\">" + (($fs | length) | tostring) + "</span></summary>"
      + ($fs | map(finding_html(.)) | join(""))
      + "</details>"
    end;

def count($sev): [.findings[]? | select((.severity // "") == $sev)] | length;

"<!DOCTYPE html>",
"<html lang=\"ja\"><head><meta charset=\"utf-8\">",
"<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">",
"<title>vet #" + ($pr_number | esc) + " " + ($pr_title | esc) + "</title>",
"<style>",
":root{color-scheme:light dark;--bg:#fff;--fg:#1a1a1a;--mut:#5a5f66;--line:#d5d9de;--card:#fafbfc;--code:#f3f4f6;--acc:#0969da;--must:#cf222e;--should:#bc4c00;--nit:#6e7781;--quest:#8250df}",
"@media(prefers-color-scheme:dark){:root{--bg:#0d1117;--fg:#e6edf3;--mut:#9198a1;--line:#30363d;--card:#161b22;--code:#161b22;--acc:#4493f8;--must:#ff7b72;--should:#ffa657;--nit:#8b949e;--quest:#d2a8ff}}",
"*{box-sizing:border-box}",
"body{margin:0;padding:2rem 1rem 4rem;background:var(--bg);color:var(--fg);font:15px/1.65 -apple-system,BlinkMacSystemFont,'Hiragino Sans','Noto Sans JP',sans-serif}",
"main{max-width:60rem;margin:0 auto}",
"h1{font-size:1.3rem;margin:0 0 .3rem}",
"h1 a{color:var(--acc);text-decoration:none}h1 a:hover{text-decoration:underline}",
"h3{font-size:1.02rem;margin:0 0 .5rem;line-height:1.45}",
".sub{color:var(--mut);font-size:.87rem;margin:0 0 1.4rem}",
".counts{display:flex;flex-wrap:wrap;gap:.5rem;margin:0 0 1.8rem}",
".c{border:1px solid var(--line);border-radius:999px;padding:.28rem .8rem;font-size:.85rem;font-weight:600}",
".c.zero{opacity:.45;font-weight:400}",
".c-must{color:var(--must)}.c-should{color:var(--should)}.c-nit{color:var(--nit)}.c-quest{color:var(--quest)}",
".sec{border:1px solid var(--line);border-radius:10px;margin:0 0 1rem;background:var(--card)}",
".sec>summary{cursor:pointer;padding:.75rem 1rem;font-weight:600;list-style:none;user-select:none}",
".sec>summary::-webkit-details-marker{display:none}",
".sec>summary::before{content:'\\25B8';display:inline-block;margin-right:.5rem;color:var(--mut);transition:transform .15s}",
".sec[open]>summary::before{transform:rotate(90deg)}",
".sev-dot{display:inline-block;width:.6rem;height:.6rem;border-radius:50%;margin-right:.45rem;vertical-align:middle}",
".sev-dot.sev-must_fix{background:var(--must)}.sev-dot.sev-should_fix{background:var(--should)}",
".sev-dot.sev-nit{background:var(--nit)}.sev-dot.sev-question{background:var(--quest)}",
".count{color:var(--mut);font-weight:400}",
".f{border-top:1px solid var(--line);padding:1.1rem 1rem 1.3rem}",
".meta{display:flex;flex-wrap:wrap;gap:.35rem;margin:0 0 .6rem}",
