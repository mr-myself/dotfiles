  printf 'Context truncated: %s\n' "$CONTEXT_TRUNCATED"
  printf 'Wait timeout:      %s seconds\n' "$WAIT_TIMEOUT_SECONDS"
} > "$VET_DIR/run-info.txt"

cat "$VET_DIR/run-info.txt"
echo ""
if [[ "$CONTEXT_TRUNCATED" == "true" ]]; then
  echo "WARNING: this review will not cover the whole PR:"
  sed 's/^/  /' "$VET_DIR/context-limits.txt"
  echo ""
fi

if [[ "$DRY_RUN" == "true" ]]; then
  echo "Dry run: no agent was launched and no pane was split."
  echo "Generated artifacts:"
  find "$VET_DIR" -mindepth 1 -maxdepth 1 -exec basename {} \; | sort | sed 's/^/  /'
  echo ""
  echo "Inspect the wiring with:"
  printf "  cat '%s'\n" "$VET_DIR/checklist.merged.md"
  printf "  cat '%s'\n" "$VET_DIR/reviewer-a-task.md"
  printf "  cat '%s'\n" "$VET_DIR/manager-prompt.md"
  echo ""
  # Render the report too when a fixture supplies consolidated JSON. This is how
  # the renderer is developed and regression-checked without spending an agent
  # run: drop a consolidated.json next to the other fixtures and --dry-run it.
  if [[ -f "$FIXTURE_DIR/consolidated.json" ]]; then
    cp "$FIXTURE_DIR/consolidated.json" "$CONSOLIDATED_PATH"
    # Same hard gate as a real run, so the validator is exercised here too.
    if validate_against_schema "$CONSOLIDATED_PATH" "$VET_DIR/consolidated-schema.json"; then
      render_report_html "$CONSOLIDATED_PATH" "$REPORT_PATH"
      echo ""
      echo "Rendered from fixture consolidated JSON:"
      printf '%s\n' "$REPORT_PATH"
    else
      echo "" >&2
      echo "Fixture consolidated JSON does not match the schema (above)." >&2
      echo "Nothing was rendered." >&2
      DRY_RUN_RENDER_FAILED=true
    fi
  fi
  echo ""
  printf "Remove this dry run with: vet rm %s\n" "$RUN_ID"
  # A dry run's artifacts ARE the deliverable - the PO inspects them and removes
  # them with `vet rm`. Commit before exiting so the cleanup trap keeps them.
  VET_LAUNCH_COMMITTED=true
  if [[ "${DRY_RUN_RENDER_FAILED:-false}" == "true" ]]; then
    exit 1
  fi
  exit 0
fi

