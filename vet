  printf 'PR URL:            %s\n' "$PR_URL"
  printf 'PR state:          %s (draft: %s)\n' "$PR_STATE" "$PR_IS_DRAFT"
  printf 'Reviewed head OID: %s\n' "$HEAD_OID"
  printf 'Started at:        %s\n' "$STARTED_AT"
  printf 'PR worktree:       %s (detached, no branch)\n' "$WORKDIR"
  printf 'Your repository:   %s (untouched)\n' "$REPO_ROOT"
  printf 'Artifacts:         %s\n' "$VET_DIR"
  printf 'Report will be at: %s\n' "$REPORT_PATH"
  printf 'Manager writes:    %s\n' "$CONSOLIDATED_PATH"
  printf 'Checklist:         %s items (common: %s, project: %s)\n' \
