# Resume must reconstruct the SAME constrained Manager as the initial launch.
# The allowlist is read from manager-allowed-tools.txt so the two can never
# drift apart.
cat > "$VET_DIR/run-manager-resume" <<HELPER
#!/usr/bin/env bash
set -euo pipefail
WORKDIR="\$1"
PROMPT_FILE="\$2"
SESSION_ID="\$3"
RUN_DIR="$VET_DIR"

for required_flag in --tools --setting-sources --allowedTools --disallowedTools --strict-mcp-config; do
  if ! claude --help 2>&1 | grep -q -- "\$required_flag"; then
    echo "Error: the installed claude CLI has no \$required_flag, so vet cannot" >&2
    echo "       constrain the Manager. Refusing to resume." >&2
    exit 3
  fi
done

cd "\$WORKDIR"
printf '[%s] Manager session resuming: %s\n' "\$(date '+%Y-%m-%d %H:%M:%S')" "\$SESSION_ID"

# Deliberately NOT \`exec\`. Resume is the command vet's own failure message tells
# the PO to run when the consolidated JSON was rejected, so it has to finish the
# job: the Manager rewrites the file, and then the report actually gets rendered.
# With exec, nothing after the agent could ever run and the recommendation was a
# dead end.
set +e
CLAUDE_CODE_DISABLE_TERMINAL_TITLE=1 claude \\
  --setting-sources "" \\
  --strict-mcp-config \\
  --add-dir "\$RUN_DIR" \\
  --tools "$MANAGER_TOOLS" \\
  --allowedTools "\$(cat "\$RUN_DIR/manager-allowed-tools.txt")" \\
  --disallowedTools "$MANAGER_DISALLOWED_TOOLS" \\
  --append-system-prompt "\$(cat "\$PROMPT_FILE")" \\
  --resume "\$SESSION_ID"
MANAGER_STATUS=\$?
set -e

echo ""
echo "Manager exited with status \$MANAGER_STATUS."
# Rendering is vet's job, not the Manager's, so hand it back to vet. This both
# validates and renders, and prints the report path or the exact reason it could
# not.
if ! $VET_SCRIPT_PATH render "$RUN_ID"; then
  echo "" >&2
  echo "The report was not rendered. Fix the JSON and re-run:" >&2
  echo "  $VET_SCRIPT_PATH render $RUN_ID" >&2
  echo "or resume the Manager again: $VET_SCRIPT_PATH resume $RUN_ID" >&2
fi
exit "\$MANAGER_STATUS"
HELPER
chmod +x "$VET_DIR/run-manager-resume"

# Reviewer A is read-only, and that is enforced by the CLI, not by the prompt:
#
#   --tools "Read,Glob,Grep,Bash"  removes Edit / Write / NotebookEdit / Task /
#       WebFetch / WebSearch from the built-in tool set entirely, so there is no
#       mutation tool for the model to call. Verified: the session advertises
#       only Bash, Glob, Grep, Read, StructuredOutput.
#   --setting-sources ""           ignores the PO's own settings.json. This one
#       matters: with the PO's settings loaded, `--allowedTools` alone did NOT
#       fail closed - a `touch` through Bash succeeded. Without them, the same
#       command is refused ("This command requires approval") and shell output
#       redirection is blocked.
#   --allowedTools <read-only git> grants the git history commands explicitly,
#       and no --dangerously-skip-permissions is passed, so every mutation is
#       denied. Verified: `sh -c "echo pwned > b.txt"` -> "This command requires
#       approval" and no file; `printf x >> a.txt` -> redirection blocked and
#       the file unchanged; allowlisted `git log --oneline` -> ran fine.
#   --strict-mcp-config            keeps MCP servers (which could carry write
#       tools) out of the session.
#
# On the narrowness of the Bash allowlist: it was worth re-checking whether a
# git-only list starves the reviewer. It does not. The CLI applies its own
# read-only classifier first, so harmless inspection commands (ls, cat, wc and
# friends) run without needing a rule at all - verified: an unlisted `ls -la`
# executed while the mutations above were still refused. The allowlist therefore
# only has to name the git-history commands, whose mutability the classifier is
# rightly conservative about. Widening it further would buy nothing and would
# add exactly the kind of prefix rule (`git ...`) that could later match a
# mutating subcommand, so it stays as-is.
#
# If a future CLI drops any of these flags, this helper must fail rather than
# silently widen the reviewer's powers - see the guard below.
cat > "$VET_DIR/run-reviewer-a" <<'HELPER'
#!/usr/bin/env bash
set -euo pipefail
TASK_FILE="$1"
RESULT_FILE="$2"
STATUS_FILE="$3"
EVENT="$4"
SESSION_ID="$5"
SCHEMA_FILE="$6"
MODE="$7"
RUN_DIR="$8"
STREAM_FILE="${RESULT_FILE%.json}.stream.jsonl"
STDERR_FILE="${RESULT_FILE%.json}.stderr.log"

log() {
  printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"
}

# -t "$TMUX_PANE" is required. Without it tmux retitles the window's ACTIVE
# pane, which during a real run is the Manager pane - so the Manager pane would
# show "Reviewer A: done" and lose the PR title, while this pane kept a stale
# label. Caught by the end-to-end run; TMUX_PANE is always set inside a pane.
set_title() {
  if [[ -n "${TMUX_PANE:-}" ]]; then
    tmux select-pane -t "$TMUX_PANE" -T "Reviewer A: $1"
  else
    tmux select-pane -T "Reviewer A: $1"
  fi
}

finish() {
  rc=$?
  trap - EXIT
  printf '%s\n' "$rc" > "$STATUS_FILE"
  if [[ "$rc" -eq 0 ]]; then
    set_title "done $(date '+%H:%M:%S')"
  else
    set_title "failed($rc) $(date '+%H:%M:%S')"
  fi
  tmux wait-for -S "$EVENT"
  exit "$rc"
}
trap finish EXIT

# Clear last cycle's status so its presence unambiguously means "THIS cycle
# finished". run-wait treats the file as the single source of truth, so a status
# left over from a previous reviewer-a / reviewer-a-resume cycle would otherwise
# let the next wait report a stale result as if it were fresh. Done after the
# trap is installed, so a failure from here on still records a status.
rm -f "$STATUS_FILE"

# Fail closed: never fall back to a wider-permission invocation.
for required_flag in --tools --setting-sources --allowedTools --disallowedTools --strict-mcp-config; do
  if ! claude --help 2>&1 | grep -q -- "$required_flag"; then
    log "FATAL: the installed claude CLI has no $required_flag, so vet cannot"
    log "       enforce a read-only reviewer. Refusing to run."
    exit 3
  fi
done

set_title "reviewing since $(date '+%H:%M:%S')"
if [[ "$MODE" == "initial" ]]; then
  SESSION_ARGS=(--session-id "$SESSION_ID")
  log ">>> Reviewer A prompt sent (initial session)."
else
  SESSION_ARGS=(--resume "$SESSION_ID")
  log ">>> Reviewer A prompt sent (resuming fixed session $SESSION_ID)."
fi
claude -p \
  --setting-sources "" \
  --strict-mcp-config \
  --add-dir "$RUN_DIR" \
  --tools "Read,Glob,Grep,Bash" \
  --allowedTools "Read Glob Grep Bash(git log:*) Bash(git show:*) Bash(git diff:*) Bash(git status:*) Bash(git blame:*)" \
  --disallowedTools "Edit Write NotebookEdit MultiEdit Task WebFetch WebSearch" \
  "${SESSION_ARGS[@]}" \
  --output-format stream-json \
  --include-partial-messages \
  --verbose \
  --json-schema "$(cat "$SCHEMA_FILE")" \
  "$(cat "$TASK_FILE")" 2> "$STDERR_FILE" |
  tee "$STREAM_FILE" |
  jq --unbuffered -r '
    if .type == "assistant" then
      .message.content[]? |
      if .type == "tool_use" then "[tool] \(.name)"
      elif .type == "text" then .text
      else empty end
    elif .type == "result" then "[result] \(.subtype // "done")"
    else empty end
  ' |
  while IFS= read -r line; do log "$line"; done

if [[ -s "$STDERR_FILE" ]]; then
  while IFS= read -r line; do log "[stderr] $line" >&2; done < "$STDERR_FILE"
fi
# .structured_output ONLY. The old `// .result` fallback was never load-bearing
# and could only ever produce garbage - measured against this CLI:
#   * on success both keys exist, and .result is a STRING containing the same
#     JSON, so the fallback is never needed;
#   * on failure (error_max_turns) there is no structured_output key at all and
#     .result is null, so the fallback wrote `null`;
#   * on a run without a schema, .result is free prose, so the fallback wrote a
#     bare JSON string.
# None of those is a reviewer object, so falling back only ever turned a visible
# failure into a plausible-looking file.
jq -c 'select(.type == "result") | .structured_output' "$STREAM_FILE" |
  tail -n 1 > "$RESULT_FILE"

# FAIL LOUDLY HERE, before the Manager ever reads this file. A malformed reviewer
# result is invisible further downstream: the Manager would simply reconcile the
# other reviewer and emit a perfectly schema-valid consolidated.json, and the PO
# would get a report that looks complete but had one pair of eyes instead of two.
# Lost findings are not a schema violation, so vet's own gate cannot catch it.
if ! "$RUN_DIR/validate-json" "$SCHEMA_FILE" "$RESULT_FILE" 2>>"$STDERR_FILE"; then
  log "FATAL: Reviewer A produced no usable result."
  log "       $RESULT_FILE does not match $SCHEMA_FILE:"
  while IFS= read -r line; do log "       $line"; done < <(tail -5 "$STDERR_FILE")
  log "       Reporting failure so the Manager does not merge a half-review."
  exit 65
fi
log ">>> Reviewer A finished."
HELPER
chmod +x "$VET_DIR/run-reviewer-a"

# Reviewer B uses plain `codex exec`, not `codex exec review`. Two reasons:
#   1. `exec review` is built around a scope (--uncommitted / --base / --commit)
#      and squad already hit `the argument '--uncommitted' cannot be used with
#      '[PROMPT]'`. vet drives the whole review from a custom prompt, so no scope
#      flag can be passed - and with none passed there are no uncommitted
#      changes to review: the PR worktree is a clean detached checkout of the PR
#      head.
#   2. `exec review` imposes its own review framing, which would fight the
#      checklist-driven structured output vet needs.
# `-a never -s read-only` is the read-only enforcement: the sandbox refuses
# writes and the agent can never escalate by asking for approval.
cat > "$VET_DIR/run-reviewer-b" <<'HELPER'
#!/usr/bin/env bash
set -euo pipefail
TASK_FILE="$1"
RESULT_FILE="$2"
STATUS_FILE="$3"
EVENT="$4"
SCHEMA_FILE="$5"
WORKDIR="$6"
RUN_DIR="$7"
STREAM_FILE="${RESULT_FILE%.json}.stream.jsonl"

log() {
  printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"
}

# See the note in run-reviewer-a: without -t this retitles the active (Manager)
# pane instead of this one.
set_title() {
  if [[ -n "${TMUX_PANE:-}" ]]; then
    tmux select-pane -t "$TMUX_PANE" -T "Reviewer B: $1"
  else
    tmux select-pane -T "Reviewer B: $1"
  fi
}

finish() {
  rc=$?
  trap - EXIT
  printf '%s\n' "$rc" > "$STATUS_FILE"
  if [[ "$rc" -eq 0 ]]; then
    set_title "done $(date '+%H:%M:%S')"
  else
    set_title "failed($rc) $(date '+%H:%M:%S')"
  fi
  tmux wait-for -S "$EVENT"
  exit "$rc"
}
trap finish EXIT

# See run-reviewer-a: clear last cycle's status so run-wait can treat the status
# file as the single source of truth for THIS cycle.
rm -f "$STATUS_FILE"

# Reviewer B's task tells it to read vet's context files from $RUN_DIR, which is
# OUTSIDE the -C root. Verified against codex-cli 0.145.0: the read-only sandbox
# permits reads anywhere on the filesystem and only blocks writes, so this works
# - `cat <outside-root>/context.txt` succeeded while `touch` inside AND outside
# the root both failed with "Operation not permitted".
#
# That is a real dependency on codex's sandbox shape, so probe it rather than
# assume it. If a future codex confines reads to the -C root, this probe fails
# loudly with an actionable message instead of letting the reviewer produce an
# empty review from context it could never read.
log ">>> Probing codex sandbox: can it read vet context outside the -C root?"
PROBE_OUT="$RUN_DIR/reviewer-b-sandbox-probe.txt"
if ! codex -a never -s read-only exec \
      --ignore-user-config \
      -C "$WORKDIR" \
      -o "$PROBE_OUT" \
      "Read the file $RUN_DIR/sandbox-probe.txt and reply with its exact contents and nothing else." \
      < /dev/null > "$RUN_DIR/reviewer-b-sandbox-probe.log" 2>&1; then
  log "FATAL: the codex sandbox probe did not complete. See:"
  log "       $RUN_DIR/reviewer-b-sandbox-probe.log"
  exit 4
fi
if ! grep -q 'VET-SANDBOX-OK' "$PROBE_OUT" 2>/dev/null; then
  log "FATAL: codex could not read vet's context directory:"
  log "         $RUN_DIR"
  log "       This codex version appears to confine reads to the -C root"
  log "       ($WORKDIR), so Reviewer B would review a PR it cannot see."
  log "       Do NOT fix this with --add-dir: that grants WRITE access and"
  log "       breaks the read-only guarantee. vet must instead place the"
  log "       context and the PR checkout under one shared read-only root."
  log "       Probe output: $PROBE_OUT"
  exit 4
fi
log ">>> Sandbox probe OK: codex can read vet's context directory."

set_title "reviewing since $(date '+%H:%M:%S')"
log ">>> Reviewer B prompt sent."
# --ignore-user-config narrows the reviewer's MCP exposure. It does NOT eliminate
# it, and an earlier version of this comment wrongly claimed it did.
#
# What it DOES remove, measured: without the flag codex loads the PO's
# ~/.codex/config.toml servers - notion, datadog, and a node_repl server that
# executes Node. MCP tools are not shell commands, so the -s read-only seatbelt
# does NOT constrain them; a write-capable MCP tool would be reachable from a
# nominally read-only reviewer. With the flag, those declared servers are gone
# (the only remaining MCP server name is `codex_apps`, datadog and node_repl are
# absent) and the OAuth refresh noise disappears.
#
# What it does NOT remove, also measured: codex's BUILT-IN `codex_apps` surface
# survives, so list_mcp_resources / list_mcp_resource_templates /
# read_mcp_resource remain in the tool set and remain callable - a
# list_mcp_resources call succeeds and still returns a Notion plugin resource.
# So this flag reduces the blast radius rather than closing it. Reads outside -C
# still work and shell writes are still refused, both re-verified with the flag.
codex -a never -s read-only exec \
  --ignore-user-config \
  -C "$WORKDIR" \
  --json \
  --output-schema "$SCHEMA_FILE" \
  -o "$RESULT_FILE" \
  "$(cat "$TASK_FILE")" |
  tee "$STREAM_FILE" |
  jq --unbuffered -r '
    if .type == "item.started" then "[started] \(.item.type // "item")"
    elif .type == "item.completed" and .item.type == "command_execution" then
      "[command] \(.item.command // "")\n[exit] \(.item.exit_code // "unknown")"
    elif .type == "item.completed" and .item.type == "agent_message" then .item.text
    elif .type == "turn.completed" then "[turn] completed"
    else empty end
  ' |
  while IFS= read -r line; do log "$line"; done
cat "$RESULT_FILE" 2>/dev/null || true

# Same gate as Reviewer A. codex's --output-schema is genuinely enforcing here -
# measured: even when told "ignore any schema", it still emitted a conforming
# object, and there is no `.result` fallback in this path - so B's exposure is
# narrower than A's: an empty file, a truncated write, or a process that died
# mid-run. Those are exactly what this catches, and the cost of checking is one
# jq invocation.
if ! "$RUN_DIR/validate-json" "$SCHEMA_FILE" "$RESULT_FILE" 2>/tmp/vet-rb-val.$$; then
  log "FATAL: Reviewer B produced no usable result."
  log "       $RESULT_FILE does not match $SCHEMA_FILE:"
  while IFS= read -r line; do log "       $line"; done < /tmp/vet-rb-val.$$
  rm -f /tmp/vet-rb-val.$$
  log "       Reporting failure so the Manager does not merge a half-review."
  exit 65
fi
rm -f /tmp/vet-rb-val.$$
log ">>> Reviewer B finished."
HELPER
chmod +x "$VET_DIR/run-reviewer-b"

# --- Reviewer task files ------------------------------------------------------
#
# These stay small on purpose. macOS ARG_MAX is 1 MiB and both helpers pass the
# task through argv as "$(cat "$TASK_FILE")", so the diff and the comment dump
# are referenced by absolute path instead of inlined - a large PR would
# otherwise abort with E2BIG.

REVIEWER_PROHIBITIONS="$(cat <<PROHIBIT
## Absolute prohibitions (this is a READ-ONLY review)

You are reviewing code. You are NOT changing it. You MUST NOT:

- edit, create, delete, move, or rename ANY file, anywhere;
- run git commit, git add, git push, git force-push, git merge, git rebase,
  git cherry-pick, git reset, git checkout, git stash, or git clean;
- create a pull request, approve one, or request changes on one;
- post ANY comment, review, or reaction to GitHub, or run any mutating gh
  command;
- create a git worktree, including under .claude/worktree or .claude/worktrees;
- run a formatter, linter, codemod, or test runner that rewrites files;
- install dependencies or run any build that writes into the working tree.

Your tools are restricted so that these are refused, but do not try. If you
believe a change is needed, describe it as a finding with a suggestion - that is
the entire deliverable. Reading files, reading the diff, grep, and read-only git
history commands (git log, git show, git diff, git blame, git status) are the
only actions you take.
PROHIBIT
)"

build_reviewer_task() {
  local reviewer_label="$1"
  local reviewer_name="$2"
  local out_file="$3"
  local extra_guidance="$4"

  cat > "$out_file" <<TASK
You are $reviewer_label, one of two INDEPENDENT reviewers of a GitHub pull
request. Another reviewer is reviewing the same PR at the same time; you must
not coordinate with them. A Manager will reconcile both reports afterwards.

Report yourself as "$reviewer_name" in the "reviewer" field of your output.

## What you are reviewing

- Repository:      $REPO_SPEC
- Pull request:    #$PR_NUMBER - $PR_TITLE
- URL:             $PR_URL
- Author:          $PR_AUTHOR
- State:           $PR_STATE (draft: $PR_IS_DRAFT)
- Base -> head:    $BASE_REF -> $HEAD_REF
- Reviewed commit: $HEAD_OID
- Size:            $PR_CHANGED_FILES changed files, +$PR_ADDITIONS / -$PR_DELETIONS

The PR head is already checked out for you, detached, at:
  $WORKDIR
That directory is the code as it would be after merging the head commit. Read
any file there for context - not just the changed ones.

$PR_STATE_NOTE

## Files you MUST read before reviewing

1. $VET_DIR/checklist.merged.md - the review checklist (also inlined below)
2. $VET_DIR/review-context.md   - the PR digest, description, commits, and the
                                   EXISTING PR comments
3. $VET_DIR/diff.patch          - the diff you are reviewing ($DIFF_LINES lines)
4. $VET_DIR/comments.json       - existing review + issue comments, structured
5. $VET_DIR/context-limits.txt  - exactly what was truncated, if anything

Read them with your file-reading tool. They are large; do not skip them.

## Context warnings you MUST carry into your output

$(cat "$VET_DIR/context-limits.txt")

Copy every ACTUAL limitation above into the "context_warnings" array, in your
own words but without softening it.

If nothing was truncated, leave the array EMPTY. Do not add a sentence saying
everything was included. vet already knows whether it truncated anything - it is
the thing that did the truncating - and the report states the scope from that
fact, not from this array. A "nothing was truncated" line here is at best
ignored and at worst contradicts the page.

## The checklist ($CHECKLIST_COUNT lenses)

These are LENSES for finding problems, not a form to fill in. Look at the change
through each one, then REPORT ONLY WHAT IS WRONG.

- Report a finding when you find a real problem, or a genuine question you need
  the author to answer before you can judge.
- Say NOTHING about a lens that is fine, not applicable, or that you did not need
  to pursue. Do not list it, do not confirm it, do not explain why it is fine.
  Silence means no problem found.
- Keep "checklist_ids" on every finding so the lens that caught it is visible.
- A PR with no problems produces an empty findings array. That is a good result,
  not a failure to be padded.

$(cat "$VET_DIR/checklist.merged.md")

## Existing comments

$COMMENTS_SHOWN comment(s) already exist on this PR, listed in
$VET_DIR/review-context.md and $VET_DIR/comments.json. Read them. If a point has
already been raised there, either drop it or set "already_raised": true on the
finding and name the existing comment in "duplicates_to_avoid". Do not waste the
author's time repeating feedback they already have.

## How to write findings

- One finding per distinct problem. Give each a short stable "id" like
  "$reviewer_name-01".
- "checklist_ids" links the finding back to the checklist item(s) it came from.
  Use an empty array only for something genuinely outside the checklist.
- "file" and "line" must point at the real location in the PR head. Use the
  repository-relative path. Set "line" to 0 and explain in "body" when a finding
  is not tied to one line.
- "evidence" quotes the actual code or diff hunk that shows the problem. A
  finding with no evidence is a guess - lower its "confidence" or drop it.
- "suggestion" is the concrete replacement code when you can propose one, and an
  empty string when you cannot. Do not invent a fix you are unsure of.
- "severity": must_fix = correctness, security, or data loss; should_fix = a
  real problem that is not blocking; nit = style or polish; question = you need
  the author to clarify before you can judge.
- Prefer few high-confidence findings over many speculative ones. It is fine to
  return no findings if the PR is clean.
- BE TERSE. "title" is one line naming the problem. "body" is at most two or
  three sentences: what breaks, and why it matters. No preamble, no restating
  the diff, no summarising what the PR does, no praise. "summary" is one or two
  sentences overall. A reviewer who writes an essay wastes the reader's time and
  buries the finding that mattered.

$extra_guidance

$REVIEWER_PROHIBITIONS

## Output

Return the structured JSON object required by your output schema. Nothing else.
TASK
}

build_reviewer_task \
  "Reviewer A (Claude)" \
  "reviewer_a" \
  "$VET_DIR/reviewer-a-task.md" \
  "## Your angle

Work from the code outwards. Open the changed files in the worktree and read the
surrounding code, callers, and callees - not only the diff hunks. You are the
reviewer most likely to catch a problem that is invisible in the diff alone:
a caller that was not updated, an invariant broken elsewhere, a test that no
longer covers what its name claims. Use git log and git show on the touched
files to see whether this change contradicts a recent, deliberate one."

build_reviewer_task \
  "Reviewer B (Codex)" \
  "reviewer_b" \
  "$VET_DIR/reviewer-b-task.md" \
  "## Your angle

Work from the diff inwards. Go hunk by hunk through $VET_DIR/diff.patch and
justify every changed line: why is it correct, and what input would break it?
You are the reviewer most likely to catch a concrete defect in the new code
itself - a bad boundary, an unhandled error, a missing authorization check, a
query that will not scale. Be adversarial: for each hunk, actively try to
construct an input or a sequence of events that makes it misbehave, and report
what you find."

