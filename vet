"pre{background:var(--code);border:1px solid var(--line);border-radius:8px;padding:.7rem .85rem;overflow-x:auto;margin:.3rem 0}",
"pre code{background:none;padding:0}",
".ev summary{cursor:pointer;color:var(--mut);font-size:.85rem}",
".sug-h{font-size:.78rem;color:var(--mut);margin-top:.6rem}",
".copy{margin-top:.85rem;font:inherit;font-size:.83rem;padding:.4rem .9rem;border:1px solid var(--line);border-radius:7px;background:var(--bg);color:var(--fg);cursor:pointer}",
".copy:hover{border-color:var(--acc);color:var(--acc)}",
".copy.ok{border-color:#1a7f37;color:#1a7f37}.copy.err{border-color:var(--must);color:var(--must)}",
".contra{border:1px solid var(--line);border-radius:10px;padding:.4rem 1rem 1rem;margin:0 0 1rem;background:var(--card)}",
".contra h2{font-size:.95rem;margin:.8rem 0 .5rem}",
".warn{border:1px solid var(--should);border-radius:10px;padding:.7rem 1rem;margin:0 0 1.2rem;color:var(--should)}",
".none{color:var(--mut);padding:1.2rem 0}",
"footer{margin-top:2.5rem;padding-top:1rem;border-top:1px solid var(--line);color:var(--mut);font-size:.8rem}",
"footer div{margin:.15rem 0}",
"</style></head><body><main>",

"<h1><a href=\"" + ($pr_url | esc) + "\">#" + ($pr_number | esc) + "</a> " + ($pr_title | esc) + "</h1>",
"<p class=\"sub\">" + ($repo_spec | esc) + " &middot; reviewed " + ($head_oid[0:12] | esc) + " &middot; " + ($generated | esc) + "</p>",

"<div class=\"counts\">"
+ "<span class=\"c c-must" + (if count("must_fix") == 0 then " zero" else "" end) + "\">must_fix " + (count("must_fix")|tostring) + "</span>"
+ "<span class=\"c c-should" + (if count("should_fix") == 0 then " zero" else "" end) + "\">should_fix " + (count("should_fix")|tostring) + "</span>"
+ "<span class=\"c c-nit" + (if count("nit") == 0 then " zero" else "" end) + "\">nit " + (count("nit")|tostring) + "</span>"
+ "<span class=\"c c-quest" + (if count("question") == 0 then " zero" else "" end) + "\">question " + (count("question")|tostring) + "</span>"
+ "</div>",

# THE BANNER IS VET'S FACT, NOT THE MODEL'S PROSE.
#
# It used to fire whenever context_warnings was non-empty. But the reviewers were
# asked to state explicitly when nothing was truncated, so on every clean run
# they wrote "Nothing was truncated ..." - a NON-EMPTY array - and the page
# announced "this review did not see the whole PR": the opposite of what the
# model said and of what vet knew. A warning that cries wolf on every run trains
# the reader to ignore it, and then the one genuinely truncated PR looks
# identical to all the others.
#
# $truncated comes from vet's own CONTEXT_TRUNCATED, computed from what vet
# actually dropped and persisted in state.env so `vet render` agrees. The
# reviewers' warnings are shown as supporting detail ONLY when vet truncated;
# a "nothing was truncated" sentence a model volunteers anyway is deliberately
# ignored, because the footer states scope from vet's own fact either way.
(if $truncated == "true"
 then "<div class=\"warn\"><strong>この review は PR 全体を見ていません</strong>"
      + (if ((.context_warnings // []) | length) > 0
         then "<div>レビュアーの申告:</div>"
              + ((.context_warnings // []) | map("<div>" + esc + "</div>") | join(""))
         else "" end)
      + "</div>"
 else "" end),

(if ((.summary // "") | length) > 0 then "<p class=\"body\">" + (.summary | esc) + "</p>" else "" end),

section("must_fix"; "must_fix"; true),
section("should_fix"; "should_fix"; true),
section("nit"; "nit"; false),
section("question"; "question"; false),

(if ((.findings // []) | length) == 0
 then "<p class=\"none\">指摘なし。チェックリストのどのレンズでも問題は見つかりませんでした。</p>"
 else "" end),

(if ((.contradictions // []) | length) > 0
 then "<div class=\"contra\"><h2>2人のレビュアーの見解が割れた点</h2>"
      + ((.contradictions // []) | map(
          "<article class=\"f\" style=\"border-top:0;padding-left:0;padding-right:0\">"
          + "<h3>" + ((.topic // "") | esc) + "</h3>"
          + "<p class=\"body\"><strong>A:</strong> " + ((.reviewer_a_position // "") | esc) + "</p>"
          + "<p class=\"body\"><strong>B:</strong> " + ((.reviewer_b_position // "") | esc) + "</p>"
          + "<p class=\"body\"><strong>結論:</strong> " + ((.resolution // "") | esc) + "</p>"
          + "</article>") | join(""))
      + "</div>"
 else "" end),

"<footer>",
"<div>checklist: " + ($checklist_common | esc) + " (" + ($checklist_count | esc) + " lenses"
  + (if ($checklist_project != "none") then ", project: " + ($checklist_project | esc) else "" end)
  + ")</div>",
"<div>問題が見つかったレンズ: "
  + ([.findings[]?.checklist_ids[]?] | unique | length | tostring)
  + " / " + ($checklist_count | esc) + "</div>",
(if $truncated == "true"
 then "<div>スコープ: 一部のみ（上部の警告を参照）</div>"
 else "<div>スコープ: PR 全体（切り詰めなし）</div>" end),
"<div>reviewed head: <code>" + ($head_oid | esc) + "</code></div>",
"<div>vet は GitHub に何も投稿していません。コピーして自分で貼ってください。</div>",
"</footer>",
"</main>",
"<script>",
"document.addEventListener('click', function (e) {",
"  var b = e.target.closest ? e.target.closest('.copy') : null;",
"  if (!b) return;",
"  var md = b.getAttribute('data-md') || '';",
"  var done = function (ok) {",
"    var t = b.textContent;",
"    b.textContent = ok ? 'Copied' : 'Copy failed - select manually';",
"    b.className = 'copy ' + (ok ? 'ok' : 'err');",
"    setTimeout(function () { b.textContent = 'Copy as markdown'; b.className = 'copy'; }, 2000);",
"  };",
"  var fallback = function () {",
"    try {",
"      var ta = document.createElement('textarea');",
"      ta.value = md;",
"      ta.setAttribute('readonly', '');",
"      ta.style.position = 'fixed';",
"      ta.style.top = '-1000px';",
"      document.body.appendChild(ta);",
"      ta.select();",
"      var ok = document.execCommand('copy');",
"      document.body.removeChild(ta);",
"      done(ok);",
"    } catch (err) { done(false); }",
"  };",
"  if (navigator.clipboard && navigator.clipboard.writeText) {",
"    navigator.clipboard.writeText(md).then(function () { done(true); }, fallback);",
"  } else { fallback(); }",
"});",
"</script>",
"</body></html>"
JQPROG
}

# --- Run state ----------------------------------------------------------------

load_run() {
  local requested_id="${1:-}"
  local allow_latest="${2:-true}"
  local state_file=""

  if [[ -n "$requested_id" ]]; then
    state_file="$VET_RUN_ROOT/$requested_id/state.env"
  elif [[ -n "${TMUX:-}" ]]; then
    state_file="$(tmux show-option -wqv @vet_state_file 2>/dev/null || true)"
  fi

  if [[ ( -z "$state_file" || ! -f "$state_file" ) && "$allow_latest" == "true" ]]; then
    state_file="$(
      find "$VET_RUN_ROOT" -mindepth 2 -maxdepth 2 -name state.env -type f 2>/dev/null |
        sort |
        tail -n 1
    )"
  fi

  [[ -n "$state_file" && -f "$state_file" ]] || {
    echo "Error: no matching vet run found (see: vet list)" >&2
    exit 1
  }

  # state.env is generated by vet itself and contains shell-escaped values.
  # shellcheck source=/dev/null
  source "$state_file"
  STATE_FILE="$state_file"
}

write_state() {
  mkdir -p "$VET_DIR"
  {
    printf 'RUN_ID=%q\n' "$RUN_ID"
    printf 'STARTED_AT=%q\n' "$STARTED_AT"
    printf 'PR_NUMBER=%q\n' "$PR_NUMBER"
    printf 'PR_URL=%q\n' "${PR_URL:-}"
    printf 'PR_TITLE=%q\n' "${PR_TITLE:-}"
    printf 'PR_STATE=%q\n' "${PR_STATE:-}"
    printf 'PR_IS_DRAFT=%q\n' "${PR_IS_DRAFT:-false}"
    printf 'REPO_SPEC=%q\n' "${REPO_SPEC:-}"
    printf 'BASE_REF=%q\n' "${BASE_REF:-}"
    printf 'HEAD_REF=%q\n' "${HEAD_REF:-}"
    printf 'HEAD_OID=%q\n' "${HEAD_OID:-}"
    printf 'IS_CROSS_REPOSITORY=%q\n' "${IS_CROSS_REPOSITORY:-false}"
    printf 'GIT_REMOTE=%q\n' "${GIT_REMOTE:-}"
    printf 'REPO_ROOT=%q\n' "$REPO_ROOT"
    printf 'WORKDIR=%q\n' "$WORKDIR"
    printf 'VET_DIR=%q\n' "$VET_DIR"
    printf 'REPORT_PATH=%q\n' "${REPORT_PATH:-}"
    printf 'CONSOLIDATED_PATH=%q\n' "${CONSOLIDATED_PATH:-}"
    # Needed so `vet render` can re-render this run later without re-deriving
    # anything from the PR.
    printf 'CHECKLIST_COUNT=%q\n' "${CHECKLIST_COUNT:-0}"
    printf 'COMMON_CHECKLIST=%q\n' "${COMMON_CHECKLIST:-}"
    printf 'COMMON_CHECKLIST_SOURCE=%q\n' "${COMMON_CHECKLIST_SOURCE:-none}"
    printf 'PROJECT_CHECKLIST_SOURCE=%q\n' "${PROJECT_CHECKLIST_SOURCE:-none}"
    # vet's OWN verdict on whether it truncated the PR. The report's
    # partial-review banner is driven by this, never by model prose, so a
    # standalone `vet render` must reach the identical conclusion.
    printf 'CONTEXT_TRUNCATED=%q\n' "${CONTEXT_TRUNCATED:-false}"
    printf 'WINDOW_SHORT_NAME=%q\n' "${WINDOW_SHORT_NAME:-vet}"
    printf 'MANAGER_SESSION_ID=%q\n' "${MANAGER_SESSION_ID:-}"
    printf 'REVIEWER_A_SESSION_ID=%q\n' "${REVIEWER_A_SESSION_ID:-}"
    printf 'WAIT_TIMEOUT_SECONDS=%q\n' "${WAIT_TIMEOUT_SECONDS:-7200}"
    printf 'WINDOW_ID=%q\n' "${WINDOW_ID:-}"
    printf 'CURRENT_WINDOW_NAME=%q\n' "${CURRENT_WINDOW_NAME:-}"
    printf 'MANAGER_PANE=%q\n' "${MANAGER_PANE:-}"
    printf 'REVIEWER_A_PANE=%q\n' "${REVIEWER_A_PANE:-}"
    printf 'REVIEWER_B_PANE=%q\n' "${REVIEWER_B_PANE:-}"
    # The pane IDs embedded in manager-prompt.md at launch. Resume rewrites the
    # prompt by mapping FROM these, so they must survive any number of resumes.
    printf 'ORIG_MANAGER_PANE=%q\n' "${ORIG_MANAGER_PANE:-${MANAGER_PANE:-}}"
    printf 'ORIG_REVIEWER_A_PANE=%q\n' "${ORIG_REVIEWER_A_PANE:-${REVIEWER_A_PANE:-}}"
    printf 'ORIG_REVIEWER_B_PANE=%q\n' "${ORIG_REVIEWER_B_PANE:-${REVIEWER_B_PANE:-}}"
    printf 'RUN_STATUS=%q\n' "${RUN_STATUS:-running}"
  } > "$VET_DIR/state.env"
  STATE_FILE="$VET_DIR/state.env"
}

# run-step is the ONLY way the Manager drives agents, and the only Bash rule it
# needs. It exists because claude permission rules are PREFIX-based, which makes
# every form of `tmux send-keys` rule unsafe. Measured against the installed CLI:
#
#   * Bash(tmux send-keys:*) lets the Manager type ARBITRARY text into a reviewer
#     pane. Verified end to end: it sent `touch .../PWNED.txt && git tag
#     pwned-via-pane`, both ran, and NO permission prompt appeared - while the
#     very same session was refused a plain `git tag -l` directly. Reviewer panes
#     are ordinary interactive shells with no permission layer, so this bypassed
#     every other restriction.
#   * Narrowing to an exact command prefix does NOT help. With
#     Bash(tmux send-keys -t %0 /abs/helper:*) allowlisted, appending extra keys
#     (`... /abs/helper Enter touch:/tmp/PWNED3.txt Enter`) was PERMITTED and the
#     appended keystrokes were typed into the pane and executed by its shell.
#     For send-keys, "extra arguments" ARE extra commands.
#
# So the Manager never gets a free-form tmux command. It gets one token from a
# closed set; run-step builds the real invocation from values baked in here.
#
# Values are baked at generation time rather than sourced from state.env,
# because state.env lives in $VET_DIR and sourcing a file the Manager might be
# able to write would reintroduce arbitrary code execution. Resume regenerates
# this file with the new pane IDs.
write_run_step() {
  cat > "$VET_DIR/run-step" <<RUNSTEP
#!/usr/bin/env bash
set -euo pipefail

# Generated by vet. Values below are baked in; nothing here comes from argv.
RUN_DIR=$(printf '%q' "$VET_DIR")
MANAGER_PANE=$(printf '%q' "${MANAGER_PANE:-}")
REVIEWER_A_PANE=$(printf '%q' "${REVIEWER_A_PANE:-}")
REVIEWER_B_PANE=$(printf '%q' "${REVIEWER_B_PANE:-}")
REVIEWER_A_SESSION_ID=$(printf '%q' "${REVIEWER_A_SESSION_ID:-}")
WORKDIR=$(printf '%q' "$WORKDIR")
WINDOW_SHORT_NAME=$(printf '%q' "${WINDOW_SHORT_NAME:-vet}")
WAIT_TIMEOUT_SECONDS=$(printf '%q' "${WAIT_TIMEOUT_SECONDS:-7200}")
EVENT_A=$(printf '%q' "vet-$RUN_ID-reviewer-a")
EVENT_B=$(printf '%q' "vet-$RUN_ID-reviewer-b")

usage() {
  cat >&2 <<'USAGE'
vet run-step: perform ONE review step. Takes exactly one token, from this
closed set, and nothing else:

  reviewer-a         start Reviewer A (new session)
  reviewer-a-resume  re-run Reviewer A, continuing its existing session
  reviewer-b         start or re-run Reviewer B
  wait-a             block until Reviewer A finishes
  wait-b             block until Reviewer B finishes
  title              apply <run dir>/new-title.txt to the pane titles

Any other argument, a missing argument, or ANY extra argument is rejected.
USAGE
}

# Extra arguments are REJECTED, never ignored. This dispatcher exists precisely
# because a trailing argument on a send-keys command becomes extra keystrokes
# executed in a reviewer pane, so "ignore the rest" would reopen the hole.
if [[ \$# -ne 1 ]]; then
  printf 'Error: run-step takes exactly one argument (got %s).\n' "\$#" >&2
  usage
  exit 2
fi

# THE STATUS FILE MUST BE CLEARED HERE, IN THE LAUNCHER, NOT BY THE HELPER.
#
# tmux send-keys only QUEUES keystrokes: the helper has not started yet, so its
# own status-file removal has not run. The Manager runs a launch token and
# then the matching wait token synchronously in its own pane, so without this
# clear, run-wait's fast path would find the PREVIOUS cycle's status file and
# report the old result before the new command had even begun. Clearing here is
# guaranteed to precede the wait because both run in the Manager's pane.
#
# Only the LAUNCH tokens clear. A wait token must never clear, or a double wait
# would discard a real result and then block.
clear_status() {
  rm -f "\$1"
}

send_reviewer_a() {
  clear_status "\$RUN_DIR/reviewer-a-status.txt"
  tmux send-keys -t "\$REVIEWER_A_PANE" \\
    "\$RUN_DIR/run-reviewer-a \$RUN_DIR/reviewer-a-task.md \$RUN_DIR/reviewer-a-result.json \$RUN_DIR/reviewer-a-status.txt \$EVENT_A \$REVIEWER_A_SESSION_ID \$RUN_DIR/reviewer-schema.json \$1 \$RUN_DIR" Enter
  printf 'run-step: Reviewer A started (%s session).\n' "\$1"
}

send_reviewer_b() {
  clear_status "\$RUN_DIR/reviewer-b-status.txt"
  tmux send-keys -t "\$REVIEWER_B_PANE" \\
    "\$RUN_DIR/run-reviewer-b \$RUN_DIR/reviewer-b-task.md \$RUN_DIR/reviewer-b-result.json \$RUN_DIR/reviewer-b-status.txt \$EVENT_B \$RUN_DIR/reviewer-schema.json \$WORKDIR \$RUN_DIR" Enter
  printf 'run-step: Reviewer B started.\n'
}

case "\$1" in
  reviewer-a)        send_reviewer_a initial ;;
  reviewer-a-resume) send_reviewer_a resume ;;
  reviewer-b)        send_reviewer_b ;;
  wait-a)
    exec "\$RUN_DIR/run-wait" "\$EVENT_A" "\$RUN_DIR/reviewer-a-status.txt" \\
      "\$REVIEWER_A_PANE" "\$WAIT_TIMEOUT_SECONDS" 'Reviewer A'
    ;;
  wait-b)
    exec "\$RUN_DIR/run-wait" "\$EVENT_B" "\$RUN_DIR/reviewer-b-status.txt" \\
      "\$REVIEWER_B_PANE" "\$WAIT_TIMEOUT_SECONDS" 'Reviewer B'
    ;;
  title)
    exec "\$RUN_DIR/update-title" "\$RUN_DIR/title.txt" "\$RUN_DIR/new-title.txt" \\
      "\$WINDOW_SHORT_NAME" "\$MANAGER_PANE" "\$REVIEWER_A_PANE" "\$REVIEWER_B_PANE"
    ;;
  *)
    printf 'Error: unknown step: %s\n' "\$1" >&2
    usage
    exit 2
    ;;
esac
RUNSTEP
  chmod +x "$VET_DIR/run-step"
}

# Re-render report.html for an existing run from its consolidated.json.
#
# This exists because the validation gate has to give the PO a way FORWARD. If
# the Manager's JSON is rejected, they can fix that file - by hand, or by having
# the Manager rewrite it - and turn it into a report without paying for another
# agent session. It is also what makes the gate's own error message honest: the
# command it prints actually works.
render_run() {
  # An EXPLICIT run-id must match exactly. load_run's default is to fall back to
  # the most recent run when the id does not resolve, which for render would
  # quietly hand the PO a different run's report after a typo. Only the no-arg
  # form is allowed to pick the current window's run or the latest.
  if [[ -n "${1:-}" ]]; then
    load_run "$1" false
  else
    load_run "" true
  fi
  local consolidated="${CONSOLIDATED_PATH:-$VET_DIR/consolidated.json}"
  local schema="$VET_DIR/consolidated-schema.json"
  REPORT_PATH="${REPORT_PATH:-$VET_DIR/report.html}"

  [[ -f "$consolidated" ]] || {
    echo "Error: this run has no consolidated JSON to render:" >&2
    printf '       %s\n' "$consolidated" >&2
    echo "       The Manager writes that file. Resume it with: vet resume $RUN_ID" >&2
    exit 1
  }
  [[ -f "$schema" ]] || {
    echo "Error: this run has no consolidated-schema.json, so it cannot be" >&2
    echo "       validated. It predates the validation gate." >&2
    exit 1
  }

  # Older runs predate these state fields; the renderer needs them to exist.
  # Read from state.env via load_run. Runs that predate this field default to
  # false: claiming a full review is wrong, but so is inventing a truncation
  # warning we have no evidence for, and the footer still states the scope.
  CONTEXT_TRUNCATED="${CONTEXT_TRUNCATED:-false}"
  CHECKLIST_COUNT="${CHECKLIST_COUNT:-0}"
  COMMON_CHECKLIST="${COMMON_CHECKLIST:-}"
  COMMON_CHECKLIST_SOURCE="${COMMON_CHECKLIST_SOURCE:-none}"
  PROJECT_CHECKLIST_SOURCE="${PROJECT_CHECKLIST_SOURCE:-none}"

  if ! validate_against_schema "$consolidated" "$schema"; then
    echo "" >&2
    echo "Error: that consolidated JSON does not match the schema (above)." >&2
    echo "NOTHING WAS RENDERED - a report is not shown rather than shown wrong." >&2
    echo "" >&2
    printf 'Edit it:   %s\n' "$consolidated" >&2
    printf 'Against:   %s\n' "$schema" >&2
    printf 'Then:      vet render %s\n' "$RUN_ID" >&2
    exit 1
  fi

  render_report_html "$consolidated" "$REPORT_PATH"
  printf 'must_fix %s / should_fix %s / nit %s / question %s\n' \
    "$(jq '[.findings[]?|select(.severity=="must_fix")]|length' "$consolidated")" \
    "$(jq '[.findings[]?|select(.severity=="should_fix")]|length' "$consolidated")" \
    "$(jq '[.findings[]?|select(.severity=="nit")]|length' "$consolidated")" \
    "$(jq '[.findings[]?|select(.severity=="question")]|length' "$consolidated")"
  echo ""
  echo "Report (cmd+click to open):"
  printf '%s\n' "$REPORT_PATH"
}

window_exists() {
  local target_window_id="${1:-}"
  [[ -n "$target_window_id" ]] || return 1
  tmux list-windows -a -F '#{window_id}' 2>/dev/null |
    awk -v target="$target_window_id" '$0 == target { found = 1 } END { exit !found }'
}

list_runs() {
  local state_file title status
  printf '%-24s  %-9s  %-10s  %s\n' "RUN ID" "STATUS" "PR" "TITLE"
  find "$VET_RUN_ROOT" -mindepth 2 -maxdepth 2 -name state.env -type f 2>/dev/null |
    sort -r |
    while IFS= read -r state_file; do
      unset RUN_ID RUN_STATUS VET_DIR WINDOW_ID PR_NUMBER PR_TITLE
      # shellcheck source=/dev/null
      source "$state_file"
      title="$(cat "$VET_DIR/title.txt" 2>/dev/null || printf '%s' "${PR_TITLE:-unknown}")"
      status="${RUN_STATUS:-unknown}"
      if window_exists "${WINDOW_ID:-}"; then
        status="running"
      elif [[ "$status" == "running" ]]; then
        status="closed"
      fi
      printf '%-24s  %-9s  %-10s  %s\n' "$RUN_ID" "$status" "#${PR_NUMBER:-?}" "$title"
    done
}

close_run() {
  load_run "${1:-}" false
  RUN_STATUS="closed"
  write_state
  if window_exists "${WINDOW_ID:-}"; then
    tmux kill-window -t "$WINDOW_ID"
  fi
  printf 'vet run closed: %s\n' "$RUN_ID"
  printf 'Resume with: vet resume %s\n' "$RUN_ID"
}

# Delete one retained run: its detached PR worktree and its artifact directory.
# Refuses while the window is still open. vet never creates a branch, so there
# is nothing to delete on the branch side. The worktree is only removed when it
# really lives under VET_WORKTREE_ROOT, so a corrupted state.env can never make
# this delete the PO's own repository.
remove_run() {
  local state_file="$1"
  unset RUN_ID RUN_STATUS VET_DIR WINDOW_ID WORKDIR REPO_ROOT
  # shellcheck source=/dev/null
  source "$state_file"
  if window_exists "${WINDOW_ID:-}"; then
    echo "Skip $RUN_ID: still running. Close it first: vet close $RUN_ID" >&2
    return 1
  fi
  if [[ -n "${WORKDIR:-}" && "$WORKDIR" == "$VET_WORKTREE_ROOT"/* && -d "$WORKDIR" ]]; then
    if [[ -n "${REPO_ROOT:-}" && -d "${REPO_ROOT:-}" ]]; then
      git -C "$REPO_ROOT" worktree remove --force "$WORKDIR" 2>/dev/null || rm -rf "$WORKDIR"
      git -C "$REPO_ROOT" worktree prune 2>/dev/null || true
    else
      rm -rf "$WORKDIR"
    fi
  fi
  rm -rf "$VET_DIR"
  printf 'vet run removed: %s\n' "$RUN_ID"
}

clean_runs() {
  local state_file answer title removable=()
  while IFS= read -r state_file; do
    unset RUN_ID RUN_STATUS WINDOW_ID
    # shellcheck source=/dev/null
    source "$state_file"
    window_exists "${WINDOW_ID:-}" || removable+=("$state_file")
  done < <(
    find "$VET_RUN_ROOT" -mindepth 2 -maxdepth 2 -name state.env -type f 2>/dev/null | sort
  )

  if [[ ${#removable[@]} -eq 0 ]]; then
    echo "No closed vet runs to remove."
    return 0
  fi

  echo "The following ${#removable[@]} vet run(s) will be DELETED (worktree, artifacts):"
  for state_file in "${removable[@]}"; do
    unset RUN_ID VET_DIR PR_NUMBER
    # shellcheck source=/dev/null
    source "$state_file"
    title="$(cat "$VET_DIR/title.txt" 2>/dev/null || printf 'unknown')"
    printf '  %s  #%s  %s\n' "$RUN_ID" "${PR_NUMBER:-?}" "$title"
  done
  printf 'Proceed? [y/N] '
  read -r answer
  [[ "$answer" == "y" || "$answer" == "Y" ]] || {
    echo "Aborted."
    return 1
  }
  for state_file in "${removable[@]}"; do
    remove_run "$state_file"
  done
}

resume_run() {
  local new_window title
  local target_session="${2:-}"

  if [[ -z "$target_session" && -z "${TMUX:-}" ]]; then
    echo "Error: vet resume must be run inside tmux (or pass --session <name>)" >&2
    exit 1
  fi

  # An EXPLICIT run-id must match exactly. load_run's default is to fall back to
  # the most recent run when the id does not resolve, which here would resume a
  # DIFFERENT run - possibly one from another PR - and look like it worked. That
  # matters because vet's own validation-failure message tells the PO to run
  # `vet resume <run-id>` with a long timestamp id, at exactly the moment they
  # are retyping it by hand. Only the no-arg form may resolve to the current
  # window's run, then the latest.
  if [[ -n "${1:-}" ]]; then
    load_run "$1" false
  else
    load_run "" true
  fi
  [[ -d "$WORKDIR" ]] || {
    echo "Error: vet PR worktree no longer exists: $WORKDIR" >&2
    exit 1
  }

  if window_exists "${WINDOW_ID:-}"; then
    echo "Error: vet is already running in window $WINDOW_ID" >&2
    exit 1
  fi

  # manager-prompt.md embeds the pane IDs from the ORIGINAL launch, so the
  # rewrite below must always map from those - not from the previous resume's
  # panes.
  ORIG_MANAGER_PANE="${ORIG_MANAGER_PANE:-${MANAGER_PANE:-}}"
  ORIG_REVIEWER_A_PANE="${ORIG_REVIEWER_A_PANE:-${REVIEWER_A_PANE:-}}"
  ORIG_REVIEWER_B_PANE="${ORIG_REVIEWER_B_PANE:-${REVIEWER_B_PANE:-}}"

  if [[ -n "$target_session" ]]; then
    new_window="$(tmux new-window -d -t "${target_session}:" -c "$WORKDIR" -P -F '#{window_id} #{pane_id}')"
  else
    new_window="$(tmux new-window -d -c "$WORKDIR" -P -F '#{window_id} #{pane_id}')"
  fi
  read -r WINDOW_ID MANAGER_PANE <<< "$new_window"
  REVIEWER_A_PANE="$(tmux split-window -h -c "$WORKDIR" -d -t "$MANAGER_PANE" -P -F '#{pane_id}')"
  REVIEWER_B_PANE="$(tmux split-window -v -c "$WORKDIR" -d -t "$REVIEWER_A_PANE" -P -F '#{pane_id}')"
  CURRENT_WINDOW_NAME="$(tmux display-message -p -t "$WINDOW_ID" '#W')"
  WINDOW_SHORT_NAME="${WINDOW_SHORT_NAME:-vet:${RUN_ID:0:15}}"
  RUN_STATUS="running"
  write_state
  # run-step has the pane IDs baked in, so it must be regenerated for the panes
  # this resume just created.
  write_run_step

  # (?!\d) keeps a shorter pane ID (%31) from matching the prefix of a longer
  # one (%319).
  OLD_MANAGER_PANE="$ORIG_MANAGER_PANE" NEW_MANAGER_PANE="$MANAGER_PANE" \
  OLD_A_PANE="$ORIG_REVIEWER_A_PANE" NEW_A_PANE="$REVIEWER_A_PANE" \
  OLD_B_PANE="$ORIG_REVIEWER_B_PANE" NEW_B_PANE="$REVIEWER_B_PANE" \
    perl -0pe '
      s/\Q$ENV{OLD_MANAGER_PANE}\E(?!\d)/$ENV{NEW_MANAGER_PANE}/g if length $ENV{OLD_MANAGER_PANE};
      s/\Q$ENV{OLD_A_PANE}\E(?!\d)/$ENV{NEW_A_PANE}/g if length $ENV{OLD_A_PANE};
      s/\Q$ENV{OLD_B_PANE}\E(?!\d)/$ENV{NEW_B_PANE}/g if length $ENV{OLD_B_PANE};
    ' "$VET_DIR/manager-prompt.md" > "$VET_DIR/manager-resume-prompt.md"

  title="$(cat "$VET_DIR/title.txt")"
  tmux rename-window -t "$WINDOW_ID" "$WINDOW_SHORT_NAME"
  tmux select-pane -t "$MANAGER_PANE" -T "$title"
  tmux select-pane -t "$REVIEWER_A_PANE" -T "Reviewer A"
  tmux select-pane -t "$REVIEWER_B_PANE" -T "Reviewer B"
  tmux set-option -w -t "$WINDOW_ID" pane-border-status top
  tmux set-option -w -t "$WINDOW_ID" pane-border-format " #{pane_title} "
  tmux set-option -w -t "$WINDOW_ID" @vet_run_id "$RUN_ID"
  tmux set-option -w -t "$WINDOW_ID" @vet_state_file "$STATE_FILE"
  tmux send-keys -t "$MANAGER_PANE" "$VET_DIR/run-manager-resume '$WORKDIR' '$VET_DIR/manager-resume-prompt.md' '$MANAGER_SESSION_ID'" Enter
  tmux select-window -t "$WINDOW_ID"
  printf 'vet run resumed: %s\n' "$RUN_ID"
}

[[ $# -gt 0 ]] || usage
case "$1" in
  -h|--help)
    usage 0
    ;;
  list)
    list_runs
    exit 0
    ;;
  close)
    close_run "${2:-}"
    exit 0
    ;;
  rm)
    shift
    [[ $# -gt 0 ]] || {
      echo "Error: vet rm requires at least one run-id (see: vet list)" >&2
      exit 1
    }
    rm_status=0
    for run_id in "$@"; do
      rm_state_file="$VET_RUN_ROOT/$run_id/state.env"
      if [[ ! -f "$rm_state_file" ]]; then
        echo "Error: unknown vet run: $run_id" >&2
        rm_status=1
        continue
      fi
      remove_run "$rm_state_file" || rm_status=1
    done
    exit "$rm_status"
    ;;
  clean)
    clean_runs
    exit 0
    ;;
  render)
    render_run "${2:-}"
    exit 0
    ;;
  resume)
    shift
    resume_session=""
    if [[ "${1:-}" == "--session" ]]; then
      if [[ $# -lt 2 || -z "${2:-}" ]]; then
        echo "Error: --session requires a value" >&2
        exit 1
      fi
      resume_session="$2"
      shift 2
    fi
    resume_run "${1:-}" "$resume_session"
    exit 0
    ;;
esac

# --- Argument parsing ---------------------------------------------------------

PR_ARG=""
ALLOW_EMPTY_CHECKLIST=false
INCLUDE_CLOSED=false
OPEN_REPORT=false
if [[ "${VET_DRY_RUN:-0}" == "1" || "${VET_DRY_RUN:-0}" == "true" ]]; then
  DRY_RUN=true
else
  DRY_RUN=false
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    --allow-empty-checklist) ALLOW_EMPTY_CHECKLIST=true; shift ;;
    --include-closed) INCLUDE_CLOSED=true; shift ;;
    --open) OPEN_REPORT=true; shift ;;
    --dry-run) DRY_RUN=true; shift ;;
    -h|--help) usage 0 ;;
    -*)
      echo "Error: unknown option: $1" >&2
      usage 1
      ;;
    *)
      [[ -z "$PR_ARG" ]] || {
        echo "Error: unexpected extra argument: $1" >&2
        usage 1
      }
      PR_ARG="$1"
      shift
      ;;
  esac
done

[[ -n "$PR_ARG" ]] || {
  echo "Error: a PR number or PR URL is required" >&2
  usage 1
}

URL_REPO_SPEC=""
if [[ "$PR_ARG" =~ ^https?://[^/]+/([^/]+)/([^/]+)/pull/([0-9]+) ]]; then
  URL_REPO_SPEC="${BASH_REMATCH[1]}/${BASH_REMATCH[2]}"
  PR_NUMBER="${BASH_REMATCH[3]}"
elif [[ "$PR_ARG" =~ ^[0-9]+$ ]]; then
  PR_NUMBER="$PR_ARG"
else
  echo "Error: not a PR number or a GitHub PR URL: $PR_ARG" >&2
  echo "Expected: 1234  or  https://github.com/org/repo/pull/1234" >&2
  exit 1
fi

WAIT_TIMEOUT_SECONDS="${VET_WAIT_TIMEOUT_SECONDS:-7200}"
[[ "$WAIT_TIMEOUT_SECONDS" =~ ^[1-9][0-9]*$ ]] || {
  echo "Error: VET_WAIT_TIMEOUT_SECONDS must be a positive integer." >&2
  exit 1
}

MAX_FILES="${VET_MAX_FILES:-80}"
MAX_DIFF_LINES="${VET_MAX_DIFF_LINES:-20000}"
MAX_CONTEXT_BYTES="${VET_MAX_CONTEXT_BYTES:-1500000}"
MAX_COMMENT_BYTES="${VET_MAX_COMMENT_BYTES:-400000}"

validate_limit() {
  local name="$1" value="$2"
  [[ "$value" =~ ^[1-9][0-9]*$ ]] || {
    echo "Error: VET_$name must be a positive integer (got: $value)" >&2
    exit 1
  }
}
validate_limit MAX_FILES "$MAX_FILES"
validate_limit MAX_DIFF_LINES "$MAX_DIFF_LINES"
validate_limit MAX_CONTEXT_BYTES "$MAX_CONTEXT_BYTES"
validate_limit MAX_COMMENT_BYTES "$MAX_COMMENT_BYTES"

ORIGINAL_WORKDIR="$(pwd)"

# --- Preflight ----------------------------------------------------------------

REQUIRED_COMMANDS="git jq perl uuidgen"
if [[ "$DRY_RUN" == "false" ]]; then
  REQUIRED_COMMANDS="$REQUIRED_COMMANDS gh tmux claude codex"
fi
for cmd in $REQUIRED_COMMANDS; do
  command -v "$cmd" >/dev/null 2>&1 || {
    echo "Error: $cmd is not installed or not in PATH" >&2
    exit 1
  }
done

if [[ "$DRY_RUN" == "false" && -z "${TMUX:-}" ]]; then
  echo "Error: vet must be run inside tmux" >&2
  exit 1
fi

REPO_ROOT="$(git -C "$ORIGINAL_WORKDIR" rev-parse --show-toplevel 2>/dev/null)" || {
  echo "Error: vet must be run inside a git repository" >&2
  exit 1
}

if [[ "$DRY_RUN" == "true" ]]; then
  FIXTURE_DIR="${VET_FIXTURE_DIR:-}"
  [[ -n "$FIXTURE_DIR" && -d "$FIXTURE_DIR" ]] || {
    echo "Error: --dry-run needs VET_FIXTURE_DIR pointing at a directory with pr.json" >&2
    exit 1
  }
  [[ -f "$FIXTURE_DIR/pr.json" ]] || {
    echo "Error: fixture PR context not found: $FIXTURE_DIR/pr.json" >&2
    exit 1
  }
fi

# --- Resolve the repository and the PR ----------------------------------------

if [[ "$DRY_RUN" == "true" ]]; then
  REPO_SPEC="${URL_REPO_SPEC:-${VET_FIXTURE_REPO_SPEC:-local/fixture}}"
else
  REPO_SPEC="$(cd "$REPO_ROOT" && gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null)" || {
    echo "Error: could not determine the GitHub repository for $REPO_ROOT" >&2
    echo "Check that this repository has a GitHub remote and that gh is authenticated." >&2
    exit 1
  }
  if [[ -n "$URL_REPO_SPEC" ]]; then
    url_spec_lower="$(printf '%s' "$URL_REPO_SPEC" | tr '[:upper:]' '[:lower:]')"
    repo_spec_lower="$(printf '%s' "$REPO_SPEC" | tr '[:upper:]' '[:lower:]')"
    [[ "$url_spec_lower" == "$repo_spec_lower" ]] || {
      echo "Error: the PR URL points at $URL_REPO_SPEC but the current directory is a" >&2
      echo "       checkout of $REPO_SPEC. vet needs a local clone of the PR's repository" >&2
      echo "       because it checks the PR head out into a worktree of it." >&2
      echo "       cd into a clone of $URL_REPO_SPEC and run: vet $PR_NUMBER" >&2
      exit 1
    }
  fi
fi

RUN_ID="$(date '+%Y%m%d-%H%M%S')-$$"
STARTED_AT="$(date '+%Y-%m-%d %H:%M:%S')"
REPO_NAME="$(basename "$REPO_ROOT")"
VET_DIR="$VET_RUN_ROOT/$RUN_ID"
WORKDIR="$VET_WORKTREE_ROOT/$REPO_NAME-pr$PR_NUMBER-$RUN_ID"
REPORT_PATH="$VET_DIR/report.html"
# The Manager produces this; vet renders REPORT_PATH from it deterministically.
CONSOLIDATED_PATH="$VET_DIR/consolidated.json"
MANAGER_SESSION_ID="$(uuidgen | tr '[:upper:]' '[:lower:]')"
REVIEWER_A_SESSION_ID="$(uuidgen | tr '[:upper:]' '[:lower:]')"

# If the launch dies anywhere between creating the run directory and actually
# starting the Manager, leave nothing behind: no orphaned run directory and no
# orphaned git worktree.
#
# The guard is this flag, NOT "does state.env exist". The old version tested for
# state.env on the theory that a run with state is resumable and must be kept -
# but write_state runs well BEFORE the Manager launch, so every abort in that
# window found state.env already present and returned without cleaning anything.
# That is exactly what happened on the first real run: the trap fired, saw
# state.env, and left both the run directory and a registered worktree behind.
# Such a run is not resumable in any useful sense either - `vet resume` execs
# `claude --resume "$MANAGER_SESSION_ID"`, and that session is only created by
# the Manager launch that never happened. Everything in the run directory is
# regenerated deterministically from the PR, so removing it loses nothing.
VET_LAUNCH_COMMITTED=false

# shellcheck disable=SC2329  # invoked by the EXIT trap below
cleanup_failed_launch() {
  # Preserve the real exit status. The old handler ended in `return 0`, which
  # replaced the failing status, so a failed launch reported success.
  rc=$?
  trap - EXIT
  if [[ "$VET_LAUNCH_COMMITTED" == "true" ]]; then
    exit "$rc"
  fi
  # $? alone is not trustworthy here. Measured on bash 3.2: after a `set -u`
  # unbound-variable abort, $? is 0 inside the EXIT trap even though the shell
  # is dying - while `false` gives 1 and `exit 3` gives 3 as expected. That is
  # precisely the abort that killed the first real run, so keying the exit
  # status off $? would still have reported success. Reaching this branch means
  # the Manager was never launched, which is itself proof of failure, so force a
  # non-zero status when $? did not supply one.
  [[ "$rc" -ne 0 ]] || rc=1
  echo "" >&2
  echo "vet: launch failed before the Manager started (exit $rc); cleaning up." >&2
  if [[ -n "${WORKDIR:-}" && -d "$WORKDIR" ]]; then
    if git -C "$REPO_ROOT" worktree remove --force "$WORKDIR" >/dev/null 2>&1; then
      echo "vet: removed worktree $WORKDIR" >&2
    else
      rm -rf "$WORKDIR"
      echo "vet: removed worktree directory $WORKDIR (forced)" >&2
    fi
    git -C "$REPO_ROOT" worktree prune >/dev/null 2>&1 || true
  fi
  if [[ -n "${VET_DIR:-}" && -d "$VET_DIR" ]]; then
    rm -rf "$VET_DIR"
    echo "vet: removed run directory $VET_DIR" >&2
  fi
  exit "$rc"
}
trap cleanup_failed_launch EXIT

mkdir -p "$VET_DIR"

# --- Collect PR context -------------------------------------------------------

if [[ "$DRY_RUN" == "true" ]]; then
  cp "$FIXTURE_DIR/pr.json" "$VET_DIR/pr.json"
else
  gh pr view "$PR_NUMBER" -R "$REPO_SPEC" --json \
    number,title,body,author,state,isDraft,url,baseRefName,headRefName,headRefOid,isCrossRepository,changedFiles,additions,deletions,files,labels,commits \
    > "$VET_DIR/pr.json" 2> "$VET_DIR/pr-view.stderr.log" || {
    echo "Error: could not read PR #$PR_NUMBER in $REPO_SPEC" >&2
    sed 's/^/       /' "$VET_DIR/pr-view.stderr.log" >&2
    exit 1
  }
fi

jq -e 'type == "object" and has("number")' "$VET_DIR/pr.json" >/dev/null 2>&1 || {
  echo "Error: PR context is not a valid gh pr view JSON object: $VET_DIR/pr.json" >&2
  exit 1
}

PR_TITLE="$(jq -r '.title // ""' "$VET_DIR/pr.json")"
PR_URL="$(jq -r '.url // ""' "$VET_DIR/pr.json")"
PR_STATE="$(jq -r '.state // "UNKNOWN"' "$VET_DIR/pr.json")"
PR_IS_DRAFT="$(jq -r '.isDraft // false' "$VET_DIR/pr.json")"
PR_AUTHOR="$(jq -r '.author.login // "unknown"' "$VET_DIR/pr.json")"
BASE_REF="$(jq -r '.baseRefName // ""' "$VET_DIR/pr.json")"
HEAD_REF="$(jq -r '.headRefName // ""' "$VET_DIR/pr.json")"
HEAD_OID="$(jq -r '.headRefOid // ""' "$VET_DIR/pr.json")"
IS_CROSS_REPOSITORY="$(jq -r '.isCrossRepository // false' "$VET_DIR/pr.json")"
PR_CHANGED_FILES="$(jq -r '.changedFiles // 0' "$VET_DIR/pr.json")"
PR_ADDITIONS="$(jq -r '.additions // 0' "$VET_DIR/pr.json")"
PR_DELETIONS="$(jq -r '.deletions // 0' "$VET_DIR/pr.json")"

case "$PR_STATE" in
  OPEN) ;;
  CLOSED|MERGED)
    if [[ "$INCLUDE_CLOSED" == "false" ]]; then
      echo "Error: PR #$PR_NUMBER is $PR_STATE. Pass --include-closed to review it anyway." >&2
      exit 1
    fi
    ;;
  *)
    echo "Note: PR #$PR_NUMBER has an unrecognized state: $PR_STATE"
    ;;
esac

PR_STATE_NOTE=""
if [[ "$PR_IS_DRAFT" == "true" ]]; then
  PR_STATE_NOTE="This PR is a DRAFT. The report must say so prominently: the author may not consider the change finished."
elif [[ "$PR_STATE" == "CLOSED" || "$PR_STATE" == "MERGED" ]]; then
  PR_STATE_NOTE="This PR is already $PR_STATE (reviewed with --include-closed). The report must say so prominently."
fi

# --- PR head worktree: detached, never a branch -------------------------------

if [[ "$DRY_RUN" == "true" ]]; then
  GIT_REMOTE="$(git -C "$REPO_ROOT" remote | head -n 1 || true)"
  if ! git -C "$REPO_ROOT" cat-file -e "${HEAD_OID}^{commit}" 2>/dev/null; then
    HEAD_OID="$(git -C "$REPO_ROOT" rev-parse HEAD)"
    echo "Note: dry run - fixture head OID is not in this repository, using HEAD ($HEAD_OID)."
  fi
else
  GIT_REMOTE=""
  for remote_name in $(git -C "$REPO_ROOT" remote); do
    if git -C "$REPO_ROOT" remote get-url "$remote_name" 2>/dev/null | grep -qiF -- "$REPO_SPEC"; then
      GIT_REMOTE="$remote_name"
      break
    fi
  done
  if [[ -z "$GIT_REMOTE" ]]; then
    if git -C "$REPO_ROOT" remote | grep -qx origin; then
      GIT_REMOTE="origin"
    else
      GIT_REMOTE="$(git -C "$REPO_ROOT" remote | head -n 1 || true)"
    fi
  fi
  [[ -n "$GIT_REMOTE" ]] || {
    echo "Error: $REPO_ROOT has no git remote to fetch the PR head from" >&2
    exit 1
  }

  # pull/<n>/head resolves for forks too, so a cross-repository PR needs no
  # extra remote.
  git -C "$REPO_ROOT" fetch --quiet "$GIT_REMOTE" "pull/$PR_NUMBER/head" || {
    echo "Error: could not fetch pull/$PR_NUMBER/head from remote '$GIT_REMOTE'" >&2
    exit 1
  }
  if ! git -C "$REPO_ROOT" cat-file -e "${HEAD_OID}^{commit}" 2>/dev/null; then
    FETCHED_OID="$(git -C "$REPO_ROOT" rev-parse FETCH_HEAD)"
    echo "Note: PR head $HEAD_OID is not available after fetch; using fetched head $FETCHED_OID."
    echo "      The PR head may have moved between the API read and the fetch."
    HEAD_OID="$FETCHED_OID"
  fi
fi

# The PO's own worktree is never touched: not checked out, not stashed, not
# cleaned. A dirty tree is only reported.
if [[ -n "$(git -C "$REPO_ROOT" status --porcelain)" ]]; then
  echo "Note: existing changes remain untouched in your worktree:"
  git -C "$REPO_ROOT" status --short
  echo ""
fi

# --detach: vet must never create a branch for a PR it only reads.
git -C "$REPO_ROOT" worktree add --detach --quiet "$WORKDIR" "$HEAD_OID"

# Deliberate divergence from squad: squad copies $REPO_ROOT/.env into its
# worktree because the squad Coder runs the app and its tests. vet never runs
# anything - it only reads - and it points two AI reviewers at this directory
# with "read any file here for context". Copying real secrets in would hand
# them to both agents for no functional gain, so vet does NOT copy .env.

# --- Checklist ----------------------------------------------------------------

COMMON_CHECKLIST=""
COMMON_CHECKLIST_SOURCE="none"
if [[ -n "${VET_CHECKLIST:-}" ]]; then
  [[ -f "$VET_CHECKLIST" ]] || {
    echo "Error: VET_CHECKLIST is set but is not a readable file: $VET_CHECKLIST" >&2
    exit 1
  }
  COMMON_CHECKLIST="$VET_CHECKLIST"
  COMMON_CHECKLIST_SOURCE="VET_CHECKLIST"
elif [[ -f "$HOME/.vet/checklist.md" ]]; then
  COMMON_CHECKLIST="$HOME/.vet/checklist.md"
  COMMON_CHECKLIST_SOURCE="$HOME/.vet/checklist.md"
elif [[ -f "$VET_SCRIPT_DIR/_vet/checklist.md" ]]; then
  COMMON_CHECKLIST="$VET_SCRIPT_DIR/_vet/checklist.md"
  COMMON_CHECKLIST_SOURCE="$VET_SCRIPT_DIR/_vet/checklist.md"
fi

PROJECT_CHECKLIST=""
PROJECT_CHECKLIST_SOURCE="none"
if [[ -f "$WORKDIR/.vet/checklist.md" ]]; then
  PROJECT_CHECKLIST="$WORKDIR/.vet/checklist.md"
  PROJECT_CHECKLIST_SOURCE=".vet/checklist.md"
elif [[ -f "$WORKDIR/.review/checklist.md" ]]; then
  PROJECT_CHECKLIST="$WORKDIR/.review/checklist.md"
  PROJECT_CHECKLIST_SOURCE=".review/checklist.md"
fi

# Parse only `- [ID] text` bullets so the checklist files stay readable prose.
# Merge rule: common first in its own order, then the project file on top -
# same ID replaces the text, a new ID is appended.
perl -e '
  use strict;
  use warnings;
  my ($common_file, $project_file) = @ARGV;
  my (@order, %text, %source);
  sub items {
    my ($file, $kind) = @_;
    my @found;
    return @found unless defined $file && length $file && -f $file;
    open my $fh, "<", $file or die "vet: cannot read $file: $!\n";
    while (my $line = <$fh>) {
      chomp $line;
      # The bullet must start at column 0. That single rule is what keeps an
      # indented "- [ID] ..." example inside the file own documentation from
      # being parsed as a real checklist item.
      next unless $line =~ /^-\s+\[([A-Z][A-Z0-9_-]*)\]\s+(\S.*?)\s*$/;
      push @found, [$1, $2, $kind];
    }
    close $fh;
    return @found;
  }
  for my $item (items($common_file, "common")) {
    my ($id, $body) = @$item;
    push @order, $id unless exists $text{$id};
    $text{$id}   = $body;
    $source{$id} = "common";
  }
  for my $item (items($project_file, "project")) {
    my ($id, $body) = @$item;
    if (exists $text{$id}) {
      $source{$id} = ($source{$id} eq "common") ? "project-override" : $source{$id};
    } else {
      push @order, $id;
      $source{$id} = "project";
    }
    $text{$id} = $body;
  }
  sub esc {
    my $value = shift;
    $value =~ s/\\/\\\\/g;
    $value =~ s/"/\\"/g;
    $value =~ s/[\x00-\x1f]/ /g;
    return $value;
  }
  for my $id (@order) {
    printf qq({"id":"%s","text":"%s","source":"%s"}\n),
      esc($id), esc($text{$id}), esc($source{$id});
  }
' "$COMMON_CHECKLIST" "$PROJECT_CHECKLIST" > "$VET_DIR/checklist.jsonl"

jq -s --arg common "$COMMON_CHECKLIST_SOURCE" --arg project "$PROJECT_CHECKLIST_SOURCE" \
  '{common_checklist: $common, project_checklist: $project, items: .}' \
  "$VET_DIR/checklist.jsonl" > "$VET_DIR/checklist.json"

CHECKLIST_COUNT="$(jq -r '.items | length' "$VET_DIR/checklist.json")"
CHECKLIST_OVERRIDES="$(jq -r '[.items[] | select(.source == "project-override")] | length' "$VET_DIR/checklist.json")"
CHECKLIST_ADDED="$(jq -r '[.items[] | select(.source == "project")] | length' "$VET_DIR/checklist.json")"

if [[ "$CHECKLIST_COUNT" -eq 0 ]]; then
  if [[ "$ALLOW_EMPTY_CHECKLIST" == "false" ]]; then
    cat >&2 <<EOF
Error: no review checklist item was found, so there is nothing to review against.

vet looks for a common checklist in, first match wins:
  1. \$VET_CHECKLIST                       (currently: ${VET_CHECKLIST:-unset})
  2. $HOME/.vet/checklist.md
  3. $VET_SCRIPT_DIR/_vet/checklist.md

and for a project checklist inside the PR worktree:
  1. .vet/checklist.md
  2. .review/checklist.md

Create one with bullets shaped like:
  - [SEC-001] Are authorization boundaries checked on every new endpoint?

Or pass --allow-empty-checklist to review without one (the reviewers will have
no lenses to look through, and the report will say so).
EOF
    exit 1
  fi
  EMPTY_CHECKLIST_WARNING="NO REVIEW CHECKLIST WAS FOUND. This review ran with --allow-empty-checklist, so the reviewers had no lenses to look through and the review is unstructured. The report must state this prominently at the top."
else
  EMPTY_CHECKLIST_WARNING=""
fi

{
  printf '# Merged review checklist\n\n'
  printf 'Common checklist:  %s\n' "$COMMON_CHECKLIST_SOURCE"
  printf 'Project checklist: %s\n' "$PROJECT_CHECKLIST_SOURCE"
  printf 'Items: %s total (%s overridden by the project, %s added by the project)\n\n' \
    "$CHECKLIST_COUNT" "$CHECKLIST_OVERRIDES" "$CHECKLIST_ADDED"
  if [[ "$CHECKLIST_COUNT" -eq 0 ]]; then
    printf '(no checklist items)\n'
  else
    jq -r '.items[] | "- [\(.id)] \(.text)  <!-- source: \(.source) -->"' "$VET_DIR/checklist.json"
  fi
} > "$VET_DIR/checklist.merged.md"

# --- Diff, files, and comments, with hard context bounds ----------------------

CONTEXT_NOTES="$VET_DIR/context-notes.tmp"
: > "$CONTEXT_NOTES"
note_limit() { printf '%s\n' "$*" >> "$CONTEXT_NOTES"; }

# These notes go straight into a report the PO pastes into GitHub, so "1 files"
# would be visible sloppiness. plural <count> <singular> <plural>
plural() {
  if [[ "$1" -eq 1 ]]; then printf '%s' "$2"; else printf '%s' "$3"; fi
}

jq '[.files // [] | .[] | {path, additions, deletions}]' "$VET_DIR/pr.json" > "$VET_DIR/files.json"
FILES_TOTAL="$(jq -r 'length' "$VET_DIR/files.json")"

jq -r --argjson n "$MAX_FILES" \
  '[.[] | . + {churn: ((.additions // 0) + (.deletions // 0))}] | sort_by(-.churn, .path) | .[:$n] | .[] | .path' \
  "$VET_DIR/files.json" > "$VET_DIR/files.kept.txt"
jq -r --argjson n "$MAX_FILES" \
  '[.[] | . + {churn: ((.additions // 0) + (.deletions // 0))}] | sort_by(-.churn, .path) | .[$n:] | .[] | "\(.path) (+\(.additions // 0)/-\(.deletions // 0))"' \
  "$VET_DIR/files.json" > "$VET_DIR/files.dropped.txt"

FILES_DROPPED="$(wc -l < "$VET_DIR/files.dropped.txt" | tr -d ' ')"
if [[ "$FILES_DROPPED" -gt 0 ]]; then
  note_limit "FILE LIMIT: the PR changes $FILES_TOTAL files, the limit is $MAX_FILES (VET_MAX_FILES)."
  note_limit "The $MAX_FILES $(plural "$MAX_FILES" file files) with the largest churn \
$(plural "$MAX_FILES" was were) kept. \
$(plural "$FILES_DROPPED" "This $FILES_DROPPED file was" "These $FILES_DROPPED files were") NOT reviewed:"
  sed 's/^/  - /' "$VET_DIR/files.dropped.txt" >> "$CONTEXT_NOTES"
fi

if [[ "$DRY_RUN" == "true" ]]; then
  if [[ -f "$FIXTURE_DIR/diff.patch" ]]; then
    cp "$FIXTURE_DIR/diff.patch" "$VET_DIR/diff.full.patch"
  else
    : > "$VET_DIR/diff.full.patch"
  fi
else
  gh pr diff "$PR_NUMBER" -R "$REPO_SPEC" --patch > "$VET_DIR/diff.full.patch" 2> "$VET_DIR/pr-diff.stderr.log" || {
    echo "Error: could not read the diff of PR #$PR_NUMBER" >&2
    sed 's/^/       /' "$VET_DIR/pr-diff.stderr.log" >&2
    exit 1
  }
fi

DIFF_TOTAL_LINES="$(wc -l < "$VET_DIR/diff.full.patch" | tr -d ' ')"

# Section index of the patch: start line, line count, byte count, both paths.
awk '
  function flush_section(end_line) {
    if (path_a != "") printf "%d\t%d\t%d\t%s\t%s\n", start, end_line - start + 1, bytes, path_a, path_b
  }
  /^diff --git / {
    if (path_a != "") flush_section(NR - 1)
    start = NR
    bytes = 0
    rest = substr($0, 12)
    idx = index(rest, " b/")
    if (idx > 0) {
      path_a = substr(rest, 3, idx - 3)
      path_b = substr(rest, idx + 3)
    } else {
      path_a = $3; sub(/^a\//, "", path_a)
      path_b = $4; sub(/^b\//, "", path_b)
    }
  }
  { bytes += length($0) + 1 }
  END { if (path_a != "") flush_section(NR) }
' "$VET_DIR/diff.full.patch" > "$VET_DIR/diff-sections.tsv"

# Reserve the per-reviewer byte budget for everything else we hand a reviewer,
# so the diff can never push the total over VET_MAX_CONTEXT_BYTES.
OTHER_CONTEXT_BYTES="$(wc -c < "$VET_DIR/checklist.merged.md" | tr -d ' ')"
DIFF_BYTE_BUDGET=$(( MAX_CONTEXT_BYTES - OTHER_CONTEXT_BYTES - MAX_COMMENT_BYTES - 65536 ))
[[ "$DIFF_BYTE_BUDGET" -gt 0 ]] || DIFF_BYTE_BUDGET=65536

# Greedy fill, smallest section first: this maximises the number of changed
# files a reviewer actually sees instead of letting one huge file eat the whole
# budget. Everything skipped is named in context-limits.txt.
remaining_lines="$MAX_DIFF_LINES"
remaining_bytes="$DIFF_BYTE_BUDGET"
: > "$VET_DIR/diff-include-starts.txt"
: > "$VET_DIR/diff.dropped.txt"
while IFS=$'\t' read -r sec_start sec_lines sec_bytes sec_path_a sec_path_b; do
  [[ -n "${sec_start:-}" ]] || continue
  in_scope=false
  if grep -qxF -- "$sec_path_a" "$VET_DIR/files.kept.txt" 2>/dev/null; then
    in_scope=true
  elif grep -qxF -- "$sec_path_b" "$VET_DIR/files.kept.txt" 2>/dev/null; then
    in_scope=true
  elif [[ "$FILES_TOTAL" -eq 0 ]]; then
    # gh reported no per-file data (or a fixture omitted it): fall back to the
    # patch itself as the source of truth rather than dropping everything.
    in_scope=true
  fi
  if [[ "$in_scope" == "false" ]]; then
    printf '%s (over the file limit, %s diff lines)\n' "$sec_path_b" "$sec_lines" >> "$VET_DIR/diff.dropped.txt"
    continue
  fi
  if [[ "$sec_lines" -le "$remaining_lines" && "$sec_bytes" -le "$remaining_bytes" ]]; then
    printf '%s\n' "$sec_start" >> "$VET_DIR/diff-include-starts.txt"
    remaining_lines=$(( remaining_lines - sec_lines ))
    remaining_bytes=$(( remaining_bytes - sec_bytes ))
  else
    printf '%s (%s diff lines, %s bytes - did not fit the remaining budget)\n' \
      "$sec_path_b" "$sec_lines" "$sec_bytes" >> "$VET_DIR/diff.dropped.txt"
  fi
done < <(sort -t"$(printf '\t')" -k2,2n "$VET_DIR/diff-sections.tsv")

DIFF_DROPPED="$(wc -l < "$VET_DIR/diff.dropped.txt" | tr -d ' ')"
if [[ "$DIFF_DROPPED" -gt 0 ]]; then
  awk 'NR == FNR { include[$1] = 1; next }
       /^diff --git / { emit = (FNR in include) }
       emit { print }' \
    "$VET_DIR/diff-include-starts.txt" "$VET_DIR/diff.full.patch" > "$VET_DIR/diff.patch"
  note_limit "DIFF LIMIT: limits are $MAX_DIFF_LINES diff lines (VET_MAX_DIFF_LINES) and $DIFF_BYTE_BUDGET diff bytes."
  note_limit "The full diff is $DIFF_TOTAL_LINES lines. The diff of \
$(plural "$DIFF_DROPPED" "this $DIFF_DROPPED file" "these $DIFF_DROPPED files") was NOT given to the reviewers:"
  sed 's/^/  - /' "$VET_DIR/diff.dropped.txt" >> "$CONTEXT_NOTES"
  note_limit "The files themselves are still present in the worktree at the PR head, but no reviewer was shown their changes."
else
  cp "$VET_DIR/diff.full.patch" "$VET_DIR/diff.patch"
fi
DIFF_LINES="$(wc -l < "$VET_DIR/diff.patch" | tr -d ' ')"

# Existing review + issue comments, so no reviewer re-raises a point that has
# already been made on the PR.
if [[ "$DRY_RUN" == "true" ]]; then
  if [[ -f "$FIXTURE_DIR/comments.json" ]]; then
    cp "$FIXTURE_DIR/comments.json" "$VET_DIR/comments.raw.json"
  else
    printf '{"review_comments":[],"issue_comments":[]}\n' > "$VET_DIR/comments.raw.json"
  fi
else
  gh api "repos/$REPO_SPEC/pulls/$PR_NUMBER/comments" --paginate 2>/dev/null |
    jq -s 'add // []' > "$VET_DIR/review-comments.json" ||
    printf '[]\n' > "$VET_DIR/review-comments.json"
  gh api "repos/$REPO_SPEC/issues/$PR_NUMBER/comments" --paginate 2>/dev/null |
    jq -s 'add // []' > "$VET_DIR/issue-comments.json" ||
    printf '[]\n' > "$VET_DIR/issue-comments.json"
  jq -n \
    --slurpfile review "$VET_DIR/review-comments.json" \
    --slurpfile issue "$VET_DIR/issue-comments.json" \
    '{
       review_comments: [($review[0] // [])[] | {
         kind: "review", id, user: (.user.login // "unknown"),
         path: (.path // null), line: (.line // .original_line // null),
         created_at, body: (.body // "")
       }],
       issue_comments: [($issue[0] // [])[] | {
         kind: "issue", id, user: (.user.login // "unknown"),
         path: null, line: null, created_at, body: (.body // "")
       }]
     }' > "$VET_DIR/comments.raw.json"
fi

COMMENTS_TOTAL="$(jq -r '((.review_comments // []) | length) + ((.issue_comments // []) | length)' "$VET_DIR/comments.raw.json")"
COMMENTS_RAW_BYTES="$(wc -c < "$VET_DIR/comments.raw.json" | tr -d ' ')"
if [[ "$COMMENTS_RAW_BYTES" -gt "$MAX_COMMENT_BYTES" ]]; then
  # Keep the newest comments: those are the ones a new review is most likely to
  # duplicate.
  jq -c '((.review_comments // []) + (.issue_comments // [])) | sort_by(.created_at) | reverse | .[]' \
    "$VET_DIR/comments.raw.json" |
    awk -v budget="$MAX_COMMENT_BYTES" '
      { size = length($0) + 1 }
      used + size <= budget { print; used += size; next }
      { dropped += 1 }
      END { printf "%d\n", dropped + 0 > "/dev/stderr" }
    ' 2> "$VET_DIR/comments.dropped.count" |
    jq -s 'sort_by(.created_at) | {review_comments: [.[] | select(.kind == "review")], issue_comments: [.[] | select(.kind == "issue")]}' \
      > "$VET_DIR/comments.json"
  COMMENTS_DROPPED="$(cat "$VET_DIR/comments.dropped.count" 2>/dev/null || printf '0')"
  note_limit "COMMENT LIMIT: existing PR comments are $COMMENTS_RAW_BYTES bytes, the limit is $MAX_COMMENT_BYTES (VET_MAX_COMMENT_BYTES)."
  note_limit "The $COMMENTS_DROPPED oldest of $COMMENTS_TOTAL existing comments \
$(plural "$COMMENTS_DROPPED" was were) NOT shown to the reviewers, so a finding may duplicate one of them."
else
  cp "$VET_DIR/comments.raw.json" "$VET_DIR/comments.json"
  COMMENTS_DROPPED=0
fi
COMMENTS_SHOWN="$(jq -r '((.review_comments // []) | length) + ((.issue_comments // []) | length)' "$VET_DIR/comments.json")"

if [[ -n "$EMPTY_CHECKLIST_WARNING" ]]; then
  note_limit "CHECKLIST: $EMPTY_CHECKLIST_WARNING"
fi

{
  printf 'Context limits for vet run %s (PR #%s)\n' "$RUN_ID" "$PR_NUMBER"
  printf '=========================================================\n\n'
  if [[ -s "$CONTEXT_NOTES" ]]; then
    printf 'THIS REVIEW DOES NOT COVER THE WHOLE PULL REQUEST.\n\n'
    cat "$CONTEXT_NOTES"
  else
    printf 'No truncation: every changed file and every diff line of this PR was\n'
    printf 'given to both reviewers, together with all %s existing PR comments.\n' "$COMMENTS_TOTAL"
  fi
  printf '\nMeasured:\n'
  printf '  changed files:      %s (kept %s, limit %s)\n' "$FILES_TOTAL" "$(( FILES_TOTAL - FILES_DROPPED ))" "$MAX_FILES"
  printf '  diff lines:         %s (kept %s, limit %s)\n' "$DIFF_TOTAL_LINES" "$DIFF_LINES" "$MAX_DIFF_LINES"
  printf '  existing comments:  %s (kept %s, byte limit %s)\n' "$COMMENTS_TOTAL" "$COMMENTS_SHOWN" "$MAX_COMMENT_BYTES"
  printf '  checklist items:    %s\n' "$CHECKLIST_COUNT"
} > "$VET_DIR/context-limits.txt"
rm -f "$CONTEXT_NOTES"

CONTEXT_TRUNCATED=false
if grep -q 'THIS REVIEW DOES NOT COVER THE WHOLE PULL REQUEST' "$VET_DIR/context-limits.txt"; then
  CONTEXT_TRUNCATED=true
fi

# --- Readable PR digest -------------------------------------------------------

{
  printf '# PR context digest\n\n'
  # A printf format starting with "-" is parsed as an option by the bash
  # builtin, so these bullets go through a %s format instead.
  printf '%s\n' "- Repository:   $REPO_SPEC"
  printf '%s\n' "- PR:           #$PR_NUMBER $PR_TITLE"
  printf '%s\n' "- URL:          $PR_URL"
  printf '%s\n' "- Author:       $PR_AUTHOR"
  printf '%s\n' "- State:        $PR_STATE (draft: $PR_IS_DRAFT, cross-repository: $IS_CROSS_REPOSITORY)"
  printf '%s\n' "- Base -> head: $BASE_REF -> $HEAD_REF"
  printf '%s\n' "- Reviewed OID: $HEAD_OID"
  printf '%s\n' "- Size:         $PR_CHANGED_FILES changed files, +$PR_ADDITIONS / -$PR_DELETIONS"
  printf '%s\n' "- Labels:       $(jq -r '[.labels // [] | .[].name] | join(", ") | if . == "" then "(none)" else . end' "$VET_DIR/pr.json")"
  printf '\n## PR description\n\n'
  jq -r '.body // "" | if . == "" then "(the author left the description empty)" else . end' "$VET_DIR/pr.json"
  printf '\n\n## Commits\n\n'
  jq -r '[.commits // []] | .[] | .[] | "- \(.oid[0:8]) \(.messageHeadline // "")"' "$VET_DIR/pr.json" 2>/dev/null ||
    printf '(commit list unavailable)\n'
  printf '\n## Changed files given to the reviewers\n\n'
  if [[ "$FILES_TOTAL" -eq 0 ]]; then
    printf '(no per-file data; use the patch itself)\n'
  else
    jq -r --slurpfile kept <(jq -R -s 'split("\n") | map(select(length > 0))' "$VET_DIR/files.kept.txt") \
      '.[] | select(.path as $p | $kept[0] | index($p)) | "- \(.path) (+\(.additions // 0)/-\(.deletions // 0))"' \
      "$VET_DIR/files.json"
  fi
  printf '\n## Existing PR comments (do NOT re-raise these)\n\n'
  if [[ "$COMMENTS_SHOWN" -eq 0 ]]; then
    printf '(none)\n'
  else
    jq -r '((.review_comments // []) + (.issue_comments // []))[] |
      "### \(.kind) comment by \(.user)\(if .path then " on \(.path):\(.line // "?")" else "" end)\n\n\(.body)\n"' \
      "$VET_DIR/comments.json"
  fi
  printf '\n## Context limits\n\n'
  cat "$VET_DIR/context-limits.txt"
} > "$VET_DIR/review-context.md"

printf '%s\n' "$PR_TITLE" > "$VET_DIR/title.txt"

# Sentinel for run-reviewer-b's sandbox probe: it lives in the run dir, outside
