cat > "$VET_DIR/run-wait" <<'HELPER'
#!/usr/bin/env bash
set -euo pipefail
EVENT="$1"
STATUS_FILE="$2"
PANE="$3"
TIMEOUT_SECONDS="$4"
LABEL="$5"

log() {
  printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"
}

# COMPLETION IS THE STATUS FILE, NOT THE TMUX EVENT.
#
# The reviewer helpers delete this file when they start and write it exactly
# once, BEFORE signalling, when they finish. So a non-empty status file means
# "this cycle finished" and nothing else can mean that. -s (not -f) is
# deliberate: it skips the instant during which the redirect has truncated the
# file but not yet written to it.
#
# The tmux event is only a low-latency hint, because it cannot be trusted alone.
# Measured on tmux 3.4: `tmux wait-for -S` on a channel with no waiter LATCHES,
# and the next wait-for on that channel returns immediately (the latch is
# single-shot). vet reuses one channel per reviewer for every
# reviewer-a / reviewer-a-resume / wait-a cycle of a run, so a latch left over
# from an earlier cycle used to make the next wait return at once - and because
# the old code then trusted the event, the Manager read a PASSING status from
# the previous cycle while the new reviewer was still running. A hang would have
# been safer than that.
#
# Two rules keep this correct no matter how the reviewer and the waiter race:
#   1. Release our own waiter by SIGNALLING it, never by killing it. Signalling
#      while our own waiter is alive to consume it does not arm the channel -
#      only a signal with NOBODY waiting does. Killing looked safer and is not:
#      measured on tmux 3.4, a killed `tmux wait-for` client stays in the
#      channel's waiter list and SWALLOWS the next signal sent to that name,
#      silently breaking the next cycle that reuses the event. squad hit this
#      first and was fixed the same way; this is that shape, ported.
#   2. Never write a status over one that is already there.
status_ready() {
  [[ -s "$STATUS_FILE" ]]
}

# Test the OUTPUT, not the exit status. `tmux display-message -p -t <pane>` exits
# 0 and prints NOTHING for a pane that does not exist, so the exit status alone
# never detects a vanished pane and the 125 path could never fire. tmux keeps no
# record of dead pane IDs, so a killed pane is indistinguishable from one that
# never existed - both print nothing.
pane_alive() {
  local found
  found="$(tmux display-message -p -t "$PANE" '#{pane_id}' 2>/dev/null || true)"
  [[ -n "$found" ]]
}

report_done() {
  log "$LABEL finished (status $(cat "$STATUS_FILE"))."
  exit 0
}

# Upper bound on how long we let our OWN `tmux wait-for` client take to notice
# the signal we send it. It exits at once in practice; the bound exists only so
# this script can never block forever.
WAITER_GRACE_SECONDS=5

# Killing is the LAST resort, never the normal mechanism - see rule 1 above.
reap_waiter() {
  local waited=0
  while kill -0 "$WAIT_PID" 2>/dev/null; do
    if (( waited >= WAITER_GRACE_SECONDS )); then
      log "$LABEL: the tmux wait-for client ignored our own signal; terminating it. Event $EVENT may now swallow one signal - use a fresh cycle rather than reusing it."
      kill "$WAIT_PID" 2>/dev/null || true
      break
    fi
    sleep 1
    waited=$((waited + 1))
  done
  wait "$WAIT_PID" 2>/dev/null || true
}

WAIT_PID=""
release_waiter() {
  if [[ -n "$WAIT_PID" ]] && kill -0 "$WAIT_PID" 2>/dev/null; then
    tmux wait-for -S "$EVENT"
    reap_waiter
  elif [[ -n "$WAIT_PID" ]]; then
    wait "$WAIT_PID" 2>/dev/null || true
  fi
  WAIT_PID=""
}
# shellcheck disable=SC2329  # invoked by the EXIT trap
cleanup() { release_waiter; }
trap cleanup EXIT

# Fast path: the reviewer may have finished before this wait was ever called.
if status_ready; then
  report_done
fi

tmux wait-for "$EVENT" &
WAIT_PID=$!

elapsed=0
while :; do
  # Authoritative check, always first.
  if status_ready; then
    release_waiter
    report_done
  fi

  # The event fired but no status file exists. The reviewer always writes the
  # status before it signals, so this cannot be this cycle's completion: it is a
  # stale latch from an earlier cycle. Discard it and keep waiting for the real
  # thing. The latch is single-shot, so this re-arm happens at most once.
  if [[ -n "$WAIT_PID" ]] && ! kill -0 "$WAIT_PID" 2>/dev/null; then
    wait "$WAIT_PID" 2>/dev/null || true
    log "$LABEL: discarded a stale tmux signal (no status file was written)."
    tmux wait-for "$EVENT" &
    WAIT_PID=$!
  fi

  if ! pane_alive; then
    release_waiter
    # The pane may have vanished only after the reviewer finished.
    if status_ready; then
      report_done
    fi
    printf '125\n' > "$STATUS_FILE"
    log "$LABEL pane disappeared before completion."
    exit 0
  fi

  if (( elapsed >= TIMEOUT_SECONDS )); then
    release_waiter
    # Re-read before giving up: the reviewer may have finished during the last
    # sleep. Recording 124 over a real status would report a completed review as
    # a timeout.
    if status_ready; then
      report_done
    fi
    printf '124\n' > "$STATUS_FILE"
    log "$LABEL timed out after $TIMEOUT_SECONDS seconds."
    exit 0
  fi

  sleep 1
  ((elapsed += 1))
done
HELPER
chmod +x "$VET_DIR/run-wait"

cat > "$VET_DIR/update-title" <<'HELPER'
