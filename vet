# --- Manager permissions ------------------------------------------------------
#
# The Manager is INTERACTIVE and orchestrates everything, so it must not run
# with --dangerously-skip-permissions: that would make vet's central promise
# ("never edits the reviewed code, never posts to GitHub unless the PO asks")
# depend on prompt text alone. Instead it is constrained at the CLI level, the
# same way the reviewers are, and anything not allowlisted becomes a permission
# prompt the PO answers. A prompt is the desired fail-safe here, not a bug.
#
# Verified against the installed CLI:
#   * --setting-sources "" is required. With the PO's own settings.json loaded,
#     a broad Bash allowlist leaks in and mutations stop failing closed.
#   * Write/Edit path scoping needs the DOUBLE-SLASH absolute form. Verified:
#     Write(/abs/**) does NOT match and still prompts, while Write(//abs/**)
#     matches. With Write(//$VET_DIR/**), writing the run's own files was approved
#     and writing into the reviewed repo prompted and never happened.
#   * Shell redirection out of the artifact dir is blocked independently of the
#     allowlist ("Output redirection to '...' was blocked").
#   * Mutating git is NOT auto-permitted: `git commit -am ...` and `git tag ...`
#     both returned "This command requires approval" and neither took effect.
#   * Read-only commands (ls, cat, git status) are auto-permitted by the CLI's
#     own classifier even without a rule, so this allowlist only has to grant
#     the workflow's specific commands - it never has to enumerate safe reads.
#
# Command CHAINING does not bypass a rule - measured, not assumed. With only
# Bash(git log:*) allowlisted: `git log --oneline; git tag X`, the same with &&,
# and `git log | tee FILE` all returned "This Bash command contains multiple
# operations. The following part requires approval: <the mutating part>", and
# `$(...)` / backticks were refused with "Contains command_substitution". No tag
# and no file was created. So an allowlisted read command CANNOT be used to
# smuggle a second command.
#
# What DOES bypass everything is handing over a command whose argument is later
# executed somewhere without a permission layer - see the run-step comment above
# for the confirmed tmux send-keys exploit. That is why the Bash allowlist below
# is a single argv-validated dispatcher and nothing else.
#
# Deliberately NOT allowlisted, so each always requires the PO to approve:
#   * ALL tmux - the Manager drives agents only through run-step.
#   * ALL gh, including read forms. A prefix rule cannot separate `gh api <path>`
#     from `gh api -X POST <path>`, and vet already collected pr.json,
#     diff.patch and comments.json, so the Manager needs no network at all.
#   * ALL git. The Manager settles contradictions by READING the worktree and
#     diff.patch, which the Read tool covers; a genuine need for git history is
#     rare enough to be worth one prompt.
#   * cat / pbcopy / open - the Read tool replaces cat, and vet itself prints the
#     pbcopy line when the run ends.
#
# Write/Edit are scoped to the three things the Manager legitimately produces,
# NOT to $VET_DIR/** as a whole. That is a deliberate deviation: $VET_DIR also
# holds run-step (which is allowlisted for EXECUTION) and state.env, so a
# blanket write rule would let the Manager rewrite the very files that enforce
# these limits and hand itself arbitrary code execution.
MANAGER_ALLOWED_TOOLS="Read Glob Grep"
# $VET_DIR is already absolute, so exactly ONE extra slash is prepended to reach
# the double-slash form the CLI wants: /<abs path> -> //abs/path
MANAGER_ALLOWED_TOOLS="$MANAGER_ALLOWED_TOOLS Write(/$VET_DIR/consolidated.json) Edit(/$VET_DIR/consolidated.json)"
MANAGER_ALLOWED_TOOLS="$MANAGER_ALLOWED_TOOLS Write(/$VET_DIR/new-title.txt) Edit(/$VET_DIR/new-title.txt)"
MANAGER_ALLOWED_TOOLS="$MANAGER_ALLOWED_TOOLS Write(/$VET_DIR/notes/**) Edit(/$VET_DIR/notes/**)"
MANAGER_ALLOWED_TOOLS="$MANAGER_ALLOWED_TOOLS Bash($VET_DIR/run-step:*)"
MANAGER_DISALLOWED_TOOLS="NotebookEdit Task WebFetch WebSearch"
MANAGER_TOOLS="Read,Glob,Grep,Bash,Write,Edit"
printf '%s\n' "$MANAGER_ALLOWED_TOOLS" > "$VET_DIR/manager-allowed-tools.txt"

# Fail closed: if a future CLI drops any flag vet relies on to constrain an
# agent, stop instead of silently launching an unconstrained one.
require_claude_enforcement_flags() {
  local who="$1" flag missing=()
  for flag in --tools --setting-sources --allowedTools --disallowedTools --strict-mcp-config; do
    claude --help 2>&1 | grep -q -- "$flag" || missing+=("$flag")
  done
  if [[ ${#missing[@]} -gt 0 ]]; then
    echo "Error: the installed claude CLI no longer supports: ${missing[*]}" >&2
    echo "       vet cannot constrain the $who at the CLI level, and refuses to" >&2
    echo "       launch it with prompt-only restrictions. Aborting." >&2
    return 1
  fi
  return 0
}

