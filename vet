# ALWAYS BRACE VARIABLES IN JAPANESE PROSE - ${VAR}, never $VAR.
#
# bash 3.2 (/bin/bash on macOS, GNU bash 3.2.57) scans an identifier byte by
# byte and treats the FIRST BYTE of a following multibyte character as part of
# the name. `。` is U+3002 = E3 80 82, so "$HEAD_OID。" is parsed as the variable
# HEAD_OID\xE3, which is unset, and under `set -u` the script aborts:
#
#   $ /bin/bash -c 'set -u; HEAD_OID=abc; echo "コミット $HEAD_OID。"'
#   /bin/bash: HEAD_OID?: unbound variable        (exit 127)
#   $ /bin/bash -c 'set -u; HEAD_OID=abc; echo "コミット ${HEAD_OID}。"'
#   コミット abc。                                 (exit 0)
#
# This aborted the first real run of vet, at the very end of a launch that had
# already fetched the PR and built the worktree. A bare $VAR only bites when a
# multibyte character follows IMMEDIATELY, so most of the names below are safe
# today - they are braced anyway, because the next person to reword this
# sentence will not know the rule and a space is all that separates working
# from broken. Measured as safe regardless of what follows: ${VAR}, positional
# $1/$@/$#/$?, ${VAR:-default} with a Japanese default, $((arith)) and
# ${array[@]}. Only a bare $NAME is exposed.
MANAGER_TASK="PR #${PR_NUMBER} (${REPO_SPEC}) のレビューを開始してください: ${PR_TITLE}
${PR_URL}

チェックリスト ${CHECKLIST_COUNT} 項目、レビュー対象コミット ${HEAD_OID}。
Reviewer A と Reviewer B を並行で起動し、両方の結果を突き合わせて
${CONSOLIDATED_PATH} に統合 JSON を書いてください。レポート HTML は vet が生成します。
GitHub には何も投稿しないでください。"

require_claude_enforcement_flags "Manager" || exit 1

cd "$WORKDIR"
# Everything the launch needed has succeeded; from here the run is the PO's to
# keep. The Manager may still fail or be interrupted, but the worktree and
# artifacts must survive that so the PO can inspect or `vet resume`.
VET_LAUNCH_COMMITTED=true
set +e
printf '[%s] Manager prompt sent for PR #%s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$PR_NUMBER"
CLAUDE_CODE_DISABLE_TERMINAL_TITLE=1 claude \
  --setting-sources "" \
  --strict-mcp-config \
  --add-dir "$VET_DIR" \
  --tools "$MANAGER_TOOLS" \
  --allowedTools "$MANAGER_ALLOWED_TOOLS" \
  --disallowedTools "$MANAGER_DISALLOWED_TOOLS" \
  --append-system-prompt "$(cat "$VET_DIR/manager-prompt.md")" \
  --session-id "$MANAGER_SESSION_ID" \
  "$MANAGER_TASK"
MANAGER_STATUS=$?
set -e

echo ""
echo "Manager exited with status $MANAGER_STATUS."
echo "PR worktree retained at: $WORKDIR"
echo "Artifacts retained at:   $VET_DIR"

if [[ -f "$CONSOLIDATED_PATH" ]]; then
  if ! validate_against_schema "$CONSOLIDATED_PATH" "$VET_DIR/consolidated-schema.json" 2>/tmp/vet-validation.$$; then
    echo "" >&2
    echo "Error: the Manager's consolidated JSON does not match the schema." >&2
    cat /tmp/vet-validation.$$ >&2
    rm -f /tmp/vet-validation.$$
    echo "" >&2
    echo "NOTHING WAS RENDERED. A report is not shown rather than shown wrong:" >&2
    echo "a page that says 'must_fix 0' because the data was malformed would read" >&2
    echo "exactly like a clean review." >&2
    echo "" >&2
    echo "The Manager's raw output:" >&2
    printf '%s\n' "$CONSOLIDATED_PATH" >&2
    echo "The schema it must match:" >&2
    printf '%s\n' "$VET_DIR/consolidated-schema.json" >&2
    # Never leave an earlier render sitting there looking like this run's result.
    if [[ -f "$REPORT_PATH" ]]; then
      mv "$REPORT_PATH" "$VET_DIR/report.previous.html"
      echo "" >&2
      echo "An earlier report.html existed and predates this attempt; it has been" >&2
      echo "moved aside so it cannot be mistaken for the current run:" >&2
      printf '%s\n' "$VET_DIR/report.previous.html" >&2
    fi
    echo "" >&2
    echo "Two ways forward, both of which end in a rendered report:" >&2
    echo "  1. Fix the JSON yourself, then render it - no agent, no cost:" >&2
    echo "       vet render $RUN_ID" >&2
    echo "  2. Have the Manager rewrite it; resume validates and renders on exit:" >&2
    echo "       vet resume $RUN_ID" >&2
    exit 1
  fi
  rm -f /tmp/vet-validation.$$
  render_report_html "$CONSOLIDATED_PATH" "$REPORT_PATH"
  echo ""
  printf 'must_fix %s / should_fix %s / nit %s / question %s\n' \
    "$(jq '[.findings[]?|select(.severity=="must_fix")]|length' "$CONSOLIDATED_PATH")" \
    "$(jq '[.findings[]?|select(.severity=="should_fix")]|length' "$CONSOLIDATED_PATH")" \
    "$(jq '[.findings[]?|select(.severity=="nit")]|length' "$CONSOLIDATED_PATH")" \
    "$(jq '[.findings[]?|select(.severity=="question")]|length' "$CONSOLIDATED_PATH")"
  echo ""
  echo "Report (cmd+click to open):"
  # Its own line, nothing appended, so the terminal linkifies the whole path.
  printf '%s\n' "$REPORT_PATH"
  if [[ "$OPEN_REPORT" == "true" ]]; then
    if command -v open >/dev/null 2>&1; then
      open "$REPORT_PATH"
    else
      echo "Note: --open needs the macOS 'open' command, which is not available."
    fi
  fi
else
  echo ""
  echo "The Manager wrote no consolidated JSON at: $CONSOLIDATED_PATH"
  echo "Nothing to render. Resume with: vet resume $RUN_ID"
fi
exit "$MANAGER_STATUS"
