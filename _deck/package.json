{
  "name": "deck",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted slide production: HTML/CSS on a fixed canvas, rendered by headless Chrome, linted on real geometry.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "deck": "./src/cli.js"
  },
  "scripts": {
    "test": "node --test --test-timeout=300000 \"test/unit/*.test.js\" \"test/geometry/*.test.js\" \"test/e2e/*.test.js\"",
    "test:unit": "node --test \"test/unit/*.test.js\"",
    "test:geometry": "node --test --test-timeout=300000 \"test/geometry/*.test.js\"",
    "test:e2e": "node --test --test-timeout=300000 \"test/e2e/*.test.js\""
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "pngjs": "7.0.0",
    "playwright-core": "1.64.0",
    "yaml": "2.9.1"
  }
}
