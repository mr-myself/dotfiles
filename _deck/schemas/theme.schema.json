{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deck.local/schemas/theme.schema.json",
  "title": "deck theme tokens",
  "description": "A theme is DATA, not code: theme.yaml + CSS + component templates + style-brief.md + reference/*.png. Following the design kit, size and spacing values are [min, max] bands rather than scalars, because the contract is the band: content that does not fit may be re-wrapped but must not be shrunk out of its band.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "name",
    "canvas",
    "colors",
    "typography",
    "spacing",
    "page_types",
    "pagination",
    "lint",
    "fonts"
  ],
  "properties": {
    "schema": {
      "const": "deck.theme/1"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "derived_from": {
      "type": "string",
      "description": "Provenance. Values measured from a generated raster are approximate BY CONSTRUCTION and this says so."
    },
    "provenance_note": {
      "type": "string"
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "safe_margins_px"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "aspect_ratio": {
          "type": "string"
        },
        "render_scale": {
          "type": "number",
          "minimum": 1,
          "maximum": 4,
          "description": "Delivery PNG scale. Measurement is always in authored pixels."
        },
        "safe_margins_px": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "left",
            "right",
            "top",
            "bottom"
          ],
          "description": "Vertically ASYMMETRIC in this kit (top 60, bottom 65), which is why the canvas centre and the safe-region centre are different y values and a centring contract must name its reference.",
          "properties": {
            "left": {
              "type": "number"
            },
            "right": {
              "type": "number"
            },
            "top": {
              "type": "number"
            },
            "bottom": {
              "type": "number"
            }
          }
        }
      }
    },
    "colors": {
      "type": "object",
      "description": "Colour roles. Each is a hex value plus the role it plays, following the design kit's {hex, use} shape.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hex",
          "use"
        ],
        "properties": {
          "hex": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "use": {
            "type": "string",
            "minLength": 1
          },
          "measured": {
            "type": "boolean",
            "description": "true when sampled from a generated raster, and therefore approximate."
          }
        }
      }
    },
    "fonts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stack",
        "pinned"
      ],
      "properties": {
        "stack": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "pinned": {
          "type": "array",
          "minItems": 1,
          "description": "Local font files with recorded hashes. deck does NOT depend on a system Japanese font: Hiragino is on the author's Mac but that is not a portable strategy.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "family",
              "file",
              "sha256",
              "license",
              "license_file",
              "source"
            ],
            "properties": {
              "family": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "weights": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              },
              "variable": {
                "type": "boolean"
              },
              "license": {
                "type": "string"
              },
              "license_file": {
                "type": "string"
              },
              "source": {
                "type": "string"
              },
              "bytes": {
                "type": "integer"
              }
            }
          }
        }
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size_bands_px",
        "line_height"
      ],
      "properties": {
        "size_bands_px": {
          "type": "object",
          "description": "Role -> [min, max] px on the authored canvas.",
          "additionalProperties": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "line_height": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          }
        },
        "prohibitions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "spacing": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "number"
          },
          {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          }
        ]
      }
    },
    "page_types": {
      "type": "object",
      "description": "Per-page-type geometry. Only implemented types appear here; an absent type is refused by name.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "composition"
        ],
        "properties": {
          "composition": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "pagination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "avoid_format",
        "position",
        "omit_for"
      ],
      "properties": {
        "format": {
          "type": "string",
          "description": "A template, e.g. \"{n}/{total}\" or \"{n}\"."
        },
        "avoid_format": {
          "type": "string",
          "description": "The forbidden form, recorded next to the allowed one as the design kit does."
        },
        "position": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "right_px",
            "bottom_px",
            "width_px",
            "height_px"
          ],
          "properties": {
            "right_px": {
              "type": "number"
            },
            "bottom_px": {
              "type": "number"
            },
            "width_px": {
              "type": "number"
            },
            "height_px": {
              "type": "number"
            }
          }
        },
        "omit_for": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string",
          "description": "Why this theme's folio differs from the design kit's, when it does. Recorded so a divergence is deliberate rather than accidental."
        },
        "rule": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "width_px",
            "height_px",
            "right_px",
            "y_px",
            "color"
          ],
          "description": "The short dash left of the folio.",
          "properties": {
            "width_px": {
              "type": "number"
            },
            "height_px": {
              "type": "number"
            },
            "right_px": {
              "type": "number"
            },
            "y_px": {
              "type": "number"
            },
            "color": {
              "type": "string"
            }
          }
        }
      }
    },
    "lint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "centring_tolerance_px",
        "contrast_min",
        "contrast_min_large"
      ],
      "properties": {
        "centring_tolerance_px": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "anchor_tolerance_px": {
          "type": "number",
          "minimum": 0
        },
        "alignment_near_miss_px": {
          "type": "number",
          "minimum": 0
        },
        "margin_slack_px": {
          "type": "number",
          "minimum": 0
        },
        "collision_min_area_px2": {
          "type": "number",
          "minimum": 0
        },
        "repetition_tolerance_px": {
          "type": "number",
          "minimum": 0
        },
        "repetition_roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "absolute_min_font_px": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "contrast_min": {
          "type": "number",
          "exclusiveMinimum": 1
        },
        "contrast_min_large": {
          "type": "number",
          "exclusiveMinimum": 1
        },
        "contrast_exceptions": {
          "type": "object",
          "description": "Role -> relaxed minimum. An exception here is REPORTED by deck doctor and deck lint, never silent: the design kit's agenda grey is deliberately low-contrast and the PO decided to record it rather than quietly darken it.",
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "exception_notes": {
          "type": "object",
          "description": "Role -> why the exception exists. Required for every entry in contrast_exceptions; deck validate refuses an undocumented exception.",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "occupancy": {
          "type": "object",
          "additionalProperties": false,
          "description": "OCCUPANCY THRESHOLDS, which must be MEASURED rather than chosen. Derived from real renders of test/fixtures/full-deck and deck's own init scaffold, with under-filled pages built by stripping content out of the fixture; each threshold sits just outside the worst page that is actually fine. Both tiers report as SUGGESTIONS: a blocking floor was built first and it failed deck's own scaffold, because good and under-filled pages overlap on both metrics. A theme with no occupancy block is not held to another theme's numbers - the rule does not run for it at all.",
          "properties": {
            "grid": {
              "type": "integer",
              "minimum": 4,
              "maximum": 400,
              "description": "Cells across the content region's width; rows are derived so the cells are square. A coarse grid is the point - this measures whether the page has anything on it, not how it is composed."
            },
            "exempt": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Page types whose emptiness is the design - a statement, a cover, a chapter divider. Declared in the theme rather than hard-coded, because which pages are deliberately sparse is a property of the design."
            },
            "advise_below": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Suggest when content ink covers less than this fraction of the content region."
            },
            "trailing_gap_above": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Suggest when this fraction of the region's HEIGHT, measured up from the bottom, holds no content. The measurement that matches 下半分が完全な空白: a page whose emptiness is at the SIDE, under the theme's landscape, scores zero here and is not reported."
            }
          }
        }
      }
    },
    "slots": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "style_brief_file": {
          "type": "string"
        },
        "reference_images": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
