# ==============================================================================
# 1Password (op) credentials
# ==============================================================================
# シェル起動時に op read すると、タブを開くたびに認証ポップアップが出る。
# 必要なときだけ手で呼ぶ。1シェルにつき1回で、そのシェルの間は維持される。
oykot-env() {
  local token account
  token="$(op read 'op://OYKOT/Cloudflare-Pages-Deploy/password')" || return 1
  account="$(op read 'op://OYKOT/Cloudflare-Pages-Deploy/username')" || return 1
  export CLOUDFLARE_API_TOKEN="$token"
  export CLOUDFLARE_ACCOUNT_ID="$account"
}

# ==============================================================================
# Modern CLI stack (2026)
# ==============================================================================
# Every block is guarded, so a machine without the tool still starts a shell.
# Nothing here is sourced from the network and nothing authenticates, so shell
# startup stays as fast and as quiet as the 1Password rule above wants it.

# --- fzf: fuzzy find for everything -------------------------------------------
if (( $+commands[fzf] )); then
  # ctrl-r (history), ctrl-t (files), alt-c (cd). fzf >= 0.48 ships this itself.
  source <(fzf --zsh) 2>/dev/null

  export FZF_DEFAULT_OPTS='--height 60% --layout=reverse --border --info=inline'

  # fd respects .gitignore, which is what makes ctrl-t usable inside a repo the
  # size of the organization checkouts.
  if (( $+commands[fd] )); then
    export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
  fi

  # ディレクトリ移動は fd ではなく proj-dirs。
  #
  # fzf の既定（fd --type d を cwd から）は、ホームで走らせると終わりません。
  # 遅いのではなく、3分以上かけて一覧が出てこない。Library・Dropbox・無数の
  # node_modules・squad の run ディレクトリを全部掘るからです。
  # 実際に移動したい先は約110個で深さも決まっているので、glob で即座に出せます。
  if (( $+commands[proj-dirs] )); then
    export FZF_ALT_C_COMMAND='proj-dirs'
    export FZF_ALT_C_OPTS="--prompt 'dir > ' --preview 'eza -la --git --group-directories-first {} 2>/dev/null || ls -la {}' --preview-window right,55%"
  fi

  # ctrl-g にも同じものを割り当てる。
  #
  # alt-c は iTerm2 の Option キーが「Esc+」を送る設定になっていないと届かず、
  # 既定の「Normal」では ç が入力されるだけです。設定を変えると Option+文字で
  # アクセント記号が打てなくなるので、それは本人の判断に任せ、設定を変えなくても
  # 使えるキーを用意しておく。
  if (( $+widgets[fzf-cd-widget] )); then
    bindkey '^G' fzf-cd-widget
  fi
  if (( $+commands[bat] )); then
    export FZF_CTRL_T_OPTS="--preview 'bat --color=always --style=numbers --line-range=:200 {}'"
  fi
fi

# --- zoxide: cd that remembers ------------------------------------------------
# Added as `z` / `zi` rather than replacing cd, so muscle memory keeps working
# and the long `cd mr-myself/organization/oykot/...` paths become `z oykot`.
if (( $+commands[zoxide] )); then
  eval "$(zoxide init zsh)"
fi

# --- yazi: terminal file manager with real image previews ---------------------
# iTerm2 renders inline images, so `y` inside a deck's out/png shows the actual
# slides instead of a list of filenames. `y` (not `yazi`) because the wrapper
# has to cd the SHELL to wherever the browsing ended up, which the binary
# cannot do by itself.
if (( $+commands[yazi] )); then
  y() {
    local tmp cwd
    tmp="$(mktemp -t yazi-cwd.XXXXXX)" || return 1
    yazi "$@" --cwd-file="$tmp"
    if cwd="$(command cat -- "$tmp" 2>/dev/null)" && [[ -n "$cwd" && "$cwd" != "$PWD" ]]; then
      builtin cd -- "$cwd" || true
    fi
    command rm -f -- "$tmp"
  }
fi

# --- bat / eza: cat and ls with syntax highlighting ---------------------------
# `cat` and `ls` themselves are left alone: scripts and the existing l/ll/sl
# aliases depend on their exact output.
if (( $+commands[bat] )); then
  alias catp='bat --paging=never'
  export PAGER='less -FRX'
  export BAT_THEME='ansi'
fi
if (( $+commands[eza] )); then
  alias lt='eza --tree --level=2 --git-ignore'
  alias lg='eza -la --git --group-directories-first'
fi

