    // fourteen of fifteen illustration slots empty, and said that seeing
    // slots_empty=14 on the same line would have caught it on the spot. It
    // is the count `render --release` refuses on and the count the slot-fill
    // rule reports, read from status rather than recounted here.
    const f = j.slot_fill || {};
    process.stdout.write(`slots_empty=${(f.empty || []).length}\n`);
    process.stdout.write(`slots_total=${f.total === undefined ? "?" : f.total}\n`);
    process.stdout.write(`slots_awaiting_your_own=${(f.awaiting_reuse || []).length}\n`);
  } catch { process.stdout.write("phase=unknown\ncontent_approved=?\ncontent_digest_matches=?\nslots_empty=?\nslots_total=?\nslots_awaiting_your_own=?\n"); }
});' 2>/dev/null)"

printf 'round=%s\n' "$NEXT"
printf 'cap=%s\n' "$CAP"
printf 'final_round=%s\n' "$([[ "$NEXT" -ge "$CAP" ]] && printf 'yes' || printf 'no')"
printf 'render_status=0\n'
printf 'lint_status=%s\n' "$LINT"
printf '%s\n' "$SUMMARY"
printf '%s\n' "$DIGEST_BLOCK"
printf 'lint_output=%s\n' "$RUN_DIR/cycle-$NEXT-lint.txt"

# THE EXIT CODE IS ABOUT REPAIR WORK, NOT ABOUT WHETHER THE DECK IS FINISHED.
#
# `lint` exits 1 while any finding blocks, empty illustration slots included.
# Those are step 7 and this is step 6, so looping on them would burn the cap
# on work that cannot be done yet. When the only thing left is pictures, this
# exits 0 and says so - lint_verdict above still reads fail, and
# `render --release` at step 8 still refuses.
if [[ "$LINT" -eq 0 ]]; then
  exit 0
elif [[ "$LINT" -eq 1 ]]; then
  LAYOUT="$(printf '%s\n' "$SUMMARY" | sed -n 's/^blocking_layout=//p')"
  if [[ "$LAYOUT" == "0" ]]; then
    printf '\nThe LAYOUT is clean. What still blocks the lint verdict is empty\n' >&2
    printf 'illustration slots, which is step 7 and not repair work. Do not run\n' >&2
    printf 'another repair round for them: go and get the illustrations.\n' >&2
    exit 0
  fi
