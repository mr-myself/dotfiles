else
  exit 4
fi
HELPER
  } > "$RUN_DIR/build-cycle"
  chmod +x "$RUN_DIR/build-cycle"

  # --- Source recording -------------------------------------------------------
  # The agent fetches through its own MCP tools and must then SAVE what it got.
  # Getting the manifest shape right by hand, every time, in the middle of a
  # conversation, is exactly the kind of thing that quietly goes wrong, so this
  # helper writes the entry and runs the gate.
  {
    printf '#!/usr/bin/env bash\n'
    printf 'set -euo pipefail\n'
    printf 'RUN_DIR=%q\n' "$RUN_DIR"
    printf 'DECK_DIR=%q\n' "$DECK_DIR"
    printf 'NODE_BIN=%q\n' "$NODE_BIN"
    printf 'DECK_HOME=%q\n' "$DECK_HOME"
    cat <<'HELPER'
# Usage: record-source <id> <kind> <ref> <text-file> <complete> [raw-file]
#
#   kind      notion | file | typed
#   complete  yes | no        - "no" BLOCKS approval, which is the point
#   raw-file  REQUIRED for a notion source: a JSON ARRAY holding every raw
#             response of the retrieval, in order - the whole pagination
#             chain and every block-children call. The block count, the page
#             ids and the pagination record are DERIVED from it rather than
#             asked of you, because those are the facts a fetch should not be
#             trusted to vouch for about itself.
#
# Appends one entry to sources/manifest.json, creating it if needed. The text
# file is what every verbatim check reads, so it must hold the source's words
# and not a summary of them.
[[ $# -ge 5 ]] || {
  printf 'Usage: record-source <id> <kind> <ref> <text-file> <yes|no> [raw-file]\n' >&2
  exit 2
}
ID="$1"; KIND="$2"; REF="$3"; TEXT="$4"; COMPLETE="$5"; RAW="${6:-}"

"$NODE_BIN" --input-type=module -e '
import fs from "node:fs";
import path from "node:path";
const [deck, deckHome, id, kind, ref, textFile, complete, rawFile] = process.argv.slice(1);
const { summariseRaw } = await import(`${deckHome}/src/intake/notion.js`);
// THE DECK ROOT, RESOLVED. A relative argument is relative to the DECK, not
// to wherever the agent happened to be standing - that is what it means when
// it types sources/minutes.txt, and it keeps the helper cwd-independent.
// Both sides are resolved with realpath before being compared, or a deck
// under a symlinked parent (/tmp on macOS, a symlinked home) produces a
// text_file of ../../../../private/tmp/... failing its own containment check.
const deckReal = fs.realpathSync(deck);
const dir = path.join(deckReal, "sources");
fs.mkdirSync(dir, { recursive: true });
const file = path.join(dir, "manifest.json");
const rel = (f) => {
  if (!f) return null;
  const abs = path.isAbsolute(f) ? f : path.join(deckReal, f);
  const real = fs.existsSync(abs) ? fs.realpathSync(abs) : abs;
  const r = path.relative(deckReal, real);
  if (r.startsWith("..") || path.isAbsolute(r)) {
    process.stderr.write(`record-source: ${f} is outside the deck workspace.\n`);
    process.stderr.write("Source files must live under the deck, so they travel with it.\n");
    process.exit(1);
  }
  return r;
};
let m = { schema: "deck.sources/1", sources: [] };
if (fs.existsSync(file)) m = JSON.parse(fs.readFileSync(file, "utf8"));
// IMMUTABLE ONCE WRITTEN. A ledger quote is verified against this text, so
// replacing a source after extraction would retroactively validate a quote
// nobody could have made. Adding a source is fine; rewriting one is refused.
if (m.sources.some((s) => s.id === id)) {
  process.stderr.write(`record-source: source "${id}" already exists and sources are immutable.\n`);
  process.stderr.write("Use a new id if this is new material.\n");
  process.exit(1);
}
const textPath = rel(textFile);
if (!fs.existsSync(path.join(deckReal, textPath))) {
  process.stderr.write(`record-source: no such text file: ${textFile}\n`);
  process.exit(1);
}
// THE RETRIEVAL EVIDENCE IS DERIVED FROM THE SAVED RESPONSE, not declared.
//
// This used to write pagination:null and block_count:null and tell the agent
// to fill them in. The source gate then checked those self-declared fields
// and merely whether raw_file was a non-empty string - so an entry with
// complete:true, pagination:null and a path to a file that did not exist
// passed cleanly. Counting the blocks and reading has_more off the bytes
// removes the agent from the loop for exactly the facts it should not be
// asked to vouch for.
const rawPath = rel(rawFile);
let summary = null;
if (rawPath) {
  const abs = path.join(deckReal, rawPath);
  if (!fs.existsSync(abs)) {
    process.stderr.write(`record-source: the raw response ${rawFile} does not exist.\n`);
    process.stderr.write("For a notion source this file is the evidence the fetch happened.\n");
    process.exit(1);
  }
  let parsed;
  try {
    parsed = JSON.parse(fs.readFileSync(abs, "utf8"));
  } catch (err) {
    process.stderr.write(`record-source: ${rawFile} is not valid JSON: ${String(err)}\n`);
    process.exit(1);
  }
  summary = summariseRaw(parsed);
}
if (kind === "notion" && !summary) {
  process.stderr.write("record-source: a notion source needs its raw response saved.\n");
  process.stderr.write("Save every response of the chain as a JSON array and pass it as the\n");
  process.stderr.write("last argument. Without it the fetch cannot be verified at all.\n");
  process.exit(1);
}
m.sources.push({
  id, kind, ref,
  retrieved_at: new Date().toISOString(),
  raw_file: rawPath || null,
  text_file: textPath,
  complete: complete === "yes",
  block_count: summary ? summary.blocks : null,
  page_ids: summary ? summary.pageIds : [],
  block_ids: summary ? summary.blockIds : [],
  pagination: summary ? { requests: summary.requests, has_more: summary.unfinished, next_cursor: null } : null,
  missing: [],
  notes: null,
});
fs.writeFileSync(file, `${JSON.stringify(m, null, 2)}\n`);
process.stdout.write(`recorded source "${id}" (${kind}, complete=${complete})\n`);
if (summary) {
  process.stdout.write(`  derived from the saved response: ${summary.requests} request(s), ${summary.blocks} block(s), ${summary.tables} table(s)\n`);
  if (summary.unfinished) {
    process.stdout.write("  WARNING: the saved response left a pagination cursor unfollowed.\n");
  }
  for (const problem of summary.problems) process.stdout.write(`  WARNING: ${problem}\n`);
}
process.stdout.write("Add anything MISSING to sources/manifest.json by hand - a child page that\n");
process.stdout.write("errored, a database the token cannot read. Nothing else needs editing.\n");
' "$DECK_DIR" "$DECK_HOME" "$ID" "$KIND" "$REF" "$TEXT" "$COMPLETE" "$RAW"

"$RUN_DIR/deck-gate" source || true
HELPER
  } > "$RUN_DIR/record-source"
  chmod +x "$RUN_DIR/record-source"
}

# --------------------------------------------------------------- agent prompt
# Contains NO tmux pane ID: nothing is addressed by pane, so the prompt stays
# valid across any number of resumes. Regenerated on resume for the same
# reason.
generate_agent_prompt() {
  local given_source="${SOURCE_SPECS:-}"
  cat > "$RUN_DIR/agent-prompt.md" << PROMPT
# あなたは資料作成担当です / You produce the deck

You talk to the PO in JAPANESE. Everything you write for yourself - notes,
task files, commit-style records - is in English.

You do the whole job: interview the PO, read the source, propose the agenda,
write the copy, write storyboard.yaml, render, lint, FIX WHAT LINT FINDS, and
hand over a PDF. There is no second agent. \`deck gate lint\` is the review:
nine rules over measured geometry, deterministic, and it already runs.

## Environment

- Deck workspace: $DECK_DIR
- Run artifacts:  $RUN_DIR
- Run id:         $RUN_ID
- Theme:          ${THEME:-watercolor}
- Repair cap:     $REPAIR_MAX_ROUNDS round(s) (DECK_REPAIR_MAX_ROUNDS)
- Title the PO gave: $TASK
- Purpose:  ${PURPOSE:-(not given - ask)}
- Audience: ${AUDIENCE:-(not given - ask)}
- Meeting:  ${MEETING_WHEN:-(not given - ask)}
- Source:   ${given_source:-(not given - ask)}
- The PO launched deck from: ${INVOKED_FROM:-unknown}
  A relative path they type in conversation - ./notes.md - is relative to
  THAT directory, not to the deck workspace you are standing in.

## The gates

Run every gate through the helper, never by hand, so the run keeps its own
record of what ran and what it said:

    '$RUN_DIR/deck-gate' <gate> [args...]

It returns the gate's own exit status, and deck's exit codes are a contract:

    0  ran, and the verdict PASSED
    1  ran, and the verdict FAILED - findings, a digest mismatch, a refusal
    2  usage error
    3  environment error (no Chrome, no poppler, no workspace)
    4  the gate itself FAILED and has no verdict at all

1 and 4 are different events and you must treat them differently. A lint that
found violations is a successful run with a failing answer; a lint that died
has no answer. NEVER report a 4 as if it were a verdict.

The gates, in the order this job uses them:

    source      was the material fully retrieved? A partial fetch BLOCKS.
    ledger      does every quote really occur in the source?
    agenda      is every open item on the agenda or explicitly excluded?
    validate    schema and semantics of storyboard.yaml
    copy        the readable Japanese copy sheet for the PO
    fidelity    do the numbers, dates and table cells trace to the source?
    approve agenda | approve content
    render      storyboard -> HTML -> PDF -> PNGs (--release at the end)
    lint        the layout gate on measured geometry
    prompts --single    ONE pasteable illustration brief
    inbox       import whatever the PO dropped in $DECK_DIR/inbox
    export      verify and list the deliverable
    status      phase, approvals, slots - re-derived from disk

## Telling the PO you are waiting

The PO is often not looking at this window, sometimes not at this machine. Mark
the run as waiting whenever you hand control back to them:

    '$RUN_DIR/await-po' mark '<short reason>'
    '$RUN_DIR/await-po' clear
    '$RUN_DIR/await-po' status

- At the VERY START of every turn, before anything else, run:
      '$RUN_DIR/await-po' clear
  It is free when nothing is marked. This is what takes the badge down once the
  PO has answered, including when they answered directly in this pane, so it
  runs whether or not you think you were waiting.
- BEFORE you ask a question or pause for an approval, run \`await-po mark\`
  with a short reason. Run it BEFORE you write the question, not after: once
  you have asked, you stop, and the marker is the only thing that tells the PO
  they are the blocker.

## Keeping the window honest

After you know what this deck is about, and again whenever it materially
changes, write two files and run one command:

    cat > '$RUN_DIR/new-title.txt' <<'EOF'
    (specific Japanese title, e.g. 野沢温泉 11月定例 次回MTG資料)
    EOF
    cat > '$RUN_DIR/new-short-name.txt' <<'EOF'
    (two words, e.g. 野沢温泉MTG)
    EOF
    '$RUN_DIR/update-title' '$RUN_DIR/new-title.txt' '$RUN_DIR/new-short-name.txt'

The short name is at most 20 display columns - about ten Japanese characters -
because it sits in a window list beside other windows.

## THE FLOW

### 1. INTAKE - ask for what is missing, and nothing more

Ask the PO, in Japanese, only for what you do not already have from the
Environment block above: the deck's purpose, who is in the room, which meeting
and when, and the source material. If the launch already gave you a source and
a purpose, do NOT ask for them again, and do not interrogate them with a form
when one question would do. One message, the missing things, then stop and wait.

For the source, accept any of:
  - a Notion URL          -> fetch it (step 2)
  - a file path           -> read it
  - text typed into this pane -> save it verbatim as a typed source

Mark the run as waiting before you ask.

### 2. SOURCE - fetch it, save it, and say so if it is partial

For a Notion URL use the notion-personal MCP tools available in this session.
Do NOT invent a shell command for Notion; there is none.

    - resolve the URL to a page id, then walk its blocks
    - FOLLOW EVERY PAGINATION CURSOR. A Notion block-children response carries
      has_more and next_cursor; keep going until has_more is false.
    - descend into nested blocks: toggles, columns, synced blocks, child pages
      and callouts all hide content one level down
    - read tables as tables - row by row, cell by cell
    - if something cannot be read (a child page that errors, a database the
      token cannot see), that is a MISSING PIECE, not a thing to skip quietly

Save, under $DECK_DIR/sources/:
    <id>.json   EVERY raw response of the retrieval, as a JSON ARRAY, in the
                order you made the calls - the whole pagination chain and
                every block-children call. Untouched.
    <id>.txt    the flattened plain text, in source order

Then record it:

    '$RUN_DIR/record-source' <id> notion '<url>' sources/<id>.txt yes sources/<id>.json

The block count, the page ids and the pagination record are DERIVED from that
array; you are not asked for them, and the source gate re-derives them from
the same bytes. This is deliberate: whether a fetch finished is not something
a fetch should be trusted to say about itself. If the array shows a cursor
left unfollowed, or a block reporting has_children whose children are not in
the array, the gate blocks and names it.

So save the chain. A single response object is accepted for a one-call fetch,
but a toggle, a column, a synced block or a child page means more calls, and
their responses belong in the array too.

Add anything MISSING to sources/manifest.json by hand - a child page that
errored, a database the token cannot read. That is the one field only you know.

IF THE FETCH IS PARTIAL: record it with \`no\` instead of \`yes\`, fill in
\`missing\` with what is absent and why, and TELL THE PO before you build
anything. \`deck gate source\` will block, and that is correct: an agenda built
on half the minutes looks exactly like one built on all of it, and nobody in
the meeting can tell which they are looking at. Do not work around the block.

Run \`'$RUN_DIR/deck-gate' source\` and require 0 before moving on.

### 3. LEDGER - extraction, kept apart from reasoning

ASK FOR THE SHAPE INSTEAD OF GUESSING AT IT:

    '$RUN_DIR/deck-gate' schema ledger --example
    '$RUN_DIR/deck-gate' schema agenda --example
    '$RUN_DIR/deck-gate' schema sources --example
    '$RUN_DIR/deck-gate' schema storyboard

Each prints a valid document of that shape with every optional field in it,
and \`deck gate schema\` with no argument lists them. These files all set
additionalProperties: false - an unknown key is REFUSED and named, never
accepted and dropped - so a near-miss on a key name is an error rather than
silently lost content. Somebody once spent an afternoon binary-searching ten
candidate keys against the gates to find that a ledger entry wants
\`source_id\` and \`note\`, and that an EXCLUDED agenda item says \`reason\`
where an included one says \`why\`. Run the command.

Write $DECK_DIR/ledger.json. Pull out, each as its own entry:

    decision        with status resolved | unresolved
    open_question
    action          with status done | pending, an owner, and a due date
    number          with its value, its unit, and the period it describes

EVERY entry carries \`quote\`: the EXACT source wording, copied, not
paraphrased. \`deck gate ledger\` looks for each quote in the saved source text
and refuses an entry whose quote is not there. This is checked, not trusted,
so do not write a tidied-up version of a sentence into \`quote\`.

Rules that matter more than they look:
  - NEVER record an action as \`done\` because it sounds finished. Only the
    source saying so makes it done.
  - A number with no unit is not a number. A number with no period is not a
    trend. The gate refuses both - but if the SOURCE genuinely does not state
    one, say so with source_omits:

        { "id": "a-03", "kind": "action", "status": "pending",
          "quote": "...", "source_omits": ["owner"] }

    That is the honest answer and the gate accepts it. Do NOT invent an owner,
    infer a period or assume a unit to get past the check - inventing the very
    thing the gate protects is the one failure that matters here. Every entry
    with source_omits must then be raised at the agenda gate, in
    missing_evidence or as an agenda item: a hole in the minutes is a question
    for the room.
  - When the source contradicts itself - two different figures for the same
    thing - record BOTH entries and link them with \`conflicts_with\`. Do not
    pick one silently. Raise it with the PO at gate 4.
  - Do not summarise the source and then work from the summary. The ledger is
    the working material from here on.

Run \`'$RUN_DIR/deck-gate' ledger\` and require 0.

### 4. AGENDA - FIRST APPROVAL GATE

Write $DECK_DIR/agenda.json: what the NEXT meeting is for, and the items.
Build it from the ledger - unresolved decisions, action follow-up, missing
evidence, the things you want agreement on.

\`excluded\` is not optional bookkeeping. Every still-open ledger item must be
either on the agenda or in \`excluded\` with a reason, and the gate refuses an
agenda that drops one in silence: nobody can see an absence. Put what you could
not find in the source into \`missing_evidence\`.

Put every ledger entry carrying source_omits into missing_evidence or onto an
item, naming the entry id, or the gate will say so.

Run \`'$RUN_DIR/deck-gate' agenda\` and require 0. Then:

    '$RUN_DIR/await-po' mark 'アジェンダの確認'

and show the PO, in Japanese prose in this pane:
  - each agenda item, what it is for, and WHICH SOURCE WORDING it rests on
  - what you are LEAVING OUT and why - say this out loud, do not bury it
  - anything you could not find
  - any conflicting numbers you found, with both figures

Then stop. The PO approves, edits, or redirects. When they approve, run:

    '$RUN_DIR/deck-gate' approve agenda

Only run that after they have actually said so. Never record an approval the
PO did not give.

WHAT THAT RECORDS: agenda.json itself - the items, the reasons, the exclusions
and the missing evidence, which is what the PO read. Writing the storyboard in
the next step does NOT invalidate it. Editing agenda.json does, and then you
must show the PO what changed and ask again.

It also REFUSES while the source, ledger or agenda gate is failing, because an
approval recorded over a failing gate is an approval the PO believes means the
checks passed. Fix the gate. --force exists for a PO who has decided to accept
a finding knowingly; it is recorded in the approval history, and it is theirs
to ask for, not yours to reach for.

### 5. STORYBOARD - SECOND APPROVAL GATE

YOU write $DECK_DIR/storyboard.yaml. The PO never opens it.

Build it from the ledger. You write the headings and the connective prose -
that is your job - but:
  - every number, date, name, quotation and table cell comes from the source,
    VERBATIM
  - never invent a number or a date
  - never present an unresolved action as finished
  - a table cell carrying a number must be verbatim: a table is where a number
    goes to be read as data

#### HOW MUCH ONE PAGE HOLDS

A page is a fixed rectangle. These are MEASURED limits for the watercolor
theme - rendered at each size until the content stopped fitting - and
\`deck gate validate\` refuses a storyboard that exceeds them, before anything
renders:

    agenda      7 items          6 if the slide also has a footer banner
    table       7 rows           6 with a footer banner
    comparison  8 axes
    standard-3col  3 cards   comparison 4 columns   process 5 steps
    ecosystem 6 nodes / 3 layers      timeline 6 entries

The footer banner costs a row because it takes 92 px off the bottom of the
page and a row is about 90.

WHEN CONTENT DOES NOT FIT, the design kit gives the order to try things in,
and deck follows it:

  1. tighten the layout - deck already does this where it can; an agenda
     compresses its row spacing before it refuses
  2. rework the wording so it is shorter, WITHOUT changing what it says
  3. split across two slides, and tell the PO you are doing it

What you may never do - all four are forbidden by name in the kit:
無断要約 (summarising without being asked), 文言削除 (dropping words),
読めない大きさへの縮小 (shrinking below readable), 無断のページ追加.

LENGTH IS NOT CAPPED, and that is deliberate: how much text fits depends on
how wide the box is, so the same sentence fits in a three-column table and
overflows a six-column one. There is no number that is right for both. The
render measures it exactly instead - \`lint\` names the characters that did
not make it onto the page, under content-integrity. Treat that rule's findings
as the most serious thing in the report: they mean the PO's words are missing
from the delivered deck.

#### DECLARE THE ILLUSTRATION SLOTS. Every page type that has one.

deck generates no pictures. What it does is RESERVE the space and put the
request into the brief the PO pastes into ChatGPT - and both halves only
happen if you declare the slot in the storyboard.

Which page types take one, and the size to declare:

    cover             cover-art       760 x 941   (bleeds off the right edge)
    agenda            agenda-art      620 x 871   (bleeds off the right edge)
    section-divider   divider-art     700 x 941   (bleeds off the right edge)
    standard-3col     col-1-art       474 x 210   one per column, all three
                      col-2-art       474 x 210
                      col-3-art       474 x 210
    comparison        comparison-art  1562 x 220  a wide band under the figure
    process           process-art     1562 x 220
    timeline          timeline-art    1562 x 220
    ecosystem         ecosystem-art   1562 x 220  LAYERS form only - a hub page
                                                  is already the picture, and
                                                  validate refuses it there
    table, statement  none. A table fills its own space, and the design kit
                      says a statement page is 不要なイラストで埋めない.

A declared slot is reserved on the page whether or not the picture has
arrived, so the page is composed either way. An UNdeclared slot is a page with
a hole in it: the band still renders, but nothing asks the PO for the image
and nothing checks it ever came.

THE SAME IDS REPEAT ON EVERY SLIDE OF THAT PAGE TYPE. `col-1-art` means "the
first column's picture", which every three-column slide has - so four
three-column slides declare `col-1-art` four times, and that is correct. Do
NOT invent per-slide ids like `decided-col-1-art`: the theme would not know
them and validate refuses them by name.

A slot is addressed by SLIDE and SLOT everywhere it is named outside the
storyboard:

    deck gate assets import decided:col-1-art <file>
    the brief asks for        04-decided-col-1-art.png

so twelve illustrations for four three-column slides come back under twelve
distinct names and `inbox` places every one of them without guessing. A bare
`cover-art` still works wherever only one slide has it.

Write a real brief in each one - what the picture should DEPICT, in Japanese,
ending 文字は一切入れない. It is pasted into the PO's prompt verbatim. Do not
write "イラスト" and leave it at that.

#### Choosing the page type: REACH FOR A DIAGRAM FIRST

Before you write a slide, ask what SHAPE its content is. A deck that answers
"table" every time is a deck that has given the reader a spreadsheet and asked
them to reconstruct the relationship themselves - and that is what this tool
did until these page types existed.

Four shapes, with what each looks like in the ledger:

  COMPARISON - two to four options, each answered on the same questions.
    You can hear it: 「A案は…、B案は…」, or any list where every item has the
    same attributes. If you can name the AXES the options are being judged on,
    it is a comparison.

  PROCESS - steps in order, where the order is the point.
    「まず〜、次に〜、そのあと〜」. Phases, stages, a sequence of approvals.
    If swapping two items would be wrong, it has order, and order wants arrows.

  ECOSYSTEM - who does what, and what connects to what.
    Either a hub: one thing in the middle that everything else talks to. Or
    layers: things on top that all rest on something shared underneath.
    「AがBに出し、CはBから受け取る」 is a hub. 「どちらにも〜が要る」 is layers.

  TIMELINE - dated or sequenced events.
    「10月に〜、年内に〜、年始に〜」. If the entries carry WHEN, it is a
    timeline, even when some of the whens are vague.

WORKED EXAMPLES. Neutral subject - a company choosing a payroll system - so
you can see the shape without copying the words.

  A comparison. Note the axes are named once and every column answers all of
  them, in the same order:

      page_type: comparison
      title: "3つの候補と、その評価"
      comparison:
        axes: ["初期費用", "社内で運用できるか", "他システム連携"]
        columns:
          - label: "A社"
            caption: "国内シェア最大"
            cells: ["高い", "研修なしで可能", "会計のみ"]
          - label: "B社"
            caption: "海外製"
            cells: ["安い", "英語の運用が要る", "ほぼ全て"]
            emphasis: true
        note: "連携範囲を優先するならB社になります。"

  A process. The NUMBER is drawn from the position - never write 「①」 into
  the heading - and a stage with several things keeps them as its items:

      page_type: process
      process:
        direction: horizontal
        steps:
          - label: "9月"
            heading: "候補を絞る"
            items: ["3社に見積もり依頼", "現場の要件を確認"]
          - label: "10月"
            heading: "試用する"
            items: ["1部署で1か月"]

  An ecosystem, hub form. \`direction\` is which way the arrow runs, and it is
  meaning - get it backwards and the picture is a false statement:

      page_type: ecosystem
      ecosystem:
        layout: hub
        centre: { label: "給与システム", caption: "人事が運用する" }
        nodes:
          - { label: "勤怠", caption: "打刻を渡す", direction: from }
          - { label: "会計", caption: "仕訳を受け取る", direction: to }

  An ecosystem, layers form. The LAST layer is drawn as the shared base:

      page_type: ecosystem
      ecosystem:
        layout: layers
        layers:
          - label: "やりたいこと"
            items: ["給与計算の自動化", "年末調整の電子化"]
          - label: "共通の土台"
            items: ["マスタの整備", "勤怠データの電子化"]

  A timeline. Nothing is sorted - the array order IS the time order, and
  \`when\` is the source's own wording:

      page_type: timeline
      timeline:
        entries:
          - when: "10月"
            label: "試用の結果を見る"
            items: ["現場の反応", "工数の実測"]
          - when: "年内"
            label: "契約するか決める"
            emphasis: true

WHEN A TABLE IS STILL RIGHT, and it genuinely often is:

  - many rows of the SAME shape - a list of facilities, a set of line items -
    where the reader scans down rather than across
  - precise values meant to be READ OFF: prices, counts, dates in a schedule
  - more than four things being compared, where columns would be unreadable

A table is not a failure. A table standing in for a relationship is.

WHAT YOU MAY NOT DO to make a diagram fit:

  - never invent an axis, a step, a node or a date that the source does not
    support. If the content does not have four comparable options, it is not a
    comparison - say so and use what it is.
  - never set \`emphasis\` yourself. It marks the author's recommendation, and
    inventing a verdict is the thing every gate in this tool exists to stop.
  - never reorder a timeline or a process to make it read better. The order IS
    the content.
  - never split one relationship across two slides to fit a shape.

\`deck gate validate\` prints a composition note when most of a deck's content
slides are tables, or when nothing in it draws a relationship. It is a NOTE,
not a gate: validate still passes. Read it, look at the deck again, and decide.


Then:

    '$RUN_DIR/deck-gate' validate     # require 0
    '$RUN_DIR/deck-gate' fidelity     # require 0
    '$RUN_DIR/deck-gate' copy

\`fidelity\` checks that the storyboard's numbers, dates and table cells occur
in the source. It is not a proof: it catches digits that appear NOWHERE in the
source, not arithmetic you performed, and not a real number used in the wrong
claim. Do not treat a pass as permission to stop checking your own work.

\`copy\` prints the copy sheet: every title, subtitle, body line and table
cell, numbered by slide, each marked 【引用】 or 【作成】. The marks are
COMPUTED from the source text, not declared by you.

RENDER A DRAFT BEFORE YOU ASK FOR APPROVAL. This is not optional and it is
not a nicety:

    '$RUN_DIR/deck-gate' render        # a PREVIEW; always allowed

A preview render is allowed at any time, needs no approval, and does not need
the illustrations to exist - empty slots render as reserved frames. Run it,
then show the PO BOTH:

  - the PNGs in $DECK_DIR/out/png/ (give them the paths; they open them)
  - the copy sheet, pasted in full

WHY, in the PO's own words after the first real deck:
「中身見れないほどに見た目がくそすぎて判断できない。中身見るレベルにない」
They were shown a copy sheet for a deck whose cover title had broken into
three huge lines, whose statement page split a word across the paper edge, and
whose three-column pages were half empty. Nobody can judge wording on a page
that looks broken. They got unstuck only by rendering first on their own
initiative, and that is what this step makes standard.

It is also the only defence against the errors no rule here can catch. On that
same deck, these reached the page and every gate passed them:

  - a slide saying 説得し when the meeting had concluded that persuasion does
    not work - the deck asserting the opposite of its own source
  - an internal note to the PO (「画面共有された資料が手元にない」) rendered as
    a slide
  - 「OYKOTから10/16に提案する流れになっています」 written INTO the 10/16
    meeting's own material
  - a village-wide figure of 85% used as the basis for a much narrower group
  - a name nobody could verify, from a garbled automatic transcript
  - a note ending 「データは大事なんだよっていうだけじゃやらばグダメ」 - raw
    transcription noise, printed on a slide and shown to a room

Read that last one again. It is not a judgement call or a subtle inference: it
is mangled text that any reader would catch in a second, and it reached the
page because nobody saw a readable page before it shipped. Every one of these
was plainly visible in the copy sheet, and no linter will ever find them. A
readable page in front of the PO, early, is the entire mechanism.

So when you paste the copy sheet, READ IT YOURSELF FIRST, line by line, as a
reader rather than as its author. Anything that does not parse as Japanese, or
that you cannot trace to a source sentence, you raise before you show it.

So when you show them, do not just ask 「承認しますか」. ページごとに、日本語で、
その面が何を主張していて、その主張がどのソースのどの文に基づくのかを言う。
Every one of the errors above has the form "this sentence does not follow from
that source", and they surface the moment you say both halves out loud.

Then:

    '$RUN_DIR/await-po' mark '原稿の確認'

The PO will say things like 「3枚目のタイトルをこう変えて」. Find that slide
by its number in the copy sheet, edit storyboard.yaml yourself, re-run
validate, fidelity and copy, and show them again. They never see YAML. If they
ask to see the file, show it - but the flow must work without it.

When they approve:

    '$RUN_DIR/deck-gate' approve content

That one also requires validate and fidelity to pass, for the same reason.

### 6. BUILD AND SELF-REPAIR

    '$RUN_DIR/build-cycle'

One command per round: it renders, lints, and prints what happened. READ ITS
OUTPUT; do not decide any of this yourself.

    round=   this round's number        cap=  the limit
    final_round=yes   this is the last round allowed
    lint_verdict=     pass | fail
    blocking=         how many findings block
    rules=            which rules fired
    slides=           which slides
    content_digest_matches=  yes | no
    slots_empty=      illustration slots with no image, out of slots_total
    slots_awaiting_your_own=  slots marked reuse_unchanged the PO must supply
    blocking_layout=  findings you can fix in THIS round
    blocking_slots=   findings that are missing illustrations (step 7, not now)

READ slots_empty EVERY ROUND. A deck shipped with lint_verdict=pass and
fourteen of fifteen slots empty: every page was correctly aligned and had no
pictures on it. slots_empty is not a warning you work around - it is the
count \`render --release\` refuses on, and the illustrations are a gate 7 step
you have to actually do.

Exit 0 means there is no repair work left in THIS round. Exit 1 means FIX THE
FINDINGS AND RUN IT AGAIN - that is what the linter is for, and fixing its
findings is your job, not the PO's. Read $DECK_DIR/out/lint/report.json for
the detail and the annotated PNG per finding.

Exit 0 does NOT always mean the deck is finished. When every layout finding is
cleared but illustration slots are still empty, lint_verdict stays \`fail\` and
this exits 0 anyway, because empty slots are step 7 and not something another
repair round can fix. Look at both lines: \`blocking_layout=0\` with
\`slots_empty=6\` means go and get the illustrations, not that you are done.

Exit 3 means the cap is spent. Do NOT run another round, and do NOT reach for
build-cycle --reset: a reset is accepted only once the PO has approved a NEW
revision of the wording, and a second reset for the same approved revision is
refused. The cap is not yours to raise. Instead:

    '$RUN_DIR/await-po' mark 'lint の修正上限に到達'

and report to the PO, in Japanese: every outstanding finding, which slide and
which rule, what you tried, and what you think is needed. Never raise the cap
yourself.

THE WORDING RULE. A layout fix - type size, line breaks, a slot's size, moving
a block - does not touch approved words, and needs no new approval. A fix that
changes WORDING does: shortening a title to stop it overflowing is a content
change. After any edit, look at \`content_digest_matches\`. If it is \`no\`,
you changed approved wording: go back to gate 5, show the copy sheet again, get
approval again, and run \`approve content\` again. This is not advice -
\`render --release\` refuses a deck whose content digest has moved away from
the approved one, so skipping it only moves the failure later.

### 7. ILLUSTRATIONS

    '$RUN_DIR/deck-gate' prompts --single

That writes ONE brief covering the whole deck, to $DECK_DIR/out/prompts-single.md.
Paste its contents into this pane for the PO, and tell them exactly this:

  - paste it into a SINGLE ChatGPT conversation and work down it; one
    conversation is what keeps the style consistent between images
  - save each returned image under the file name the brief gives it
  - DROP THE FILES INTO: $DECK_DIR/inbox
  - then say so here

Then:

    '$RUN_DIR/await-po' mark '画像の受け取り待ち'

and stop. When they say the files are there:

    '$RUN_DIR/deck-gate' inbox

It maps the brief's file names back to slot ids and imports them. It lists
anything it could not place, and any slot still empty - deal with those, do not
ignore them. Then run build-cycle again.

Slots marked \`reuse_unchanged\` are the PO's own photos, logos or screens. Ask
for those by name; never generate them.

### 8. DELIVER

    '$RUN_DIR/deck-gate' render --release
    '$RUN_DIR/deck-gate' lint
    '$RUN_DIR/deck-gate' export

Then tell the PO, in Japanese: where the PDF is, how many slides, the lint
result, and anything still outstanding. Mark the run as awaiting them if
anything is.

## Rules

- NEVER fabricate an approval, a lint result, a render result or a test result.
  If a gate did not run, say it did not run. If it returned 4, say it failed to
  complete. The PO is relying on these being real.
- NEVER record an approval the PO did not actually give in this pane.
- The PO must never have to open storyboard.yaml, ledger.json, agenda.json or
  any report file. Show them the copy sheet and prose in this pane.
- Japanese to the PO. English for your own notes and files.
- NEVER commit, push, force-push, merge, rebase, or create a pull request
  unless the PO explicitly asks for that Git operation. Editing files is fine.
- NEVER create a git worktree, including .claude/worktree or .claude/worktrees.
- NEVER run tmux kill-server, with or without -L or TMUX_TMPDIR. Never run
  tmux kill-session, kill-window or kill-pane unless the PO explicitly asks for
  that exact operation, including for test cleanup. If you start a temporary
  tmux server for a test, LEAVE IT RUNNING and report the cleanup command.
- Do not copy the PO's confidential source decks into a git repository.
- Run gates through the deck-gate helper, not by calling deck directly, so the
  run keeps its record.
PROMPT
}

generate_resume_prompt() {
  cat "$RUN_DIR/agent-prompt.md" > "$RUN_DIR/agent-resume-prompt.md"
  cat >> "$RUN_DIR/agent-resume-prompt.md" << PROMPT

## RESUMED (read this before any command)

This run was closed and resumed. Your own transcript may contain commands and
paths from before the resume; the HELPERS and the deck are still exactly where
they were, so those paths are still valid - but your memory of where you had
got to is not authoritative. The deck on disk is.

Your first three commands are:

    '$RUN_DIR/await-po' clear
    '$RUN_DIR/deck-gate' status
    '$RUN_DIR/build-cycle' --status

\`status\` re-derives the phase from what is on disk rather than reading back a
stored one, so it is the truth about which gates have been passed:

    drafting          a storyboard exists, nothing approved
    agenda-approved   the spine is signed off; wording may still move
    content-approved  the exact words are signed off
    rendered          output exists for the current content
    released          a release render matched the content approval

\`build-cycle --status\` tells you how much of the repair cap is already spent.
A resume does NOT reset it, and you must not reset it to buy more rounds.

A resume does NOT answer a question you had asked the PO, so an awaiting-PO
marker deliberately survived into this window. Run clear, then look at whether
they have actually replied, and mark again if you are still waiting.

Pick up at the gate the phase says you are at. Do not re-run an approval the
PO already gave, and do not silently redo work: tell them in one short Japanese
line where you are resuming from.
PROMPT
}

# --------------------------------------------------------------------- resume
resume_run() {
  local requested="${1:-}"
  load_run "$requested" true
  require_node_sources

  if run_is_live "${LAUNCHER_PID:-}"; then
    echo "Error: run $RUN_ID is still running (pid $LAUNCHER_PID)." >&2
    echo "       Switch to its pane, or close it first with: deck close $RUN_ID" >&2
    exit 1
  fi
  if [[ ! -f "$DECK_DIR/deck.yaml" ]]; then
    echo "Error: the deck this run was building is gone: $DECK_DIR" >&2
    echo "       Nothing can be resumed. Remove the run with: deck rm $RUN_ID" >&2
    exit 1
  fi

  resolve_repair_max_rounds resume
  RUN_STATUS="running"
  LAUNCHER_PID="$$"

  if [[ -n "${TMUX:-}" ]] && command -v tmux >/dev/null 2>&1; then
    AGENT_PANE="${TMUX_PANE:-$(tmux display-message -p '#{pane_id}')}"
    WINDOW_ID="$(tmux display-message -p -t "$AGENT_PANE" '#{window_id}')"
    CURRENT_WINDOW_NAME="$(tmux display-message -p -t "$AGENT_PANE" '#W')"
  else
    AGENT_PANE=""
    WINDOW_ID=""
  fi

  write_state
  tag_pane "${AGENT_PANE:-}" agent
  if [[ -n "${WINDOW_ID:-}" ]] && command -v tmux >/dev/null 2>&1; then
    tmux set-option -w @deck_run_id "$RUN_ID" 2>/dev/null || true
    tmux set-option -w @deck_state_file "$STATE_FILE" 2>/dev/null || true
  fi

  # Regenerated, not reused: a run created by an older deck gets the current
  # helpers and the current prompt the moment it is resumed.
  generate_helper_scripts
  generate_agent_prompt
  generate_resume_prompt

  if [[ -n "${WINDOW_ID:-}" ]] && command -v tmux >/dev/null 2>&1; then
    tmux rename-window "$("$RUN_DIR/window-name" display)" 2>/dev/null || true
  fi

  printf 'Resuming deck run %s\n' "$RUN_ID"
  printf 'Deck:  %s\n' "$DECK_DIR"
  printf 'Phase: %s\n' "$(run_phase "$DECK_DIR")"
  printf 'Repair rounds used: %s of %s\n' \
    "$(cat "$RUN_DIR/repair-round.txt" 2>/dev/null || printf 0)" "$REPAIR_MAX_ROUNDS"
  echo ""

  launch_agent resume
}

# --------------------------------------------------------------------- launch
launch_agent() {
  local mode="$1"
  local prompt_file="$RUN_DIR/agent-prompt.md"
  local agent_status=0
  [[ "$mode" == "resume" ]] && prompt_file="$RUN_DIR/agent-resume-prompt.md"

  cd "$DECK_DIR"

  # The kill-guard, same shape and same reason as squad's: the agent gets a
  # tmux on PATH that refuses the four destructive subcommands. deck's own
  # close path resolves the real binary (see deck_real_tmux), so this does not
  # weaken `deck close`.
  local guard_bin="$RUN_DIR/agent-guard-bin"
  mkdir -p "$guard_bin"
  if DECK_REAL_TMUX="$(deck_real_tmux)"; then
    export DECK_REAL_TMUX
    cat > "$guard_bin/tmux" <<'WRAPPER'
#!/usr/bin/env bash
set -euo pipefail
for arg in "$@"; do
  case "$arg" in
    kill-server|kill-session|kill-window|kill-pane)
      printf 'deck: blocked dangerous tmux command: %s\n' "$arg" >&2
      exit 126
      ;;
  esac
done
exec "$DECK_REAL_TMUX" "$@"
WRAPPER
    chmod +x "$guard_bin/tmux"
    export PATH="$guard_bin:$PATH"
  fi

  if ! command -v "$DECK_AGENT" >/dev/null 2>&1; then
    echo "Error: the agent binary '$DECK_AGENT' is not on PATH." >&2
    echo "       deck launches one Claude Code agent. Set DECK_AGENT to point at it." >&2
    exit 2
  fi

  # --resume ON A RESUME, --session-id ON A FIRST LAUNCH.
  #
  # These are not interchangeable. --session-id NAMES a new session; it does
  # not ask for an existing conversation back, and on a session that already
  # exists it can fail outright. A resumed run that silently started a fresh
  # conversation lost the whole interview: the purpose, the audience, the
  # agenda discussion and every answer the PO had already given.
  local -a session_args
  if [[ "$mode" == "resume" ]]; then
    session_args=(--resume "$AGENT_SESSION_ID")
  else
    session_args=(--session-id "$AGENT_SESSION_ID")
  fi

  set +e
  printf '[%s] Agent prompt sent for deck: %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$(cat "$RUN_DIR/title.txt")"
  CLAUDE_CODE_DISABLE_TERMINAL_TITLE=1 "$DECK_AGENT" --dangerously-skip-permissions \
    --allowedTools "Bash Read Write Edit Glob Grep mcp__notion-personal" \
    --append-system-prompt "$(cat "$prompt_file")" \
    "${session_args[@]}" \
    "$(initial_message "$mode")"
  agent_status=$?
  set -e

  # The agent is gone, so nothing is waiting on the PO any more. Without this a
  # run that ended with a question outstanding would leave the marker up
  # forever: there is no agent turn left to clear it. This pane is still alive,
  # so the window really is renameable and the badge really does come down.
  clear_awaiting_po "$RUN_DIR"
  # The launcher is about to exit, so the run is no longer live. Recorded
  # before printing, so `deck list` in another window is right immediately.
  LAUNCHER_PID=""
  RUN_STATUS="closed"
  write_state

  echo ""
  echo "Agent exited with status $agent_status."
  echo "Deck retained at:      $DECK_DIR"
  echo "Run artifacts at:      $RUN_DIR"
  echo "Resume with:           deck resume $RUN_ID"
  exit "$agent_status"
}

initial_message() {
  if [[ "$1" == "resume" ]]; then
    printf 'この資料作成を再開してください。まず await-po clear、deck-gate status、build-cycle --status を実行して、どこまで進んでいたか確認してから続けてください。資料のタイトル: %s' "$TASK"
  else
    printf '%s' "$TASK"
  fi
}

# ONE --source VALUE, AS THE AGENT SHOULD SEE IT.
#
# A URL passes through untouched. Anything else is a path the PO typed in
# THEIR shell, so it is resolved here, before any directory change, and
# handed on absolute. A missing file is reported now rather than discovered by
# the agent twenty minutes later - but it is a warning, not a refusal: the PO
# may be about to save the file, and refusing the launch over it would be
# worse than saying so.
resolve_source_spec() {
  local spec="$1" resolved
  case "$spec" in
    *://*) printf '%s' "$spec"; return 0 ;;
  esac
  if [[ "$spec" == /* ]]; then
    resolved="$spec"
  else
    resolved="$(cd "$(dirname "$spec")" 2>/dev/null && pwd)/$(basename "$spec")" || resolved=""
    if [[ -z "$resolved" || "$resolved" == "/$(basename "$spec")" && "$(dirname "$spec")" != "/" ]]; then
      # The directory could not be entered, so there is nothing honest to
      # resolve against. Keep what the PO typed and say so.
      printf 'Warning: --source %s could not be resolved from %s; passing it on as typed.\n' \
        "$spec" "$(pwd)" >&2
      printf '%s' "$spec"
      return 0
    fi
  fi
  if [[ ! -e "$resolved" ]]; then
    printf 'Warning: --source %s does not exist yet (looked at %s).\n' "$spec" "$resolved" >&2
    printf '         The agent will be told this path and will ask you about it.\n' >&2
  fi
  printf '%s' "$resolved"
}

# An absolute path for something that does not exist yet.
#
# The obvious spelling - $(cd "$(dirname "$x")" && pwd)/$(basename "$x") -
# collapses to "/<basename>" when the cd fails, and the surrounding `||` does
# not fire because the ASSIGNMENT succeeded. deck then created a directory at
# the filesystem ROOT. Found by the wiring tests, on a --dir whose parent had
# not been created yet, which is the ordinary case.
#
# Missing parents are created, because both callers are about to create the
# thing anyway; what is refused is a path that cannot be resolved at all.
resolve_new_path() {
  local target="$1" parent base resolved
  parent="$(dirname "$target")"
  base="$(basename "$target")"
  mkdir -p "$parent" 2>/dev/null || true
  if ! resolved="$(cd "$parent" 2>/dev/null && pwd)"; then
    echo "Error: cannot resolve $target - its parent directory does not exist" >&2
    echo "       and could not be created: $parent" >&2
    exit 1
  fi
  # Belt and braces: whatever happens above, never hand back the root.
  if [[ -z "$resolved" || -z "$base" || "$base" == "/" ]]; then
    echo "Error: refusing to resolve $target to the filesystem root" >&2
    exit 1
  fi
  printf '%s/%s' "$resolved" "$base"
}

# A deck directory name the PO can find later.
#
# Japanese characters are KEPT: the PO's own decks live under Japanese paths,
# and a slug that transliterated or dropped them would produce directories
# nobody can match to a meeting. Only genuinely path-hostile characters go.
deck_dir_for_title() {
  local title="$1" slug
  slug="$(printf '%s' "$title" |
    tr -d '\000-\037' |
    sed -E 's#[/\\:*?"<>|]#-#g; s/[[:space:]]+/-/g; s/^[-.]+//; s/-+$//')"
  slug="$(printf '%s' "$slug" | cut -c 1-80)"
  [[ -n "$slug" ]] || slug="deck"
  printf '%s/%s-%s' "$DECK_DECKS_ROOT" "$(date '+%Y%m%d')" "$slug"
}

# ------------------------------------------------------------------- dispatch

case "${1:-}" in
  ''|-h|--help|help)
    [[ "${1:-}" == "" ]] && usage 1
    usage 0
    ;;
  --version|version)
    printf 'deck 0.2.0\n'
    exit 0
    ;;
  gate)
    shift
    require_node_sources
    # The deterministic layer, verbatim. `deck gate` with no arguments prints
    # the gate layer's own usage, which is the Node CLI's.
    exec "$NODE_BIN" "$DECK_HOME/src/cli.js" "${@:---help}"
    ;;
  list)
    list_runs
    exit 0
    ;;
  check)
    check_run "${2:-}"
    exit $?
    ;;
  close)
    close_run "${2:-}"
    exit 0
    ;;
  resume)
    resume_run "${2:-}"
    exit 0
    ;;
  rm)
    shift
    [[ $# -ge 1 ]] || { echo "Error: deck rm needs at least one run id" >&2; exit 1; }
    status=0
    for id in "$@"; do
      remove_run "$id" || status=1
    done
    exit "$status"
    ;;
  clean)
    clean_runs
    exit 0
    ;;
  gen-helpers)
    [[ -n "${2:-}" ]] || {
      echo "Error: deck gen-helpers requires a target directory" >&2
      exit 1
    }
    # Writes the WHOLE generated surface - helpers and both prompts - so all of
    # it can be inspected or tested without an agent, a tmux server or a deck.
    # The placeholder values below only ever reach the generated text.
    require_own_gen_dir "$2"
    RUN_DIR="$(resolve_new_path "$2")"
    mkdir -p "$RUN_DIR"
    RUN_ID="${DECK_GEN_RUN_ID:-gen-helpers}"
    STARTED_AT="$(date '+%Y-%m-%d %H:%M:%S')"
    TASK="${DECK_GEN_TASK:-gen-helpers}"
    DECK_DIR="${DECK_GEN_DECK_DIR:-$(pwd)}"
    AGENT_SESSION_ID="${DECK_GEN_SESSION_ID:-00000000-0000-0000-0000-000000000000}"
    THEME="${DECK_GEN_THEME:-watercolor}"
    PURPOSE="${DECK_GEN_PURPOSE:-}"
    AUDIENCE="${DECK_GEN_AUDIENCE:-}"
    MEETING_WHEN="${DECK_GEN_WHEN:-}"
    SOURCE_SPECS="${DECK_GEN_SOURCE:-}"
    WINDOW_SHORT_NAME="$(placeholder_window_name)"
    resolve_repair_max_rounds
    printf '%s\n' "$TASK" > "$RUN_DIR/title.txt"
    printf '%s\n' "$WINDOW_SHORT_NAME" > "$RUN_DIR/short-name.txt"
    generate_helper_scripts
    generate_agent_prompt
    generate_resume_prompt
    printf 'Generated helpers and prompts in %s\n' "$RUN_DIR"
    exit 0
    ;;
  --)
    # Everything after -- is a title, even if it reads like a gate name. This
    # is the escape hatch for a deck genuinely called "render".
    shift
    [[ $# -ge 1 ]] || usage 1
    FORCE_TASK=true
    ;;
esac

# ---------------------------------------------------------------- launch path

TASK=""
FORCE_TASK="${FORCE_TASK:-false}"
# WHERE THE PO WAS STANDING. Captured before anything changes directory, so a
# relative --source can be resolved and so the agent can say where a path came
# from if it turns out to be wrong.
INVOKED_FROM="$(pwd)"
PURPOSE=""
AUDIENCE=""
MEETING_WHEN=""
SOURCE_SPECS=""
THEME="watercolor"
DECK_DIR_ARG=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --source)
      [[ -n "${2:-}" ]] || { echo "Error: --source requires a value" >&2; exit 1; }
      # A LOCAL PATH IS RESOLVED HERE, against the directory the PO is
      # standing in, because launch_agent cds into the deck workspace before
      # starting the agent. `--source ./notes.md` used to reach the agent
      # verbatim and resolve against the DECK, where no such file exists.
      SOURCE_ONE="$(resolve_source_spec "$2")"
      # Repeatable: minutes in Notion plus a spreadsheet on disk is one deck.
      if [[ -n "$SOURCE_SPECS" ]]; then
        SOURCE_SPECS="$SOURCE_SPECS"$'\n'"$SOURCE_ONE"
      else
        SOURCE_SPECS="$SOURCE_ONE"
      fi
      shift 2
      ;;
    --purpose)
      [[ -n "${2:-}" ]] || { echo "Error: --purpose requires a value" >&2; exit 1; }
      PURPOSE="$2"; shift 2 ;;
    --audience)
      [[ -n "${2:-}" ]] || { echo "Error: --audience requires a value" >&2; exit 1; }
      AUDIENCE="$2"; shift 2 ;;
    --when)
      [[ -n "${2:-}" ]] || { echo "Error: --when requires a value" >&2; exit 1; }
      MEETING_WHEN="$2"; shift 2 ;;
    --dir)
      [[ -n "${2:-}" ]] || { echo "Error: --dir requires a value" >&2; exit 1; }
      DECK_DIR_ARG="$2"; shift 2 ;;
    --theme)
      [[ -n "${2:-}" ]] || { echo "Error: --theme requires a value" >&2; exit 1; }
      THEME="$2"; shift 2 ;;
    -*)
      echo "Error: unknown option $1" >&2
      echo "       See: deck --help" >&2
      exit 1
      ;;
    *)
      if [[ -n "$TASK" ]]; then
        TASK="$TASK $1"
      else
        TASK="$1"
      fi
      shift
      ;;
  esac
done

[[ -n "$TASK" ]] || {
  echo "Error: deck needs a title for the deck." >&2
  echo "       Example: deck \"野沢温泉 次回MTG資料\"" >&2
  exit 1
}

# A GATE NAME IS NOT A DECK TITLE.
#
# The deterministic commands moved behind `deck gate`, so `deck render` now
# parses as a deck titled "render" - and launching an agent is a loud, slow,
# token-spending thing to do to someone who typed the old spelling out of
# habit. Refusing by name costs one line and turns a silent agent launch into
# an instruction. -- is the escape hatch for a deck really called "render".
if [[ "$FORCE_TASK" != "true" ]]; then
  case "${TASK%% *}" in
    init|doctor|source|ledger|agenda|copy|fidelity|inbox|validate|approve|status|prompts|assets|render|lint|export)
      echo "Error: \"${TASK%% *}\" is a deck GATE, not a deck title." >&2
      echo "       The deterministic commands live behind \"deck gate\" now:" >&2
      echo "         deck gate $TASK" >&2
      echo "" >&2
      echo "       deck <title> starts an agent that drives those gates for you." >&2
      echo "       If this deck is really called \"${TASK%% *}\", say: deck -- $TASK" >&2
      exit 2
      ;;
  esac
fi

require_node_sources
resolve_repair_max_rounds

RUN_ID="$(date '+%Y%m%d-%H%M%S')-$$"
STARTED_AT="$(date '+%Y-%m-%d %H:%M:%S')"

if command -v uuidgen >/dev/null 2>&1; then
  AGENT_SESSION_ID="$(uuidgen | tr 'A-Z' 'a-z')"
else
  # The session id only has to be unique per run; claude accepts any uuid.
  AGENT_SESSION_ID="$("$NODE_BIN" -e 'process.stdout.write(require("node:crypto").randomUUID())')"
fi

# WHERE THE DECK GOES.
#
# Standing inside a deck already means working on THAT deck - the PO cd'd there
# on purpose. Otherwise a new workspace under DECK_DECKS_ROOT, named so they
# can find it next month.
if [[ -n "$DECK_DIR_ARG" ]]; then
  DECK_DIR="$(resolve_new_path "$DECK_DIR_ARG")"
elif existing_root="$("$NODE_BIN" -e '
const { findWorkspace } = await import(process.argv[1] + "/src/workspace.js");
const r = findWorkspace(process.cwd());
if (r) process.stdout.write(r); else process.exit(1);
' "$DECK_HOME" 2>/dev/null)"; then
  DECK_DIR="$existing_root"
  printf 'Using the deck you are standing in: %s\n' "$DECK_DIR"
else
  DECK_DIR="$(deck_dir_for_title "$TASK")"
fi

if [[ ! -f "$DECK_DIR/deck.yaml" ]]; then
  mkdir -p "$(dirname "$DECK_DIR")"
  "$NODE_BIN" "$DECK_HOME/src/cli.js" init "$DECK_DIR" --theme "$THEME" || {
    echo "Error: could not scaffold a deck workspace at $DECK_DIR" >&2
    exit 1
  }
fi
# The drop directory for returned illustrations, so gate 7 can say "put them
# here" and mean a directory that exists.
mkdir -p "$DECK_DIR/inbox"

RUN_DIR="$DECK_RUN_ROOT/$(basename "$DECK_DIR")/$RUN_ID"
mkdir -p "$RUN_DIR"

WINDOW_SHORT_NAME="$(placeholder_window_name)"
printf '%s\n' "$TASK" > "$RUN_DIR/title.txt"
printf '%s\n' "$WINDOW_SHORT_NAME" > "$RUN_DIR/short-name.txt"

if [[ -n "${TMUX:-}" ]] && command -v tmux >/dev/null 2>&1; then
  AGENT_PANE="${TMUX_PANE:-$(tmux display-message -p '#{pane_id}')}"
  WINDOW_ID="$(tmux display-message -p -t "$AGENT_PANE" '#{window_id}')"
  CURRENT_WINDOW_NAME="$(tmux display-message -p -t "$AGENT_PANE" '#W')"
else
  AGENT_PANE=""
  WINDOW_ID=""
  CURRENT_WINDOW_NAME=""
fi

RUN_STATUS="running"
LAUNCHER_PID="$$"
write_state
tag_pane "${AGENT_PANE:-}" agent
if [[ -n "${WINDOW_ID:-}" ]] && command -v tmux >/dev/null 2>&1; then
  tmux rename-window "$WINDOW_SHORT_NAME" 2>/dev/null || true
  tmux set-option -w @deck_run_id "$RUN_ID" 2>/dev/null || true
  tmux set-option -w @deck_state_file "$STATE_FILE" 2>/dev/null || true
  tmux select-pane -T "$TASK" 2>/dev/null || true
fi

generate_helper_scripts
generate_agent_prompt
generate_resume_prompt

cat > "$RUN_DIR/run-info.txt" <<INFO
Deck title:     $TASK
Run id:         $RUN_ID
Started at:     $STARTED_AT
Deck workspace: $DECK_DIR
Run artifacts:  $RUN_DIR
Theme:          $THEME
Agent session:  $AGENT_SESSION_ID
Repair rounds:  $REPAIR_MAX_ROUNDS maximum
Purpose:        ${PURPOSE:-(the agent will ask)}
Audience:       ${AUDIENCE:-(the agent will ask)}
Meeting:        ${MEETING_WHEN:-(the agent will ask)}
Source:         ${SOURCE_SPECS:-(the agent will ask)}
INFO
cat "$RUN_DIR/run-info.txt"
echo ""

launch_agent initial
